    {
      "provider": "cdnjs",
      "library": "dayjs@1.11.21",
      "destination": "wwwroot/lib/dayjs/"
    },
    {
      "provider": "cdnjs",
      "library": "vue@3.5.41",
      "destination": "wwwroot/lib/vue/"
    },
    {
      "provider": "cdnjs",
      "library": "element-plus-icons-vue@2.3.2",
      "destination": "wwwroot/lib/element-plus-icons-vue/"
    },
    {
      "provider": "cdnjs",
      "library": "vue-i18n@11.4.8",
      "destination": "wwwroot/lib/vue-i18n/"
