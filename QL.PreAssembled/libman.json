{
  "version": "3.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "provider": "cdnjs",
      "library": "element-plus@2.13.5",
      "destination": "wwwroot/lib/element-plus/",
      "files": [
        "index.css",
        "locale/en.min.js",
        "locale/zh-cn.min.js",
        "index.full.min.js",
        "index.min.css"
      ]
    },
    {
      "provider": "cdnjs",
      "library": "axios@1.18.1",
      "destination": "wwwroot/lib/axios/"
