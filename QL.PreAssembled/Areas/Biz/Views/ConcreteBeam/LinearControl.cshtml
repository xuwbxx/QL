                    <div class="sm-card-title">{{ face.faceKey ? $t('biz.concreteBeam.' + (face.faceKey === 'floatingBulkhead' ? 'floatingBulkheadJointAsCast' : 'fixedBulkheadJointAsCast')) : face.faceName + $t('biz.concreteBeam.jointAsCastSuffix') }}</div>
                    <table class="pc-table">
                        <thead>
                            <tr><th>{{ $t('biz.concreteBeam.fieldNameHeader') }}</th><th>X</th><th>Y</th><th>Z</th></tr>
                        </thead>
                        <tbody>
                            <tr v-for="row in face.asCast" :key="row.label">
                                <td>{{ row.labelKey ? $t('biz.concreteBeam.' + row.labelKey) : row.label }}</td><td>{{ row.x }}</td><td>{{ row.y }}</td><td>{{ row.z }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- 定位点信息 -->
            <div class="sm-section-title">{{ $t('biz.concreteBeam.boltsHairpins') }}</div>
            <div class="sm-row">
                <!-- 左侧：高程测点（南北两侧各两个角点） -->
                <div class="sm-card">
                    <div class="sm-card-title">{{ $t('biz.concreteBeam.bolts') }}</div>
                    <table class="pc-table">
                        <thead>
                            <tr><th>{{ $t('biz.concreteBeam.fieldNameHeader') }}</th><th>X</th><th>Y</th><th>Z</th></tr>
                        </thead>
                        <tbody>
                            <tr v-for="row in pouringView.elevationPoints" :key="row.label">
                                <td>{{ row.labelKey ? $t('biz.concreteBeam.' + row.labelKey) : row.label }}</td><td>{{ row.x }}</td><td>{{ row.y }}</td><td>{{ row.z }}</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <!-- 右侧：轴柱测点 + 中线长度 -->
                <div class="sm-col">
                    <div class="sm-card">
                        <div class="sm-card-title">{{ $t('biz.concreteBeam.hairpins') }}</div>
                        <table class="pc-table">
                            <thead>
                                <tr><th>{{ $t('biz.concreteBeam.fieldNameHeader') }}</th><th>X</th><th>Y</th><th>Z</th></tr>
                            </thead>
                            <tbody>
                                <tr v-for="row in pouringView.axisPoints" :key="row.label">
                                    <td>{{ row.labelKey ? $t('biz.concreteBeam.' + row.labelKey) : row.label }}</td><td>{{ row.x }}</td><td>{{ row.y }}</td><td>{{ row.z }}</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="sm-card">
                        <div class="sm-card-title">{{ $t('biz.concreteBeam.lengthOnCenter') }}</div>
                        <table class="pc-table">
                            <tbody>
                                <tr><td>{{ $t('biz.concreteBeam.theoreticalLabel') }}</td><td>{{ pouringView.theoreticalCenterLength }}</td><td>{{ $t('biz.concreteBeam.theoreticalTotalLabel') }}</td><td>{{ pouringView.theoreticalTotalCenterLength }}</td></tr>
                                <tr><td>{{ $t('biz.concreteBeam.asCastLabel') }}</td><td>{{ pouringView.asCastCenterLength }}</td><td>{{ $t('biz.concreteBeam.asCastTotalLabel') }}</td><td>{{ pouringView.asCastTotalCenterLength }}</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </template>

        <!-- 底部按钮 -->
        <div style="text-align: center; padding: 16px 0 0; border-top: 1px solid #e8e8e8; margin-top: 12px;">
            <el-button type="primary" @@click="handlePouringPrint">{{ $t('biz.concreteBeam.print') }}</el-button>
            <el-button type="primary" @@click="handlePouringPreview">{{ $t('biz.concreteBeam.preview') }}</el-button>
            <el-button @@click="handlePouringCancel">{{ $t('common.cancel') }}</el-button>
        </div>
    </div>

    <!-- 6. 报告 -->
    <!-- 误差分析与报警 -->
    <div class="lc-tab-panel" v-show="activeTab === 'alarm'" v-loading="alarmLoading">
        @* 2026-11-13：「预警配置」入口已迁移到【项目信息】页签（右侧梁段表格上方工具行左侧），
           此处保留原按钮以便需要时恢复。
        <div style="display: flex; justify-content: flex-end; margin-bottom: 12px;">
            <el-button type="primary" @@click="openAlarmConfig">{{ $t('biz.concreteBeam.alarmConfig') }}</el-button>
        </div>
        *@

        <!-- 三张折线图：东 / 中 / 西 -->
        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
            <div v-for="(c, idx) in alarmCharts" :key="c.lineType"
                 style="flex: 1 1 320px; min-width: 320px; border: 1px solid #e8e8e8; border-radius: 6px; padding: 8px; background: #fff;">
                <div :ref="setAlarmChartRef(idx)" style="width: 100%; height: 260px;"></div>
            </div>
        </div>

        <!-- 预警记录列表 -->
        <div class="sm-section-title" style="margin-top: 20px;">{{ $t('biz.concreteBeam.alarmRecordsTitle') }}</div>
        <el-table :data="alarmRecords" border stripe style="width: 100%;" empty-text="-">
            <el-table-column :label="$t('biz.concreteBeam.tableIndex')" width="70" align="center">
                <template #default="scope">{{ scope.$index + 1 }}</template>
            </el-table-column>
            <el-table-column :label="$t('biz.concreteBeam.alarmColTime')" width="170" align="center">
                <template #default="scope">{{ scope.row.alarmTime ? String(scope.row.alarmTime).replace('T', ' ') : '-' }}</template>
            </el-table-column>
            <el-table-column :label="$t('biz.concreteBeam.alarmColPosition')" min-width="140" align="center">
                <template #default="scope">{{ scope.row.position || '-' }}</template>
            </el-table-column>
            <el-table-column :label="$t('biz.concreteBeam.alarmColDeviation')" width="120" align="center">
                <template #default="scope">{{ scope.row.deviation }}</template>
            </el-table-column>
            <el-table-column :label="$t('biz.concreteBeam.alarmColLevel')" width="130" align="center">
                <template #default="scope">
                    <el-tag v-if="scope.row.level === 1" type="danger">{{ $t('biz.concreteBeam.alarmLevel1') }}</el-tag>
                    <el-tag v-else-if="scope.row.level === 2" type="warning">{{ $t('biz.concreteBeam.alarmLevel2') }}</el-tag>
                    <el-tag v-else-if="scope.row.level === 3" type="info" effect="plain">{{ $t('biz.concreteBeam.alarmLevel3') }}</el-tag>
                    <span v-else>-</span>
                </template>
            </el-table-column>
        </el-table>

        <!-- 预警配置弹框 -->
        @* 2026-11-13：入口已迁到【项目信息】，本弹框仍挂在本面板内，而面板 v-show=false 时整体 display:none；
           Element Plus 的 el-dialog 默认 append-to-body=false（渲染在原地），会被父级连带隐藏，
           表现为「点【预警配置】毫无反应」。加 append-to-body 让弹框挂到 body，与触发页签解耦。 *@
        <el-dialog v-model="alarmDialogVisible" :title="$t('biz.concreteBeam.alarmConfig')" width="640px"
                   append-to-body :close-on-click-modal="false">
            <div style="font-size: 12px; color: #909399; margin-bottom: 12px;">
                {{ $t('biz.concreteBeam.alarmConfigTip') }}
            </div>
            @* 2026-11-13：已有梁段实测填报后预警配置锁定，只读展示。 *@
            <div v-if="alarmConfigLocked"
                 style="margin-bottom: 12px; padding: 8px 12px; background: #fdf6ec; border: 1px solid #f5dab1; border-radius: 4px; color: #e6a23c; font-size: 13px;">
                {{ $t('biz.concreteBeam.alarmConfigLockedTip') }}
            </div>
            <el-table :data="[{ key: 1 }, { key: 2 }, { key: 3 }]" border style="width: 100%;" :show-header="true">
                <el-table-column :label="$t('biz.concreteBeam.alarmColLevel')" width="120" align="center">
                    <template #default="scope">
                        <span>{{ $t('biz.concreteBeam.alarmLevel' + scope.row.key) }}</span>
                    </template>
                </el-table-column>
                <el-table-column :label="$t('biz.concreteBeam.alarmColMin')" align="center">
                    <template #default="scope">
                        <el-input v-model="alarmConfigForm['level' + scope.row.key + 'Min']"
                                  :disabled="!alarmConfigEditable" :placeholder="$t('biz.concreteBeam.alarmNotSet')" />
                    </template>
                </el-table-column>
                <el-table-column :label="$t('biz.concreteBeam.alarmColMax')" align="center">
                    <template #default="scope">
                        <el-input v-model="alarmConfigForm['level' + scope.row.key + 'Max']"
                                  :disabled="!alarmConfigEditable" :placeholder="$t('biz.concreteBeam.alarmNotSet')" />
                    </template>
                </el-table-column>
            </el-table>
            <template #footer>
                <div style="display: flex; justify-content: space-between;">
                    <div>
                        <el-button v-if="!alarmConfigEditable && alarmHasConfig" :disabled="alarmConfigLocked" @@click="onAlarmConfigEdit">
                            {{ $t('biz.concreteBeam.alarmEdit') }}
                        </el-button>
                    </div>
                    <div>
                        <el-button @@click="handleAlarmConfigClose">{{ $t('common.cancel') }}</el-button>
                        <el-button type="primary" :disabled="!alarmConfigEditable" @@click="handleAlarmConfigSave">
                            {{ $t('biz.concreteBeam.alarmConfirm') }}
                        </el-button>
                    </div>
                </div>
            </template>
        </el-dialog>
    </div>

    <div class="lc-tab-panel" v-show="activeTab === 'report'">
        <!-- 整体报告 -->
        <div class="sm-section-title">{{ $t('biz.concreteBeam.overallReports') }}</div>
        <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; max-width: 200px; margin-left: auto; margin-right: auto;">
            <div style="text-align: left;"><el-radio v-model="reportOverallType" label="项目信息" @@change="onReportOverallChange">{{ $t('biz.concreteBeam.reportProject') }}</el-radio></div>
            <div style="text-align: left;"><el-radio v-model="reportOverallType" label="浇筑和理论坐标" @@change="onReportOverallChange">{{ $t('biz.concreteBeam.reportCastTheory') }}</el-radio></div>
            <div style="display: flex; align-items: center; gap: 24px;">
                <el-radio v-model="reportOverallType" label="理论坐标" @@change="onReportOverallChange">{{ $t('biz.concreteBeam.reportTheory') }}</el-radio>
                @* 2026-11-13：【包含所有】按要求隐藏并禁用；值仍参与请求（includeAll 按勾选状态提交，
                   当前默认 true = 理论坐标报告列出全部节点）。 *@
                <el-checkbox v-model="reportIncludeAll" :disabled="true" v-show="false"
                             @@change="onReportOverallChange">{{ $t('biz.concreteBeam.includeAll') }}</el-checkbox>
            </div>
        </div>

        <!-- 单梁段报告 -->
        <div class="sm-section-title">{{ $t('biz.concreteBeam.segmentReports') }}</div>
        <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px;">
            <div style="display: flex; align-items: center; justify-content: center; gap: 24px;">
                <div class="sm-form-item" style="flex: 1; max-width: 360px;">
                    <label>{{ $t('biz.concreteBeam.pouringSegmentLabel') }}</label>
                    @* 2026-11-13：整体报告与单梁段报告合并为同一组单选，仅选中单梁段报告时本下拉可用 *@
                    <el-select v-model="reportSegmentName" :disabled="reportScope !== 'segment'"
                               :placeholder="$t('biz.concreteBeam.selectSegmentPrompt')" style="flex: 1;" @@change="onReportSegmentChange">
                        <el-option v-for="s in reportSegmentList" :key="s.segmentName" :label="s.label" :value="s.segmentName"></el-option>
                    </el-select>
                </div>
            </div>
            <div style="text-align: center;">
                <el-radio v-model="reportSegmentType" label="梁段设置" @@change="onReportTypeChange">{{ $t('biz.concreteBeam.reportSegmentSetup') }}</el-radio>
                <el-radio v-model="reportSegmentType" label="已浇筑梁段" style="margin-left: 24px;" @@change="onReportTypeChange">{{ $t('biz.concreteBeam.reportSegmentAsCast') }}</el-radio>
            </div>
            <div v-if="reportUnavailableHint" style="text-align: center; font-size: 13px; color: #e6a23c;">
                {{ reportUnavailableHint }}
            </div>
        </div>

        <!-- 底部按钮 -->
        <div style="text-align: center; padding: 16px 0 0; border-top: 1px solid #e8e8e8; margin-top: 12px;">
            <el-button type="primary" :loading="reportLoading" @@click="handleReportTabPrint">{{ $t('biz.concreteBeam.print') }}</el-button>
            <el-button type="primary" @@click="handleReportPreview">{{ $t('biz.concreteBeam.preview') }}</el-button>
            <el-button type="primary" :loading="reportExporting" @@click="handleReportTabExport">{{ $t('biz.concreteBeam.export') }}</el-button>
            <el-button @@click="handleReportCancel">{{ $t('common.cancel') }}</el-button>
        </div>
    </div>

    <!-- 报告预览对话框：服务端生成 PDF，前端用 PDF.js 渲染到 canvas -->
    <el-dialog v-model="reportDialogVisible" :title="reportDialogTitle" width="900px" top="4vh"
               :close-on-click-modal="false">
        <div v-loading="reportLoading" :element-loading-text="$t('biz.concreteBeam.generatingReport')" style="min-height: 360px;">
            <div v-if="reportError" style="padding: 48px 16px; text-align: center; color: #f56c6c; font-size: 14px;">
                {{ reportError }}
            </div>
            <div v-else style="text-align: center; background: #f5f7fa; padding: 12px 0; max-height: 68vh; overflow: auto;">
                <canvas ref="reportCanvas" style="max-width: 100%; box-shadow: 0 2px 12px rgba(0,0,0,.15); background: #fff;"></canvas>
            </div>
        </div>
        <template #footer>
            <div style="display: flex; align-items: center; justify-content: space-between;">
                <div>
                    <el-button size="small" :disabled="reportPageNo <= 1" @@click="reportPrevPage">{{ $t('biz.concreteBeam.prevPage') }}</el-button>
                    <span style="margin: 0 8px; font-size: 13px;">{{ reportPageCount ? reportPageNo + ' / ' + reportPageCount : '-' }}</span>
                    <el-button size="small" :disabled="reportPageNo >= reportPageCount" @@click="reportNextPage">{{ $t('biz.concreteBeam.nextPage') }}</el-button>
                    <el-button size="small" :disabled="reportZoom <= 0.5" @@click="reportZoomOut">{{ $t('biz.concreteBeam.zoomOut') }}</el-button>
                    <el-button size="small" :disabled="reportZoom >= reportZoomMax" @@click="reportZoomIn">{{ $t('biz.concreteBeam.zoomIn') }}</el-button>
                </div>
                <div>
                    <el-button type="primary" :disabled="!!reportError" @@click="handleReportPrint">{{ $t('biz.concreteBeam.print') }}</el-button>
                    <el-button type="primary" :disabled="!!reportError" @@click="handleReportExport">{{ $t('biz.concreteBeam.export') }}</el-button>
                    <el-button @@click="reportDialogVisible = false">{{ $t('biz.concreteBeam.close') }}</el-button>
                </div>
            </div>
        </template>
    </el-dialog>

    <el-dialog v-model="importDialogVisible" :title="importType === 'segments' ? $t('biz.concreteBeam.importSegmentTitle') : (importType === 'design' ? $t('biz.concreteBeam.importDesignTitle') : $t('biz.concreteBeam.importCamberTitle'))" width="560px"
               :close-on-click-modal="false" :close-on-press-escape="!importLoading" :show-close="!importLoading">
        <el-upload ref="uploadRef" class="lc-upload" drag :auto-upload="false" :limit="1"
                   :on-change="onFileChange" :on-remove="onFileRemove" :on-exceed="onFileExceed"
                   accept=".xlsx" :disabled="importLoading">
            <el-icon class="el-icon--upload"><upload-filled /></el-icon>
            <div class="el-upload__text">{{ $t('biz.concreteBeam.uploadDrag') }}<em>{{ $t('biz.concreteBeam.uploadClick') }}</em></div>
            <template #tip><div class="el-upload__tip">{{ $t('biz.concreteBeam.uploadTip') }}</div></template>
        </el-upload>
        <template #footer>
            <el-button :disabled="importLoading" @@click="importDialogVisible=false">{{ $t('common.cancel') }}</el-button>
            <el-button type="primary" :loading="importLoading" @@click="confirmImport">{{ $t('common.confirm') }}</el-button>
        </template>
    </el-dialog>
</div>

@section Scripts {
    <script>
        window.__groupID = @groupID;
        window.__pdfWorkerSrc = '@Url.Content("~/lib/pdfjs/pdf.worker.min.js")';
    </script>
    <!-- 报告预览用 PDF.js 3.11.174 经典脚本版。
         注意：pdfjs-dist 自 v4 起只发布 ES Module（pdf.min.mjs），本项目是全局 <script> 体系，
         故锁定 3.x 的最后一个版本，直接用 window.pdfjsLib。 -->
    <script src="~/lib/pdfjs/pdf.min.js"></script>
    <script src="~/lib/echarts/echarts.min.js"></script>
    <script src="~/js/Biz/concrete-beam-linear-control.js" asp-append-version="true"></script>
}
