@{
    Layout = "_LayoutModelEP";
    ViewData["Title"] = "线形管控";
    var groupID = ViewBag.GroupID ?? 0;
}

@section Styles {
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .lc-upload .el-upload, .lc-upload .el-upload-dragger { width: 100%; }

        .lc-container {
            background: #f0f2f5;
            height: 100%;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .lc-header {
            background: #fff;
            padding: 16px 24px;
            border-bottom: 1px solid #e8e8e8;
            display: flex;
            align-items: center;
        }

        .lc-title {
            font-size: 18px;
            font-weight: 600;
            color: #1890ff;
            text-align: center;
            flex: 1;
        }

        .lc-tabs-bar {
            background: #fff;
            padding: 0 24px;
            border-bottom: 1px solid #e8e8e8;
            display: flex;
            gap: 0;
            flex: 0 0 auto;
        }

        .lc-tab-btn {
            padding: 12px 24px;
            cursor: pointer;
            font-size: 14px;
            color: #606266;
            border-bottom: 2px solid transparent;
            transition: all 0.2s;
        }

            .lc-tab-btn:hover {
                color: #1890ff;
            }

            .lc-tab-btn.active {
                color: #1890ff;
                border-bottom-color: #1890ff;
                font-weight: 600;
            }

            .lc-tab-btn.disabled {
                color: #c0c4cc;
                cursor: not-allowed;
            }

                .lc-tab-btn.disabled:hover {
                    color: #c0c4cc;
                    border-bottom-color: transparent;
                }

        .lc-tab-panel {
            padding: 16px 24px;
            background: #fff;
            flex: 1 1 auto;
            min-height: 0;
            overflow-y: auto;
        }

        /* 项目信息页签左右布局 */
        .pi-layout {
            display: flex;
            gap: 20px;
        }

        .pi-sidebar {
            width: 300px;
            flex-shrink: 0;
        }

        .pi-main {
            flex: 1;
            min-width: 0;
        }

        .pi-form-section {
            margin-bottom: 20px;
        }

        .pi-form-section-title {
            font-size: 14px;
            font-weight: 600;
            color: #303133;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px solid #e8e8e8;
        }

        .pi-form-row {
            margin-bottom: 12px;
        }

        .pi-form-label {
            font-size: 13px;
            color: #606266;
            margin-bottom: 4px;
        }

        .pi-required {
            color: #f56c6c;
            margin-right: 4px;
        }

        .pi-meta {
            font-size: 12px;
            color: #909399;
            text-align: right;
            margin-bottom: 12px;
        }

        .pi-pagination {
            display: flex;
            justify-content: flex-end;
            margin-top: 16px;
        }

        /* 设站及测量页签 */
        .sm-row {
            display: flex;
            gap: 20px;
            margin-bottom: 16px;
        }

        .sm-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .sm-card {
            flex: 1;
            border: 1px solid #e8e8e8;
            border-radius: 4px;
            padding: 16px;
        }

        .sm-card-title {
            font-size: 14px;
            font-weight: 600;
            color: #303133;
            margin-bottom: 12px;
            text-align: center;
        }

        .sm-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .sm-form-cols {
            display: flex;
            gap: 20px;
        }

        .sm-form-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .sm-form-col-title {
            min-height: 32px;
            font-size: 13px;
            color: #606266;
            margin-bottom: 0;
            text-align: center;
        }

        .sm-form-item {
            min-height: 32px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .sm-form-item label {
                font-size: 13px;
                color: #606266;
                white-space: nowrap;
                min-width: 85px;
                text-align: right;
            }

        /* 输入框占满剩余宽度；有复选框时复选框靠右 */
        .sm-form-item .el-input {
            flex: 1;
            min-width: 0;
        }

        /* 复选框 tooltip 的最大宽度，避免长文案拉成一行 */
        .sm-tip-popper {
            max-width: 320px;
            line-height: 1.5;
        }

        .sm-deviation-grid {
            display: flex;
            gap: 20px;
        }

        .sm-deviation-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .sm-deviation-header {
            font-size: 13px;
            font-weight: 600;
            color: #303133;
            text-align: center;
        }

        .sm-section-title {
            font-size: 14px;
            font-weight: 600;
            color: #303133;
            margin: 12px 0;
            padding-bottom: 8px;
            border-bottom: 2px solid #d0d0d0;
        }

        /* 设计坐标「核对与预览」：等宽文本还原原版版式（上下两段） */
        .lc-mono {
            margin: 0;
            font-family: Consolas, "Courier New", monospace;
            font-size: 13px;
            line-height: 1.35;
            white-space: pre;
            color: #303133;
        }

        /* 浇筑坐标页签 */
        .pc-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .pc-table th, .pc-table td {
                border: 1px solid #e8e8e8;
                padding: 8px 12px;
                text-align: center;
            }

            .pc-table th {
                background: #fafafa;
                font-weight: 600;
                color: #303133;
            }

            .pc-table td:first-child {
                text-align: left;
            }

        .pc-length-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .pc-length-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .pc-length-item label {
                font-size: 13px;
                color: #606266;
                white-space: nowrap;
                min-width: 85px;
                text-align: right;
            }
    </style>
}

<div v-cloak id="app" class="lc-container">
    <div class="lc-tabs-bar">
        <div v-for="tab in tabs" :key="tab.name"
             :class="['lc-tab-btn', { active: activeTab === tab.name, disabled: tab.disabled }]"
            @@click="onTabChange(tab.name)">
            {{ tab.label }}
        </div>
    </div>

    <!-- 1. 项目信息 -->
    <div class="lc-tab-panel" v-show="activeTab === 'projectInfo'">
        <div v-if="hasSurveyData"
             style="margin-bottom: 12px; padding: 8px 12px; background: #fdf6ec; border: 1px solid #f5dab1; border-radius: 4px; color: #e6a23c; font-size: 13px;">
            {{ $t('biz.concreteBeam.surveyLockedProjectTip') }}
        </div>
        <div class="pi-layout">
            <!-- 左侧表单 -->
            <div class="pi-sidebar">
                <div class="pi-form-section">
                    <div class="pi-form-row">
                        <div class="pi-form-label">{{ $t('biz.concreteBeam.projectName') }}</div>
                        <el-input v-model="projectInfo.projectName" disabled></el-input>
                    </div>
                    <div class="pi-form-row">
                        <div class="pi-form-label">{{ $t('biz.concreteBeam.castingGroupName') }}</div>
                        <el-input v-model="projectInfo.castingGroupName" disabled></el-input>
                    </div>
                    <div class="pi-form-row">
                        <div class="pi-form-label">{{ $t('biz.concreteBeam.managerName') }}</div>
                        <el-input v-model="projectInfo.managerName" disabled></el-input>
                    </div>
                </div>
                <div class="pi-form-section">
                    <div class="pi-form-section-title">{{ $t('biz.concreteBeam.offsetDimensions') }}</div>
                    <div class="pi-form-row">
                        <div class="pi-form-label"><span class="pi-required">*</span>A</div>
                        <el-input v-model="projectInfo.offsetA" :placeholder="$t('biz.concreteBeam.offsetAPlaceholder')" :disabled="hasSurveyData"></el-input>
                    </div>
                    <div class="pi-form-row">
                        <div class="pi-form-label"><span class="pi-required">*</span>B</div>
                        <el-input v-model="projectInfo.offsetB" :placeholder="$t('biz.concreteBeam.offsetBPlaceholder')" :disabled="hasSurveyData"></el-input>
                    </div>
                    <div class="pi-form-row">
                        <div class="pi-form-label"><span class="pi-required">*</span>C</div>
                        <el-input v-model="projectInfo.offsetC" :placeholder="$t('biz.concreteBeam.offsetCPlaceholder')" :disabled="hasSurveyData"></el-input>
                    </div>
                </div>
                <div class="pi-form-section">
                    <div class="pi-form-section-title">{{ $t('biz.concreteBeam.referenceElevationSection') }}</div>
                    <div class="pi-form-row">
                        <div class="pi-form-label"><span class="pi-required">*</span>{{ $t('biz.concreteBeam.referenceElevation') }}</div>
                        <el-input v-model="projectInfo.referenceElevation" :placeholder="$t('biz.concreteBeam.referenceElevationPlaceholder')" :disabled="hasSurveyData"></el-input>
                    </div>
                </div>
            </div>

            <!-- 右侧表格 -->
            <div class="pi-main">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    @* 2026-11-13：「预警配置」由【误差分析与报警】页签迁移至此。 *@
                    <div>
                        <el-button type="primary" @@click="openAlarmConfig">{{ $t('biz.concreteBeam.alarmConfig') }}</el-button>
                    </div>
                    <div class="pi-meta">
                        {{ $t('biz.concreteBeam.createdBy') }}：{{ projectInfo.createdBy || '-' }}<br />
                        {{ $t('biz.concreteBeam.createdTime') }}：{{ projectInfo.createdTime || '-' }}<br />
                        {{ $t('biz.concreteBeam.updatedTime') }}：{{ projectInfo.updatedTime || '-' }}
                    </div>
                </div>
                <el-table v-loading="loading" :data="segmentTableData" border stripe style="width: 100%;">
                    <el-table-column :label="$t('biz.concreteBeam.tableIndex')" width="70" align="center">
                        <template #default="scope">{{ (segmentPageIndex - 1) * segmentPageSize + scope.$index + 1 }}</template>
                    </el-table-column>
                    <el-table-column :label="$t('biz.concreteBeam.segmentName')" min-width="150" align="center">
                        <template #default="scope">{{ scope.row.segmentName || '-' }}</template>
                    </el-table-column>
                    <el-table-column :label="$t('biz.concreteBeam.downstream')" min-width="100" align="center">
                        <template #default="scope">{{ scope.row.downstream || '-' }}</template>
                    </el-table-column>
                    <el-table-column :label="$t('biz.concreteBeam.upstream')" min-width="100" align="center">
                        <template #default="scope">{{ scope.row.upstream || '-' }}</template>
                    </el-table-column>
                    <el-table-column :label="$t('biz.concreteBeam.joint1')" width="120" align="center">
                        <template #default="scope">{{ scope.row.node1 || '-' }}</template>
                    </el-table-column>
                    <el-table-column :label="$t('biz.concreteBeam.joint2')" width="120" align="center">
                        <template #default="scope">{{ scope.row.node2 || '-' }}</template>
                    </el-table-column>
                    <el-table-column :label="$t('biz.concreteBeam.pouringDate')" width="150" align="center">
                        <template #default="scope">{{ scope.row.pouringDate || '-' }}</template>
                    </el-table-column>
                </el-table>
                <div class="pi-pagination">
                    <el-pagination background layout="total, sizes, prev, pager, next, jumper"
                                   :total="segmentTotal" :page-size="segmentPageSize" :current-page="segmentPageIndex"
                                   :page-sizes="[10, 20, 50, 100]" @@size-change="handleSegmentSizeChange" @@current-change="handleSegmentPageChange" />
                </div>
            </div>
        </div>
        <div style="text-align: center; padding: 20px 0 0; border-top: 1px solid #e8e8e8; margin-top: 20px;">
            <el-button type="primary" @@click="handleConfirm" :disabled="hasSurveyData">{{ $t('common.ok') }}</el-button>
            <el-button @@click="handleCancel" :disabled="hasSurveyData">{{ $t('common.cancel') }}</el-button>
            <el-button @@click="handleReset" :disabled="hasSurveyData">{{ $t('common.reset') }}</el-button>
        </div>
    </div>

    <!-- 2. 设计坐标 -->
    <div class="lc-tab-panel" v-show="activeTab === 'designCoord'">
        <div v-if="hasSurveyData"
             style="margin-bottom: 12px; padding: 8px 12px; background: #fdf6ec; border: 1px solid #f5dab1; border-radius: 4px; color: #e6a23c; font-size: 13px;">
            {{ $t('biz.concreteBeam.surveyLockedDesignTip') }}
        </div>
        <div style="margin-bottom: 12px;">
            <el-button @@click="downloadDesignTemplate"><el-icon><Download /></el-icon>{{ $t('biz.concreteBeam.downloadTemplate') }}</el-button>
            <el-button type="primary" @@click="handleImportDesignCoord" :disabled="hasSurveyData"><el-icon><Upload-Filled /></el-icon>{{ $t('biz.concreteBeam.importDesignCoord') }}</el-button>
        </div>
        <el-table v-loading="designLoading" :data="designTableData" border stripe style="width: 100%;">
            <el-table-column :label="$t('biz.concreteBeam.tableIndex')" width="70" align="center">
                <template #default="scope">{{ (designPageIndex - 1) * designPageSize + scope.$index + 1 }}</template>
            </el-table-column>
            <el-table-column :label="$t('biz.concreteBeam.nodeName')" min-width="150" align="center">
                <template #default="scope">{{ scope.row.nodeName || '-' }}</template>
            </el-table-column>
            <el-table-column :label="$t('biz.concreteBeam.eastControlPoint')" align="center">
                <el-table-column label="XE" width="150" align="center">
                    <template #default="scope">{{ scope.row.xe || '-' }}</template>
                </el-table-column>
                <el-table-column label="YE" width="150" align="center">
                    <template #default="scope">{{ scope.row.ye || '-' }}</template>
                </el-table-column>
                <el-table-column label="ZE" width="150" align="center">
                    <template #default="scope">{{ scope.row.ze || '-' }}</template>
                </el-table-column>
            </el-table-column>
            <el-table-column :label="$t('biz.concreteBeam.centerControlPoint')" align="center">
                <el-table-column label="XC" width="150" align="center">
                    <template #default="scope">{{ scope.row.xc || '-' }}</template>
                </el-table-column>
                <el-table-column label="YC" width="150" align="center">
                    <template #default="scope">{{ scope.row.yc || '-' }}</template>
                </el-table-column>
                <el-table-column label="ZC" width="150" align="center">
                    <template #default="scope">{{ scope.row.zc || '-' }}</template>
                </el-table-column>
            </el-table-column>
            <el-table-column :label="$t('biz.concreteBeam.westControlPoint')" align="center">
                <el-table-column label="XW" width="150" align="center">
                    <template #default="scope">{{ scope.row.xw || '-' }}</template>
                </el-table-column>
                <el-table-column label="YW" width="150" align="center">
                    <template #default="scope">{{ scope.row.yw || '-' }}</template>
                </el-table-column>
                <el-table-column label="ZW" width="150" align="center">
                    <template #default="scope">{{ scope.row.zw || '-' }}</template>
                </el-table-column>
            </el-table-column>
        </el-table>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px;">
            <div>
                <el-checkbox v-model="designNormalize" :disabled="hasSurveyData" @@change="onDesignNormalizeChange">{{ $t('biz.concreteBeam.normalize') }}</el-checkbox>
                <el-checkbox v-model="designIncludeCamber" :disabled="hasSurveyData" @@change="onDesignCamberChange" style="margin-left: 16px;">{{ $t('biz.concreteBeam.camberIncluded') }}</el-checkbox>
            </div>
            <el-pagination background layout="total, sizes, prev, pager, next, jumper"
                           :total="designTotal" :page-size="designPageSize" :current-page="designPageIndex"
                           :page-sizes="[10, 20, 50, 100]" @@size-change="handleDesignSizeChange" @@current-change="handleDesignPageChange" />
        </div>
        <div style="text-align: center; padding: 20px 0 0; border-top: 1px solid #e8e8e8; margin-top: 20px;">
            <el-button type="primary" @@click="handleDesignPrint">{{ $t('biz.concreteBeam.print') }}</el-button>
            <el-button type="primary" @@click="handleDesignPreview">{{ $t('biz.concreteBeam.preview') }}</el-button>
            <el-button type="primary" @@click="handleDesignConfirm" :disabled="hasSurveyData">{{ $t('common.apply') }}</el-button>
            <el-button @@click="handleDesignCancel" :disabled="hasSurveyData">{{ $t('common.cancel') }}</el-button>
        </div>
    </div>

    <!-- 3. 预拱度 -->
    <div class="lc-tab-panel" v-show="activeTab === 'preCamber'">
        <div v-if="hasSurveyData"
             style="margin-bottom: 12px; padding: 8px 12px; background: #fdf6ec; border: 1px solid #f5dab1; border-radius: 4px; color: #e6a23c; font-size: 13px;">
            {{ $t('biz.concreteBeam.surveyLockedCamberTip') }}
        </div>
        <div style="margin-bottom: 12px;">
            <el-button @@click="downloadCamberTemplate"><el-icon><Download /></el-icon>{{ $t('biz.concreteBeam.downloadTemplate') }}</el-button>
            <el-button type="primary" @@click="handleImportCamber" :disabled="hasSurveyData"><el-icon><Upload-Filled /></el-icon>{{ $t('biz.concreteBeam.importCamberTitle') }}</el-button>
        </div>
        <el-table v-loading="camberLoading" :data="camberTableData" border stripe style="width: 100%;">
            <el-table-column :label="$t('biz.concreteBeam.tableIndex')" width="70" align="center">
                <template #default="scope">{{ (camberPageIndex - 1) * camberPageSize + scope.$index + 1 }}</template>
            </el-table-column>
            <el-table-column :label="$t('biz.concreteBeam.nodeName')" min-width="150" align="center">
                <template #default="scope">{{ scope.row.nodeName || '-' }}</template>
            </el-table-column>
            <el-table-column label="ZE" min-width="150" align="center">
                <template #default="scope">{{ scope.row.ze || '-' }}</template>
            </el-table-column>
            <el-table-column label="ZC" min-width="150" align="center">
                <template #default="scope">{{ scope.row.zc || '-' }}</template>
            </el-table-column>
            <el-table-column label="ZW" min-width="150" align="center">
                <template #default="scope">{{ scope.row.zw || '-' }}</template>
            </el-table-column>
        </el-table>
        <div style="display: flex; justify-content: flex-end; align-items: center; margin-top: 16px;">
            <el-pagination background layout="total, sizes, prev, pager, next, jumper"
                           :total="camberTotal" :page-size="camberPageSize" :current-page="camberPageIndex"
                           :page-sizes="[10, 20, 50, 100]" @@size-change="handleCamberSizeChange" @@current-change="handleCamberPageChange" />
        </div>
        <div style="text-align: center; padding: 20px 0 0; border-top: 1px solid #e8e8e8; margin-top: 20px;">
            <el-button type="primary" @@click="handleCamberPrint">{{ $t('biz.concreteBeam.print') }}</el-button>
            <el-button type="primary" @@click="handleCamberPreview">{{ $t('biz.concreteBeam.preview') }}</el-button>
            <el-button type="primary" @@click="handleCamberConfirm" :disabled="hasSurveyData">{{ $t('common.apply') }}</el-button>
            <el-button @@click="handleCamberCancel" :disabled="hasSurveyData">{{ $t('common.cancel') }}</el-button>
        </div>
    </div>

    <!-- 设计坐标「核对与预览」已改为 PDF：复用【报告】页签的 PDF 预览弹窗（reportDialogVisible） -->

    <!-- 4. 设站及测量 -->
    <div class="lc-tab-panel" v-show="activeTab === 'setupSurvey'">
        <!-- 筛选行：梁段 / 类型 / 浇筑日期 / 上游梁段（字段名与后端 SetupNSurveyDTO 一致） -->
        <div style="display: flex; align-items: flex-start; justify-content: left; gap: 24px; margin-bottom: 16px;">
            <div class="sm-form-item" style="flex: 1; max-width: 360px;">
                <label>{{ $t('biz.concreteBeam.setupSegmentLabel') }}</label>
                <el-select v-model="segmentSurvey.segmentName" :placeholder="$t('common.pleaseSelect')" style="flex: 1;" @@change="onSegmentChange">
                    <el-option v-for="item in segmentList" :key="item.segmentName"
                               :label="item.segmentName + (item.isFirst ? '(' + $t('biz.concreteBeam.tagStarter') + ')' : '(' + $t('biz.concreteBeam.tagStandard') + ')') + (item.isFilled ? ' · ' + $t('biz.concreteBeam.tagFilled') : '')"
                               :value="item.segmentName"></el-option>
                </el-select>
                <el-tag :type="segmentIsFirst ? 'warning' : 'success'" style="margin-left: 8px; white-space: nowrap;">
                    {{ segmentIsFirst ? $t('biz.concreteBeam.tagStarter') : $t('biz.concreteBeam.tagStandard') }}
                </el-tag>
            </div>
            <div class="sm-form-item" style="flex: 1; max-width: 360px;">
                <label>{{ $t('biz.concreteBeam.castOn') }}</label>
                <el-date-picker v-model="segmentSurvey.pouringDate" type="date" :placeholder="$t('common.pleaseSelect')"
                                style="flex: 1;" :disabled="isPerfectCast || !segmentSurvey.segmentName || (!segmentSurvey.canEdit && !(segmentSurvey.segmentID > 0))"></el-date-picker>
            </div>
            <template v-if="!segmentIsFirst">
                <div class="sm-form-item" style="flex: 1; max-width: 360px;">
                    <label>{{ $t('biz.concreteBeam.matchCast') }}</label>
                    <el-input v-model="upstreamSegmentName" disabled style="flex: 1;"></el-input>
                </div>
            </template>
            <div class="sm-form-item" v-if="!segmentSurvey.canEdit && segmentSurvey.lockedReason">
                <label>{{ $t('biz.concreteBeam.status') }}</label>
                <span style="color: #e6a23c; white-space: nowrap;">{{ segmentSurvey.lockedReason }}</span>
            </div>
        </div>

        <!-- ===== 起始段布局（对应原系统 STARTER 页） ===== -->
        <template v-if="segmentSurvey.isFirst">
            <!-- 上部：活动端模板（Floating Bulkhead Setup，算法产出的目标值，只读）+ 测点偏位（Bolt Offsets，录入） -->
            <div class="sm-row">
                <div class="sm-card">
                    <div class="sm-card-title">{{ $t('biz.concreteBeam.floatingBulkheadSetup') }}</div>
                    <div class="sm-form-grid">
