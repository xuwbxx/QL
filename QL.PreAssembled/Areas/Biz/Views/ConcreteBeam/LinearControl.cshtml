@{
    Layout = "_LayoutModelEP";
    ViewData["Title"] = "线性管控";
    var groupID = ViewBag.GroupID ?? 0;
}

@section Styles {
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .lc-upload .el-upload, .lc-upload .el-upload-dragger { width: 100%; }

        .lc-container {
            background: #f0f2f5;
            height: 100%;
            overflow-y: auto;
        }

        .lc-header {
            background: #fff;
            padding: 16px 24px;
            border-bottom: 1px solid #e8e8e8;
            display: flex;
            align-items: center;
        }

        .lc-title {
            font-size: 18px;
            font-weight: 600;
            color: #1890ff;
            text-align: center;
            flex: 1;
        }

        .lc-tabs-bar {
            background: #fff;
            padding: 0 24px;
            border-bottom: 1px solid #e8e8e8;
            display: flex;
            gap: 0;
        }

        .lc-tab-btn {
            padding: 12px 24px;
            cursor: pointer;
            font-size: 14px;
            color: #606266;
            border-bottom: 2px solid transparent;
            transition: all 0.2s;
        }

            .lc-tab-btn:hover {
                color: #1890ff;
            }

            .lc-tab-btn.active {
                color: #1890ff;
                border-bottom-color: #1890ff;
                font-weight: 600;
            }

            .lc-tab-btn.disabled {
                color: #c0c4cc;
                cursor: not-allowed;
            }

                .lc-tab-btn.disabled:hover {
                    color: #c0c4cc;
                    border-bottom-color: transparent;
                }

        .lc-tab-panel {
            padding: 16px 24px;
            background: #fff;
        }

        /* 项目信息页签左右布局 */
        .pi-layout {
            display: flex;
            gap: 20px;
        }

        .pi-sidebar {
            width: 300px;
            flex-shrink: 0;
        }

        .pi-main {
            flex: 1;
            min-width: 0;
        }

        .pi-form-section {
            margin-bottom: 20px;
        }

        .pi-form-section-title {
            font-size: 14px;
            font-weight: 600;
            color: #303133;
            margin-bottom: 12px;
            padding-bottom: 8px;
            border-bottom: 1px solid #e8e8e8;
        }

        .pi-form-row {
            margin-bottom: 12px;
        }

        .pi-form-label {
            font-size: 13px;
            color: #606266;
            margin-bottom: 4px;
        }

        .pi-required {
            color: #f56c6c;
            margin-right: 4px;
        }

        .pi-meta {
            font-size: 12px;
            color: #909399;
            text-align: right;
            margin-bottom: 12px;
        }

        .pi-pagination {
            display: flex;
            justify-content: flex-end;
            margin-top: 16px;
        }

        /* 设站及测量页签 */
        .sm-row {
            display: flex;
            gap: 20px;
            margin-bottom: 16px;
        }

        .sm-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .sm-card {
            flex: 1;
            border: 1px solid #e8e8e8;
            border-radius: 4px;
            padding: 16px;
        }

        .sm-card-title {
            font-size: 14px;
            font-weight: 600;
            color: #303133;
            margin-bottom: 12px;
            text-align: center;
        }

        .sm-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .sm-form-cols {
            display: flex;
            gap: 20px;
        }

        .sm-form-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .sm-form-col-title {
            font-size: 13px;
            color: #606266;
            margin-bottom: 0;
            text-align: center;
        }

        .sm-form-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .sm-form-item label {
                font-size: 13px;
                color: #606266;
                white-space: nowrap;
                min-width: 85px;
                text-align: right;
            }

        .sm-deviation-grid {
            display: flex;
            gap: 20px;
        }

        .sm-deviation-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .sm-deviation-header {
            font-size: 13px;
            font-weight: 600;
            color: #303133;
            text-align: center;
            margin-bottom: 12px;
        }

        .sm-section-title {
            font-size: 14px;
            font-weight: 600;
            color: #303133;
            margin: 12px 0;
            padding-bottom: 8px;
            border-bottom: 2px solid #d0d0d0;
        }

        /* 浇筑坐标页签 */
        .pc-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .pc-table th, .pc-table td {
                border: 1px solid #e8e8e8;
                padding: 8px 12px;
                text-align: center;
            }

            .pc-table th {
                background: #fafafa;
                font-weight: 600;
                color: #303133;
            }

            .pc-table td:first-child {
                text-align: left;
            }

        .pc-length-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .pc-length-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .pc-length-item label {
                font-size: 13px;
                color: #606266;
                white-space: nowrap;
                min-width: 85px;
                text-align: right;
            }
    </style>
}

<div id="app" class="lc-container">
    <div class="lc-tabs-bar">
        <div v-for="tab in tabs" :key="tab.name"
             :class="['lc-tab-btn', { active: activeTab === tab.name, disabled: tab.disabled }]"
            @@click="onTabChange(tab.name)">
            {{ tab.label }}
        </div>
    </div>

    <!-- 1. 项目信息 -->
    <div class="lc-tab-panel" v-show="activeTab === 'projectInfo'">
        <div class="pi-layout">
            <!-- 左侧表单 -->
            <div class="pi-sidebar">
                <div class="pi-form-section">
                    <div class="pi-form-row">
                        <div class="pi-form-label">项目名称</div>
                        <el-input v-model="projectInfo.projectName" disabled></el-input>
                    </div>
                    <div class="pi-form-row">
                        <div class="pi-form-label">浇筑组名称</div>
                        <el-input v-model="projectInfo.castingGroupName" disabled></el-input>
                    </div>
                    <div class="pi-form-row">
                        <div class="pi-form-label">项目负责人</div>
                        <el-input v-model="projectInfo.managerName" disabled></el-input>
                    </div>
                </div>
                <div class="pi-form-section">
                    <div class="pi-form-section-title">测点偏位信息</div>
                    <div class="pi-form-row">
                        <div class="pi-form-label"><span class="pi-required">*</span>A</div>
                        <el-input v-model="projectInfo.offsetA" placeholder="请输入A值"></el-input>
                    </div>
                    <div class="pi-form-row">
                        <div class="pi-form-label"><span class="pi-required">*</span>B</div>
                        <el-input v-model="projectInfo.offsetB" placeholder="请输入B值"></el-input>
                    </div>
                    <div class="pi-form-row">
                        <div class="pi-form-label"><span class="pi-required">*</span>C</div>
                        <el-input v-model="projectInfo.offsetC" placeholder="请输入C值"></el-input>
                    </div>
                </div>
                <div class="pi-form-section">
                    <div class="pi-form-section-title">浇筑参考高程</div>
                    <div class="pi-form-row">
                        <div class="pi-form-label"><span class="pi-required">*</span>参考高程</div>
                        <el-input v-model="projectInfo.referenceElevation" placeholder="请输入参考高程"></el-input>
                    </div>
                </div>
            </div>

            <!-- 右侧表格 -->
            <div class="pi-main">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                    <div>
                        <el-button @@click="downloadSegmentTemplate">下载模板</el-button>
                        <el-button type="primary" @@click="handleImportSegment">导入梁段信息</el-button>
                    </div>
                    <div class="pi-meta">
                        创建时间：{{ projectInfo.createdTime || '-' }}<br />
                        更新时间：{{ projectInfo.updatedTime || '-' }}
                    </div>
                </div>
                <el-table v-loading="loading" :data="segmentTableData" border stripe style="width: 100%;">
                    <el-table-column label="序号" width="70" align="center">
                        <template #default="scope">{{ (segmentPageIndex - 1) * segmentPageSize + scope.$index + 1 }}</template>
                    </el-table-column>
                    <el-table-column label="梁段名称" min-width="150" align="center">
                        <template #default="scope">{{ scope.row.segmentName || '-' }}</template>
                    </el-table-column>
                    <el-table-column label="下游" min-width="100" align="center">
                        <template #default="scope">{{ scope.row.downstream || '-' }}</template>
                    </el-table-column>
                    <el-table-column label="上游" min-width="100" align="center">
                        <template #default="scope">{{ scope.row.upstream || '-' }}</template>
                    </el-table-column>
                    <el-table-column label="节点1" width="80" align="center">
                        <template #default="scope">{{ scope.row.node1 || '-' }}</template>
                    </el-table-column>
                    <el-table-column label="节点2" width="80" align="center">
                        <template #default="scope">{{ scope.row.node2 || '-' }}</template>
                    </el-table-column>
                    <el-table-column label="浇筑日期" width="150" align="center">
                        <template #default="scope">{{ scope.row.pouringDate || '-' }}</template>
                    </el-table-column>
                </el-table>
                <div class="pi-pagination">
                    <el-pagination background layout="total, sizes, prev, pager, next, jumper"
                                   :total="segmentTotal" :page-size="segmentPageSize" :current-page="segmentPageIndex"
                                   :page-sizes="[10, 20, 50]" @@size-change="handleSegmentSizeChange" @@current-change="handleSegmentPageChange" />
                </div>
            </div>
        </div>
        <div style="text-align: center; padding: 20px 0 0; border-top: 1px solid #e8e8e8; margin-top: 20px;">
            <el-button type="primary" @@click="handleConfirm">确定</el-button>
            <el-button @@click="handleCancel">取消</el-button>
            <el-button @@click="handleReset">重置</el-button>
        </div>
    </div>

    <!-- 2. 设计坐标 -->
    <div class="lc-tab-panel" v-show="activeTab === 'designCoord'">
        <div style="margin-bottom: 12px;">
            <el-button @@click="downloadDesignTemplate">下载模板</el-button>
            <el-button type="primary" @@click="handleImportDesignCoord">导入设计坐标</el-button>
        </div>
        <el-table v-loading="designLoading" :data="designTableData" border stripe style="width: 100%;">
            <el-table-column label="序号" width="70" align="center">
                <template #default="scope">{{ (designPageIndex - 1) * designPageSize + scope.$index + 1 }}</template>
            </el-table-column>
            <el-table-column label="节点名称" min-width="150" align="center">
                <template #default="scope">{{ scope.row.nodeName || '-' }}</template>
            </el-table-column>
            <el-table-column label="东侧控制点" align="center">
                <el-table-column label="XE" width="150" align="center">
                    <template #default="scope">{{ scope.row.xe || '-' }}</template>
                </el-table-column>
                <el-table-column label="YE" width="150" align="center">
                    <template #default="scope">{{ scope.row.ye || '-' }}</template>
                </el-table-column>
                <el-table-column label="ZE" width="150" align="center">
                    <template #default="scope">{{ scope.row.ze || '-' }}</template>
                </el-table-column>
            </el-table-column>
            <el-table-column label="中间控制点" align="center">
                <el-table-column label="XC" width="150" align="center">
                    <template #default="scope">{{ scope.row.xc || '-' }}</template>
                </el-table-column>
                <el-table-column label="YC" width="150" align="center">
                    <template #default="scope">{{ scope.row.yc || '-' }}</template>
                </el-table-column>
                <el-table-column label="ZC" width="150" align="center">
                    <template #default="scope">{{ scope.row.zc || '-' }}</template>
                </el-table-column>
            </el-table-column>
            <el-table-column label="西侧控制点" align="center">
                <el-table-column label="XW" width="150" align="center">
                    <template #default="scope">{{ scope.row.xw || '-' }}</template>
                </el-table-column>
                <el-table-column label="YW" width="150" align="center">
                    <template #default="scope">{{ scope.row.yw || '-' }}</template>
                </el-table-column>
                <el-table-column label="ZW" width="150" align="center">
                    <template #default="scope">{{ scope.row.zw || '-' }}</template>
                </el-table-column>
            </el-table-column>
        </el-table>
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 16px;">
            <div>
                <el-checkbox v-model="designNormalize" @@change="onDesignNormalizeChange">归一化坐标</el-checkbox>
                <el-checkbox v-model="designIncludeCamber" @@change="onDesignCamberChange" style="margin-left: 16px;">标高含预拱度</el-checkbox>
            </div>
            <el-pagination background layout="total, sizes, prev, pager, next, jumper"
                           :total="designTotal" :page-size="designPageSize" :current-page="designPageIndex"
                           :page-sizes="[10, 20, 50]" @@size-change="handleDesignSizeChange" @@current-change="handleDesignPageChange" />
        </div>
        <div style="text-align: center; padding: 20px 0 0; border-top: 1px solid #e8e8e8; margin-top: 20px;">
            <el-button type="primary" @@click="handleDesignPrint">打印</el-button>
            <el-button type="primary" @@click="handleDesignPreview">预览</el-button>
            <el-button type="primary" @@click="handleDesignConfirm">确定</el-button>
            <el-button @@click="handleDesignCancel">取消</el-button>
        </div>
    </div>

    <!-- 3. 预拱度 -->
    <div class="lc-tab-panel" v-show="activeTab === 'preCamber'">
        <div style="margin-bottom: 12px;">
            <el-button type="primary" @@click="handleImportCamber">导入预拱度</el-button>
        </div>
        <el-table v-loading="camberLoading" :data="camberTableData" border stripe style="width: 100%;">
            <el-table-column label="序号" width="70" align="center">
                <template #default="scope">{{ (camberPageIndex - 1) * camberPageSize + scope.$index + 1 }}</template>
            </el-table-column>
            <el-table-column label="节点名称" min-width="150" align="center">
                <template #default="scope">{{ scope.row.nodeName || '-' }}</template>
            </el-table-column>
            <el-table-column label="ZE" min-width="150" align="center">
                <template #default="scope">{{ scope.row.ze || '-' }}</template>
            </el-table-column>
            <el-table-column label="ZC" min-width="150" align="center">
                <template #default="scope">{{ scope.row.zc || '-' }}</template>
            </el-table-column>
            <el-table-column label="ZW" min-width="150" align="center">
                <template #default="scope">{{ scope.row.zw || '-' }}</template>
            </el-table-column>
        </el-table>
        <div style="display: flex; justify-content: flex-end; align-items: center; margin-top: 16px;">
            <el-pagination background layout="total, sizes, prev, pager, next, jumper"
                           :total="camberTotal" :page-size="camberPageSize" :current-page="camberPageIndex"
                           :page-sizes="[10, 20, 50]" @@size-change="handleCamberSizeChange" @@current-change="handleCamberPageChange" />
        </div>
        <div style="text-align: center; padding: 20px 0 0; border-top: 1px solid #e8e8e8; margin-top: 20px;">
            <el-button type="primary" @@click="handleCamberPrint">打印</el-button>
            <el-button type="primary" @@click="handleCamberPreview">预览</el-button>
            <el-button type="primary" @@click="handleCamberConfirm">确定</el-button>
            <el-button @@click="handleCamberCancel">取消</el-button>
        </div>
    </div>

    <!-- 4. 设站及测量 -->
    <div class="lc-tab-panel" v-show="activeTab === 'stationMeasure'">
        <!-- 筛选行 -->
        <div style="display: flex; align-items: center; justify-content: center; gap: 24px; margin-bottom: 16px;">
            <div class="sm-form-item" style="flex: 1; max-width: 360px;">
                <label>梁段名称</label>
                <el-select v-model="stationSegmentType" placeholder="请选择" style="flex: 1;" @@change="onStationSegmentChange">
                    <el-option label="KF-P2-1U(起始段)" value="起始段"></el-option>
                    <el-option label="KF-P2-1U(标准段)" value="标准段"></el-option>
                </el-select>
                <span style="font-size: 14px; color: #303133; white-space: nowrap;">{{ stationSegmentType }}</span>
            </div>
            <div class="sm-form-item" style="flex: 1; max-width: 360px;">
                <label>浇筑日期</label>
                <el-date-picker v-model="stationPouringDate" type="date" placeholder="默认今天" style="flex: 1;"></el-date-picker>
            </div>
            <template v-if="stationSegmentType === '标准段'">
                <div class="sm-form-item" style="flex: 1; max-width: 360px;">
                    <label>匹配浇筑</label>
                    <el-input v-model="stationMatchPouring" disabled style="flex: 1;"></el-input>
                </div>
            </template>
        </div>

        <!-- ===== 起始段布局 ===== -->
        <template v-if="stationSegmentType === '起始段'">
            <!-- 上部：活动端模板 + 测点偏位 -->
            <div class="sm-row">
                <div class="sm-card">
                    <div class="sm-card-title">活动端模板</div>
                    <div class="sm-form-grid">
                        <div class="sm-form-item"><label>东侧高程</label><el-input v-model="stationStartTemplate.eastElevation" disabled></el-input></div>
                        <div class="sm-form-item"><label>东侧长度</label><el-input v-model="stationStartTemplate.eastLength" disabled></el-input></div>
                        <div class="sm-form-item"><label>西侧高程</label><el-input v-model="stationStartTemplate.westElevation" disabled></el-input></div>
                        <div class="sm-form-item"><label>西侧长度</label><el-input v-model="stationStartTemplate.westLength" disabled></el-input></div>
                        <div class="sm-form-item"><label>中心偏移量</label><el-input v-model="stationStartTemplate.centerOffset" disabled></el-input></div>
                    </div>
                </div>
                <div class="sm-card">
                    <div class="sm-card-title">测点偏位</div>
                    <div class="sm-deviation-grid">
                        <div class="sm-deviation-col">
                            <div class="sm-deviation-header">北侧</div>
                            <div class="sm-form-item"><label>北侧a</label><el-input v-model="stationDeviation.northA"></el-input></div>
                            <div class="sm-form-item"><label>北侧c</label><el-input v-model="stationDeviation.northC"></el-input></div>
                        </div>
                        <div class="sm-deviation-col">
                            <div class="sm-deviation-header">南侧</div>
                            <div class="sm-form-item"><label>南侧a</label><el-input v-model="stationDeviation.southA"></el-input></div>
                            <div class="sm-form-item"><label>南侧c</label><el-input v-model="stationDeviation.southC"></el-input></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="sm-section-title">实测</div>
            <!-- 下部：活动端模板(实测) + 固定端模板(实测) | 浇筑梁段(实测) -->
            <div class="sm-row">
                <div class="sm-col">
                    <div class="sm-card">
                        <div class="sm-card-title">活动端模板</div>
                        <div class="sm-form-grid">
                            <div class="sm-form-item"><label>东侧高程</label><el-input v-model="stationStartActiveMeasure.eastElevation"></el-input></div>
                            <div class="sm-form-item"><label>中心偏移量</label><el-input v-model="stationStartActiveMeasure.centerOffset"></el-input></div>
                            <div class="sm-form-item"><label>西侧高程</label><el-input v-model="stationStartActiveMeasure.westElevation"></el-input></div>
                        </div>
                    </div>
                    <div class="sm-card">
                        <div class="sm-card-title">固定端模板</div>
                        <div class="sm-form-grid">
                            <div class="sm-form-item"><label>东侧高程</label><el-input v-model="stationStartFixedMeasure.eastElevation"></el-input></div>
                            <div class="sm-form-item"><label>中心偏移量</label><el-input v-model="stationStartFixedMeasure.centerOffset"></el-input></div>
                            <div class="sm-form-item"><label>西侧高程</label><el-input v-model="stationStartFixedMeasure.westElevation"></el-input></div>
                        </div>
                    </div>
                </div>
                <div class="sm-card">
                    <div class="sm-card-title">浇筑梁段</div>
                    <div class="sm-form-grid">
                        <div class="sm-form-item"><label>东北角高程</label><el-input v-model="stationStartPouringMeasure.neElevation"></el-input></div>
                        <div class="sm-form-item"><label>北向偏移量</label><el-input v-model="stationStartPouringMeasure.northOffset"></el-input></div>
                        <div class="sm-form-item"><label>西北角高程</label><el-input v-model="stationStartPouringMeasure.nwElevation"></el-input></div>
                        <div class="sm-form-item"><label>南向偏移量</label><el-input v-model="stationStartPouringMeasure.southOffset"></el-input></div>
                        <div class="sm-form-item"><label>东南角高程</label><el-input v-model="stationStartPouringMeasure.seElevation"></el-input></div>
                        <div class="sm-form-item"><label>东侧长度</label><el-input v-model="stationStartPouringMeasure.eastLength"></el-input></div>
                        <div class="sm-form-item"><label>西南角高程</label><el-input v-model="stationStartPouringMeasure.swElevation"></el-input></div>
                        <div class="sm-form-item"><label>西侧长度</label><el-input v-model="stationStartPouringMeasure.westLength"></el-input></div>
                    </div>
                    <div style="margin-top: 12px;"><el-checkbox v-model="stationAccuracyOk">精度达标</el-checkbox></div>
                </div>
            </div>
        </template>

        <!-- ===== 标准段布局 ===== -->
        <template v-if="stationSegmentType === '标准段'">
            <!-- 上部：匹配梁段设置参数 + 测点偏位 -->
            <div class="sm-row">
                <div class="sm-card">
                    <div class="sm-card-title">匹配梁段设置参数</div>
                    <div class="sm-form-cols">
                        <div class="sm-form-col">
                            <div class="sm-form-item"><label>东北角高程</label><el-input v-model="stationStandardParams.neElevation" disabled></el-input></div>
                            <div class="sm-form-item"><label>西北角高程</label><el-input v-model="stationStandardParams.nwElevation" disabled></el-input></div>
                            <div class="sm-form-item"><label>东南角高程</label><el-input v-model="stationStandardParams.seElevation" disabled></el-input></div>
                            <div class="sm-form-item"><label>西南角高程</label><el-input v-model="stationStandardParams.swElevation" disabled></el-input></div>
                        </div>
                        <div class="sm-form-col">
                            <div class="sm-form-col-title">中心偏移量：</div>
                            <div class="sm-form-item"><label>北向</label><el-input v-model="stationStandardParams.northOffset" disabled></el-input></div>
                            <div class="sm-form-item"><label>南向</label><el-input v-model="stationStandardParams.southOffset" disabled></el-input></div>
                            <div class="sm-form-item"><label>梁段长度</label><el-input v-model="stationStandardParams.segmentLength" disabled></el-input></div>
                        </div>
                    </div>
                </div>
                <div class="sm-card">
                    <div class="sm-card-title">测点偏位</div>
                    <div class="sm-deviation-grid">
                        <div class="sm-deviation-col">
                            <div class="sm-deviation-header">北侧</div>
                            <div class="sm-form-item"><label>北侧a</label><el-input v-model="stationDeviation.northA"></el-input></div>
                            <div class="sm-form-item"><label>北侧c</label><el-input v-model="stationDeviation.northC"></el-input></div>
                        </div>
                        <div class="sm-deviation-col">
                            <div class="sm-deviation-header">南侧</div>
                            <div class="sm-form-item"><label>南侧a</label><el-input v-model="stationDeviation.southA"></el-input></div>
                            <div class="sm-form-item"><label>南侧c</label><el-input v-model="stationDeviation.southC"></el-input></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="sm-section-title">实测</div>
            <!-- 下部 2×2 -->
            <div class="sm-row">
                <div class="sm-card">
                    <div class="sm-card-title">匹配梁段</div>
                    <div class="sm-form-cols">
                        <div class="sm-form-col">
                            <div class="sm-form-item"><label>东北角高程</label><el-input v-model="stationStandardMatchMeasure.neElevation"></el-input></div>
                            <div class="sm-form-item"><label>西北角高程</label><el-input v-model="stationStandardMatchMeasure.nwElevation"></el-input></div>
                            <div class="sm-form-item"><label>东南角高程</label><el-input v-model="stationStandardMatchMeasure.seElevation"></el-input></div>
                            <div class="sm-form-item"><label>西南角高程</label><el-input v-model="stationStandardMatchMeasure.swElevation"></el-input></div>
                        </div>
                        <div class="sm-form-col">
                            <div class="sm-form-col-title">中心偏移量：</div>
                            <div class="sm-form-item"><label>北向</label><el-input v-model="stationStandardMatchMeasure.northOffset"></el-input></div>
                            <div class="sm-form-item"><label>南向</label><el-input v-model="stationStandardMatchMeasure.southOffset"></el-input></div>
                        </div>
                    </div>
                </div>
                <div class="sm-card">
                    <div class="sm-card-title">浇筑梁段</div>
                    <div class="sm-form-cols">
                        <div class="sm-form-col">
                            <div class="sm-form-item"><label>东北角高程</label><el-input v-model="stationStandardPouringMeasure.neElevation"></el-input></div>
                            <div class="sm-form-item"><label>西北角高程</label><el-input v-model="stationStandardPouringMeasure.nwElevation"></el-input></div>
                            <div class="sm-form-item"><label>东南角高程</label><el-input v-model="stationStandardPouringMeasure.seElevation"></el-input></div>
                            <div class="sm-form-item"><label>西南角高程</label><el-input v-model="stationStandardPouringMeasure.swElevation"></el-input></div>
                        </div>
                        <div class="sm-form-col">
                            <div class="sm-form-col-title">中心偏移量：</div>
                            <div class="sm-form-item"><label>北向</label><el-input v-model="stationStandardPouringMeasure.northOffset"></el-input></div>
                            <div class="sm-form-item"><label>南向</label><el-input v-model="stationStandardPouringMeasure.southOffset"></el-input></div>
                            <div class="sm-form-item"><label>梁段长度</label><el-input v-model="stationStandardPouringMeasure.segmentLength"></el-input></div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="sm-row">
                <div class="sm-card">
                    <div class="sm-card-title">固定端模板</div>
                    <div class="sm-form-grid">
                        <div class="sm-form-item"><label>东侧高程</label><el-input v-model="stationStandardFixedMeasure.eastElevation"></el-input></div>
                        <div class="sm-form-item"><label>中心偏移量</label><el-input v-model="stationStandardFixedMeasure.centerOffset"></el-input></div>
                        <div class="sm-form-item"><label>西侧高程</label><el-input v-model="stationStandardFixedMeasure.westElevation"></el-input></div>
                    </div>
                </div>
                <div class="sm-card" style="display: flex; flex-direction: column;">
                    <div class="sm-form-grid">
                        <div class="sm-form-item"><label>匹配浇筑扭转</label><el-input v-model="stationMatchTorsion"></el-input></div>
                    </div>
                    <div style="margin-top: auto;"><el-checkbox v-model="stationAccuracyOk">精度达标</el-checkbox></div>
                </div>
            </div>
        </template>

        <!-- 底部按钮 -->
        <div style="text-align: center; padding: 16px 0 0; border-top: 1px solid #e8e8e8; margin-top: 12px;">
            <el-button type="primary" @@click="handleStationPrint">打印</el-button>
            <el-button type="primary" @@click="handleStationConfirm">确定</el-button>
            <el-button @@click="handleStationCancel">取消</el-button>
        </div>
    </div>

    <!-- 5. 浇筑坐标 -->
    <div class="lc-tab-panel" v-show="activeTab === 'pouringCoord'">
        <!-- 筛选行 -->
        <div style="display: flex; align-items: center; justify-content: center; gap: 24px; margin-bottom: 16px;">
            <div class="sm-form-item" style="flex: 1; max-width: 360px;">
                <label>梁段名称</label>
                <el-select v-model="pouringSegmentType" placeholder="请选择" style="flex: 1;" @@change="onPouringSegmentChange">
                    <el-option label="KF-P2-1U(起始段)" value="起始段"></el-option>
                    <el-option label="KF-P2-1U(标准段)" value="标准段"></el-option>
                </el-select>
                <span style="font-size: 14px; color: #303133; white-space: nowrap;">{{ pouringSegmentType }}</span>
            </div>
            <div class="sm-form-item" style="flex: 1; max-width: 360px;">
                <label>浇筑日期</label>
                <el-date-picker v-model="pouringPouringDate" type="date" placeholder="默认今天" style="flex: 1;"></el-date-picker>
            </div>
            <template v-if="pouringSegmentType === '标准段'">
                <div class="sm-form-item" style="flex: 1; max-width: 360px;">
                    <label>匹配浇筑</label>
                    <el-input v-model="pouringMatchPouring" disabled style="flex: 1;"></el-input>
                </div>
            </template>
        </div>

        <!-- 第一行：端部节点理论坐标 + 端部节点浇筑坐标 -->
        <div class="sm-row">
            <div class="sm-card">
                <div class="sm-card-title">端部节点理论坐标</div>
                <table class="pc-table">
                    <thead>
                        <tr><th>字段名称</th><th>X</th><th>Y</th><th>Z</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>西侧控制点</td><td>{{ pouringTheoreticalCoords.west.x }}</td><td>{{ pouringTheoreticalCoords.west.y }}</td><td>{{ pouringTheoreticalCoords.west.z }}</td></tr>
                        <tr><td>中心线</td><td>{{ pouringTheoreticalCoords.center.x }}</td><td>{{ pouringTheoreticalCoords.center.y }}</td><td>{{ pouringTheoreticalCoords.center.z }}</td></tr>
                        <tr><td>东侧控制点</td><td>{{ pouringTheoreticalCoords.east.x }}</td><td>{{ pouringTheoreticalCoords.east.y }}</td><td>{{ pouringTheoreticalCoords.east.z }}</td></tr>
                    </tbody>
                </table>
            </div>
            <div class="sm-card">
                <div class="sm-card-title">端部节点浇筑坐标</div>
                <table class="pc-table">
                    <thead>
                        <tr><th>字段名称</th><th>X</th><th>Y</th><th>Z</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>西侧控制点</td><td>{{ pouringActualCoords.west.x }}</td><td>{{ pouringActualCoords.west.y }}</td><td>{{ pouringActualCoords.west.z }}</td></tr>
                        <tr><td>中心线</td><td>{{ pouringActualCoords.center.x }}</td><td>{{ pouringActualCoords.center.y }}</td><td>{{ pouringActualCoords.center.z }}</td></tr>
                        <tr><td>东侧控制点</td><td>{{ pouringActualCoords.east.x }}</td><td>{{ pouringActualCoords.east.y }}</td><td>{{ pouringActualCoords.east.z }}</td></tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- 第二行：定位点信息 -->
        <div class="sm-section-title">定位点信息</div>
        <div class="sm-row">
            <!-- 左侧：高程测点 -->
            <div class="sm-card">
                <div class="sm-card-title">高程测点</div>
                <table class="pc-table">
                    <thead>
                        <tr><th>字段名称</th><th>X</th><th>Y</th><th>Z</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>东北侧点位</td><td>{{ pouringElevationPoints.ne.x }}</td><td>{{ pouringElevationPoints.ne.y }}</td><td>{{ pouringElevationPoints.ne.z }}</td></tr>
                        <tr><td>西北侧点位</td><td>{{ pouringElevationPoints.nw.x }}</td><td>{{ pouringElevationPoints.nw.y }}</td><td>{{ pouringElevationPoints.nw.z }}</td></tr>
                        <tr><td>东南侧点位</td><td>{{ pouringElevationPoints.se.x }}</td><td>{{ pouringElevationPoints.se.y }}</td><td>{{ pouringElevationPoints.se.z }}</td></tr>
                        <tr><td>西南侧点位</td><td>{{ pouringElevationPoints.sw.x }}</td><td>{{ pouringElevationPoints.sw.y }}</td><td>{{ pouringElevationPoints.sw.z }}</td></tr>
                    </tbody>
                </table>
            </div>
            <!-- 右侧：轴线测点 + 中线长度 -->
            <div class="sm-col">
                <div class="sm-card">
                    <div class="sm-card-title">轴线测点</div>
                    <table class="pc-table">
                        <thead>
                            <tr><th>字段名称</th><th>X</th><th>Y</th><th>Z</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>北侧点位</td><td>{{ pouringAxisPoints.north.x }}</td><td>{{ pouringAxisPoints.north.y }}</td><td>{{ pouringAxisPoints.north.z }}</td></tr>
                            <tr><td>南侧点位</td><td>{{ pouringAxisPoints.south.x }}</td><td>{{ pouringAxisPoints.south.y }}</td><td>{{ pouringAxisPoints.south.z }}</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="sm-card">
                    <div class="sm-card-title">中线长度</div>
                    <table class="pc-table">
                        <tbody>
                            <tr><td>理论值</td><td>{{ pouringCenterLine.theoreticalValue }}</td><td>理论值总长度</td><td>{{ pouringCenterLine.theoreticalTotal }}</td></tr>
                            <tr><td>实测值</td><td>{{ pouringCenterLine.actualValue }}</td><td>实测值总长度</td><td>{{ pouringCenterLine.actualTotal }}</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- 底部按钮 -->
        <div style="text-align: center; padding: 16px 0 0; border-top: 1px solid #e8e8e8; margin-top: 12px;">
            <el-button type="primary" @@click="handlePouringPrint">打印</el-button>
            <el-button type="primary" @@click="handlePouringPreview">预览</el-button>
            <el-button @@click="handlePouringCancel">取消</el-button>
        </div>
    </div>

    <!-- 6. 报告 -->
    <div class="lc-tab-panel" v-show="activeTab === 'report'">
        <!-- 整体报告 -->
        <div class="sm-section-title">整体报告</div>
        <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; max-width: 200px; margin-left: auto; margin-right: auto;">
            <div style="text-align: left;"><el-radio v-model="reportOverallType" label="项目信息">项目信息</el-radio></div>
            <div style="text-align: left;"><el-radio v-model="reportOverallType" label="浇筑和理论坐标">浇筑和理论坐标</el-radio></div>
            <div style="display: flex; align-items: center; gap: 24px;">
                <el-radio v-model="reportOverallType" label="理论坐标">理论坐标</el-radio>
                <el-checkbox v-model="reportIncludeAll">包含所有</el-checkbox>
            </div>
        </div>

        <!-- 单梁段报告 -->
        <div class="sm-section-title">单梁段报告</div>
        <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px;">
            <div style="display: flex; align-items: center; justify-content: center; gap: 24px;">
                <div class="sm-form-item" style="flex: 1; max-width: 360px;">
                    <label>梁段名称</label>
                    <el-select v-model="reportSegmentName" placeholder="请选择" style="flex: 1;" @@change="onReportSegmentChange">
                        <el-option label="KF-P2-1U(起始段)" value="起始段"></el-option>
                        <el-option label="KF-P2-1U(标准段)" value="标准段"></el-option>
                    </el-select>

                </div>
            </div>
            <div style="text-align: center;">
                <el-radio v-model="reportSegmentType" label="梁段设置">梁段设置</el-radio>
                <el-radio v-model="reportSegmentType" label="已浇筑梁段" style="margin-left: 24px;">已浇筑梁段</el-radio>
            </div>
        </div>

        <!-- 底部按钮 -->
        <div style="text-align: center; padding: 16px 0 0; border-top: 1px solid #e8e8e8; margin-top: 12px;">
            <el-button type="primary" @@click="handleReportPrint">打印</el-button>
            <el-button type="primary" @@click="handleReportPreview">预览</el-button>
            <el-button type="primary" @@click="handleReportExport">导出</el-button>
            <el-button @@click="handleReportCancel">取消</el-button>
        </div>
    </div>

    <el-dialog v-model="importDialogVisible" :title="importType === 'segments' ? '导入梁段信息' : '导入设计坐标'" width="560px"
               :close-on-click-modal="false" :close-on-press-escape="!importLoading" :show-close="!importLoading">
        <el-upload ref="uploadRef" class="lc-upload" drag :auto-upload="false" :limit="1"
                   :on-change="onFileChange" :on-remove="onFileRemove" :on-exceed="onFileExceed"
                   accept=".xlsx" :disabled="importLoading">
            <el-icon class="el-icon--upload"><upload-filled /></el-icon>
            <div class="el-upload__text">将文件拖曳到此区域，或<em>点击添加</em></div>
            <template #tip><div class="el-upload__tip">仅支持 .xlsx，最大 20 MB，第一个工作表最多 50,000 条数据。</div></template>
        </el-upload>
        <template #footer>
            <el-button :disabled="importLoading" @@click="importDialogVisible=false">取消</el-button>
            <el-button type="primary" :loading="importLoading" @@click="confirmImport">确定</el-button>
        </template>
    </el-dialog>
</div>

@section Scripts {
    <script>
        window.__groupID = @groupID;
    </script>
    <script src="~/js/Biz/concrete-beam-linear-control.js" asp-append-version="true"></script>
}
