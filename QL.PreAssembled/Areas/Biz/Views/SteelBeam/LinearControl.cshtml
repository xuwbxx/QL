@{
    Layout = "_LayoutModelEP";
    ViewData["Title"] = "线性管控";
    var bridgeID = ViewBag.BridgeID ?? 0;
}

@section Styles {
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: auto;
        }

        .lc-container {
            background: #f0f2f5;
            min-height: 100%;
        }

        .lc-header {
            background: #fff;
            padding: 16px 24px;
            border-bottom: 1px solid #e8e8e8;
            display: flex;
            align-items: center;
        }

        .lc-title {
            font-size: 18px;
            font-weight: 600;
            color: #1890ff;
            text-align: center;
            flex: 1;
        }

        .lc-tabs-bar {
            background: #fff;
            padding: 0 24px;
            border-bottom: 1px solid #e8e8e8;
            display: flex;
            gap: 0;
        }

        .lc-tab-btn {
            padding: 12px 24px;
            cursor: pointer;
            font-size: 14px;
            color: #606266;
            border-bottom: 2px solid transparent;
            transition: all 0.2s;
        }

            .lc-tab-btn:hover {
                color: #1890ff;
            }

            .lc-tab-btn.active {
                color: #1890ff;
                border-bottom-color: #1890ff;
                font-weight: 600;
            }

        .lc-tab-panel {
            padding: 20px 24px;
            background: #fff;
        }

        .lc-search-area {
            display: flex;
            justify-content: space-between;
            margin-bottom: 16px;
            align-items: center;
        }

        .lc-search-left {
            display: flex;
            gap: 10px;
            align-items: center;
        }

        .lc-pagination {
            display: flex;
            justify-content: flex-end;
            margin-top: 16px;
        }

        .lc-import-dialog .el-dialog__body {
            padding: 0 20px;
        }

        .lc-import-tips {
            background: #f0f7ff;
            border: 1px solid #d6e8ff;
            border-radius: 4px;
            padding: 12px 16px;
            margin-bottom: 20px;
        }

            .lc-import-tips ul {
                margin: 0;
                padding: 0;
                list-style: none;
            }

            .lc-import-tips li {
                font-size: 13px;
                color: #606266;
                line-height: 1.8;
                position: relative;
                padding-left: 14px;
            }

                .lc-import-tips li::before {
                    content: '';
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: #1890ff;
                    position: absolute;
                    left: 0;
                    top: 9px;
                }

        .lc-upload-zone {
            width: 100%;
        }

            .lc-upload-zone .el-upload-dragger {
                width: 100%;
                height: 200px;
                display: flex;
                flex-direction: column;
                justify-content: center;
                align-items: center;
            }

                .lc-upload-zone .el-upload-dragger .el-icon--upload {
                    font-size: 48px;
                    color: #1890ff;
                    margin-bottom: 8px;
                }

            .lc-upload-zone .el-upload__text {
                font-size: 14px;
                color: #606266;
            }

                .lc-upload-zone .el-upload__text em {
                    color: #1890ff;
                    font-style: normal;
                }
    </style>
}

<div id="app" class="lc-container">
    <div class="lc-header">
        <el-button type="primary" plain size="small" @@click="goBack">返回</el-button>
        <div class="lc-title">{{ pageTitle }}</div>
    </div>

    <div class="lc-tabs-bar">
        <div v-for="tab in tabs" :key="tab.name"
             :class="['lc-tab-btn', { active: activeTab === tab.name }]"
            @@click="onTabChange(tab.name)">
            {{ tab.label }}
        </div>
    </div>

    <!-- 理论数据 -->
    <div class="lc-tab-panel" v-show="activeTab === 'theoretical'">
        <div class="lc-search-area">
            <div class="lc-search-left">
                <el-select v-model="searchPointCode" placeholder="请选择测点编号" clearable style="width: 200px;">
                    <el-option v-for="item in pointOptions" :key="item" :label="item" :value="item"></el-option>
                </el-select>
                <el-select v-model="searchSegment" placeholder="请选择梁段号" clearable style="width: 200px;">
                    <el-option v-for="item in segmentOptions" :key="item" :label="item" :value="item"></el-option>
                </el-select>
                <el-button type="primary" @@click="handleSearch">搜索</el-button>
                <el-button @@click="handleReset">重置</el-button>
            </div>
            <el-button type="primary" @@click="handleImport">导入理论数据</el-button>
        </div>
        <el-table v-loading="loading" :data="tableData" border stripe style="width: 100%;">

            <el-table-column label="测点编号" min-width="120" align="center">
                <template #default="scope">{{ scope.row.pointCode || '-' }}</template>
            </el-table-column>

            <!-- 多级表头：设计坐标(m) 包含 X Y Z -->
            <el-table-column label="设计坐标(m)" align="center">
                <el-table-column label="x" width="110" align="center">
                    <template #default="scope">{{ scope.row.designX || '-' }}</template>
                </el-table-column>
                <el-table-column label="y" width="110" align="center">
                    <template #default="scope">{{ scope.row.designY || '-' }}</template>
                </el-table-column>
                <el-table-column label="z" width="110" align="center">
                    <template #default="scope">{{ scope.row.designZ || '-' }}</template>
                </el-table-column>
            </el-table-column>

            <el-table-column label="预拱度(m)" width="110" align="center">
                <template #default="scope">{{ scope.row.preCamber || '-' }}</template>
            </el-table-column>
            <el-table-column label="权值" width="80" align="center">
                <template #default="scope">{{ scope.row.weight || '-' }}</template>
            </el-table-column>
            <el-table-column label="所属梁段号" width="120" align="center">
                <template #default="scope">{{ scope.row.segmentNo || '-' }}</template>
            </el-table-column>
            <el-table-column label="测位名称" min-width="120" align="center">
                <template #default="scope">{{ scope.row.positionName || '-' }}</template>
            </el-table-column>

            <el-table-column label="操作" width="100" align="center">
                <template #default="scope">
                    <el-button type="primary" link @@click="handleEdit(scope.row)">编辑</el-button>
                </template>
            </el-table-column>
        </el-table>
        <div class="lc-pagination">
            <el-pagination background layout="total, sizes, prev, pager, next, jumper"
                           :total="total" :page-size="pageSize" :current-page="pageIndex"
                           :page-sizes="[10, 20, 50]" @@size-change="handleSizeChange" @@current-change="handlePageChange" />
        </div>
    </div>

    <!-- 实测数据 -->
    <div class="lc-tab-panel" v-show="activeTab === 'measured'">
        <div class="lc-search-area">
            <div class="lc-search-left">
                <el-select v-model="searchPushCount" placeholder="请选择顶推次数" clearable style="width: 200px;">
                    <el-option v-for="item in pushCountOptions" :key="item" :label="item" :value="item"></el-option>
                </el-select>
                <el-date-picker v-model="searchMeasureTime" type="datetime" placeholder="选择测量时间" value-format="YYYY-MM-DD HH:mm:ss" style="width: 220px;"></el-date-picker>
                <el-button type="primary" @@click="handleSearch">搜索</el-button>
                <el-button @@click="handleReset">重置</el-button>
            </div>
            <div>
                <el-button type="primary" @@click="handleImport">导入实测数据</el-button>
                <el-button type="primary" plain @@click="handleDownloadMeasured">下载实测数据</el-button>
                <el-button type="primary" plain @@click="handleDownloadTemplate">下载模板</el-button>
            </div>
        </div>
        <el-table v-loading="loading" :data="tableData" border stripe style="width: 100%;">
            <el-table-column label="测点编号" min-width="150" align="center">
                <template #default="scope">{{ scope.row.pointCode || '-' }}</template>
            </el-table-column>

            <!-- 多级表头：设计坐标(m) 包含 X Y Z -->
            <el-table-column label="实测坐标(m)" align="center">
                <el-table-column label="x" width="110" align="center">
                    <template #default="scope">{{ scope.row.measuredX || '-' }}</template>
                </el-table-column>
                <el-table-column label="y" width="110" align="center">
                    <template #default="scope">{{ scope.row.measuredY || '-' }}</template>
                </el-table-column>
                <el-table-column label="z" width="110" align="center">
                    <template #default="scope">{{ scope.row.measuredZ || '-' }}</template>
                </el-table-column>
            </el-table-column>

            <el-table-column label="操作" width="100" align="center">
                <template #default="scope">
                    <el-button type="primary" link @@click="handleEdit(scope.row)">编辑</el-button>
                </template>
            </el-table-column>
        </el-table>
        <div class="lc-pagination">
            <el-pagination background layout="total, sizes, prev, pager, next, jumper"
                           :total="total" :page-size="pageSize" :current-page="pageIndex"
                           :page-sizes="[10, 20, 50]" @@size-change="handleSizeChange" @@current-change="handlePageChange" />
        </div>
    </div>

    <!-- 监控计算 -->
    <div class="lc-tab-panel" v-show="activeTab === 'monitoring'">
    </div>

    <!-- 误差分析 -->
    <div class="lc-tab-panel" v-show="activeTab === 'analysis'">
    </div>

    <!-- 导入对话框 -->
    <el-dialog v-model="importDialogVisible" :title="importDialogTitle" width="520px" class="lc-import-dialog" :close-on-click-modal="false">
        <div class="lc-import-tips">
            <ul>
                <li v-if="activeTab === 'theoretical'">测点编号可以是数字+符号+字母格式，例如GS-Z-1-4；</li>
                <li v-if="activeTab === 'theoretical'">权值是测点的重要程度，范围0~1，默认取值1，例如快车道测点权值取1，人行道测点取0.5，若取0表示不计算该测点；</li>
                <li v-if="activeTab === 'theoretical'">坐标及预拱度单位均为m。</li>
                <li v-if="activeTab === 'measured'">只录入未发生变形的测点，若测点所在梁段已离开支架发生变形，则不录入。</li>
            </ul>
        </div>
        <div v-if="activeTab === 'measured'" style="margin-bottom: 20px;">
            <div style="display: flex; gap: 20px; margin-bottom: 16px;">
                <div style="flex: 1;">
                    <div style="margin-bottom: 6px; font-size: 14px; color: #606266;">顶推次数</div>
                    <el-select v-model="importPushCount" placeholder="请选择顶推次数" style="width: 100%;">
                        <el-option v-for="item in pushCountOptions" :key="item" :label="item" :value="item"></el-option>
                    </el-select>
                </div>
                <div style="flex: 1;">
                    <div style="margin-bottom: 6px; font-size: 14px; color: #606266;">测量时间</div>
                    <el-date-picker v-model="importMeasureTime" type="datetime" placeholder="选择测量时间" value-format="YYYY-MM-DD HH:mm:ss" style="width: 100%;"></el-date-picker>
                </div>
            </div>
        </div>
        <el-upload class="lc-upload-zone" drag :auto-upload="false" :limit="1" :on-change="onFileChange" :on-exceed="onFileExceed" accept=".xlsx,.xls,.csv">
            <el-icon class="el-icon--upload"><UploadFilled /></el-icon>
            <div class="el-upload__text">将文件拖曳到此区域，或<em>点击添加</em></div>
            <template #tip>
                <div style="font-size: 12px; color: #909399; text-align: center; margin-top: 4px;">支持 .xlsx / .xls / .csv 格式文件</div>
            </template>
        </el-upload>
        <template #footer>
            <el-button @@click="importDialogVisible = false">取消</el-button>
            <el-button type="primary" @@click="confirmImport" :loading="importLoading">确定</el-button>
        </template>
    </el-dialog>
</div>

@section Scripts {
    <script src="~/js/Biz/steel-beam-linear-control.js" asp-append-version="true"></script>
}
