@{
    Layout = "_LayoutEP";
    ViewData["Title"] = "节段拼装梁预制安装线形控制平台";
}
@section Styles {
    <link href="~/css/Home/home-index.css" rel="stylesheet" />
}
<div v-cloak id="app">
    <el-container>
        <!-- 左侧侧边栏 -->
        <el-aside :class="{ 'aside-collapse': isCollapsed }" :width="isCollapsed ? '64px' : '240px'">
            <div class="sidebar-logo">
                <div class="logo-line2">节段拼装梁预制<span>安装</span></div>
                <div class="logo-text">线形控制平台</div>
            </div>
            <div class="sidebar-menu-wrapper">
                <el-menu ref="elMenuRef"
                         class="sidebar-menu"
                         :selected="activeMenuId"
                         v-on:select="(val)=>{ activeMenuId.value = val; handleMenuSelect(val); }"
                         :collapse="isCollapsed"
                         :collapse-transition="false"
                         router="false"
                         unique-opened>
                    <template v-for="item in menuTree" :key="item.id">
                        <!-- 一级目录菜单 -->
                        <el-sub-menu v-if="item.menuType !== 'button' && hasChildren(item)" :index="String(item.id)">
                            <template #title>
                                <el-icon v-if="item.icon">
                                    <component :is="item.icon" />
                                </el-icon>
                                <span>{{ $t(`dyn.menu.menu_${item.id}`) }}</span>
                            </template>
                            <template v-for="child in item.children" :key="child.id">
                                <el-sub-menu v-if="child.menuType !== 'button' && hasChildren(child)" :index="String(child.id)">
                                    <template #title>
                                        <el-icon v-if="child.icon">
                                            <component :is="child.icon" />
                                        </el-icon>
                                        <span>{{ $t(`dyn.menu.menu_${child.id}`) }}</span>
                                    </template>
                                    <el-menu-item v-for="grandChild in child.children"
                                                  :key="grandChild.id"
                                                  :index="String(grandChild.id)">
                                        <template v-if="grandChild.menuType !== 'button'">
                                            <el-icon v-if="grandChild.icon">
                                                <component :is="grandChild.icon" />
                                            </el-icon>
                                            <span>{{ $t(`dyn.menu.menu_${grandChild.id}`) }}</span>
                                        </template>
                                    </el-menu-item>
                                </el-sub-menu>
                                <el-menu-item v-else-if="child.menuType !== 'button'" :index="String(child.id)">
                                    <el-icon v-if="child.icon">
                                        <component :is="child.icon" />
                                    </el-icon>
                                    <span>{{ $t(`dyn.menu.menu_${child.id}`) }}</span>
                                </el-menu-item>
                            </template>
                        </el-sub-menu>
                        <!-- 一级独立菜单 -->
                        <el-menu-item v-else-if="item.menuType !== 'button'" :index="String(item.id)">
                            <el-icon v-if="item.icon">
                                <component :is="item.icon" />
                            </el-icon>
                            <span>{{ $t(`dyn.menu.menu_${item.id}`) }}</span>
                        </el-menu-item>
                    </template>
                </el-menu>
            </div>
        </el-aside>

        <el-container direction="vertical">
            <!-- 顶部header -->
            <el-header class="header-bar">
                <div class="header-bar__left">
                    <div class="collapse-btn" v-on:click="toggleCollapse">
                        <el-icon>
                            <component :is="isCollapsed ? iconMap['Expand'] : iconMap['Fold']" />
                        </el-icon>
                    </div>
                </div>
                <div class="header-bar__right">
                    <el-dropdown class="user-header-dropdown" trigger="hover">
                        <div class="user-header-item">
                            <div class="user-avatar">
                                <img src="~/img/avatar-default.png" alt="avatar" />
                            </div>
                            <span class="user-name">{{ userInfo.userName }}</span>
                        </div>

                        <template #dropdown>
                            <el-dropdown-menu>
                                <el-dropdown-item>
                                    <el-button @@click="switchGlobalLang(currentLang === 'zh-cn' ? 'en' : 'zh-cn')" style="width:100%;">
                                        <span v-text="currentLang === 'zh-cn' ? 'switch to English' : '切换中文'"></span>
                                    </el-button>
                                </el-dropdown-item>
                                <el-dropdown-item>
                                    <el-button @@click="handleUserCommand('changePassword')" style="width:100%;">
                                        {{ $t('app.changePwd') }}
                                    </el-button>
                                </el-dropdown-item>
                                <el-dropdown-item divided>
                                    <el-button @@click="logout" type="danger" size="small" style="width:100%;">
                                        {{ $t('app.logout') }}
                                    </el-button>
                                </el-dropdown-item>
                            </el-dropdown-menu>
                        </template>
                    </el-dropdown>
                </div>
            </el-header>

            <!-- ========== Tab标签栏：移到header-bar正下方，不再放在el-main内部 ========== -->
            <div class="tabs-outer-wrap">
                <el-tabs v-model="activeTabKey" type="card" @@tab-remove="handleTabRemove" @@tab-change="handleTabChange">
                    <!-- 固定首页Tab：不可关闭，内置页面，无iframe -->
                    <el-tab-pane name="home" :closable="false" :label="$t('common.homeTab')">
                    </el-tab-pane>
                    <!-- 动态菜单打开的iframe标签页 -->
                    <el-tab-pane v-for="tab in tabList"
                                 :key="tab.action"
                                 :name="tab.action"
                                 :closable="true">
                        <template #label>
                            <span v-if="tab.id != null">
                                {{ $t(`dyn.menu.menu_${tab.id}`) }}
                            </span>
                            <span v-else>{{ tab.title }}</span>
                        </template>
                    </el-tab-pane>
                </el-tabs>
            </div>

            <!-- ========= el-main 只承载Tab内容面板 ========= -->
            <el-main>
                <div class="tab-content-container">
                    <!-- 首页原生内容区域 -->
                    <div v-show="activeTabKey === 'home'" class="home-dashboard">
                        <h2>{{ $t('common.welcomeTitle') }}</h2>
                        <p>{{ $t('common.homeDesc') }}</p>
                    </div>
                    <!-- iframe动态标签页 -->
                    <div v-for="tab in tabList" v-show="activeTabKey === tab.action" :key="tab.action">
                        <iframe class="iframe-container" :src="tab.action" :data-tab-key="tab.action"></iframe>
                    </div>
                </div>
            </el-main>
        </el-container>
    </el-container>

    <!-- 修改密码弹窗 -->
    <el-dialog v-model="passwordDialogVisible" title="修改密码" width="420px" :close-on-click-modal="false">
        <el-form ref="passwordFormRef" :model="passwordForm" :rules="passwordRules" label-width="80px">
            <el-form-item label="旧密码" prop="oldPassword">
                <el-input v-model="passwordForm.oldPassword" type="password" show-password placeholder="请输入旧密码" />
            </el-form-item>
            <el-form-item label="新密码" prop="newPassword">
                <el-input v-model="passwordForm.newPassword" type="password" show-password placeholder="请输入新密码" />
            </el-form-item>
            <el-form-item label="确认密码" prop="confirmPassword">
                <el-input v-model="passwordForm.confirmPassword" type="password" show-password placeholder="请再次输入新密码" />
            </el-form-item>
        </el-form>
        <template #footer>
            <el-button @@click="passwordDialogVisible = false">取消</el-button>
            <el-button type="primary" :loading="passwordLoading" @@click="submitPasswordChange">确定</el-button>
        </template>
    </el-dialog>
</div>

@section Scripts {
    <script src="~/lib/crypto-js/crypto-js.min.js"></script>
    <script src="~/js/Home/home-index.js" asp-append-version="true"></script>
}
