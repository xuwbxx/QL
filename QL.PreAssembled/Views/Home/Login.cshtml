@page
@model QL.PreAssembled.Views.Home.LoginModel
@{
    Layout = "_LayoutModelEP";
}
@section Styles {
    <link href="~/css/Home/home-login.css" rel="stylesheet" />
}
<div v-cloak id="app">
    <div class="login-container">
        <div class="login-title">{{ $t('app.title') }}</div>
        <div class="login-subtitle">{{ $t('app.subtitle') }}</div>

        <el-form ref="loginFormRef"
                 :model="loginForm"
                 :rules="loginRules"
                 class="login-form"
                 v-on:submit.prevent="handleLogin">
            <!-- 账号 -->
            <el-form-item prop="account">
                <el-input v-model="loginForm.account"
                          :placeholder="$t('app.accountPlaceholder')"
                          size="large"
                          clearable>
                    <template #prefix>
                        <el-icon><User /></el-icon>
                    </template>
                </el-input>
            </el-form-item>

            <!-- 密码 -->
            <el-form-item prop="password">
                <el-input v-model="loginForm.password"
                          type="password"
                          :placeholder="$t('app.passwordPlaceholder')"
                          size="large"
                          show-password
                          clearable
                          v-on:keyup.enter="handleLogin">
                    <template #prefix>
                        <el-icon><Lock /></el-icon>
                    </template>
                </el-input>
            </el-form-item>

            <!-- 按钮 -->
            <el-form-item>
                <el-button class="login-btn"
                           type="primary"
                           size="large"
                           v-bind:loading="loading"
                           v-on:click="handleLogin">
                    {{ loading ? $t('app.loggingIn') : $t('app.login') }}
                </el-button>
            </el-form-item>
        </el-form>

        <div class="login-footer">
            {{ $t('app.footer') }}
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/lib/crypto-js/crypto-js.min.js"></script>
    <script src="~/js/Home/home-login.js"></script>
}