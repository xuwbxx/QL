<!-- 模态框（Modal） -->
<div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static">
	<div class="modal-dialog">
		<div class="modal-content">

			<div class="modal-header">
				<button type="button" class="close" data-dismiss="modal" aria-hidden="true">
					&times;
				</button>
			</div>

		</div>
	</div>
</div>


<script>
	$(document).ready(function() {

		$('#myModal').modal('show'); // 页面加载时自动显示模态框

		DataInit();

	});

	var DataInit = function(){
	
		var softwareHtml = '';
		var firstSoftwareID = 0;
		$(departDataList).each(function(index, dom){

			$(dom.Softwares).each(function(index2, dom2){

					if(firstSoftwareID == 0)
					{
						firstSoftwareID = dom2.SoftwareID;
					}
					softwareHtml += '<div class="mod_con"><div><img src="' + dom2.Img + '" class="img-rounded img-thumbnail"></div><div>' + dom2.SoftwareName + '</div><div><button class="button_color01" onclick="PlatRedirect(' + dom2.SoftwareID + ')">进入</button><button class="button_color02" onclick="PlatInfo(' + dom2.SoftwareID + ')">详情</button></div></div>';

				});

		});
		$('#div_softwareHtml').html(softwareHtml);
		PlatInfo(firstSoftwareID);

	}

	$('#ul_Depart').children('li').click(function(dom){
	
		var DepartID = $(this).attr('data-ID');
		//alert(DepartID);
		ChooseDepart(DepartID);
	});

	var ChooseDepart = function(DepartID){
	
		if(DepartID == null || DepartID == '')
		{
			return;
		}
		
		var softwareHtml = '';
		var firstSoftwareID = 0;
		$(departDataList).each(function(index, dom){
		
			if(dom.DepartID == DepartID || DepartID == 0)
			{
				$(dom.Softwares).each(function(index2, dom2){
				
					if(firstSoftwareID == 0)
					{
						firstSoftwareID = dom2.SoftwareID;
					}
					softwareHtml += '<div class="mod_con"><div><img src="' + dom2.Img + '" class="img-rounded img-thumbnail"></div><div>' + dom2.SoftwareName + '</div><div><button class="button_color01" onclick="PlatRedirect(' + dom2.SoftwareID + ')">进入</button><button class="button_color02" onclick="PlatInfo(' + dom2.SoftwareID + ')">详情</button></div></div>';

				});
			}

		});
		$('#div_softwareHtml').html(softwareHtml);
		PlatInfo(firstSoftwareID);
	}

	var PlatInfo = function(SoftwareID){
	
		$('#div_SoftwareName').html('');
		$('#span_SoftwareInfo').html('');
		$('#span_Manager').html('');
		$('#span_UseTime').html('');

		if(SoftwareID == null || SoftwareID == '' || SoftwareID == 0)
		{
			return;
		}

		
		$(departDataList).each(function(index, dom){
		
			let IsBreak = false;
			$(dom.Softwares).each(function(index2, dom2){
			
				if(dom2.SoftwareID == SoftwareID)
				{
					$('#div_SoftwareName').html(dom2.SoftwareName);
					$('#span_SoftwareInfo').html(dom2.Info);
					$('#span_Manager').html(dom2.Manager);
					$('#span_UseTime').html(dom2.UseTime);
					IsBreak = true;
					return false;
				}

			});
			if(IsBreak) 
			{
				return false;
			}

		});

	}

	var PlatRedirect = function(SoftwareID){
	
		if(SoftwareID == null || SoftwareID == '' || SoftwareID == 0)
		{
			return;
		}

		//打开新页面
		window.open('/Tech/Home/PlatRedirect?SoftwareID=' + SoftwareID, '_blank');

	}


</script>