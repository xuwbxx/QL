<script>

	$(document).ready(function(){

		QueryData();

	})


	var OpenProject = function(ProjectCode){

		if(ProjectCode == null || ProjectCode == '')
		{
			return;
		}

		var ProjectListHtml = '<li class="clearfix th"><span>项目名称</span><span>报警数量</span></li>';

		if(ProjectCode == 'TH')
		{
			$('#img_ProjectImg').attr('src', '/Web/Monitor/img/BannerPic/TH/1.png');

			$('#span_ProjectName').html('填海工程');

			$(WebQueryData.thProject.Projects).each(function(index, dom){

				ProjectListHtml += '<li class="clearfix"><span>' + dom.ProjectName + '</span><span>' + dom.AlarmCount + '</span></li>';

			});

			$('#btn_OpenProject').attr('data-url', 'https://www.baidu.com/');

		}
		else if(ProjectCode == 'JK')
		{
			$('#img_ProjectImg').attr('src', '/Web/Monitor/img/BannerPic/JK/1.png');

			$('#span_ProjectName').html('基坑工程');

			$(WebQueryData.jkProject.Projects).each(function(index, dom){

				ProjectListHtml += '<li class="clearfix"><span>' + dom.ProjectName + '</span><span>' + dom.AlarmCount + '</span></li>';

			});

			$('#btn_OpenProject').attr('data-url', 'https://www.baidu.com/');
		}
		else if(ProjectCode == 'HJ')
		{
			$('#img_ProjectImg').attr('src', '/Web/Monitor/img/BannerPic/HJ/1.png');

			$('#span_ProjectName').html('环境工程');

			$(WebQueryData.hjProject.Projects).each(function(index, dom){

				ProjectListHtml += '<li class="clearfix"><span>' + dom.ProjectName + '</span><span>' + dom.AlarmCount + '</span></li>';

			});

			$('#btn_OpenProject').attr('data-url', 'https://www.baidu.com/');
		}
		else if(ProjectCode == 'QL')
		{
			$('#img_ProjectImg').attr('src', '/Web/Monitor/img/BannerPic/QL/1.png');

			$('#span_ProjectName').html('桥梁工程');

			$(WebQueryData.qlProject.Projects).each(function(index, dom){

				ProjectListHtml += '<li class="clearfix"><span>' + dom.ProjectName + '</span><span>' + dom.AlarmCount + '</span></li>';

			});

			$('#btn_OpenProject').attr('data-url', 'https://www.baidu.com/');
		}

		$('#ul_ProjectList').html(ProjectListHtml);

		$('#marquee1').hide();
		$('#thgc_son').show();

	}

	var OpenProjectPlat = function(dom){

		if(dom == null)
		{
			return;
		}

		var URL = $(dom).attr('data-url');
		if(URL == '')
		{
			return;
		}

		window.open(URL, '_blank');

	}


	var WebQueryData = {};

	var QueryData = function(){

		var Param = {};
		Param.Name = "程伟";

		$.ajax({
			url: 'GetProjectInfo',
			method: "POST",  // 或 "GET"、"PUT" 等
			dataType: "json",
			//timeout: 5000,
			data: Param,
			success: function(response)
			{
				//var user = 123;

				if(response.Success)
				{
					var Data = response.Data;

					WebQueryData = Data;

					//已完工监控项目数量
					$('#div_thProjectCount').html(Data.thProject.ProjectFinishedCount);
					$('#div_jkProjectCount').html(Data.jkProject.ProjectFinishedCount);
					$('#div_hjProjectCount').html(Data.hjProject.ProjectFinishedCount);
					$('#div_qlProjectCount').html(Data.qlProject.ProjectFinishedCount);

					//监控正常项目列表
					var NormalProjectListHtml = '';
					$(Data.NormalProjects).each(function(index, dom){

						NormalProjectListHtml += '<li><a>' + dom.ProjectName + '</a><span>正常</span></li>';

					});
					$('#ul_NormalProjectList').html(NormalProjectListHtml);


					//监控异常项目列表
					var AbnormalProjectPointsHtml = '';
					$(Data.AbnormalProjectPoints).each(function(index, dom){

						AbnormalProjectPointsHtml += '<li><a>' + dom.ProjectPoint + '<span>' + dom.Time + '</span></a></li>';

					});
					$('#ul_AbnormalProjectPointList').html(AbnormalProjectPointsHtml);

					//监控正常项目数量
					DrawNormalProjecrChart(Data);
					//监控异常项目数量
					DrawAbnormalProjectChart(Data);
				}

			},
			error: function(error)
			{
				console.log(error);
			},
			complete: function()
			{
				//alert(111);
			},

			// 更多配置...
		})

	}

	var DrawNormalProjecrChart = function(data){

		var option = {
		  tooltip: {
			trigger: 'axis',
			axisPointer: {
			  type: 'shadow'
			}
		  },
		  legend: {

			  textStyle:{

				  color: '#fff',

			  }

		  },
		  grid: {
			left: '0%',
			right: '0%',
			top: '20%',
			bottom: '0%',
			containLabel: true
		  },
		  xAxis: [
			{

			  type: 'category',
			  data: [],
			  axisLabel: {
					show: true,
					color: '#fff' // 设置文字颜色为蓝色
				},
			}
		  ],
		  yAxis: [
			{
			  type: 'value',
			  axisLabel: {
					show: true,
					color: '#fff' // 设置文字颜色为蓝色
				},
			  splitLine: {
				show: true, // 确保显示分割线
				lineStyle: {
				// 或者使用 rgba 控制透明度（更浅）
				color: 'rgba(255, 255, 255, 0.3)',
				width: 1,     // 线宽
				type: 'dashed'  // 线型，可以是'solid'、'dashed'、'dotted'
				}
			  }
			}
		  ],
		  series: [
			// {
			//   name: 'Direct',
			//   type: 'bar',
			//   emphasis: {
			// 	focus: 'series'
			//   },
			//   data: [320, 332, 301, 334, 390, 330, 320]
			// },

		  ]
		};


		var thSerie = {
			  name: '填海工程',
			  type: 'bar',
			  roundCap: true,
			  itemStyle: {
					borderRadius: [10, 10, 0, 0]  // 可选的圆角效果
				},
			  barWidth: '15%',
			  emphasis: {
				focus: 'series'
			  },
			  data: []
			};
		$(data.thProject.YearNormalProjectCountChart).each(function(index, dom){

			option.xAxis[0].data.push(dom.Year + '年');

			thSerie.data.push(dom.ProjectCount);

		});
		option.series.push(thSerie);

		var jkSerie = {
			  name: '基坑工程',
			  type: 'bar',
			  roundCap: true,
			  itemStyle: {
					borderRadius: [10, 10, 0, 0]  // 可选的圆角效果
				},
			  barWidth: '15%',
			  emphasis: {
				focus: 'series'
			  },
			  data: []
			};
		$(data.jkProject.YearNormalProjectCountChart).each(function(index, dom){

			jkSerie.data.push(dom.ProjectCount);

		});
		option.series.push(jkSerie);

		var hjSerie = {
			  name: '环境工程',
			  type: 'bar',
			  roundCap: true,
			  itemStyle: {
					borderRadius: [10, 10, 0, 0]  // 可选的圆角效果
				},
			  barWidth: '15%',
			  emphasis: {
				focus: 'series'
			  },
			  data: []
			};
		$(data.hjProject.YearNormalProjectCountChart).each(function(index, dom){

			hjSerie.data.push(dom.ProjectCount);

		});
		option.series.push(hjSerie);

		var qlSerie = {
			  name: '桥梁工程',
			  type: 'bar',
			  roundCap: true,
			  itemStyle: {
					borderRadius: [10, 10, 0, 0]  // 可选的圆角效果
				},
			  barWidth: '15%',
			  emphasis: {
				focus: 'series'
			  },
			  data: []
			};
		$(data.qlProject.YearNormalProjectCountChart).each(function(index, dom){

			qlSerie.data.push(dom.ProjectCount);

		});
		option.series.push(qlSerie);

		var chartDom = document.getElementById('div_NormalProjectChart');
		var myChart = echarts.init(chartDom);
		option && myChart.setOption(option);

	}


	var DrawAbnormalProjectChart = function(data){

		var option = {
		  tooltip: {
			trigger: 'item',
			formatter: '{a} <br/>{b}: {c} ({d}%)'
		  },
		  grid:{
			left: '1%',
			right: '30%'
		  },
		  legend: {
			  textStyle:{
				  color: '#fff',
			  },
			  orient: 'vertical',
			  right: 2,
			  // height: '60%',       // 限制高度
			  // itemGap: 10,         // 图例项之间的间隔
			data: [
			  '填海异常',
			  '基坑异常',
