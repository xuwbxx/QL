	var OpenProject = function(ProjectCode){

		if(ProjectCode == null || ProjectCode == '')
		{
			return;
		}

		var ProjectListHtml = '<li class="clearfix th"><span>测点名称</span><span>报警数量</span></li>';

		if(ProjectCode == 'TH')
		{
			$('#img_ProjectImg').attr('src', '/Web/Monitor/img/BannerPic/TH/1.png');

			$('#span_ProjectName').html('地表竖向位移');

			$(WebQueryData.thProject.Projects).each(function(index, dom){

				ProjectListHtml += '<li class="clearfix"><span>' + dom.ProjectName + '</span><span>' + dom.AlarmCount + '</span></li>';

			});

			$('#btn_OpenProject').attr('data-url', 'https://www.baidu.com/');

		}
		else if(ProjectCode == 'JK')
		{
			$('#img_ProjectImg').attr('src', '/Web/Monitor/img/BannerPic/JK/1.png');

			$('#span_ProjectName').html('支撑轴力');

			$(WebQueryData.jkProject.Projects).each(function(index, dom){

				ProjectListHtml += '<li class="clearfix"><span>' + dom.ProjectName + '</span><span>' + dom.AlarmCount + '</span></li>';

			});

			$('#btn_OpenProject').attr('data-url', 'https://www.baidu.com/');
		}
		else if(ProjectCode == 'HJ')
		{
			$('#img_ProjectImg').attr('src', '/Web/Monitor/img/BannerPic/HJ/1.png');

			$('#span_ProjectName').html('深层水平位移');

			$(WebQueryData.hjProject.Projects).each(function(index, dom){

				ProjectListHtml += '<li class="clearfix"><span>' + dom.ProjectName + '</span><span>' + dom.AlarmCount + '</span></li>';

			});

			$('#btn_OpenProject').attr('data-url', 'https://www.baidu.com/');
		}
		else if(ProjectCode == 'QL')
		{
			$('#img_ProjectImg').attr('src', '/Web/Monitor/img/BannerPic/QL/1.png');

			$('#span_ProjectName').html('地下水位');

			$(WebQueryData.qlProject.Projects).each(function(index, dom){

				ProjectListHtml += '<li class="clearfix"><span>' + dom.ProjectName + '</span><span>' + dom.AlarmCount + '</span></li>';

			});

			$('#btn_OpenProject').attr('data-url', 'https://www.baidu.com/');
		}

		$('#ul_ProjectList').html(ProjectListHtml);

		$('#marquee1').hide();
		$('#thgc_son').show();

	}

	var OpenProjectPlat = function(dom){

		PlatRedirect(3);

		return;

		if(dom == null)
		{
			return;
		}

		var URL = $(dom).attr('data-url');
		if(URL == '')
		{
			return;
		}

		window.open(URL, '_blank');

	}


	var WebQueryData = {};

	var QueryData = function(){

		var Param = {};
		Param.ID = $('#hid_projectID').val();

		$.ajax({
			url: 'GetProjectInfo_KuLun',
			method: "POST",  // 或 "GET"、"PUT" 等
			dataType: "json",
			//timeout: 5000,
			data: Param,
			success: function(response)
			{
				//var user = 123;

				if(response.Success)
				{
					var Data = response.Data;

					WebQueryData = Data;

					$('#span_projectName').html(Data.ProjectName);

					//已完工监控项目数量
					$('#div_thProjectCount').html(Data.thProject.ProjectFinishedCount);
					$('#div_jkProjectCount').html(Data.jkProject.ProjectFinishedCount);
					$('#div_hjProjectCount').html(Data.hjProject.ProjectFinishedCount);
					$('#div_qlProjectCount').html(Data.qlProject.ProjectFinishedCount);

					//监控正常项目列表
					var NormalProjectListHtml = '';
					$(Data.NormalProjects).each(function(index, dom){

						NormalProjectListHtml += '<li><a>' + dom.PointName + '(' + dom.Type + ')</a><span>正常</span></li>';

					});
					$('#ul_NormalProjectList').html(NormalProjectListHtml);


					//监控异常项目列表
					var AbnormalProjectPointsHtml = '';
					$(Data.AbnormalProjectPoints).each(function(index, dom){

						AbnormalProjectPointsHtml += '<li><a>' + dom.ProjectPoint + '<span>' + dom.Time + '</span></a></li>';

					});
					$('#ul_AbnormalProjectPointList').html(AbnormalProjectPointsHtml);

					//监控正常项目数量
					DrawNormalProjecrChart(Data);
					//监控异常项目数量
					DrawAbnormalProjectChart(Data);
				}

			},
			error: function(error)
			{
				console.log(error);
			},
			complete: function()
			{
				//alert(111);
			},

			// 更多配置...
		})

	}

