<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>地基弱化处理</title>
    <style>
        /* 全局样式重置 */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            list-style: none;
        }

        body {
            background-color: #ffffff;
            padding: 2vw;
            font-family: "Microsoft Yahei", sans-serif;
            font-size: 14px;
        }

        /* 网格容器 */
        .grid-container {
            display: flex;
            flex-direction: column;
            gap: 0;
            align-items: center;
            max-width: fit-content;
            margin: 0 auto;
        }

        .grid-row {
            display: flex;
            gap: 0;
            margin-bottom: 0.2vh;
        }

        .grid-cell {
            width: 5vw;
            height: 3.5vh;
            border: 0.1vw solid green;
            background-color: transparent;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1vw;
            color: #333;
            cursor: pointer;
            transition: background-color 0.2s;
            margin: 0 0.05vw;
        }

            .grid-cell:hover {
                background-color: rgba(46, 204, 113, 0.1);
            }

        /* 弹窗样式 */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1000;
            align-items: center;
            justify-content: center;
            padding: 2vw 0;
        }

        .modal-content {
            background-color: white;
            width: 90vw;
            max-width: 1000px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
            display: flex;
            flex-direction: column;
        }

        /* 弹窗头部 */
        .modal-header {
            background-color: #2c3e50;
            color: white;
            padding: 16px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .modal-header h2 {
                font-size: 18px;
                font-weight: 500;
                margin: 0;
            }

            .modal-header .cell-number {
                font-size: 18px;
                font-weight: 400;
            }

        .btn-construction {
            background-color: #e74c3c;
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            transition: background-color 0.2s;
        }

            .btn-construction:hover {
                background-color: #c0392b;
            }

        /* 弹窗主体 */
        .modal-body {
            padding: 24px;
        }

        /* 公共信息行 */
        .common-info-row {
            display: flex;
            gap: 24px;
            margin-bottom: 24px;
        }

        .common-form-group {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .common-form-group label {
                font-size: 14px;
                color: #333;
            }

            .common-form-group input, .common-form-group select {
                padding: 8px 12px;
                border: 1px solid #ddd;
                border-radius: 4px;
                font-size: 14px;
                width: 100%;
            }

        /* 双栏数据区 */
        .data-sections {
            display: flex;
            gap: 24px;
        }

        .data-section {
            flex: 1;
            background-color: #f8f9fa;
            border-radius: 4px;
            padding: 16px;
        }

        .data-section-title {
            font-size: 16px;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 16px;
            padding-bottom: 8px;
            border-bottom: 1px solid #e9ecef;
        }

        .form-section-title {
            font-size: 14px;
            font-weight: 600;
            color: #34495e;
            margin: 16px 0 12px 0;
        }

        .form-row {
            display: flex;
            gap: 16px;
            margin-bottom: 12px;
        }

        .form-group {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .form-group.full-width {
                flex: 1 1 100%;
            }

            .form-group label {
                font-size: 14px;
                color: #333;
            }

            .form-group input {
                padding: 8px 12px;
                border: 1px solid #ddd;
                border-radius: 4px;
                font-size: 14px;
                width: 100%;
            }

        /* 弹窗底部按钮 */
        .modal-footer {
            padding: 16px 24px;
            border-top: 1px solid #eee;
            display: flex;
            justify-content: flex-end;
            gap: 12px;
        }

        .modal-btn {
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            transition: background-color 0.2s;
        }

        .btn-save {
            background-color: #2ecc71;
            color: white;
        }

            .btn-save:hover {
                background-color: #27ae60;
            }

        .btn-close {
            background-color: #95a5a6;
            color: white;
        }

            .btn-close:hover {
                background-color: #7f8c8d;
            }

        /* 单元格状态样式 */
        .grid-cell.status-unfinished {
            background-color: #e0e0e0;
        }

        .grid-cell.status-ongoing {
            background-color: #fff3cd;
        }

        .grid-cell.status-finished {
            background-color: #d4edda;
        }

        /* 页面标题和状态说明 */
        .title-container {
            position: relative;
            text-align: center;
            margin-bottom: 2vw;
            padding-bottom: 1vw;
            border-bottom: 0.2vw solid #2ecc71;
        }

        .page-title {
            font-size: 2.5vw;
            font-weight: bold;
            color: #333;
            margin: 0;
        }

        .status-legend {
            position: absolute;
            top: 50%;
            right: 2vw;
            transform: translateY(-50%);
            display: flex;
            align-items: center;
            gap: 1.5vw;
            font-size: 1.2vw;
            color: #666;
        }

        .color-block {
            display: inline-block;
            width: 1.2vw;
            height: 1.2vw;
            border-radius: 0.2vw;
            margin-right: 0.5vw;
            vertical-align: middle;
            border: 0.1vw solid #ccc;
        }

            .color-block.unfinished {
                background-color: #e0e0e0;
            }

            .color-block.ongoing {
                background-color: #fff3cd;
                border-color: #ffe082;
            }

            .color-block.finished {
                background-color: #d4edda;
                border-color: #a5d6a7;
            }
    </style>
</head>
<body>
    <div class="title-container">
        <h1 class="page-title">地基弱化处理</h1>
        <div class="status-legend">
            <span class="legend-item">
                <span class="color-block unfinished"></span>未施工
            </span>
            <span class="legend-item">
                <span class="color-block ongoing"></span>正在施工
            </span>
            <span class="legend-item">
                <span class="color-block finished"></span>已完工
            </span>
        </div>
    </div>

    <div class="grid-container"></div>

    <div class="modal" id="infoModal">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h2>地基信息 <span class="cell-number" id="cellNumber"></span></h2>
                </div>
                <button id="startConstructionBtn" class="btn-construction">点击施工</button>
                <button class="modal-btn btn-close" onclick="closeModal()">关闭</button>
            </div>

            <div class="modal-body">
                <div class="common-info-row">
                    <div class="common-form-group">
                        <label for="equipmentId">设备ID：</label>
                        <input type="text" id="equipmentId" placeholder="设备唯一标识">
                    </div>
                    <div class="common-form-group">
                        <label for="constructionStatus">施工状态：</label>
                        <select id="constructionStatus">
                            <option value="未施工">未施工</option>
                            <option value="正在施工">正在施工</option>
                            <option value="已完成">已完成</option>
                        </select>
                    </div>
                </div>

                <div class="data-sections">
                    <div class="data-section">
                        <div class="data-section-title" style="color:blue;">设计数据</div>

                        <div class="form-section-title">位置数据</div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="design_posX">X 坐标：</label>
                                <input type="number" id="design_posX" placeholder="X" step="0.01">
                            </div>
                            <div class="form-group">
                                <label for="design_posY">Y 坐标：</label>
                                <input type="number" id="design_posY" placeholder="Y" step="0.01">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group full-width">
                                <label for="design_posZ">Z 坐标：</label>
                                <input type="number" id="design_posZ" placeholder="Z" step="0.01">
                            </div>
                        </div>

                        <div class="form-section-title">工艺数据</div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="design_pileLength">桩长：</label>
                                <input type="number" id="design_pileLength" placeholder="米" step="0.01">
                            </div>
                            <div class="form-group">
                                <label for="design_finishedPileLength">成桩长：</label>
                                <input type="number" id="design_finishedPileLength" placeholder="米" step="0.01">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group full-width">
                                <label for="design_finishedPileWidth">成桩宽：</label>
                                <input type="number" id="design_finishedPileWidth" placeholder="米" step="0.01">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="design_mudVolume">用泥量：</label>
                                <input type="number" id="design_mudVolume" placeholder="立方" step="0.01">
                            </div>
                            <div class="form-group">
                                <label for="design_mudPenetration">泥贯入量：</label>
                                <input type="number" id="design_mudPenetration" placeholder="立方" step="0.01">
                            </div>
                        </div>
                    </div>

                    <div class="data-section">
                        <div class="data-section-title" style="color:coral;">实际数据</div>

                        <div class="form-section-title">位置数据</div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="actual_posX">X 坐标：</label>
                                <input type="number" id="actual_posX" placeholder="X" step="0.01">
                            </div>
                            <div class="form-group">
                                <label for="actual_posY">Y 坐标：</label>
                                <input type="number" id="actual_posY" placeholder="Y" step="0.01">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group full-width">
                                <label for="actual_posZ">Z 坐标：</label>
                                <input type="number" id="actual_posZ" placeholder="Z" step="0.01">
                            </div>
                        </div>

                        <div class="form-section-title">工艺数据</div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="actual_pileLength">桩长：</label>
                                <input type="number" id="actual_pileLength" placeholder="米" step="0.01">
                            </div>
                            <div class="form-group">
                                <label for="actual_finishedPileLength">成桩长：</label>
                                <input type="number" id="actual_finishedPileLength" placeholder="米" step="0.01">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group full-width">
                                <label for="actual_finishedPileWidth">成桩宽：</label>
                                <input type="number" id="actual_finishedPileWidth" placeholder="米" step="0.01">
                            </div>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="actual_mudVolume">用泥量：</label>
                                <input type="number" id="actual_mudVolume" placeholder="立方" step="0.01">
                            </div>
                            <div class="form-group">
                                <label for="actual_mudPenetration">泥贯入量：</label>
                                <input type="number" id="actual_mudPenetration" placeholder="立方" step="0.01">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                @* <button class="modal-btn btn-save" onclick="saveInfo()">保存</button> *@
                <button class="modal-btn btn-close" onclick="closeModal()">关闭</button>
            </div>
        </div>
    </div>

    <script>
        let currentCell = null;

        function initGrid() {
            const gridContainer = document.querySelector('.grid-container');
            const totalRows = 20;
            let cellNumber = 1;

            for (let rowIndex = 1; rowIndex <= totalRows; rowIndex++) {
                const row = document.createElement('ul');
                row.className = `grid-row ${rowIndex % 2 === 1 ? 'odd' : 'even'}`;
                const cellCount = rowIndex % 2 === 1 ? 17 : 16;

                for (let i = 0; i < cellCount; i++) {
                    const cell = document.createElement('li');
                    cell.className = 'grid-cell';

                    let randomNum = getRandomNumber();
                    if(randomNum === 1) {
                        cell.classList.add('status-unfinished');
                    } else if(randomNum === 2) {
                        cell.classList.add('status-finished');
                    } else {
                        cell.classList.add('status-ongoing');
                    }

                    const formattedNumber = cellNumber.toString().padStart(3, '0');
                    cell.textContent = formattedNumber;
                    cell.dataset.number = formattedNumber;

                    cell.addEventListener('click', function() {
                        openModal(this);
                    });

                    row.appendChild(cell);
                    cellNumber++;
                }

                gridContainer.appendChild(row);
            }
        }

        function openModal(cell) {
            currentCell = cell;
            const modal = document.getElementById('infoModal');
            const cellNumber = document.getElementById('cellNumber');
            cellNumber.textContent = `No.${cell.dataset.number}`;

            const savedInfo = cell.dataset.info ? JSON.parse(cell.dataset.info) : {
                equipmentId: '',
                constructionStatus: '未施工',
                design_posX: '',
                design_posY: '',
                design_posZ: '',
                design_pileLength: '',
                design_finishedPileLength: '',
                design_finishedPileWidth: '',
                design_mudVolume: '',
                design_mudPenetration: '',
                actual_posX: '',
                actual_posY: '',
                actual_posZ: '',
                actual_pileLength: '',
                actual_finishedPileLength: '',
                actual_finishedPileWidth: '',
                actual_mudVolume: '',
                actual_mudPenetration: ''
            };

            document.getElementById('equipmentId').value = savedInfo.equipmentId;
            document.getElementById('constructionStatus').value = savedInfo.constructionStatus;

            document.getElementById('design_posX').value = savedInfo.design_posX;
            document.getElementById('design_posY').value = savedInfo.design_posY;
            document.getElementById('design_posZ').value = savedInfo.design_posZ;
            document.getElementById('design_pileLength').value = savedInfo.design_pileLength;
            document.getElementById('design_finishedPileLength').value = savedInfo.design_finishedPileLength;
            document.getElementById('design_finishedPileWidth').value = savedInfo.design_finishedPileWidth;
            document.getElementById('design_mudVolume').value = savedInfo.design_mudVolume;
            document.getElementById('design_mudPenetration').value = savedInfo.design_mudPenetration;

            document.getElementById('actual_posX').value = savedInfo.actual_posX;
            document.getElementById('actual_posY').value = savedInfo.actual_posY;
            document.getElementById('actual_posZ').value = savedInfo.actual_posZ;
            document.getElementById('actual_pileLength').value = savedInfo.actual_pileLength;
            document.getElementById('actual_finishedPileLength').value = savedInfo.actual_finishedPileLength;
            document.getElementById('actual_finishedPileWidth').value = savedInfo.actual_finishedPileWidth;
            document.getElementById('actual_mudVolume').value = savedInfo.actual_mudVolume;
            document.getElementById('actual_mudPenetration').value = savedInfo.actual_mudPenetration;

            modal.style.display = 'flex';
        }

        function closeModal() {
            const modal = document.getElementById('infoModal');
            modal.style.display = 'none';
            currentCell = null;
        }

        function saveInfo() {
            if (!currentCell) return;

            const info = {
                equipmentId: document.getElementById('equipmentId').value,
                constructionStatus: document.getElementById('constructionStatus').value,
                design_posX: document.getElementById('design_posX').value,
                design_posY: document.getElementById('design_posY').value,
                design_posZ: document.getElementById('design_posZ').value,
                design_pileLength: document.getElementById('design_pileLength').value,
                design_finishedPileLength: document.getElementById('design_finishedPileLength').value,
                design_finishedPileWidth: document.getElementById('design_finishedPileWidth').value,
                design_mudVolume: document.getElementById('design_mudVolume').value,
                design_mudPenetration: document.getElementById('design_mudPenetration').value,
                actual_posX: document.getElementById('actual_posX').value,
                actual_posY: document.getElementById('actual_posY').value,
                actual_posZ: document.getElementById('actual_posZ').value,
                actual_pileLength: document.getElementById('actual_pileLength').value,
                actual_finishedPileLength: document.getElementById('actual_finishedPileLength').value,
                actual_finishedPileWidth: document.getElementById('actual_finishedPileWidth').value,
                actual_mudVolume: document.getElementById('actual_mudVolume').value,
                actual_mudPenetration: document.getElementById('actual_mudPenetration').value
            };

            currentCell.dataset.info = JSON.stringify(info);

            const status = info.constructionStatus;
            currentCell.classList.remove('status-unfinished', 'status-ongoing', 'status-finished');
            switch(status) {
                case '未施工':
                    currentCell.classList.add('status-unfinished');
                    break;
                case '正在施工':
                    currentCell.classList.add('status-ongoing');
                    break;
                case '已完成':
                    currentCell.classList.add('status-finished');
                    break;
            }

            closeModal();
            alert('信息保存成功！');
        }

        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('startConstructionBtn').addEventListener('click', function() {
                if (currentCell) {
                    document.getElementById('constructionStatus').value = '正在施工';
                    alert('已切换为施工状态，请点击保存确认！');
                }
            });
        });

        function getRandomNumber() {
            return Math.floor(Math.random() * 3) + 1;
        }

        window.onload = function() {
            initGrid();

            const modal = document.getElementById('infoModal');
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    closeModal();
                }
            });
        };
    </script>
</body>
</html>