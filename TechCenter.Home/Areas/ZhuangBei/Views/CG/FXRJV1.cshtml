<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>桶式基础沉贯可行性分析软件</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #000;
        }

        .fullscreen-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .download-btn {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 100;
            padding: 12px 28px;
            background: linear-gradient(135deg, #ff6a00, #ee0979);
            color: #fff;
            font-size: 16px;
            font-weight: bold;
            text-decoration: none;
            border-radius: 8px;
            box-shadow: 0 4px 15px rgba(238, 9, 121, 0.4);
            transition: transform 0.2s, box-shadow 0.2s;
            cursor: pointer;
        }

        .download-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(238, 9, 121, 0.6);
        }

        .download-btn:active {
            transform: translateY(0);
        }
    </style>
</head>
<body>

    <a class="download-btn" href="/content/ZB/bucket_app.zip" download>软件下载</a>

    <img class="fullscreen-img" src="/content/ZB/cgv1.png" alt="截图" />

</body>
</html>