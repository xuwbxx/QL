<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>折叠菜单布局示例</title>
    <!-- 引入Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome CDN -->
    <link rel="stylesheet" href="/css/font-awesome-4.7.0/css/font-awesome.min.css">

    <script>
        window.tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        sidebar: '#2c3e50',
                        primary: '#3498db',
                        header: '#ffffff',
                        content: '#f8f9fa',
                    },
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                    },
                }
            }
        }
    </script>

    <style type="text/tailwindcss">
        .content-auto {
            content-visibility: auto;
        }

        .sidebar-shadow {
            box-shadow: 2px 0 10px rgba(0, 0, 0, 0.1);
        }

        .transition-all-300 {
            transition: all 0.3s ease;
        }

        .menu-item-active {
            background-color: rgba(52, 152, 219, 0.2);
            color: #3498db;
            border-left: 4px solid #3498db;
        }

        /* 基础布局样式 */
        body {
            overflow-x: hidden;
            height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .sidebar {
            width: 250px;
            flex-shrink: 0;
            transition: width 0.3s ease;
        }

            .sidebar.collapsed {
                width: 64px;
            }

                .sidebar.collapsed .menu-text {
                    display: none;
                }

                .sidebar.collapsed .menu-collapse-icon {
                    display: none;
                }

                .sidebar.collapsed .sidebar-header-text {
                    display: none;
                }

        .main-content {
            flex: 1;
            overflow-y: hidden; /* 改为hidden，由iframe处理滚动 */
        }

        /* iframe样式 - 铺满主内容区域 */
        #contentIframe {
            width: 100%;
            height: 100%;
            border: none;
            outline: none;
        }

        /* 多级菜单展开/折叠样式 */
        .menu-subitem {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }

            .menu-subitem.expanded {
                max-height: 1000px;
            }

        .menu-subsubitem {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.3s ease;
        }

            .menu-subsubitem.expanded {
                max-height: 1000px;
            }
    </style>
</head>
<body class="bg-gray-100">
    <!-- 顶部标题栏 -->
    <header class="bg-header sidebar-shadow z-10 py-4 px-6 flex items-center justify-between">
        <div class="flex items-center">
            <button id="toggleSidebar" class="mr-4 text-gray-700 hover:text-primary transition-all-300">
                <i class="fa fa-graduation-cap text-xl"></i>
            </button>
            <h1 class="text-2xl font-bold text-gray-800">三航局岩土所-桩靴插拔风险评估系统</h1>
        </div>
        <div class="flex items-center space-x-4">
            <span class="text-gray-600"><i class="fa fa-bell-o text-xl"></i></span>
            <div class="flex items-center">
                <img src="https://picsum.photos/id/1005/40/40" alt="用户头像" class="w-8 h-8 rounded-full mr-2">
                <span class="text-gray-700">管理员</span>
            </div>
        </div>
    </header>

    <div class="flex flex-1 overflow-hidden">
        <!-- 左侧菜单 -->
        <aside id="sidebar" class="sidebar bg-sidebar text-white h-full sidebar-shadow">
            <!-- 侧边栏头部 -->
            <div class="sidebar-header py-4 px-4 flex items-center justify-between border-b border-gray-700">
                <span class="sidebar-header-text font-bold text-lg">菜单导航</span>
                <button id="collapseSidebar" class="hover:text-primary transition-all-300">
                    <i class="fa fa-angle-left text-xl"></i>
                </button>
            </div>

            <!-- 菜单列表 -->
            <nav class="py-4">
                <ul class="menu-list">
                    <!-- 菜单项1 - 无子菜单 -->
                    <li class="mb-1">
                        <a href="/YanTu/CBZwork/Index" class="flex items-center py-3 px-4 hover:bg-gray-700 transition-all-300 menu-item-active">
                            <i class="fa fa-asterisk text-lg w-6"></i>
                            <span class="menu-text ml-2">风险评估</span>
                        </a>
                    </li>

                    <!-- 菜单项3 - 有二级菜单 -->
                    <li class="mb-1">
                        <div class="menu-parent flex items-center justify-between py-3 px-4 hover:bg-gray-700 transition-all-300 cursor-pointer">
                            <div class="flex items-center">
                                <i class="fa fa-file-text text-lg w-6"></i>
                                <span class="menu-text ml-2">分析模型</span>
                            </div>
                            <i class="fa fa-angle-down menu-collapse-icon transition-all-300"></i>
                        </div>
                        <ul class="menu-subitem pl-6 bg-gray-800">
                            <li class="py-2 px-2 hover:bg-gray-700 transition-all-300">
                                <a href="/YanTu/CBZwork/Article" class="menu-text flex items-center">
                                    <i class="fa fa-newspaper-o w-6"></i>
                                    <span>分析模型1</span>
                                </a>
                            </li>
                            <li class="py-2 px-2 hover:bg-gray-700 transition-all-300">
                                <a href="/YanTu/CBZwork/Image" class="menu-text flex items-center">
                                    <i class="fa fa-picture-o w-6"></i>
                                    <span>分析模型2</span>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- 菜单项2 - 有三级菜单 -->
                    <li class="mb-1">
                        <div class="menu-parent flex items-center justify-between py-3 px-4 hover:bg-gray-700 transition-all-300 cursor-pointer">
                            <div class="flex items-center">
                                <i class="fa fa-cubes text-lg w-6"></i>
                                <span class="menu-text ml-2">评价打分</span>
                            </div>
                            <i class="fa fa-angle-down menu-collapse-icon transition-all-300"></i>
                        </div>
                        <ul class="menu-subitem pl-6 bg-gray-800">
                            <li class="py-2 px-2 hover:bg-gray-700 transition-all-300">
                                <div class="menu-subparent flex items-center justify-between w-full hover:bg-gray-700 transition-all-300 cursor-pointer">
                                    <div class="flex items-center">
                                        <i class="fa fa-lock w-6"></i>
                                        <span class="menu-text">分析模型1</span>
                                    </div>
                                    <i class="fa fa-angle-down menu-collapse-icon transition-all-300 text-xs"></i>
                                </div>
                                <ul class="menu-subsubitem pl-6 bg-gray-900">
                                    <li class="py-2 px-2 hover:bg-gray-700 transition-all-300">
                                        <a href="/YanTu/CBZwork/Config" class="menu-text flex items-center">
                                            <i class="fa fa-cog w-6 text-xs"></i>
                                            <span>准则层1</span>
                                        </a>
                                    </li>
                                    <li class="py-2 px-2 hover:bg-gray-700 transition-all-300">
                                        <a href="/YanTu/CBZwork/Page1" class="menu-text flex items-center">
                                            <i class="fa fa-line-chart w-6 text-xs"></i>
                                            <span>指标层1</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                            <!-- 二级菜单带三级子菜单 -->
                            <li class="py-2 px-2 hover:bg-gray-700 transition-all-300">
                                <div class="menu-subparent flex items-center justify-between w-full hover:bg-gray-700 transition-all-300 cursor-pointer">
                                    <div class="flex items-center">
                                        <i class="fa fa-lock w-6"></i>
                                        <span class="menu-text">分析模型2</span>
                                    </div>
                                    <i class="fa fa-angle-down menu-collapse-icon transition-all-300 text-xs"></i>
                                </div>
                                <ul class="menu-subsubitem pl-6 bg-gray-900">
                                    <li class="py-2 px-2 hover:bg-gray-700 transition-all-300">
                                        <a href="/YanTu/CBZwork/Config" class="menu-text flex items-center">
                                            <i class="fa fa-cog w-6 text-xs"></i>
                                            <span>准则层2</span>
                                        </a>
                                    </li>
                                    <li class="py-2 px-2 hover:bg-gray-700 transition-all-300">
                                        <a href="/YanTu/CBZwork/Page1" class="menu-text flex items-center">
                                            <i class="fa fa-line-chart w-6 text-xs"></i>
                                            <span>指标层2</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </li>

                    

                    <!-- 菜单项4 - 无子菜单 -->
                    <li class="mb-1">
                        <a href="/YanTu/CBZwork/Stat" class="flex items-center py-3 px-4 hover:bg-gray-700 transition-all-300">
                            <i class="fa fa-bar-chart text-lg w-6"></i>
                            <span class="menu-text ml-2">分析结果</span>
                        </a>
                    </li>

                </ul>
            </nav>
        </aside>

        <!-- 主内容区域 - 替换为iframe -->
        <main class="main-content bg-content">
            <iframe id="contentIframe" src="/YanTu/CBZwork/Index" frameborder="0"></iframe>
        </main>
    </div>

    <script>
        // 侧边栏折叠/展开
        const sidebar = document.getElementById('sidebar');
        const collapseSidebarBtn = document.getElementById('collapseSidebar');
        const toggleSidebarBtn = document.getElementById('toggleSidebar');
        const contentIframe = document.getElementById('contentIframe');

        // 折叠/展开侧边栏（宽度变化）
        collapseSidebarBtn.addEventListener('click', function() {
            sidebar.classList.toggle('collapsed');

            // 切换图标方向
            const icon = collapseSidebarBtn.querySelector('i');
            if (sidebar.classList.contains('collapsed')) {
                icon.classList.remove('fa-angle-left');
                icon.classList.add('fa-angle-right');
            } else {
                icon.classList.remove('fa-angle-right');
                icon.classList.add('fa-angle-left');
            }
        });

        // 移动端切换侧边栏显示/隐藏
        toggleSidebarBtn.addEventListener('click', function() {
            if (window.innerWidth < 768) {
                sidebar.classList.toggle('hidden');
            }
        });

        // 一级菜单子项展开/折叠
        const menuParents = document.querySelectorAll('.menu-parent');
        menuParents.forEach(function(parent) {
            parent.addEventListener('click', function() {
                const submenu = parent.nextElementSibling;
                submenu.classList.toggle('expanded');

                // 切换子菜单图标
                const icon = parent.querySelector('.menu-collapse-icon');
                if (submenu.classList.contains('expanded')) {
                    icon.classList.remove('fa-angle-down');
                    icon.classList.add('fa-angle-up');
                } else {
                    icon.classList.remove('fa-angle-up');
                    icon.classList.add('fa-angle-down');
                }
            });
        });

        // 二级菜单子项（三级菜单）展开/折叠
        const menuSubParents = document.querySelectorAll('.menu-subparent');
        menuSubParents.forEach(function(parent) {
            parent.addEventListener('click', function() {
                const submenu = parent.nextElementSibling;
                submenu.classList.toggle('expanded');

                // 切换子菜单图标
                const icon = parent.querySelector('.menu-collapse-icon');
                if (submenu.classList.contains('expanded')) {
                    icon.classList.remove('fa-angle-down');
                    icon.classList.add('fa-angle-up');
                } else {
                    icon.classList.remove('fa-angle-up');
                    icon.classList.add('fa-angle-down');
                }
            });
        });

        // 响应式处理
        window.addEventListener('resize', function() {
            if (window.innerWidth >= 768) {
                sidebar.classList.remove('hidden');
            }
        });

        // 初始化移动端侧边栏状态
        if (window.innerWidth < 768) {
            sidebar.classList.add('hidden');
        }

        // 菜单项点击逻辑 - 加载iframe页面
        const menuItems = document.querySelectorAll('.menu-list a');
        menuItems.forEach(function(item) {
            item.addEventListener('click', function(e) {
                e.preventDefault(); // 统一阻止跳转，通过iframe加载

                // 移除所有激活状态
                document.querySelectorAll('.menu-item-active').forEach(function(active) {
                    active.classList.remove('menu-item-active');
                });

                // 添加当前激活状态
                item.classList.add('menu-item-active');

                // 获取菜单对应的页面路径
                const pageUrl = this.getAttribute('href');
                if (pageUrl && pageUrl !== '#') {
                    // 更新iframe src
                    contentIframe.src = pageUrl;

                    // 更新页面标题（可选）
                    const menuText = this.querySelector('.menu-text')
                        ? this.querySelector('.menu-text').textContent
                        : this.textContent.trim();
                    document.title = `系统管理平台 - ${menuText}`;
                }
            });
        });
    </script>
</body>
</html>