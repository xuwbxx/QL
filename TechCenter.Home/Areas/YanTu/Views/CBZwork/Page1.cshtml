                // 辅助函数：数据格式转换（仅保留原功能，移除换行处理）
        function convertModel2ToModel1(model2Data) {
            if (!Array.isArray(model2Data) || model2Data.length === 0) return {};

            const transformNode = node => {
                const resultNode = {
                    name: node.name || '',
                    // 移除formattedName字段，恢复原始逻辑
                    value: node.itemData || 0
                };
                if (Array.isArray(node.children) && node.children.length > 0) {
                    resultNode.children = node.children.map(child => transformNode(child));
                }
                return resultNode;
            };
            return transformNode(model2Data[0]);
        }

