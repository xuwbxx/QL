<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>岩土所-插拔桩风险评估</title>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/lib/Echarts/echarts.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Microsoft Yahei", sans-serif;
        }

        body {
            padding: 1.5vw; /* 替换20px为1.5vw */
            background-color: #f5f7fa;
            min-height: 100vh; /* 页面最小高度占满视口 */
        }

        /* 核心：默认弹性布局，通过JS动态切换类名实现响应式 */
        .page-container {
            display: flex;
            width: 100%;
            gap: 1.5vw; /* 替换20px为1.5vw */
            min-height: calc(100vh - 3vw); /* 减去上下padding的总和 */
            flex-direction: row; /* 默认横向排列 */
        }

            /* 小屏幕适配类（通过JS动态添加/移除） */
            .page-container.mobile {
                flex-direction: column; /* 小屏幕垂直排列 */
            }

        .left-panel {
            width: 40%; /* 左侧面板加宽（原30%） */
            display: flex;
            flex-direction: column;
            align-items: center;
            flex-shrink: 0;
        }

        /* 小屏幕左侧面板占满宽度 */
        .page-container.mobile .left-panel {
            width: 100%;
        }

        /* 右侧面板核心样式优化（居中显示） */
        .right-panel {
            width: 60%; /* 右侧面板适配左侧宽度 */
            background: #fff;
            border: 0.08vw solid #e6e6e6; /* 替换1px为0.08vw */
            border-radius: 0.5vw; /* 替换6px为0.5vw */
            box-shadow: 0 0.15vw 0.6vw rgba(0,0,0,0.08); /* 替换2px/8px为vw单位 */
            display: flex;
            align-items: center; /* 垂直居中 */
            justify-content: center; /* 水平居中 */
            font-size: 1.8vw; /* 替换24px为1.8vw */
            color: #333;
            font-weight: 600;
            flex-shrink: 0;
            min-height: 100%; /* 高度占满父容器 */
            padding: 1vw; /* 增加内边距，避免图表贴边 */
            box-sizing: border-box; /* 确保内边距不影响宽度计算 */
        }

        /* 图表容器样式（关键：居中+适配） */
        #MainChart {
            width: 99% !important; /* 图表宽度占面板95%，留边距更美观 */
            height: 99% !important; /* 图表高度占面板95% */
            margin: 0 auto; /* 双重保障水平居中 */
            display: block; /* 确保块级元素居中生效 */
        }

        /* 小屏幕右侧面板适配 */
        .page-container.mobile .right-panel {
            width: 100%;
            font-size: 3vw;
            min-height: 60vh; /* 提升小屏幕高度，保证图表显示完整 */
            margin-top: 1.5vw;
            padding: 2vw; /* 小屏幕增加内边距 */
        }

        /* 小屏幕图表容器适配 */
        .page-container.mobile #MainChart {
            width: 98% !important;
            height: 98% !important;
        }

        .menu-actions {
            width: 100%;
            max-width: 90%; /* 替换450px为90% */
            margin: 0 auto 1vw; /* 替换15px为1vw */
            display: flex;
            gap: 0.6vw; /* 替换8px为0.6vw */
            flex-wrap: wrap;
            justify-content: center;
        }

        .menu-btn {
            padding: 0.45vw 0.9vw; /* 替换6px/12px为vw单位 */
            border: none;
            border-radius: 0.3vw; /* 替换4px为0.3vw */
            cursor: pointer;
            font-size: 1vw; /* 替换14px为1vw */
            display: flex;
            align-items: center;
            gap: 0.3vw; /* 替换4px为0.3vw */
            transition: background-color 0.2s;
        }

        /* 小屏幕按钮文字放大 */
        .page-container.mobile .menu-btn {
            font-size: 2vw;
        }

        .btn-add {
            background-color: #52c41a;
            color: #fff;
        }

            .btn-add:hover {
                background-color: rgba(82, 196, 26, 0.6);
            }

        .btn-edit {
            background-color: #1890ff;
            color: #fff;
        }

            .btn-edit:hover {
                background-color: rgba(24, 144, 255, 0.6);
            }

        .btn-delete {
            background-color: #ff4d4f;
            color: #fff;
        }

            .btn-delete:hover {
                background-color: rgba(255, 77, 79, 0.6);
            }

        .btn-export {
            background-color: #722ed1;
            color: #fff;
        }

            .btn-export:hover {
                background-color: rgba(114, 46, 209, 0.6);
            }

        .btn-import {
            background-color: #13c2c2;
            color: #fff;
        }

            .btn-import:hover {
                background-color: rgba(19, 194, 194, 0.6);
            }

        /* 核心：加宽树状菜单 */
        .tree-menu {
            width: 100%;
            max-width: 95%; /* 替换280px为95%，大幅加宽 */
            background: #fff;
            border: 0.08vw solid #e6e6e6; /* 替换1px为0.08vw */
            border-radius: 0.5vw; /* 替换6px为0.5vw */
            box-shadow: 0 0.15vw 0.6vw rgba(0,0,0,0.08); /* 替换2px/8px为vw单位 */
        }

        /* 小屏幕菜单占满宽度 */
        .page-container.mobile .tree-menu {
            max-width: 100%;
        }

        .tree-title {
            padding: 0.9vw 1.2vw; /* 替换12px/16px为vw单位 */
            font-size: 1.2vw; /* 替换16px为1.2vw */
            font-weight: 600;
            color: #333;
            border-bottom: 0.08vw solid #e6e6e6; /* 替换1px为0.08vw */
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .tree-list {
            list-style: none;
            padding: 0.6vw 0; /* 替换8px为0.6vw */
        }

        .tree-item {
            position: relative;
            padding: 0 1.2vw; /* 替换16px为1.2vw */
            list-style: none;
        }

        .tree-item-content {
            display: flex;
            align-items: center;
            height: 3vw; /* 替换40px为3vw */
            color: #666;
            cursor: pointer;
            border-radius: 0.3vw; /* 替换4px为0.3vw */
            padding: 0 0.6vw; /* 替换8px为0.6vw */
            transition: background-color 0.2s;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* 小屏幕菜单项高度增加 */
        .page-container.mobile .tree-item-content {
            height: 6vw;
        }

        .tree-item-content:hover {
            background-color: #f5f7fa;
        }

        .tree-item-content.active {
            background-color: #e8f4ff;
            color: #1890ff;
            font-weight: 500;
        }

        .tree-toggle {
            margin-right: 0.6vw; /* 替换8px为0.6vw */
            font-size: 0.9vw; /* 替换12px为0.9vw */
            color: #999;
            transition: transform 0.2s ease;
            cursor: pointer;
            flex-shrink: 0;
            width: 1.2vw; /* 替换16px为1.2vw */
            height: 1.2vw; /* 替换16px为1.2vw */
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

            /* 折叠图标默认状态，展开时旋转90度 */
            .tree-toggle.expanded {
                transform: rotate(90deg);
            }

        .tree-children {
            list-style: none;
            margin-left: 1.5vw; /* 替换20px为1.5vw */
            display: none;
            padding-left: 0;
        }

            /* 子菜单显示类 */
            .tree-children.open {
                display: block;
            }

        .tree-icon {
            margin-right: 0.6vw; /* 替换8px为0.6vw */
            font-size: 1.05vw; /* 替换14px为1.05vw */
            width: 1.2vw; /* 替换16px为1.2vw */
            text-align: center;
            flex-shrink: 0;
        }

        .menu-text {
            display: flex;
            align-items: center;
            width: 100%;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .menu-name {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            flex: 1;
            font-size: 1.05vw; /* 补充：菜单文字适配 */
        }

        /* 小屏幕菜单文字放大 */
        .page-container.mobile .menu-name,
        .page-container.mobile .form-label,
        .page-container.mobile .modal-btn {
            font-size: 2vw;
        }

        .modal {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.5);
            display: flex;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            display: none;
        }

        .modal-content {
            background: #fff;
            padding: 1.5vw; /* 替换20px为1.5vw */
            border-radius: 0.5vw; /* 替换6px为0.5vw */
            width: 22vw; /* 替换300px为22vw */
            box-shadow: 0 0.3vw 0.9vw rgba(0,0,0,0.15); /* 替换4px/12px为vw单位 */
        }

        /* 小屏幕模态框宽度适配 */
        .page-container.mobile .modal-content {
            width: 85vw;
        }

        #importModal .modal-content {
            width: 38vw; /* 替换500px为38vw */
        }

        /* 小屏幕导入模态框宽度适配 */
        .page-container.mobile #importModal .modal-content {
            width: 90vw;
        }

        .modal-title {
            font-size: 1.2vw; /* 替换16px为1.2vw */
            font-weight: 600;
            margin-bottom: 1.1vw; /* 替换15px为1.1vw */
            color: #333;
        }

        .form-item {
            margin-bottom: 1.1vw; /* 替换15px为1.1vw */
        }

        .form-label {
            display: block;
            margin-bottom: 0.45vw; /* 替换6px为0.45vw */
            font-size: 1vw; /* 替换14px为1vw */
            color: #666;
        }

        .form-input {
            width: 100%;
            height: 2.7vw; /* 替换36px为2.7vw */
            padding: 0 0.9vw; /* 替换12px为0.9vw */
            border: 0.08vw solid #d9d9d9; /* 替换1px为0.08vw */
            border-radius: 0.3vw; /* 替换4px为0.3vw */
            font-size: 1vw; /* 替换14px为1vw */
            outline: none;
        }

            .form-input:focus {
                border-color: #1890ff;
                box-shadow: 0 0 0 0.15vw rgba(24, 144, 255, 0.2); /* 替换2px为0.15vw */
            }

        .json-textarea {
            width: 100%;
            height: 15vw; /* 替换200px为15vw */
            padding: 0.9vw; /* 替换12px为0.9vw */
            border: 0.08vw solid #d9d9d9; /* 替换1px为0.08vw */
            border-radius: 0.3vw; /* 替换4px为0.3vw */
            font-size: 1vw; /* 替换14px为1vw */
            outline: none;
            resize: none;
            font-family: "Consolas", monospace;
        }

            .json-textarea:focus {
                border-color: #1890ff;
                box-shadow: 0 0 0 0.15vw rgba(24, 144, 255, 0.2); /* 替换2px为0.15vw */
            }

        .icon-select {
            width: 100%;
            height: 2.7vw; /* 替换36px为2.7vw */
            border: 0.08vw solid #d9d9d9; /* 替换1px为0.08vw */
            border-radius: 0.3vw; /* 替换4px为0.3vw */
            padding: 0 0.9vw; /* 替换12px为0.9vw */
            font-size: 1vw; /* 替换14px为1vw */
            outline: none;
            appearance: none;
            background: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='%23666' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3E%3Cpath d='M6 9l6 6 6-6'/%3E%3C/svg%3E") no-repeat right 0.9vw center; /* 替换12px为0.9vw */
            background-size: 1.2vw; /* 替换16px为1.2vw */
        }

            .icon-select:focus {
                border-color: #1890ff;
                box-shadow: 0 0 0 0.15vw rgba(24, 144, 255, 0.2); /* 替换2px为0.15vw */
            }

        .add-position-item {
            margin-bottom: 0.75vw; /* 替换10px为0.75vw */
            display: flex;
            align-items: center;
            gap: 0.6vw; /* 替换8px为0.6vw */
        }

        .add-position-radio {
            width: 1.2vw; /* 替换16px为1.2vw */
            height: 1.2vw; /* 替换16px为1.2vw */
            cursor: pointer;
        }

        .modal-buttons {
            display: flex;
            justify-content: flex-end;
            gap: 0.6vw; /* 替换8px为0.6vw */
            margin-top: 1.5vw; /* 替换20px为1.5vw */
        }

        .modal-btn {
            padding: 0.45vw 1.2vw; /* 替换6px/16px为vw单位 */
            border: none;
            border-radius: 0.3vw; /* 替换4px为0.3vw */
            cursor: pointer;
            font-size: 1vw; /* 替换14px为1vw */
            transition: all 0.2s;
        }

        .btn-cancel {
            background-color: #f5f5f5;
            color: #666;
        }

            .btn-cancel:hover {
                background-color: #e8e8e8;
            }

        .btn-confirm {
            background-color: #1890ff;
            color: #fff;
        }

            .btn-confirm:hover {
                background-color: #40a9ff;
            }

        .toast {
            position: fixed;
            top: 1.5vw; /* 替换20px为1.5vw */
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.7);
            color: #fff;
            padding: 0.6vw 1.2vw; /* 替换8px/16px为vw单位 */
            border-radius: 0.3vw; /* 替换4px为0.3vw */
            font-size: 1vw; /* 替换14px为1vw */
            z-index: 1001;
            display: none;
            transition: opacity 0.2s;
        }

        .itemdata-textarea {
            width: 100%;
            height: 6vw; /* 替换80px为6vw */
            padding: 0.9vw; /* 替换12px为0.9vw */
            border: 0.08vw solid #d9d9d9; /* 替换1px为0.08vw */
            border-radius: 0.3vw; /* 替换4px为0.3vw */
            font-size: 1vw; /* 替换14px为1vw */
            outline: none;
            resize: vertical;
            font-family: "Microsoft Yahei", sans-serif;
        }

            .itemdata-textarea:focus {
                border-color: #1890ff;
                box-shadow: 0 0 0 0.15vw rgba(24, 144, 255, 0.2); /* 替换2px为0.15vw */
            }

    </style>
</head>
<body>
    <div class="page-container">
        <div class="left-panel">
            <div class="menu-actions">
                <button class="menu-btn btn-add" id="addMenuBtn">
                    <i class="fas fa-plus"></i> 添加菜单
                </button>
                <button class="menu-btn btn-edit" id="editMenuBtn">
                    <i class="fas fa-pen"></i> 修改菜单
                </button>
                <button class="menu-btn btn-delete" id="deleteMenuBtn">
                    <i class="fas fa-trash"></i> 删除菜单
                </button>
                <button class="menu-btn btn-export" id="exportMenuBtn">
                    <i class="fas fa-download"></i> 导出JSON
                </button>
                <button class="menu-btn btn-import" id="importMenuBtn">
                    <i class="fas fa-upload"></i> 导入JSON
                </button>
                <button class="menu-btn btn-add" id="chartMenuBtn" onclick="ChartShow();">
                    <i class="fas fa-area-chart"></i> 转换图表
                </button>
            </div>
            <div class="tree-menu">
                <div class="tree-title">工序步骤</div>
                <ul class="tree-list" id="treeMenu">
                </ul>
            </div>
        </div>
        <div class="right-panel">
            <div id="MainChart"></div>
        </div>
    </div>

    <div class="modal" id="menuModal">
        <div class="modal-content">
            <div class="modal-title" id="modalTitle">添加菜单</div>
            <div class="form-item" id="addPositionContainer">
                <label class="form-label">添加位置</label>
                <div class="add-position-item">
                    <input type="radio" name="addPosition" value="level1" class="add-position-radio" id="radioLevel1">
                    <label for="radioLevel1">一级菜单（根节点）</label>
                </div>
                <div class="add-position-item">
                    <input type="radio" name="addPosition" value="child" class="add-position-radio" id="radioChild">
                    <label for="radioChild">当前选中菜单的子菜单</label>
                </div>
            </div>
            <div class="form-item">
                <label class="form-label">菜单名称</label>
                <input type="text" class="form-input" id="menuNameInput" placeholder="请输入菜单名称">
            </div>
            <div class="form-item">
                <label class="form-label">选择图标</label>
                <select class="icon-select" id="menuIconSelect">
                    <option value="">❌ 无图标</option>
                    <option value="fas fa-circle">● 圆形</option>
                    <option value="fas fa-home">🏠 首页</option>
                    <option value="fas fa-desktop">🖥️ 桌面</option>
                    <option value="fas fa-shopping-cart">🛒 购物车</option>
                    <option value="fas fa-users">👥 用户</option>
                    <option value="fas fa-cog">⚙️ 设置</option>
                    <option value="fas fa-folder">📁 文件夹（一级菜单推荐）</option>
                    <option value="fas fa-plus">➕ 加号</option>
                    <option value="fas fa-pen">✏️ 编辑</option>
                    <option value="fas fa-trash">🗑️ 删除</option>
                    <option value="fas fa-list">📋 列表</option>
                    <option value="fas fa-file">📄 文件</option>
                    <option value="fas fa-search">🔍 搜索</option>
                    <option value="fas fa-save">💾 保存</option>
                    <option value="fas fa-redo">🔄 刷新</option>
                </select>
            </div>
            <div class="form-item">
                <label class="form-label">ItemData数据（可选，文本类型，仅存储）</label>
                <textarea class="itemdata-textarea" id="menuItemDataInput" placeholder="请输入ItemData文本内容（不会在菜单中显示）"></textarea>
            </div>
            <div class="modal-buttons">
                <button class="modal-btn btn-cancel" id="cancelBtn">取消</button>
                <button class="modal-btn btn-confirm" id="confirmBtn">确认</button>
            </div>
        </div>
    </div>

    <div class="modal" id="importModal">
        <div class="modal-content">
            <div class="modal-title">导入菜单JSON</div>
            <div class="form-item">
                <label class="form-label">JSON数据（菜单名称最多10个字符，超出会自动截断，仅包含itemData字段）</label>
                <textarea class="json-textarea" id="jsonImportText" placeholder='示例格式：
[
  {
    "id": 1,
    "name": "首页管理",
    "icon": "fas fa-home",
    "itemData": "自定义文本数据，仅存储不显示",
    "children": [
      {
        "id": 2,
        "name": "首页轮播",
        "icon": "fas fa-desktop",
        "itemData": "子菜单的自定义文本",
        "children": [
          {
            "id": 3,
            "name": "轮播列表",
            "icon": "fas fa-circle",
            "itemData": "孙菜单的自定义文本",
            "children": []
          }
        ]
      }
    ]
  }
]'></textarea>
            </div>
            <div class="modal-buttons">
                <button class="modal-btn btn-cancel" id="importCancelBtn">取消</button>
                <button class="modal-btn btn-confirm" id="importConfirmBtn">确认导入</button>
            </div>
        </div>
    </div>

    <div class="toast" id="toast"></div>

    <script>
        const MENU_CONFIG = {
            MAX_NAME_LENGTH: 10,
            DEFAULT_NEXT_ID: 32,
            INIT_MENU_DATA: [
                {
                    "id": 14,
                    "name": "桩靴插拔作业风险评估",
                    "icon": "fas fa-home",
                    "itemData": "一级菜单自定义文本数据",
                    "children": [
                        {
                            "id": 15,
                            "name": "地质情况",
                            "icon": "",
                            "itemData": "地质情况子菜单自定义数据",
                            "children": [
                                { "id": 19, "name": "表层土性", "icon": "", "itemData": "表层土性孙菜单自定义数据", "children": [] },
                                { "id": 20, "name": "破坏模式", "icon": "", "itemData": "破坏模式孙菜单自定义数据", "children": [] },
                                { "id": 21, "name": "土体性质指标", "icon": "", "itemData": "土体性质指标孙菜单自定义数据", "children": [] },
                                { "id": 22, "name": "经验参数", "icon": "", "itemData": "经验参数孙菜单自定义数据", "children": [] }
                            ]
