                  borderRadius: 4,
                  padding: [5, 8],
                  position: 'right',
                  verticalAlign: 'middle',
                  align: 'left',
                  color: '#333'
                }
              },
              // 高亮样式
              emphasis: {
                focus: 'none', // 关键：改为none，不隐藏/淡化其他节点
                blurScope: 'none', // 可选：关闭模糊作用域
                label: {
                  fontSize: 15,
                  backgroundColor: '#409EFF',
                  color: '#fff',
                  borderColor: '#1989fa'
                },
                lineStyle: {
                  width: 2,
                  color: '#1989fa'
                },
                // 确保其他节点样式不变
                itemStyle: {
                  opacity: 1 // 强制当前节点外的其他节点不透明
                }
              },
              // 展开收起配置
              expandAndCollapse: true,
              // 动画配置
              animationDuration: 550,
              animationDurationUpdate: 750,
              // 折叠/展开图标样式
              expandIcon: {
                path: 'M10 8L6 12 10 16V8Z', // 自定义展开图标
                size: 12
              },
              collapseIcon: {
                path: 'M8 10L12 6 8 2V10Z', // 自定义折叠图标
                size: 12
              }
            }
          ]
        };

            var chartDom = document.getElementById('MainChart');
            var myChart = echarts.init(chartDom);

            option && myChart.setOption(option);
        }
        

    </script>
</body>
</html>