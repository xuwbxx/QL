        const MenuState = {
            currentActiveItem: $(),
            isEditMode: false,
            nextMenuId: MENU_CONFIG.DEFAULT_NEXT_ID
        };

        const MenuUtils = {
            truncateMenuName: function(name) {
                if (!name) return '';
                return name.length > MENU_CONFIG.MAX_NAME_LENGTH
                    ? name.substring(0, MENU_CONFIG.MAX_NAME_LENGTH) + '...'
                    : name;
            },
            showToast: function(message, duration) {
                duration = duration || 3000;
                const $toast = $('#toast');
                $toast.text(message).show();
                setTimeout(() => $toast.hide(), duration);
            },
            updateNextMenuId: function() {
                let maxId = 0;
                $('.tree-item').each(function() {
                    const id = parseInt($(this).data('id'));
                    if (!isNaN(id) && id > maxId) maxId = id;
                });
                MenuState.nextMenuId = maxId + 1;
            },
            processImportedMenuJson: function(menuJson) {
                const self = this;
                return menuJson.map(item => {
                    const processedItem = {
                        id: item.id,
                        name: item.name || '',
                        fullName: item.name || '',
                        displayName: self.truncateMenuName(item.name || ''),
                        icon: item.icon || '',
                        itemData: item.itemData || '',
                        children: []
                    };
                    if (item.children && item.children.length > 0) {
                        processedItem.children = self.processImportedMenuJson(item.children);
                    }
                    return processedItem;
                });
            },
            // 新增：检测屏幕宽度并适配
            checkScreenSize: function() {
                const $container = $('.page-container');
                const screenWidth = window.innerWidth;
                // 小于768px时添加mobile类，否则移除
                if (screenWidth <= 768) {
                    $container.addClass('mobile');
                } else {
                    $container.removeClass('mobile');
                }
            }
        };

        const MenuData = {
            exportMenuToJson: function($container) {
                const self = this;
                const menuList = [];
                if (!$container || !$container.length || !$container.children('.tree-item').length) return menuList;

                $container.children('.tree-item').each(function() {
                    const $item = $(this);
                    const $content = $item.children('.tree-item-content').first();
                    const $menuNameEl = $content.find('.menu-text > .menu-name').first();
                    const menuName = $menuNameEl.attr('data-full-name') || $menuNameEl.text().trim();
                    const menuIcon = $content.find('.menu-text > .tree-icon').first().attr('class')?.replace('tree-icon', '').trim() || '';
                    const menuItemData = $item.data('itemdata');

                    const menuItem = {
                        id: parseInt($item.data('id') || 0),
                        name: menuName,
                        icon: menuIcon,
                        children: []
                    };
                    if (menuItemData !== null && menuItemData !== undefined && menuItemData !== '') {
                        menuItem.itemData = menuItemData;
                    }

                    const $childrenContainer = $item.find('.tree-children').first();
                    if ($childrenContainer.length > 0) {
                        menuItem.children = self.exportMenuToJson($childrenContainer);
                    }
                    menuList.push(menuItem);
                });
                return menuList;
            },
            renderMenuFromJson: function(menuJson, $container) {
                const self = this;
                menuJson.forEach(menuItem => {
                    // 创建菜单项主容器
                    const $treeItem = $('<li>').addClass('tree-item').attr('data-id', menuItem.id);
                    if (menuItem.itemData) $treeItem.data('itemdata', menuItem.itemData);

                    // 构建图标和折叠按钮
                    let iconHtml = menuItem.icon ? `<i class="${menuItem.icon} tree-icon"></i>` : '';
                    const fullName = menuItem.fullName || menuItem.name || '';
                    const displayName = menuItem.displayName || MenuUtils.truncateMenuName(menuItem.name || '');
                    let toggleHtml = '';

                    // 有子菜单时添加折叠图标
                    if (menuItem.children && menuItem.children.length > 0) {
                        const level = $container.parents('.tree-item').length;
                        const toggleIcon = level === 0 ? 'fas fa-caret-right' : 'fas fa-angle-right';
                        toggleHtml = `<i class="${toggleIcon} tree-toggle"></i>`;
                    }

                    // 构建菜单内容
                    const $content = $('<div>').addClass('tree-item-content');
                    const $menuText = $('<div>').addClass('menu-text').html(toggleHtml + iconHtml + `<span class="menu-name" data-full-name="${fullName}">${displayName}</span>`);
                    $content.append($menuText);
                    $treeItem.append($content);

                    // 渲染子菜单容器（关键：确保子菜单容器正确挂载）
                    if (menuItem.children && menuItem.children.length > 0) {
                        const $childrenContainer = $('<ul>').addClass('tree-children');
                        $treeItem.append($childrenContainer);
                        // 递归渲染子菜单
                        self.renderMenuFromJson(menuItem.children, $childrenContainer);
                    }

                    // 添加到父容器
                    $container.append($treeItem);
                });
            },
            addLevel1Menu: function(fullName, displayName, menuIcon, menuItemData) {
                const newMenuId = MenuState.nextMenuId++;
                let iconHtml = menuIcon ? `<i class="${menuIcon} tree-icon"></i>` : '';

                const $newMenuItem = $('<li>').addClass('tree-item').attr('data-id', newMenuId);
                const $content = $('<div>').addClass('tree-item-content active');
                const $menuText = $('<div>').addClass('menu-text').html(`<i class="fas fa-caret-right tree-toggle"></i>${iconHtml}<span class="menu-name" data-full-name="${fullName}">${displayName}</span>`);

                $content.append($menuText);
                $newMenuItem.append($content).append($('<ul>').addClass('tree-children'));
                if (menuItemData) $newMenuItem.data('itemdata', menuItemData);

                $('#treeMenu').append($newMenuItem);
                MenuState.currentActiveItem = $newMenuItem;
                $('.tree-item-content').removeClass('active');
                $newMenuItem.find('.tree-item-content').addClass('active');
            },
            addChildMenu: function(fullName, displayName, menuIcon, menuItemData) {
                const newMenuId = MenuState.nextMenuId++;
                let iconHtml = menuIcon ? `<i class="${menuIcon} tree-icon"></i>` : '';

                const $newMenuItem = $('<li>').addClass('tree-item').attr('data-id', newMenuId);
                const $content = $('<div>').addClass('tree-item-content active');
                const $menuText = $('<div>').addClass('menu-text').html(`${iconHtml}<span class="menu-name" data-full-name="${fullName}">${displayName}</span>`);

                $content.append($menuText);
                $newMenuItem.append($content);
                if (menuItemData) $newMenuItem.data('itemdata', menuItemData);

                let $childrenContainer = MenuState.currentActiveItem.find('.tree-children').first();
                if (!$childrenContainer.length) {
                    const $menuText = MenuState.currentActiveItem.find('.tree-item-content > .menu-text').first();
                    const level = MenuState.currentActiveItem.parents('.tree-item').length;
                    const toggleIcon = level === 0 ? 'fas fa-caret-right' : 'fas fa-angle-right';
                    $menuText.prepend(`<i class="${toggleIcon} tree-toggle"></i>`);
                    $childrenContainer = $('<ul>').addClass('tree-children open');
                    MenuState.currentActiveItem.append($childrenContainer);
                } else {
                    $childrenContainer.addClass('open');
                }

                $childrenContainer.append($newMenuItem);
                MenuState.currentActiveItem = $newMenuItem;
                $('.tree-item-content').removeClass('active');
                $newMenuItem.find('.tree-item-content').addClass('active');
            }
        };

        const MenuEvents = {
            initEvents: function() {
                const self = this;
                $(document)
                    // 折叠图标点击事件（核心修复）
                    .on('click', '.tree-toggle', function(e) {
                        e.stopPropagation();
                        const $toggle = $(this);
                        const $parentItem = $toggle.closest('.tree-item');
                        const $children = $parentItem.find('.tree-children').first();

                        // 切换折叠状态
                        $toggle.toggleClass('expanded');
                        $children.toggleClass('open');

                        // 切换图标样式（视觉优化）
                        if ($toggle.hasClass('fa-caret-right')) {
                            $toggle.toggleClass('fa-caret-right fa-caret-down');
                        } else if ($toggle.hasClass('fa-angle-right')) {
                            $toggle.toggleClass('fa-angle-right fa-angle-down');
                        }
                    })
                    // 菜单项点击事件
                    .on('click', '.tree-item-content', function(e) {
                        e.stopPropagation();
                        const $content = $(this);
                        const $treeItem = $content.closest('.tree-item');

                        // 激活选中状态
                        $('.tree-item-content').removeClass('active');
                        $content.addClass('active');
                        MenuState.currentActiveItem = $treeItem;

                        // 自动展开子菜单（如果有）
                        const $toggle = $content.find('.tree-toggle').first();
                        const $children = $treeItem.find('.tree-children').first();
                        if ($toggle.length > 0 && $children.length > 0 && !$children.hasClass('open')) {
                            $toggle.click(); // 触发折叠图标点击事件
                        }
                    })
                    .on('click', '#addMenuBtn', () => self.handleAddMenuClick())
                    .on('click', '#editMenuBtn', () => self.handleEditMenuClick())
                    .on('click', '#deleteMenuBtn', () => self.handleDeleteMenuClick())
                    .on('click', '#confirmBtn', () => self.handleConfirmClick())
                    .on('click', '#cancelBtn', () => self.handleCancelClick())
                    .on('click', '#exportMenuBtn', () => self.handleExportClick())
                    .on('click', '#importMenuBtn', () => self.handleImportClick())
                    .on('click', '#importCancelBtn', () => self.handleImportCancelClick())
                    .on('click', '#importConfirmBtn', () => self.handleImportConfirmClick())
                    .on('click', '.modal', (e) => self.handleModalOutsideClick(e));

                // 新增：监听窗口大小变化，实时适配
                $(window).on('resize', function() {
                    MenuUtils.checkScreenSize();
                });
            },
            handleAddMenuClick: function() {
                $('#modalTitle').text('添加菜单');
                $('#menuNameInput').val('');
                $('#menuIconSelect').val('');
                $('#menuItemDataInput').val('');
                MenuState.isEditMode = false;

                $('#radioLevel1').prop('checked', !MenuState.currentActiveItem.length);
                $('#radioChild').prop('checked', !!MenuState.currentActiveItem.length);

                $('#menuModal').show();
            },
            handleEditMenuClick: function() {
                if (!MenuState.currentActiveItem.length) {
                    MenuUtils.showToast('请先选中要修改的菜单');
                    return;
                }

                const $content = MenuState.currentActiveItem.children('.tree-item-content').first();
                const menuText = $content.find('.menu-name').attr('data-full-name') || $content.find('.menu-name').text().trim();
                const menuIcon = $content.find('.tree-icon').attr('class')?.replace('tree-icon', '').trim() || '';
                const menuItemData = MenuState.currentActiveItem.data('itemdata') || '';

                $('#modalTitle').text('修改菜单');
                $('#menuNameInput').val(menuText);
                $('#menuIconSelect').val(menuIcon);
                $('#menuItemDataInput').val(menuItemData);
                MenuState.isEditMode = true;
                $('#addPositionContainer').hide();
                $('#menuModal').show();
            },
            handleDeleteMenuClick: function() {
                const $activeContent = $('.tree-item-content.active');
                if (!$activeContent.length) {
                    MenuUtils.showToast('请先选中要删除的菜单');
                    return;
                }

                const $activeItem = $activeContent.closest('.tree-item');
                const menuText = $activeContent.find('.menu-name').attr('data-full-name') || $activeContent.find('.menu-name').text().trim();

                if (confirm(`确定要删除菜单【${menuText}】吗？删除后子菜单也会被移除！`)) {
                    const $parentContainer = $activeItem.parent();
                    $activeItem.remove();
                    $('.tree-item-content').removeClass('active');

                    // 选中父菜单（如果存在）
                    const $firstItem = $parentContainer.find('.tree-item').first();
                    if ($firstItem.length) {
                        // $firstItem.find('.tree-item-content').addClass('active');
                        // MenuState.currentActiveItem = $firstItem;
                    } else {
                        const $parentTreeItem = $parentContainer.closest('.tree-item');
                        if ($parentTreeItem.length) {
                            $parentTreeItem.find('.tree-item-content').addClass('active');
                            MenuState.currentActiveItem = $parentTreeItem;
                            // 移除空父菜单的折叠图标
                            $parentTreeItem.find('.tree-toggle').remove();
                            $parentTreeItem.find('.tree-children').remove();
                        } else {
                            MenuState.currentActiveItem = $();
                        }
                    }
                    MenuUtils.showToast('菜单删除成功');
                }
            },
            handleConfirmClick: function() {
                let menuName = $('#menuNameInput').val().trim();
                const menuIcon = $('#menuIconSelect').val().trim();
                const menuItemData = $('#menuItemDataInput').val().trim();

                if (!menuName) {
                    MenuUtils.showToast('请输入菜单名称');
                    return;
                }

                const fullMenuName = menuName;
                const displayMenuName = MenuUtils.truncateMenuName(menuName);

                if (MenuState.isEditMode) {
                    const $content = MenuState.currentActiveItem.children('.tree-item-content').first();
                    const $menuNameEl = $content.find('.menu-name');
                    const $iconEl = $content.find('.tree-icon');

                    $menuNameEl.text(displayMenuName).attr('data-full-name', fullMenuName);
                    if (menuIcon) {
                        $iconEl.length ? $iconEl.attr('class', `tree-icon ${menuIcon}`) : $menuNameEl.before(`<i class="${menuIcon} tree-icon"></i>`);
                    } else {
                        $iconEl.remove();
                    }
                    MenuState.currentActiveItem.data('itemdata', menuItemData);
                    MenuUtils.showToast('菜单修改成功');
                } else {
                    const addAsLevel1 = $('#radioLevel1').is(':checked');
                    if (addAsLevel1) {
                        MenuData.addLevel1Menu(fullMenuName, displayMenuName, menuIcon, menuItemData);
                    } else {
                        if (!MenuState.currentActiveItem.length) {
                            MenuUtils.showToast('请先选中父菜单');
                            return;
                        }
                        MenuData.addChildMenu(fullMenuName, displayMenuName, menuIcon, menuItemData);
                    }
                    MenuUtils.showToast('菜单添加成功');
                }

                $('#menuModal').hide();
                $('#addPositionContainer').show();
            },
            handleCancelClick: function() {
                $('#menuModal').hide();
                $('#addPositionContainer').show();
            },
            handleExportClick: function() {
                const menuJson = MenuData.exportMenuToJson($('#treeMenu'));
                const formattedJson = JSON.stringify(menuJson, null, 2);
                const blob = new Blob([formattedJson], { type: 'application/json' });
                const url = URL.createObjectURL(blob);
                const a = $('<a>').attr({ href: url, download: `菜单配置_${new Date().toLocaleDateString()}.json` });

                $('body').append(a);
                a[0].click();
                setTimeout(() => {
                    a.remove();
                    URL.revokeObjectURL(url);
                }, 100);

                MenuUtils.showToast('JSON导出成功（仅包含itemData字段）');
            },
            handleImportClick: function() {
                $('#importModal').show();
            },
            handleImportCancelClick: function() {
                $('#importModal').hide();
            },
            handleImportConfirmClick: function() {
                try {
                    const jsonText = $('#jsonImportText').val().trim();
                    if (!jsonText) {
                        MenuUtils.showToast('请输入JSON数据');
                        return;
                    }

                    const menuJson = JSON.parse(jsonText);
                    if (!Array.isArray(menuJson)) throw new Error('JSON格式错误：根节点必须是数组');

                    const processedMenuJson = MenuUtils.processImportedMenuJson(menuJson);
                    $('#treeMenu').empty();
                    $('.tree-item-content').removeClass('active');
                    MenuState.currentActiveItem = $();

                    MenuData.renderMenuFromJson(processedMenuJson, $('#treeMenu'));
                    MenuUtils.updateNextMenuId();

                    // 导入后默认选中第一个菜单并激活样式
                    const $firstItem = $('#treeMenu').find('.tree-item').first();
                    if ($firstItem.length) {
                        MenuState.currentActiveItem = $firstItem;
                        $firstItem.find('.tree-item-content').addClass('active');
                        const $toggle = $firstItem.find('.tree-toggle').first();
                        if ($toggle.length > 0) {
                            setTimeout(() => $toggle.click(), 100); // 延迟执行确保DOM渲染完成
                        }
                    }

                    MenuUtils.showToast('JSON导入成功（超长名称已自动截断，仅包含itemData字段）');
                    $('#importModal').hide();
                } catch (error) {
                    MenuUtils.showToast(`导入失败：${error.message}`);
                    console.error('导入错误：', error);
                }
            },
            handleModalOutsideClick: function(e) {
                if (e.target === this) {
                    $(this).hide();
                    $('#addPositionContainer').show();
                }
            }
        };

        const MenuInit = {
            initLoadMenuJson: function() {
                try {
                    const processedMenuJson = MenuUtils.processImportedMenuJson(MENU_CONFIG.INIT_MENU_DATA);
                    $('#treeMenu').empty();
                    $('.tree-item-content').removeClass('active');
                    MenuState.currentActiveItem = $();

                    // 渲染菜单
                    MenuData.renderMenuFromJson(processedMenuJson, $('#treeMenu'));
                    MenuUtils.updateNextMenuId();

                    // 初始化后默认选中第一个菜单并展开（关键：延迟执行）
                    setTimeout(() => {
                        const $firstItem = $('#treeMenu').find('.tree-item').first();
                        if ($firstItem.length) {
                            MenuState.currentActiveItem = $firstItem;
                            $firstItem.find('.tree-item-content').addClass('');
                            const $toggle = $firstItem.find('.tree-toggle').first();
                            if ($toggle.length > 0) {
                                $toggle.click(); // 展开一级菜单
                                // 展开第一个子菜单（可选）
                                setTimeout(() => {
