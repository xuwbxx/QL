
@{
    ViewBag.Title = "跳转";
    Layout = "~/Views/Shared/BlankLayout.cshtml";
}

<input type="hidden" id="hid_Type" value="@ViewData["Type"].ToString()" />
<input type="hidden" id="hid_ID" value="@ViewData["ID"].ToString()" />
<h2>跳转中......</h2>

<script>
    $(document).ready(function () {

        var Type = $('#hid_Type').val();
        var ID = $('#hid_ID').val();
        if (Type == '' || ID == '' || ID == 0)
            return;

        if (/Mobi|Android|iPhone/i.test(navigator.userAgent)) {
            // 当前设备是移动设备

            if (Type == 'Project') {
                window.location.href = "/Mobile/Project/Index?CloudID=" + ID;
            }
            else if (Type == 'Task')
            {
                window.location.href = "/Mobile/Task/Index?CloudID=" + ID;
            }
            

        }
        else
        {
            if (Type == 'Project') {
                window.location.href = "/Cloud/Project/Index?CloudID=" + ID;
            }
            else if (Type == 'Task') {
                window.location.href = "/Cloud/Task/Index?CloudID=" + ID;
            }
        }

    })

</script>