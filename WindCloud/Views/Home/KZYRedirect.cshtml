
@{
    ViewBag.Title = "跳转";
    Layout = "~/Views/Shared/BlankLayout.cshtml";
}

<input type="hidden" id="hid_TaskCode" value="@ViewData["TaskCode"].ToString()" />
<input type="hidden" id="hid_Type" value="@ViewData["Type"].ToString()" />
<h2>跳转中......</h2>

<script>
    $(document).ready(function () {

        var TaskCode = $('#hid_TaskCode').val();
        var Type = $('#hid_Type').val();
        if (TaskCode == '' || Type == '')
            return;

        if (/Mobi|Android|iPhone/i.test(navigator.userAgent)) {
            // 当前设备是移动设备

            window.location.href = "/Mobile/Task/Index";

        }
        else
        {
            window.location.href = "/Cloud/Task/Index?TaskCode=" + TaskCode + "&Type=" + Type;
        }

    })

</script>

