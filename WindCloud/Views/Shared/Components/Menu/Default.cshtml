<!-- ====================== 修复版：URL自动打开菜单（无报错） ====================== -->
<script>
    // 等待 layui 完全加载 + 初始化 element 后再执行
    layui.use(['element', 'layer'], function () {
        var element = layui.element;
        var $ = layui.jquery;

        $(function () {
            var targetUrl = getQueryString("target");
            if (!targetUrl) return;

            var $menu = $("a[_href='" + targetUrl + "']");
            if ($menu.length === 0) return;

            // 展开父菜单
            $menu.parents(".sub-menu").show();
            //$menu.parents("li").addClass("layui-nav-itemed");
            element.init(); // 刷新layui组件

            // 延迟执行点击，确保 xadmin 完全就绪
            setTimeout(function () {
                $menu.trigger("click");
            }, 100);
        });

        // 获取URL参数
        function getQueryString(name) {
            var reg = new RegExp("(^|&)" + name + "=([^&]*)(&|$)", "i");
            var r = window.location.search.substr(1).match(reg);
            if (r != null) return decodeURIComponent(r[2]);
            return null;
        }
    });
</script>
