<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>

    <meta charset="UTF-8">
    <meta name="renderer" content="webkit">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="shortcut icon" type="image/x-icon" href="@(Url.Content("~/Content/Manage/images/title-logo.ico"))" />
    <link rel="stylesheet" type="text/css" href="@(Url.Content("~/Content/Manage/css/font.css"))">
    <link rel="stylesheet" type="text/css" href="@(Url.Content("~/Content/Manage/css/font-awesome.4.6.0.css"))">
    <link rel="stylesheet" type="text/css" href="@(Url.Content("~/Content/Manage/css/layui.css"))">
    <link rel="stylesheet" type="text/css" href="@(Url.Content("~/Content/Manage/css/xadmin.css"))">
    <link rel="stylesheet" type="text/css" href="@(Url.Content("~/Content/Manage/css/style.css"))">

    <script type="text/javascript" src="@(Url.Content("~/js/jquery1.12.4.min.js?timestamp=") + DateTime.Now.Ticks)"></script>
    <script type="text/javascript" src="@(Url.Content("~/Content/Manage/lib/layui/layui.js"))"></script>
    <script type="text/javascript" src="@(Url.Content("~/Content/Manage/js/xadmin.js"))"></script>

</head>
<body>
    <!-- 顶部开始 -->
    <div class="container">
        <div class="logo"><a href="./index.html">风电云服务平台后台管理系统</a></div>
        <div class="left_open">
            <i title="展开左侧栏" class="fa fa-reorder"></i>
        </div>
        <!--
                <ul class="layui-nav left fast-add" lay-filter="">
                  <li class="layui-nav-item">
                    <a href="javascript:;">+新增</a>
                    <dl class="layui-nav-child">
                      <dd><a onclick="x_admin_show('资讯','http://www.baidu.com')"><i class="iconfont">&#xe6a2;</i>资讯</a></dd>
                      <dd><a onclick="x_admin_show('图片','http://www.baidu.com')"><i class="iconfont">&#xe6a8;</i>图片</a></dd>
                       <dd><a onclick="x_admin_show('用户','http://www.baidu.com')"><i class="iconfont">&#xe6b8;</i>用户</a></dd>
                    </dl>
                  </li>
                </ul>
        -->
        <ul class="layui-nav right" lay-filter="">
            <li class="layui-nav-item">
                <a href="javascript:;">admin</a>
                <dl class="layui-nav-child">
                    <!-- 二级菜单 -->
                    <dd><a onclick="x_admin_show('个人信息','http://www.baidu.com')">个人信息</a></dd>
                    <dd><a onclick="x_admin_show('切换帐号','http://www.baidu.com')">切换帐号</a></dd>
                    <dd><a href="./login.html">退出</a></dd>
                </dl>
            </li>
            <li class="layui-nav-item to-index"><a href="/">前台首页</a></li>
        </ul>
    </div>
    <!-- 顶部结束 -->
    <!-- 中部开始 -->
    <!-- 左侧菜单开始 -->
    @await Component.InvokeAsync("Menu") 

    <!-- 左侧菜单结束 -->
    <!-- 右侧主体开始 -->
    @RenderBody()
    
    <!--    <div class="page-content-bg"></div>-->
    <!-- 右侧主体结束 -->
    <!-- 中部结束 -->
    <!-- 底部开始 -->
    <!--
        <div class="footer">
            <div class="copyright">Copyright ©2017 x-admin v2.3 All Rights Reserved</div>
        </div>
    -->

</body>
</html>
