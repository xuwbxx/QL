
@{
    ViewBag.Title = "平台船库";
    Layout = "~/Views/Shared/BackManagePageLayout.cshtml";
}

<input type="hidden" id="hid_PostToken" value="@ViewData["PostToken"].ToString()" />

<div class="div_body">

    <div class="div_form">

        <form class="form-inline">
            <div class="form-group">
                <input type="text" class="form-control" placeholder="请输入船舶名称" name="txt_ShipName_Query">
            </div>
            <div class="form-group">
                <select class="form-control" name="select_ShipConfirm_Query">
                    <option value="0">是否确认</option>
                    <option value="1">已确认</option>
                    <option value="2">未确认</option>
                </select>
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-primary" onclick="ShipJS.DoQuery();">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </form>
    </div>

    <div class="div_table">
        <table class="table table-hover table_chongzhi">
            <thead>
                <tr>
                    <th width="40%">船名</th>
                    <th width="30%">是否确认</th>
                    <th width="40%">操作</th>
                </tr>
            </thead>
            <tbody id="html_ShipList">
                <tr>
                    <td>项目部业务员申请</td>
                    <td>节点类型</td>
                    <td>
                        <button type="button" class="btn btn-primary-s" onClick="PopupConfiguration();"><i class="icon iconfont table_icon">&#xe66e;</i>配置节点人员</button>
                    </td>
                </tr>
                <tr>
                    <td>项目部总工审批</td>
                    <td class="redcolor">否</td>
                    <td>节点类型</td>
                    <td>
                        <button type="button" class="btn btn-primary-s"><i class="icon iconfont table_icon">&#xe66e;</i>配置节点人员</button>
                    </td>
                </tr>

            </tbody>

        </table>

        <div class="text-center">

            <div id="Pagination">
            </div>
        </div>

    </div>
</div>


<!--船舶详情弹框-->
<div class="modal fade" id="Tk_ShipDetail" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-dialog-m mt12">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h4 class="modal-title" id="popup_LibraryShipInfoName">
                    港航平9
                </h4>
            </div>
            <div class="modal-body">
                <input type="hidden" id="popup_LibraryShipID" />
                <ul class="cbxq_ul clearfix">
                    <li><span>桩腿直径（m）</span><span></span><span><input id="popup_Ship_ZTZJ" type="number" class="form-control"></span></li>
                    <li><span>桩腿周长（m）</span><span></span><span><input id="popup_Ship_ZTZC" type="number" class="form-control"></span></li>
                    <li><span>桩靴长度 L（m）</span><span></span><span><input id="popup_Ship_ZXCD" type="number" class="form-control"></span></li>
                    <li><span>桩靴宽度 B（m）</span><span></span><span><input id="popup_Ship_ZXKD" type="number" class="form-control"></span></li>
                    <li><span>桩靴高度 H（m）</span><span></span><span><input id="popup_Ship_ZXGD" type="number" class="form-control"></span></li>
                    <li><span>桩靴面积 A（m2）</span><span></span><span><input id="popup_Ship_ZXMJ" type="number" class="form-control"></span></li>
                    <li><span>桩靴最大截面周长（m）</span><span></span><span><input id="popup_Ship_ZXZDJMZC" type="number" class="form-control"></span></li>
                    <li><span>桩靴体积 V（m3）</span><span></span><span><input id="popup_Ship_ZXTJ" type="number" class="form-control"></span></li>

                    <li><span>桩腿、桩靴自重 W（t）</span> <span></span><span><input id="popup_Ship_ZTZXZZ" type="number" class="form-control"></span></li>
                    <li><span style="color:red;">桩腿预压力（t）</span><span></span><span><input id="popup_Ship_ZTYYL" style="color:red;" type="number" class="form-control"></span></li>
                    <li><span style="color:red;">计算预压荷载（t）</span><span></span><span><input id="popup_Ship_JSYYHZ" style="color:red;" type="number" class="form-control"></span></li>
                    <li><span>拔桩力（t）</span> <span></span> <span><input id="popup_Ship_BZL" type="number" class="form-control"></span></li>

                    <li><span>对地比压（kpa）</span> <span></span><span><input id="popup_Ship_DDBY" type="number" class="form-control"></span></li>
                    <li><span>有效桩腿长度（船底到靴底）（m）</span><span></span><span><input id="popup_Ship_YXZTCD" type="number" class="form-control"></span></li>
                    <li><span>气隙（船底到水面）（m）</span><span></span><span><input id="popup_Ship_QX" type="number" class="form-control"></span></li>
                    <li><span>桩腿有效长度（m）</span><span></span><span><input id="popup_Ship_ZTYXCD" type="number" class="form-control"></span></li>
                    <li><span>桩腿截面积（m2）</span><span></span><span><input id="popup_Ship_ZTJMJ" type="number" class="form-control"></span></li>

                    <li>
                        <span>是否确认</span><span></span>
                        <span>
                            <input type="radio" name="popup_ShipIsConfirm" id="popup_ShipConfirmTrue" />已确认
                            <input type="radio" name="popup_ShipIsConfirm" id="popup_ShipConfirmFalse" checked />未确认
                        </span>
                    </li>

                </ul>
            </div>
            <div class="modal-footer tishi_footer_tk">

                <button type="button" class="btn btn-primary" onclick="ShipJS.Save();">保存</button>
                <button type="button" class="btn btn-success" onclick="ShipJS.DoBack();">退回</button>
            </div>
        </div>
    </div>
</div>


<script>
    var ShipJS = function ($) {

        $(document).ready(function () {
            ParamInit();
            Query();
        })

        var Param = {};
        var ParamInit = function () {
            Param.PageIndex = 1;
            Param.PageSize = 10;
            Param.TotalPage = 0;
            Param.TotalCount = 0;

            Param.ProjectName = $("input[name='txt_ShipName_Query']").val();
            Param.ShipIsConfirm = $("select[name='select_ShipConfirm_Query']").val();

        }

        //查询
        var Query = function () {

            //OpenMaskLayout();

            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();

            $.post('ShipListQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var ListHtml = '';
                            $(data.Data).each(function (index, dom) {

                                var ShipConfirmClass = '';
                                if (dom.IsConfirm == true) {
                                    ShipConfirmClass = 'greencolor';
                                }
                                else
                                {
                                    ShipConfirmClass = 'redcolor';
                                }

                                ListHtml += '<tr><td>' + dom.ShipName + '</td><td class="' + ShipConfirmClass + '">' + dom.ShipConfirm + '</td><td><button type="button" class="btn btn-primary-s" onclick="ShipJS.Edit(' + dom.ID + ');"><i class="icon iconfont table_icon">&#xe66e;</i>编辑</button></td></tr>';

                            })
                            $('#html_ShipList').html(ListHtml);

                            //分页
                            Param.TotalPage = data.TotalPage;
                            Param.TotalCount = data.TotalCount;
                            Param.PageIndex = data.PageIndex;

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                    Pagination();
                    //CloseMaskLayout();
                });

        }

        var DoQuery = function () {

            Param.ShipIsConfirm = $("select[name='select_ShipConfirm_Query']").val();
            Param.ShipName = $("input[name='txt_ShipName_Query']").val();
            Query();
        }

        //分页
        var Pagination = function () {
            $("#Pagination").pagination({
                currentPage: Param.PageIndex,
                totalPage: Param.TotalPage,
                isShow: true,
                totalCount: Param.TotalCount,
                count: 7,
                homePageText: "首页",
                endPageText: "尾页",
                prevPageText: "上一页",
                nextPageText: "下一页",
                callback: function (current) {
                    Param.PageIndex = current;
                    Query();
                }
            });
        }

        //打开模态框
        var Save = function () {

            ModalPopup('information', '是否保存?');

            $("#ModalSubmit").unbind('click').bind('click', function () {
                SaveData();
            });
        }

        //保存
        var SaveData = function () {

            DataModalCreate();
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('ShipDataSave', Param)
                .success(function (data, statusText, jqXRH) {

                    if (data) {

                        if (data.Success) {
                            ModalPopup('success', '保存成功');
                            $('#Tk_ShipDetail').modal('hide');
                            DoQuery();
                        }
                        else {

                            ModalPopup('error', data.Message);
                        }


                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                    ModalClose('information');
                });
        }


        //编辑
        var Edit = function (ID) {

            if (ID == null || ID == '' || ID == 0)
                return;

            DataModalClear();
            Param.ShipID = ID;
            $('#Tk_ShipDetail').modal('show');
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('ShipDataQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            var ShipInfo = data.Data;

                            $('#popup_LibraryShipID').val(ShipInfo.ID);
                            $('#popup_LibraryShipInfoName').html(ShipInfo.ShipName);
                            $('#popup_Ship_ZTZJ').val(ShipInfo.ZTZJ);
                            $('#popup_Ship_ZTJMJ').val(ShipInfo.ZTJMJ);
                            $('#popup_Ship_ZTZC').val(ShipInfo.ZTZC);
                            $('#popup_Ship_ZXCD').val(ShipInfo.ZXCD);
                            $('#popup_Ship_ZXKD').val(ShipInfo.ZXKD);
                            $('#popup_Ship_ZXGD').val(ShipInfo.ZXGD);
                            $('#popup_Ship_ZXMJ').val(ShipInfo.ZXMJ);
                            $('#popup_Ship_ZXZDJMZC').val(ShipInfo.ZXZDJMZC);
                            $('#popup_Ship_ZXTJ').val(ShipInfo.ZXTJ);
                            $('#popup_Ship_ZTZXZZ').val(ShipInfo.ZTZXZZ);
                            $('#popup_Ship_ZTYYL').val(ShipInfo.ZTYYL);
                            $('#popup_Ship_JSYYHZ').val(ShipInfo.JSYYHZ);
                            $('#popup_Ship_BZL').val(ShipInfo.BZL);
                            $('#popup_Ship_DDBY').val(ShipInfo.DDBY);
                            $('#popup_Ship_YXZTCD').val(ShipInfo.YXZTCD);
                            $('#popup_Ship_QX').val(ShipInfo.QX);
                            $('#popup_Ship_ZTYXCD').val(ShipInfo.ZTYXCD);

                            if (ShipInfo.IsConfirm == true) {
                                $('#popup_ShipConfirmTrue').prop('checked', true);
                            }
                            else
                            {
                                $('#popup_ShipConfirmFalse').prop('checked', true);
                            }

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {

                });

        }

        //数据生成
        var DataModalCreate = function () {

            Param.ShipID = $('#popup_LibraryShipID').val();

            Param.Ship_ZTZJ = $('#popup_Ship_ZTZJ').val();
            Param.Ship_ZTJMJ = $('#popup_Ship_ZTJMJ').val();
            Param.Ship_ZTZC = $('#popup_Ship_ZTZC').val();
            Param.Ship_ZXCD = $('#popup_Ship_ZXCD').val();
            Param.Ship_ZXKD = $('#popup_Ship_ZXKD').val();
            Param.Ship_ZXGD = $('#popup_Ship_ZXGD').val();
            Param.Ship_ZXMJ = $('#popup_Ship_ZXMJ').val();
            Param.Ship_ZXZDJMZC = $('#popup_Ship_ZXZDJMZC').val();
            Param.Ship_ZXTJ = $('#popup_Ship_ZXTJ').val();
            Param.Ship_ZTZXZZ = $('#popup_Ship_ZTZXZZ').val();
            Param.Ship_ZTYYL = $('#popup_Ship_ZTYYL').val();
            Param.Ship_JSYYHZ = $('#popup_Ship_JSYYHZ').val();
            Param.Ship_BZL = $('#popup_Ship_BZL').val();
            Param.Ship_DDBY = $('#popup_Ship_DDBY').val();
            Param.Ship_YXZTCD = $('#popup_Ship_YXZTCD').val();
            Param.Ship_QX = $('#popup_Ship_QX').val();
            Param.Ship_ZTYXCD = $('#popup_Ship_ZTYXCD').val();

            Param.IsConfirm = $('#popup_ShipConfirmTrue').prop('checked');

        }

        //清除模态框
        var DataModalClear = function () {

            $('#popup_LibraryShipID').html(0);

            $('#popup_Ship_ZTZJ').val('');
            $('#popup_Ship_ZTJMJ').val('');
            $('#popup_Ship_ZTZC').val('');
            $('#popup_Ship_ZXCD').val('');
            $('#popup_Ship_ZXKD').val('');
            $('#popup_Ship_ZXGD').val('');
            $('#popup_Ship_ZXMJ').val('');
            $('#popup_Ship_ZXZDJMZC').val('');
            $('#popup_Ship_ZXTJ').val('');
            $('#popup_Ship_ZTZXZZ').val('');
            $('#popup_Ship_ZTYYL').val('');
            $('#popup_Ship_JSYYHZ').val('');
            $('#popup_Ship_BZL').val('');
            $('#popup_Ship_DDBY').val('');
            $('#popup_Ship_YXZTCD').val('');
            $('#popup_Ship_QX').val('');
            $('#popup_Ship_ZTYXCD').val('');

        }



        var DoBack = function () {

            $('#Tk_ShipDetail').modal('hide');

        }

        return {
            HomeSiteInit: function () {
                Init();
            },
            DoQuery: DoQuery,
            Edit: Edit,
            Save: Save,
            DoBack: DoBack,
            field: {

            }
        }

    }(jQuery);
</script>