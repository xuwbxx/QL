
@{
    ViewBag.Title = "分公司配置";
    Layout = "~/Views/Shared/BackManagePageLayout.cshtml";
}

<input type="hidden" id="hid_PostToken" value="@ViewData["PostToken"].ToString()" />

<div class="div_body">

    <div class="div_form">

        <form class="form-inline">
            <div class="form-group">
                <input type="text" class="form-control" placeholder="请输入分公司名称" name="txt_CompanyName_Query">
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-primary" onclick="CompanyJS.DoQuery();"><i class="fa fa-search"></i></button>
            </div>
        </form>
    </div>

    <div class="div_btn">
        <button type="button" class="btn btn-success" data-toggle="modal" data-target="" onclick="CompanyJS.Add();"><i class="fa fa-plus zdy_icon"></i>新增</button>
    </div>

    <div class="div_table">
        <table class="table table-hover table_chongzhi">
            <thead>
                <tr>
                    <th width="50%">公司名称</th>
                    <th width="25%">项目总工</th>
                    <th width="25%">操作</th>
                </tr>
            </thead>
            <tbody id="html_CompanyList">
            </tbody>

        </table>



    </div>
</div>


<div class="modal fade" id="tk_Company" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-dialog-m" style="margin-top:25vh;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h4 class="modal-title">
                    分公司编辑
                </h4>
            </div>
            <div class="modal-body">


                <form class="clearfix">

                    <div class="col-md-12 mar_b10">
                        <label class="tk_label">
                            公司名称
                        </label>
                        <div class="tk_div_input">
                            <input class="form-control" type="text" placeholder="请输入分公司姓名" name="txt_CompanyName">
                        </div>
                    </div>
                    <div class="col-md-12 mar_b10">
                        <label class="tk_label">
                            项目总工
                        </label>
                        <div class="tk_div_input">
                            <ul class="pejd_user" id="popup_htmlProjectRole">
                                <li class="clearfix">
                                    <span>
                                        <div class="nice-select">
                                            <input type="text" class="form-control" value="" autocomplete="off" id="popup_MajorEngName" data-UserName="" data-UserCode="" data-UserDepart="" data-UserPhone="" data-UserJobName="">
                                            <div class="search_div" onclick="CompanyJS.ClearUser();"><i class="fa fa-close"></i></div>

                                            <ul id="popup_ul_MajorEngList">
                                            </ul>

                                        </div>
                                    </span>
                                    <span>
                                        <button type="button" class="btn btn-primary" onclick="CompanyJS.FindUser();"><i class="fa fa-search"></i>搜索</button>
                                        <button type="button" class="btn btn-danger" onclick="CompanyJS.DeleteUser();"><i class="fa fa-trash-o"></i>删除</button>
                                    </span>
                                </li>
                                
                            </ul>
                        </div>
                    </div>
                    
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="CompanyJS.Save();"><i class="fa fa-arrow-down"></i>保存</button>
                <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-reply"></i>返回</button>
            </div>
        </div>
    </div>
</div>


<script>
    var CompanyJS = function ($) {

        $(document).ready(function () {
            ParamInit();
            Query();
        })

        var Param = {};
        var ParamInit = function () {
            Param.PageIndex = 1;
            Param.PageSize = 10;
            Param.TotalPage = 0;
            Param.TotalCount = 0;

            Param.CompanyName = $("input[name='txt_CompanyName_Query']").val();

        }

        //查询
        var Query = function () {

            //OpenMaskLayout();
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('CompanyListQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var DataListHtml = '';
                            $(data.Data).each(function (index, dom) {

                                var MajorEngName = '';
                                if (dom.MajorEng != null && dom.MajorEng.UserName != '')
                                {
                                    MajorEngName = dom.MajorEng.UserName;
                                }

                                DataListHtml += '<tr><td>' + dom.Company + '</td><td>' + MajorEngName + '</td><td><button type="button" class="btn btn-primary-s" onclick="CompanyJS.Edit(' + dom.ID + ')"><i class="fa fa-eye table_icon"></i>编辑</button></td></tr>';

                            });

                            $('#html_CompanyList').html(DataListHtml);

                            //分页
                            Param.TotalPage = data.TotalPage;
                            Param.TotalCount = data.TotalCount;
                            Param.PageIndex = data.PageIndex;

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                    Pagination();
                    //CloseMaskLayout();
                });

        }

        var DoQuery = function () {

            Param.CompanyName = $("input[name='txt_CompanyName_Query']").val();
            Query();
        }

        //分页
        var Pagination = function () {
            $("#Pagination").pagination({
                currentPage: Param.PageIndex,
                totalPage: Param.TotalPage,
                isShow: true,
                totalCount: Param.TotalCount,
                count: 7,
                homePageText: "首页",
                endPageText: "尾页",
                prevPageText: "上一页",
                nextPageText: "下一页",
                callback: function (current) {
                    Param.PageIndex = current;
                    Query();
                }
            });
        }

        //新增
        var Add = function () {

            DataModalClear();

            Param.ID = 0;

            $('#tk_Company').modal('show');


        }

        //打开模态框
        var Save = function () {

            ModalPopup('information', '是否保存?');

            $("#ModalSubmit").unbind('click').bind('click', function () {
                SaveData();
            });
        }

        //保存
        var SaveData = function () {

            DataModalCreate();
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('CompanyDataSave', Param)
                .success(function (data, statusText, jqXRH) {

                    if (data) {
                        //$('#myModal').modal('hide');

                        if (data.Success) {
                            ModalPopup('success', '保存成功');
                            $('#tk_Company').modal('hide');
                            DoQuery();
                        }
                        else {

                            ModalPopup('error', data.Message);
                        }


                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                    ModalClose('information');
                });
        }

        //打开删除提示框
        //var Delete = function (dom) {
        //    if (dom == null) {
        //        return;
        //    }
        //    var ID = $(dom).attr('data-id');
        //    var Name = $(dom).attr('data-name');
        //    ModalPopup('information', '是否删除 ' + Name + " ?");



        //    $("#ModalSubmit").bind('click', function () {
        //        var DeleteParam = {};
        //        DeleteParam.ID = ID;
        //        DoDelete(DeleteParam);
        //    })

        //}

        //删除数据
        //var DoDelete = function (dom) {

        //    $.post('DataDelete', dom)
        //        .success(function (data, statusText, jqXRH) {
        //            if (data) {
        //                if (data.Success) {
        //                    ModalPopup('success', '删除成功');
        //                    DoQuery();
        //                }
        //                else {
        //                    ModalPopup('error', data.Message);
        //                }
        //            }
        //        })
        //        .fail(function (jqXHR, statusText, errorMessage) {
        //            //console.error(arguments);
        //        })
        //        .always(function (data) {
        //            ModalClose('information');
        //        });
        //}

        //编辑
        var Edit = function (ID) {

            if (ID == null || ID == '' || ID == 0)
                return;

            DataModalClear();
            Param.ID = ID;
            $('#tk_Company').modal('show');
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('CompanyDataQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            var Company = data.Data;
                            $('input[name="txt_CompanyName"]').val(Company.Company);

                            var MajorEng = Company.MajorEng;
                            $('#popup_MajorEngName').val(MajorEng.UserName + '(' + MajorEng.UserDepartName + ')');
                            $('#popup_MajorEngName').attr('data-UserName', MajorEng.UserName);
                            $('#popup_MajorEngName').attr('data-UserCode', MajorEng.UserCode);
                            $('#popup_MajorEngName').attr('data-UserDepart', MajorEng.UserDepartName);
                            $('#popup_MajorEngName').attr('data-UserPhone', MajorEng.UserPhone);
                            $('#popup_MajorEngName').attr('data-UserJobName', MajorEng.UserJobName);

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {

                });

        }

        //数据生成
        var DataModalCreate = function () {

            Param.CompanyName = $('input[name="txt_CompanyName"]').val();

            //$('#popup_MajorEngName').attr('data-UserName', '');
            //$('#popup_MajorEngName').attr('data-UserCode', '');
            //$('#popup_MajorEngName').attr('data-UserDepart', '');
            //$('#popup_MajorEngName').attr('data-UserPhone', '');
            //$('#popup_MajorEngName').attr('data-UserJobName', '');

            var User = {};
            User.UserName = $('#popup_MajorEngName').attr('data-UserName');
            User.UserCode = $('#popup_MajorEngName').attr('data-UserCode');
            User.UserDepartName = $('#popup_MajorEngName').attr('data-UserDepart');
            User.UserPhone = $('#popup_MajorEngName').attr('data-UserPhone');
            User.UserJobName = $('#popup_MajorEngName').attr('data-UserJobName');

            Param.NodeManagers = [];
            Param.NodeManagers.push(User);

        }

        //清除模态框
        var DataModalClear = function () {

            //清除txt
            $('input[name="txt_CompanyName"]').val('');

            ClearUser();

        }

        var FindUser = function () {

            var UserName = $('#popup_MajorEngName').val();
            if (UserName == '')
                return;

            Param.Name = UserName;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('/Cloud/Base/FindShjUser', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var ShjUsertml = '';
                            $(data.Data).each(function (index, dom) {

                                ShjUsertml += '<li onclick="CompanyJS.ChooseUser(this);" data-usercode="' + dom.empcode + '" data-name="' + dom.name + '" data-depart="' + dom.wholeDeptPath + '" data-phone="' + dom.phone + '" data-jobname="' + dom.jobname + '" ><h3>' + dom.name + '(' + dom.jobname + ')</h3><div>' + dom.wholeDeptPath + '</div></li >';

                            });
                            $('#popup_ul_MajorEngList').show().html(ShjUsertml);

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                    Pagination();
                });

        }

        var ChooseUser = function (dom) {

            if (dom == null)
                return;

            var Name = $(dom).attr('data-name');
            var UserCode = $(dom).attr('data-usercode');
            var Depart = $(dom).attr('data-depart');
            var Phone = $(dom).attr('data-phone');
            var JobName = $(dom).attr('data-jobname');

            var UserDom = $(dom).parent().parent().children().first();

            $(UserDom).val(Name + '(' + Depart + ')');

            $(UserDom).attr('data-UserName', Name);
            $(UserDom).attr('data-UserCode', UserCode);
            $(UserDom).attr('data-UserDepart', Depart);
            $(UserDom).attr('data-UserPhone', Phone);
            $(UserDom).attr('data-UserJobName', JobName);

            $(dom).parent().hide();

        }

        var ClearUser = function (dom) {

            $('#popup_MajorEngName').attr('data-UserName', '');
            $('#popup_MajorEngName').attr('data-UserCode', '');
            $('#popup_MajorEngName').attr('data-UserDepart', '');
            $('#popup_MajorEngName').attr('data-UserPhone', '');
            $('#popup_MajorEngName').attr('data-UserJobName', '');

            $('#popup_MajorEngName').val('');

        }

        var DeleteUser = function () {

            $('#popup_MajorEngName').attr('data-UserName', '');
            $('#popup_MajorEngName').attr('data-UserCode', '');
            $('#popup_MajorEngName').attr('data-UserDepart', '');
            $('#popup_MajorEngName').attr('data-UserPhone', '');
            $('#popup_MajorEngName').attr('data-UserJobName', '');

            $('#popup_MajorEngName').val('');

        }


        return {
            HomeSiteInit: function () {
                Init();
            },
            DoQuery: DoQuery,
            Edit: Edit,
            Save: Save,
            Add: Add,
            FindUser: FindUser,
            ChooseUser: ChooseUser,
            ClearUser: ClearUser,
            DeleteUser: DeleteUser,
            field: {

            }
        }

    }(jQuery);
</script>
