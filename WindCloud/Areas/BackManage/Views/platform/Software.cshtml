
@{
    ViewBag.Title = "软件配置";
    Layout = "~/Views/Shared/BackManagePageLayout.cshtml";
}

<input type="hidden" id="hid_PostToken" value="@ViewData["PostToken"].ToString()" />

<div class="div_body">

    <div class="div_form">

        <form class="form-inline">
            <div class="form-group">
                <input type="text" class="form-control" placeholder="请输入软件名称" name="txt_SoftwareName_Query">
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-primary"><i class="fa fa-search"></i></button>
            </div>
        </form>
    </div>



    <div class="div_table">
        <table class="table table-hover table_chongzhi">
            <thead>
                <tr>
                    <th width="25%">软件名称</th>
                    <th width="25%">软件类型</th>
                    <th width="25%">软件地址</th>
                    <th width="25%">操作</th>
                </tr>
            </thead>
            <tbody id="html_SoftwareList">
                
            </tbody>

        </table>



    </div>
</div>


<div class="modal fade" id="tk_Software" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-dialog-s">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h4 class="modal-title">
                    海上风电WebGIS平台
                </h4>
            </div>
            <div class="modal-body">


                <form class="clearfix">

                    <div class="col-md-12 mar_b10">
                        <label class="tk_label">
                            软件名称
                        </label>
                        <div class="tk_div_input">
                            <input class="form-control" type="text" placeholder="请输入姓名" name="txt_SoftwareName" disabled>
                        </div>
                    </div>
                    <div class="col-md-12 mar_b10">
                        <label class="tk_label">
                            所属部门
                        </label>
                        <div class="tk_div_input">
                            <select class="form-control" name="select_Depart">
                                <option value="0">请选择</option>
                                <option value="1">技术中心总部</option>
                                <option value="2">总部领导</option>
                                <option value="3">风电所</option>
                                <option value="4">岩土所</option>
                                <option value="5">BIM所</option>
                                <option value="6">装备所</option>
                                <option value="7">结构所</option>
                                <option value="8">桥梁所</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-12 mar_b10">
                        <label class="tk_label">
                            软件类型
                        </label>
                        <div class="tk_div_input">
                            <select class="form-control" name="select_FlowType">
                                <option value="0">项目申请类</option>
                                <option value="1">软件委托型</option>
                                <option value="2">软件使用类</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-12 mar_b10">
                        <label class="tk_label">
                            软件地址
                        </label>
                        <div class="tk_div_input">
                            <input class="form-control" type="text" placeholder="请输入软件地址" name="txt_SoftwareUrl">
                        </div>
                    </div>
                    <div class="col-md-12 mar_b10">
                        <label class="tk_label">
                            软件简介
                        </label>
                        <div class="tk_div_input">
                            <textarea class="form-control" rows="6" name="txt_SoftwareComment"></textarea>
                        </div>
                    </div>
                </form>

            </div>
            <div class="modal-footer">
                @*<button type="button" class="btn btn-primary"><i class="fa fa-arrow-down"></i>保存</button>*@
                <button type="button" class="btn btn-default" data-dismiss="modal"><i class="fa fa-reply"></i>返回</button>
            </div>
        </div>
    </div>
</div>



<script>
    var SoftwareJS = function ($) {

        $(document).ready(function () {
            ParamInit();
