        //编辑
        var Edit = function (ID) {

            if (ID == null || ID == '' || ID == 0)
                return;

            DataModalClear();
            Param.ID = ID;
            $('#tk_Software').modal('show');
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('SoftwareDataQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            var Software = data.Data;
                            $('input[name="txt_SoftwareName"]').val(Software.SoftwareName);
                            $('input[name="txt_SoftwareUrl"]').val(Software.SoftwareUrl);
                            $('[name="txt_SoftwareComment"]').val(Software.SoftwareComment);
                            $('select[name="select_Depart"]').val(Software.DepartID);
                            $('select[name="select_FlowType"]').val(Software.FlowType);
