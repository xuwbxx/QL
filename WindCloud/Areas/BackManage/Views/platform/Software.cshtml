        })

        var Param = {};
        var ParamInit = function () {
            Param.PageIndex = 1;
            Param.PageSize = 10;
            Param.TotalPage = 0;
            Param.TotalCount = 0;

            Param.SoftwareName = $("input[name='txt_SoftwareName_Query']").val();

        }

        //查询
        var Query = function () {

            //OpenMaskLayout();
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('SoftwareListQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var DataListHtml = '';
                            $(data.Data).each(function (index, dom) {

                                DataListHtml += '<tr><td>' + dom.SoftwareName + '</td><td>' + dom.FlowTypeName + '</td><td>' + dom.SoftwareUrl + '</td><td><button type="button" class="btn btn-primary-s" onclick="SoftwareJS.Edit(' + dom.ID + ')"><i class="fa fa-eye table_icon"></i>查看</button></td></tr>';
                                
                            });

                            $('#html_SoftwareList').html(DataListHtml);

                            //分页
                            Param.TotalPage = data.TotalPage;
                            Param.TotalCount = data.TotalCount;
                            Param.PageIndex = data.PageIndex;

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                    Pagination();
                    //CloseMaskLayout();
                });

        }

        var DoQuery = function () {

            Param.Name = $("input[name='txt_SoftwareName_Query']").val();
            Query();
        }

