
@{
    ViewBag.Title = "节点配置";
    Layout = "~/Views/Shared/BackManagePageLayout.cshtml";
}

@{ 
    var SoftwareList = ViewData["SoftwareList"] as List<DataFactory.KingBase.CloudWind.Manage_Software>;
}

<input type="hidden" id="hid_PostToken" value="@ViewData["PostToken"].ToString()" />

<div class="div_body">

    <div class="div_form">

        <form class="form-inline">
            <div class="form-group">
                <input type="text" class="form-control" placeholder="请输入节点名称" name="txt_NodeName_Query">
            </div>
            <div class="form-group">
                <select class="form-control" name="select_Software_Query">
                    <option value="0">请选择软件</option>
                    @{ 
                        foreach (var item in SoftwareList)
                        {
                            <option value="@item.ID">@item.SoftwareName</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-primary" onclick="NodeJS.DoQuery();">
                    <i class="fa fa-search"></i>
                </button>
            </div>
        </form>
    </div>



    <div class="div_table">
        <table class="table table-hover table_chongzhi">
            <thead>
                <tr>
                    <th width="20%">节点名称</th>
                    <th width="20%">所属软件</th>
                    <th width="13%">是否已配置人员</th>
                    <th width="13%">节点是否可编辑</th>
                    <th width="13%">是否单人审批通过</th>
                    <th width="20%">操作</th>
                </tr>
            </thead>
            <tbody id="html_NodeList">
                <tr>
                    <td>项目部业务员申请</td>
                    <td class="greencolor">是</td>
                    <td>节点类型</td>
                    <td>
                        <button type="button" class="btn btn-primary-s" onClick="PopupConfiguration();"><i class="icon iconfont table_icon">&#xe66e;</i>配置节点人员</button>
                    </td>
                </tr>
                <tr>
                    <td>项目部总工审批</td>
                    <td class="redcolor">否</td>
                    <td>节点类型</td>
                    <td>
                        <button type="button" class="btn btn-primary-s"><i class="icon iconfont table_icon">&#xe66e;</i>配置节点人员</button>
                    </td>
                </tr>

            </tbody>

        </table>

        <div class="text-center">

            <div id="Pagination">
            </div>
        </div>

    </div>
</div>

