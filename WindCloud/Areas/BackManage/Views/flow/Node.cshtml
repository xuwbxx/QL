<script>
    var NodeJS = function ($) {

        $(document).ready(function () {
            ParamInit();
            Query();
        })

        var Param = {};
        var ParamInit = function () {
            Param.PageIndex = 1;
            Param.PageSize = 10;
            Param.TotalPage = 0;
            Param.TotalCount = 0;

            Param.NodeName = $("input[name='txt_NodeName_Query']").val();
            Param.SoftwareID = $("select[name='select_Software_Query']").val();

        }

        //查询
        var Query = function () {

            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('NodeListQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var DataListHtml = '';
                            $(data.Data).each(function (index, dom) {

                                var ManagerCss = '';
                                var ManagerContent = '';
                                if (dom.ManagerIsSetting == true) {
                                    ManagerContent = '是';
                                    ManagerCss = 'greencolor';
                                }
                                else {
                                    ManagerContent = '否';
                                    ManagerCss = 'redcolor';
                                }
                                var EditContent = '';
                                if (dom.DoEdit == true) {
                                    EditContent = '可编辑';
                                }
                                else
                                {
                                    EditContent = '不可编辑';
                                }
                                var NodeApprovalContent = '';
                                if (dom.NodeApprovalType == true) {
                                    NodeApprovalContent = '可单人审批通过';
                                }
                                else {
                                    NodeApprovalContent = '不可单人审批通过';
                                }

                                DataListHtml += '<tr><td>' + dom.NodeName + '</td><td>' + dom.SoftwareName + '</td><td class="' + ManagerCss + '">' + ManagerContent + '</td><td>' + EditContent + '</td><td>' + NodeApprovalContent + '</td><td><button type="button" class="btn btn-primary-s" onclick="NodeJS.Edit(' + dom.ID + ');"><i class="icon iconfont table_icon">&#xe66e;</i>配置节点人员</button></td></tr>';
                                
                            });

                            $('#html_NodeList').html(DataListHtml);

                            //分页
                            Param.TotalPage = data.TotalPage;
                            Param.TotalCount = data.TotalCount;
                            Param.PageIndex = data.PageIndex;

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                    Pagination();
                    //CloseMaskLayout();
                });

        }

        var DoQuery = function () {

            Param.NodeName = $("input[name='txt_NodeName_Query']").val();
            Param.SoftwareID = $("select[name='select_Software_Query']").val();
            Query();
        }

        //分页
        var Pagination = function () {
            $("#Pagination").pagination({
                currentPage: Param.PageIndex,
                totalPage: Param.TotalPage,
                isShow: true,
                totalCount: Param.TotalCount,
                count: 7,
                homePageText: "首页",
                endPageText: "尾页",
                prevPageText: "上一页",
                nextPageText: "下一页",
                callback: function (current) {
                    Param.PageIndex = current;
                    Query();
                }
            });
        }

        //新增
        //var Add = function () {

        //    DataModalClear();

        //    Param.ID = 0;

        //    $('#Modal_Software').modal('show');


        //}

        //打开模态框
        var Save = function () {

            ModalPopup('information', '是否保存?');

            $("#ModalSubmit").unbind('click').bind('click', function () {
                SaveData();
            });
        }

        //保存
        var SaveData = function () {

            DataModalCreate();

            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('DataSave', Param)
                .success(function (data, statusText, jqXRH) {

                    if (data) {
                        //$('#myModal').modal('hide');

                        if (data.Success) {
                            ModalPopup('success', '保存成功');
                            $('#Modal_Account').modal('hide');
                            $('#tk_Configuration').modal('hide');
                            DoQuery();
                        }
                        else {

                            ModalPopup('error', data.Message);
                        }


                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                    ModalClose('information');
                });
        }

        //打开删除提示框
        //var Delete = function (dom) {
        //    if (dom == null) {
        //        return;
        //    }
        //    var ID = $(dom).attr('data-id');
