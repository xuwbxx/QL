        //编辑
        var Edit = function (ID) {

            if (ID == null || ID == '' || ID == 0)
                return;

            DataModalClear();
            Param.ID = ID;
            $('#tk_Configuration').modal('show');
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('NodeDataQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            $('#popup_NodeName').html(data.Data.NodeName);

                            $('#hid_NodeID').val(data.Data.ID);

                            var html_NodeManager = '';
                            $(data.Data.NodeManagers).each(function (index, dom) {

                                html_NodeManager += '<li class="clearfix"><span><div class="nice-select"><input type="text" class="form-control" data-UserName="' + dom.ManageName + '" data-UserCode="' + dom.ManageUserCode + '" data-UserDepart="' + dom.ManageDepart + '" data-UserPhone="' + dom.ManagePhone + '" data-UserJobName="' + dom.ManageJobName + '" value="'  + dom.ManageName + '(' + dom.ManageDepart + ')"><div class="search_div" onclick="NodeJS.ClearManager(this);"><i class="fa fa-close"></i></div><ul></ul></div></span>'
                                    + '<span><button type="button" class="btn btn-primary" onclick="NodeJS.FindUser(this);"><i class="fa fa-search"></i>搜索</button><button type="button" class="btn btn-danger" onclick="NodeJS.DeleteManager(this);"><i class="fa fa-trash-o"></i>删除</button></span></li>';

                            })

                            if (data.Data.DoEdit) {
                                $('#popup_NodeDoEditTrue').prop('checked', true);
                            }
                            else
                            {
                                $('#popup_NodeDoEditFalse').prop('checked', true);
                            }

                            if (data.Data.NodeApprovalType) {
                                $('#popup_NodeApprovalTypeTrue').prop('checked', true);
                            }
                            else {
                                $('#popup_NodeApprovalTypeFalse').prop('checked', true);
                            }

                            $('#popup_htmlNodeManager').html(html_NodeManager);
                            
                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {

                });

        }

        //数据生成
        var DataModalCreate = function () {

            Param.NodeID = $('#hid_NodeID').val();

            Param.NodeApprovalType = $('#popup_NodeApprovalTypeTrue').prop('checked');

            Param.NodeDoEdit = $('#popup_NodeDoEditTrue').prop('checked');

            var NodeManagers = [];

            $('#popup_htmlNodeManager li.clearfix').each(function (index, dom) {

                var ManagerDom = $(dom).find('input.form-control').first();

                if (ManagerDom != null && (ManagerDom).attr('data-usercode') != null && $(ManagerDom).attr('data-usercode') != '')
                {
                    var Manager = {};
                    Manager.UserName = $(ManagerDom).attr('data-UserName');
                    Manager.UserCode = $(ManagerDom).attr('data-UserCode');
                    Manager.UserDepartName = $(ManagerDom).attr('data-UserDepart');
                    Manager.UserPhone = $(ManagerDom).attr('data-UserPhone');
                    Manager.UserJobName = $(ManagerDom).attr('data-UserJobName');
                    NodeManagers.push(Manager);
                }

            })

            Param.NodeManagers = NodeManagers;

        }

        //清除模态框
        var DataModalClear = function () {

            $('#popup_NodeDoEditFalse').prop('checked', true);
            $('#popup_NodeApprovalTypeFalse').prop('checked', true);
            $('#popup_htmlNodeManager').html('');

        }



        var AddManager = function () {

            var NewHtml = '<li class="clearfix"><span><div class="nice-select"><input type="text" class="form-control" data-UserName="" data-UserCode="" data-UserDepart="" data-UserPhone="" data-UserJobName="" value=""><div class="search_div" onclick="NodeJS.ClearManager(this);"><i class="fa fa-close"></i></div><ul></ul></div></span>'
                + '<span><button type="button" class="btn btn-primary" onclick="NodeJS.FindUser(this);"><i class="fa fa-search"></i>搜索</button><button type="button" class="btn btn-danger" onclick="NodeJS.DeleteManager(this);"><i class="fa fa-trash-o"></i>删除</button></span></li>';

            $('#popup_htmlNodeManager').append(NewHtml);

        }

        var ClearManager = function (dom) {

            $(dom).prev('input').val('');

        }

        var DeleteManager = function (dom) {

            $(dom).parent().parent().remove();

        }

        var DoBack = function () {

            $('#tk_Configuration').modal('hide');

        }

        var FindUser = function (dom) {

            var UserName = $(dom).parent().prev().children().children().first().val();
            if (UserName == null || UserName == '')
                return;

            var ShjUserDom = $(dom).parent().prev().children().children('ul');

            $(ShjUserDom).html('');

            Param.Name = UserName;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('/Cloud/Base/FindShjUser', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var ShjUsertml = '';
                            $(data.Data).each(function (index, dom) {

                                ShjUsertml += '<li onclick="NodeJS.ChooseUser(this);" data-usercode="' + dom.empcode + '" data-name="' + dom.name + '" data-depart="' + dom.wholeDeptPath + '" data-phone="' + dom.phone + '" data-jobname="' + dom.jobname + '" ><h3>' + dom.name + '(' + dom.jobname + ')</h3><div>' + dom.wholeDeptPath + '</div></li >';

                            });
                            $(ShjUserDom).show().html(ShjUsertml);
                           
                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                    Pagination();
                });

        }

        var ChooseUser = function (dom) {

            if (dom == null)
                return;

            var Name = $(dom).attr('data-name');
            var UserCode = $(dom).attr('data-usercode');
            var Depart = $(dom).attr('data-depart');
            var Phone = $(dom).attr('data-phone');
            var JobName = $(dom).attr('data-jobname');

            var UserDom = $(dom).parent().parent().children().first();

            $(UserDom).val(Name + '(' + Depart + ')');

            $(UserDom).attr('data-UserName', Name);
            $(UserDom).attr('data-UserCode', UserCode);
            $(UserDom).attr('data-UserDepart', Depart);
            $(UserDom).attr('data-UserPhone', Phone);
            $(UserDom).attr('data-UserJobName', JobName);

            $(dom).parent().hide();

        }

        return {
            HomeSiteInit: function () {
                Init();
            },
            DoQuery: DoQuery,
            Edit: Edit,
            AddManager: AddManager,
            ClearManager: ClearManager,
            DeleteManager: DeleteManager,
            FindUser: FindUser,
            ChooseUser: ChooseUser,
            Save: Save,
            DoBack: DoBack,
            field: {

            }
        }

    }(jQuery);
</script>
