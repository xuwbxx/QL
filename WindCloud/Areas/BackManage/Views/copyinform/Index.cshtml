
@{
    ViewBag.Title = "抄送通知";
    Layout = "~/Views/Shared/BackManagePageLayout.cshtml";
}

<input type="hidden" id="hid_PostToken" value="@ViewData["PostToken"].ToString()" />

@{
    var SoftwareList = ViewData["SoftwareList"] as List<DataFactory.KingBase.CloudWind.Manage_Software>;
}

<div class="div_body">

    <div class="div_form">

        <form class="form-inline">
            <div class="form-group">
                <input type="text" class="form-control" placeholder="请输入姓名" name="txt_CopyName_Query">
            </div>
            <div class="form-group">
                @*<input type="text" class="form-control" placeholder="请输入姓名" name="txt_CopyName_Query">*@
                <select class="form-control" id="select_Software_Query">
                    <option value="0">请选择软件</option>
                    @{
                        foreach (var item in SoftwareList)
                        {
                            <option value="@item.ID">@item.SoftwareName</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <button type="button" class="btn btn-primary" onclick="CopyInformJS.DoQuery();"><i class="fa fa-search"></i></button>
            </div>
        </form>
    </div>

    <div class="div_btn">
        <button type="button" class="btn btn-success" data-toggle="modal" data-target="" onclick="CopyInformJS.Add();"><i class="fa fa-plus zdy_icon"></i>新增</button>
    </div>

    <div class="div_table">
        <table class="table table-hover table_chongzhi">
            <thead>
                <tr>
                    <th>软件名</th>
                    <th>姓名</th>
                    <th>操作</th>
                </tr>
            </thead>
            <tbody id="html_CopyList">
            </tbody>

        </table>



    </div>
</div>

<!--配置节点人员弹框-->
<div class="modal fade" id="tk_Configuration" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog modal-dialog-s">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h4 class="modal-title" id="popup_ProjectName">
                    抄送通知
                </h4>
                <input type="hidden" id="hid_ProjectID" />
            </div>
            <div class="modal-body">

                @*<div class="div_btn mar_b20">
                        <button type="button" class="btn btn-primary" onclick="PlatRoleJS.AddRole();"><i class="fa fa-plus"></i>新增角色</button>
                    </div>*@
                <ul class="pejd_user" id="popup_htmlPlatRole">
                    <li class="clearfix">
                        <select class="form-control" id="popup_select_Software">
                            <option value="0">请选择软件</option>
                            @{
                                foreach (var item in SoftwareList)
                                {
                                    <option value="@item.ID">@item.SoftwareName</option>
                                }
                            }
                        </select>
                    </li>
                    
                    <li class="clearfix">
                        <span>
                            <div class="nice-select">
                                <input id="popup_txt_UserInfo" type="text" class="form-control" data-UserName="" data-UserCode="" data-UserDepart="" data-UserPhone="" data-UserJobName="" value="" autocomplete="off">
                                <div class="search_div" onclick="CopyInformJS.ClearRole(this);">
                                    <i class="fa fa-close"></i>
                                </div>
                                <ul></ul>
                            </div>
                        </span>
                        <span><button type="button" class="btn btn-primary" onclick="CopyInformJS.FindUser(this);"><i class="fa fa-search"></i>搜索</button></span>
                    </li>
                </ul>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="CopyInformJS.Save();"><i class="fa fa-arrow-down"></i>保存</button>
                <button type="button" class="btn btn-default" onclick="CopyInformJS.DoBack();"><i class="fa fa-reply"></i>返回</button>
            </div>
        </div>
    </div>
</div>

<script>
    var CopyInformJS = function ($) {

        $(document).ready(function () {
            ParamInit();
            Query();
        })

        var Param = {};
        var ParamInit = function () {
            Param.PageIndex = 1;
            Param.PageSize = 10;
            Param.TotalPage = 0;
            Param.TotalCount = 0;

            Param.Name = $("input[name='txt_CopyName_Query']").val();
            Param.SoftwareID = $("#select_Software_Query").val();
        }

        //查询
        var Query = function () {

            //OpenMaskLayout();
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('ListQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var DataListHtml = '';
                            $(data.Data).each(function (index, dom) {

                                DataListHtml += '<tr><td>' + dom.Software + '</td><td>' + dom.UserName + '</td><td><button type="button" class="btn btn-danger-s" data-id="' + dom.ID + '" data-name="' + dom.UserName + '" onclick="CopyInformJS.Delete(this)">删除</button></td></tr>';

                            });

                            $('#html_CopyList').html(DataListHtml);

                            //分页
                            Param.TotalPage = data.TotalPage;
                            Param.TotalCount = data.TotalCount;
                            Param.PageIndex = data.PageIndex;

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                    Pagination();
                    //CloseMaskLayout();
                });

        }

        var DoQuery = function () {

            Param.UserName = $("input[name='txt_CopyName_Query']").val();
            Param.SoftwareID = $("#select_Software_Query").val();
            Query();
        }

        //分页
        var Pagination = function () {
            $("#Pagination").pagination({
                currentPage: Param.PageIndex,
                totalPage: Param.TotalPage,
                isShow: true,
                totalCount: Param.TotalCount,
                count: 7,
                homePageText: "首页",
                endPageText: "尾页",
                prevPageText: "上一页",
                nextPageText: "下一页",
                callback: function (current) {
                    Param.PageIndex = current;
                    Query();
                }
            });
        }

        //新增
        var Add = function () {

            DataModalClear();

            Param.ID = 0;

            $('#tk_Configuration').modal('show');


        }


        //打开模态框
        var Save = function () {

            ModalPopup('information', '是否保存?');

            $("#ModalSubmit").unbind('click').bind('click', function () {
                SaveData();
            });
        }

        //保存
        var SaveData = function () {

            DataModalCreate();
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('DataSave', Param)
                .success(function (data, statusText, jqXRH) {

                    if (data) {
                        //$('#myModal').modal('hide');

                        if (data.Success) {
                            ModalPopup('success', '保存成功');
                            //$('#Modal_Account').modal('hide');
                            $('#tk_Configuration').modal('hide');
                            DoQuery();
                        }
                        else {

                            ModalPopup('error', data.Message);
                        }


                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                    ModalClose('information');
                });
        }

        //打开删除提示框
        var Delete = function (dom) {
            if (dom == null) {
                return;
            }
            var ID = $(dom).attr('data-id');
            var Name = $(dom).attr('data-name');
            ModalPopup('information', '是否删除 ' + Name + " ?");



            $("#ModalSubmit").unbind('click').bind('click', function () {
                var DeleteParam = {};
                DeleteParam.ID = ID;
                DoDelete(DeleteParam);
            })

        }

        //删除数据
        var DoDelete = function (dom) {

            $.post('DataDelete', dom)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {
                            ModalPopup('success', '删除成功');
                            DoQuery();
                        }
                        else {
                            ModalPopup('error', data.Message);
                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                    ModalClose('information');
                });
        }

        //数据生成
        var DataModalCreate = function () {

            //Param.ProjectID = $('#hid_ProjectID').val();

            Param.SoftwareID = $('#popup_select_Software').val();

            var NodeManagers = [];

            var User = {};

            User.UserName = $('#popup_txt_UserInfo').attr('data-UserName');
            User.UserCode = $('#popup_txt_UserInfo').attr('data-UserCode');
            User.UserDepartName = $('#popup_txt_UserInfo').attr('data-UserDepart');
            User.UserPhone = $('#popup_txt_UserInfo').attr('data-UserPhone');
            User.UserJobName = $('#popup_txt_UserInfo').attr('data-UserJobName');

            NodeManagers.push(User);

            Param.NodeManagers = NodeManagers;

        }

        //清除模态框
        var DataModalClear = function () {

            //清除txt
            $('#popup_select_Software').val(0);

            ClearUser();

        }

        var FindUser = function (dom) {

            var UserName = $(dom).parent().prev().children().last().children().first().val()
            if (UserName == null || UserName == '')
                return;

            var ShjUserDom = $(dom).parent().prev().children().children('ul');

            $(ShjUserDom).html('');

            Param.Name = UserName;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('/Cloud/Base/FindShjUser', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var ShjUsertml = '';
                            $(data.Data).each(function (index, dom) {

                                ShjUsertml += '<li onclick="CopyInformJS.ChooseUser(this);" data-usercode="' + dom.empcode + '" data-name="' + dom.name + '" data-depart="' + dom.wholeDeptPath + '" data-phone="' + dom.phone + '" data-jobname="' + dom.jobname + '" ><h3>' + dom.name + '(' + dom.jobname + ')</h3><div>' + dom.wholeDeptPath + '</div></li >';

                            });
                            $(ShjUserDom).show().html(ShjUsertml);

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                    Pagination();
                });

        }

        var ChooseUser = function (dom) {

            if (dom == null)
                return;

            var Name = $(dom).attr('data-name');
            var UserCode = $(dom).attr('data-usercode');
            var Depart = $(dom).attr('data-depart');
            var Phone = $(dom).attr('data-phone');
            var JobName = $(dom).attr('data-jobname');

            var UserDom = $(dom).parent().parent().children().first();

            $(UserDom).val(Name + '(' + Depart + ')');

            $(UserDom).attr('data-UserName', Name);
            $(UserDom).attr('data-UserCode', UserCode);
            $(UserDom).attr('data-UserDepart', Depart);
            $(UserDom).attr('data-UserPhone', Phone);
            $(UserDom).attr('data-UserJobName', JobName);

            $(dom).parent().hide();

        }

        var ClearUser = function (dom) {

            $('#popup_txt_UserInfo').attr('data-UserName', '');
            $('#popup_txt_UserInfo').attr('data-UserCode', '');
            $('#popup_txt_UserInfo').attr('data-UserDepart', '');
            $('#popup_txt_UserInfo').attr('data-UserPhone', '');
            $('#popup_txt_UserInfo').attr('data-UserJobName', '');

            $('#popup_txt_UserInfo').val('');

        }

        var DeleteUser = function () {

            $('#popup_txt_UserInfo').attr('data-UserName', '');
            $('#popup_txt_UserInfo').attr('data-UserCode', '');
            $('#popup_txt_UserInfo').attr('data-UserDepart', '');
            $('#popup_txt_UserInfo').attr('data-UserPhone', '');
            $('#popup_txt_UserInfo').attr('data-UserJobName', '');

            $('#popup_txt_UserInfo').val('');

        }

        var DoBack = function () {

            $('#tk_Configuration').modal('hide');

        }

        return {
            HomeSiteInit: function () {
                Init();
            },
            DoQuery: DoQuery,
            Save: Save,
            Add: Add,
            Delete: Delete,
            FindUser: FindUser,
            ChooseUser: ChooseUser,
            ClearUser: ClearUser,
            DeleteUser: DeleteUser,
            DoBack: DoBack,
            field: {

            }
        }

    }(jQuery);
</script>