@{
    Layout = "~/Views/Shared/TowingLayout.cshtml";
    ViewData["Title"] = "深远海风机安装拖航系统";
    var loginInfoStr = ViewData["LoginInfo"];
    var flashTimeStr = ViewData["FlashTime"];

    var pxyKey = ViewData["PXYKey"].ToString();
}
@section Styles {
    <link rel="stylesheet" type="text/css" href="~/Content/Towing/css/bootstrap.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/Towing/css/laydate.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/Towing/css/checkbox_radio.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/Towing/css/font-awesome.4.6.0.css" />

    <link rel="stylesheet" type="text/css" href="~/Content/Towing/css/towing_main_style.css?t=@DateTime.Now.ToString("yyyyMMddHHmmss")" />
    <script>
        var loginUser = @Html.Raw(loginInfoStr);
        var flashTime = @Html.Raw(flashTimeStr);
    </script>
}
@section Scripts {
    <script type="text/javascript" src="https://api.shipxy.com/h5/api/?v=3.0&k=@(pxyKey)"></script>
    <script type="text/javascript" src="~/Content/Towing/lib/leaflet/dist/leaflet-ant-path.js"></script>
    <script type="text/javascript" src="~/Content/Towing/js/checkbox.js"></script>
    <script type="text/javascript" src="~/Content/Towing/js/laydate.js"></script>
    <script type="text/javascript" src="~/Content/Towing/js/imgenlarge.js"></script>
    <script type="text/javascript" src="~/Content/Towing/Scripts/towing/towing_script.js?t=@DateTime.Now.ToString("yyyyMMddHHmmss")"></script>

}

<input type="hidden" id="PXYKey" value="@pxyKey" />

