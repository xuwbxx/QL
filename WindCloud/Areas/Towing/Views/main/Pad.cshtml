@{
    Layout = "~/Views/Shared/TowingPadLayout.cshtml";
    ViewData["Title"] = "深远海风机安装拖航系统";
    var loginInfoStr = ViewData["LoginInfo"];
    var flashTimeStr = ViewData["FlashTime"];

    var pxyKey = ViewData["PXYKey"].ToString();
}
@section Styles {
    <link rel="stylesheet" type="text/css" href="~/Content/PadTowing/css/ipad-style.css" />
    <link rel="stylesheet" type="text/css" href="~/Content/PadTowing/css/checkbox_radio.css" />
    <script>
        var loginUser = @Html.Raw(loginInfoStr);
        var flashTime = @Html.Raw(flashTimeStr);
    </script>
}
@section Scripts {
    <script type="text/javascript" src="https://api.shipxy.com/h5/api/?v=3.0&k=@(pxyKey)"></script>
    <script type="text/javascript" src="~/Content/PadTowing/lib/leaflet/dist/leaflet-ant-path.js"></script>
    <script type="text/javascript" src="~/Content/PadTowing/js/checkbox.js"></script>
    <script type="text/javascript" src="~/Content/PadTowing/js/imgenlarge.js"></script>
    <script type="text/javascript" src="~/Content/PadTowing/js/JSfontsize.js"></script>
    <script type="text/javascript" src="~/Content/PadTowing/Scripts/towing/towingPad_script.js?t=@DateTime.Now.ToString("yyyyMMddHHmmss")"></script>

}

<style>
    .leaflet-bottom {
        display: none;
    }
</style>

<input type="hidden" id="PXYKey" value="@pxyKey" />

<!--背景 start-->
<!--    <div class="bim-content"></div>-->
<!--背景 end-->
