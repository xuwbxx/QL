
@{
    ViewBag.Title = "登录";
    Layout = "~/Views/Shared/LoginLayout.cshtml";
}

<img class="sci-wheel" src="~/Content/Cloud/img/sci.gif">

<div class="login_k clearfix">
    <div class="text-center title-login">
        中交三航局技术中心<br />云平台中心
    </div>
    <h3 style="color:red;text-align:center;">@ViewData["Text"].ToString()</h3>
    <div class="box-login">
        <form action="/CCSHJ/Center/DoLogin">
            <div class="form-group">
                <input type="text" name="UserName" class="form-control input_login bg_user" placeholder="请输入用户名">
            </div>
            <div class="form-group">
                <input type="password" name="Password" class="form-control input_login bg_password" placeholder="请输入密码">
            </div>
            <div class="form-group">
                <button type="submit" class="btn-login">登录</button>
            </div>
        </form>
    </div>
</div>

<!--流星-->
<div class="liuxing liuxing1 liuxingFla"></div>
