
@{
    ViewBag.Title = "三航局技术中心风电数字化板块";
    Layout = "~/Views/Shared/WindDoorPadLayout.cshtml";
}

<header class="header_box">
    <span><img src="~/Content/Pad/img/logo.png">三航局技术中心风电数字化板块</span>


    <div class="login_user">
        <img src="~/Content/Pad/img/icon_user.png"><span>程伟</span>
    </div>
</header>


