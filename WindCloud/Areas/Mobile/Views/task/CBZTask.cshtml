<script>

    $(document).ready(function () {

        ParamInit();
        Query();
        LoadDKFile();
        LoadDKData();
        LoadShip();
    })

    var Param = {};
    var ParamInit = function () {
        Param.TaskID = $('#hid_TaskID').val();
    }

    var ClearTaskForm = function () {

        $('#txt_TaskName').val('');
        $('#html_dkyszlList').html('');
        $('#html_dksjbList').html('');
        $('#html_DKZL_CBZ').html('');
        $('#html_ShipList').html('');
        $('#DKFile_CBZ').html('');
        $('#DKFile_CBZ_JSCS').html('');
        $('#html_ShipFile_CBZ').html('');
        $('#html_ReportList').html('');
        $('#html_ModifyReportList').html('');
        /*$('#txt_DeliverTime').val('');*/
        $('#txt_LastNodeComment').val('');
        $('#txt_NextNode').html('');
        $('#ul_NextNodeUser').html('');
    }

    var Query = function () {

        //OpenMaskLayout();
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('TaskQuery_CBZ', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        var Task = data.Data;

                        $('#txt_TaskName').val(Task.TaskName);
                        //$('#txt_DeliverTime').val(Task.DeliverTime);
                        

                        var ReportFileHtml = '';
                        $(Task.Report.ReportFile).each(function (index, dom) {
                            ReportFileHtml += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a href="' + dom.FilePath + '" class="btn btn-primary" download="' + dom.FileName + '" >下载</a></td></tr>';
                        })
                        $('#html_ReportList').html(ReportFileHtml);

                        var ReportModifyFileHtml = '';
                        $(Task.Report.ReportModifyFile).each(function (index, dom) {
                            ReportModifyFileHtml += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a href="' + dom.FilePath + '" class="btn btn-primary" download="' + dom.FileName + '" >下载</a></td></tr>';
                        })
                        $('#html_ModifyReportList').html(ReportModifyFileHtml);

                        var CommentHtml = '';
                        $(Task.FlowInfo.LastNode).each(function (index, dom) {
                            CommentHtml += dom.UserName + ':' + dom.Comment + ';\n'
                        });
                        $('#txt_LastNodeComment').val(CommentHtml);

                        if (Task.FlowInfo.NextNodeID == 0) {
                            $('#txt_NextNode').html('流程结束');
                            $('#ul_NextNodeUser').html('');
                        }
                        else
                        {
                            $('#txt_NextNode').html(Task.FlowInfo.NodeName);
                            var NodeUserHtml = '';
                            $(Task.FlowInfo.Node).each(function (index, dom) {

                                NodeUserHtml += '<li><div>' + dom.UserName + '</div><div>（' + dom.UserDepart + '）</div></li>'

                            });
                            $('#ul_NextNodeUser').html(NodeUserHtml);
                        }

                    }

                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                //Pagination();
            });

    }

    var LoadDKFile = function () {

        var ProjectID = $('#hid_ProjectID').val();
        //if (ProjectID == null || ProjectID == '' || ProjectID == 0)
        //    return;
        var TaskID = $('#hid_TaskID').val();

        Param.ProjectID = ProjectID;
        Param.TaskID = TaskID;
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        //下一节点人员
        $.post('LoadDKFile', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {

                        var GeologyFile_dkyszl_Html = '';
                        $(data.Data.File_dkyszl).each(function (index, dom) {
                            GeologyFile_dkyszl_Html += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a href="' + dom.FilePath + '" class="xm_zt_green" download="' + dom.FileName + '">下载</a></td></tr>';
                        })
                        $('#html_dkyszlList').html(GeologyFile_dkyszl_Html);

                        var GeologyFile_dksjb_Html = '';
                        $(data.Data.File_dksjb).each(function (index, dom) {
                            GeologyFile_dksjb_Html += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a href="' + dom.FilePath + '" class="xm_zt_green" download="' + dom.FileName + '">下载</a></td></tr>';
                        })
                        $('#html_dksjbList').html(GeologyFile_dksjb_Html);

                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
            });

    }

    var LoadDKData = function () {

        var ProjectID = $('#hid_ProjectID').val();
        var TaskID = $('#hid_TaskID').val();
        if (ProjectID == null || ProjectID == '' || ProjectID == 0) {
            return;
        }
        if (TaskID == null || TaskID == '' || TaskID == 0) {
            return;
        }

        Param.ProjectID = ProjectID;
        Param.FlowHandle = 'view';
        Param.TaskID = TaskID;
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('LoadDKZL', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        var DKDataHtml = '<li><input type="checkbox" data-id="0" onclick="SoftwareCBZHelper.ChooseAllDKs(this);">选择所有</li>';
                        $(data.Data.DKs).each(function (index, dom) {

                            DKDataHtml += '<li><input type="checkbox" data-id="' + dom.ID + '" data-name="' + dom.DKName + '">' + dom.DKName + '</li>';

                        })

                        $('#html_DKZL_CBZ').html(DKDataHtml);

                        if (data.Data.File.FileName != null && data.Data.File.FilePath != null && data.Data.File.FileName != '' && data.Data.File.FilePath != '') {
                            $('#DKFile_CBZ').html(data.Data.File.FileName).attr('href', data.Data.File.FilePath).attr('download', data.Data.File.FileName);

                            $('#DKFile_CBZ_JSCS').html('计算参数.xlsx').attr('href', '\\File\\Task\\计算参数.xlsx').attr('download', '计算参数.xlsx');

                        }
                        
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
            });

    }


    var LoadShip = function () {

        Param.FlowHandle = 'view';
        Param.TaskID = $('#hid_TaskID').val();
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('LoadShip', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        var ShipHtml = '';
                        $(data.Data.Ships).each(function (index, dom) {

                            ShipHtml += '<li><input type="checkbox" data-id="' + dom.ID + '" data-name="' + dom.ShipName + '">' + dom.ShipName + '</li>';

                        })
                        $('#html_ShipList').html(ShipHtml);

                        var FileHtml = '';
                        $(data.Data.Files).each(function (index, dom) {

                            FileHtml += '<li><a href="' + dom.FilePath + '" download="' + dom.FileName + '">' + dom.FileName + '</a></li>';

                        })
                        $('#html_ShipFile_CBZ').html(FileHtml);

                        



                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
            });

    }


    var DoBack = function () {

        window.location.href = "Index";

    }


</script>