<script>

    $(document).ready(function () {

        ParamInit();
        Query();

    })

    var Param = {};
    var ParamInit = function () {
        Param.TaskID = $('#hid_TaskID').val();
    }

    var Query = function () {

        //OpenMaskLayout();
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('TaskQuery_KZY', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        var Task = data.Data;

                        $('#txt_TaskName').val(Task.TaskName);

                        $(Task.TaskInfo_KZY.ShipIDs).each(function (index, dom) {
                            $('#ul_ShipList input[data-id="' + dom + '"]').prop('checked', true);
                        });

                        $('#div_YFYNo').html(Task.TaskInfo_KZY.YFYNo);
                        $('#div_Balance').html(Task.TaskInfo_KZY.Balance);
                        $('#div_Lon').html(Task.TaskInfo_KZY.Lon);
                        $('#div_Lat').html(Task.TaskInfo_KZY.Lat);

                        $('#ForecastTime').html(Task.TaskInfo_KZY.ForecastStartTime + ' 至 ' + Task.TaskInfo_KZY.ForecastEndTime)

                        var ReportHtml = '';
                        $(Task.Report.KZYReportFile).each(function (index, dom) {

                            ReportHtml += '<tr><td>' + dom.FileName + '</td ><td>' + dom.FileTime + '</td><td><a download="' + dom.FileName + '" href="' + dom.FilePath + '" class="btn btn-primary">下载</a></td></tr>';

                        })

                        $('#html_ReportList').html(ReportHtml);


                        var CommentHtml = '';
                        $(Task.FlowInfo.LastNode).each(function (index, dom) {
                            CommentHtml += dom.UserName + ':' + dom.Comment + ';\n'
                        });
                        $('#txt_LastNodeComment').val(CommentHtml);

                        if (Task.FlowInfo.NextNodeID == 0) {
                            $('#txt_NextNode').html('流程结束');
                            $('#ul_NextNodeUser').html('');
                        }
                        else {
                            $('#txt_NextNode').html(Task.FlowInfo.NodeName);
                            var NodeUserHtml = '';
                            $(Task.FlowInfo.Node).each(function (index, dom) {

                                NodeUserHtml += '<li><div>' + dom.UserName + '</div><div>（' + dom.UserDepart + '）</div></li>'

                            });
                            $('#ul_NextNodeUser').html(NodeUserHtml);
                        }

                    }

                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                //Pagination();
            });

    }

    var LoadKZYShip = function () {

        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('LoadKZYShip', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        var ShipHtml = '';
                        $(data.Data).each(function (index, dom) {

                            ShipHtml += '<li><input type="checkbox">' + dom.ShipName + '</li>';

                        })
                        $('#ul_ShipList').html(ShipHtml);


                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
            });

    }


    var DoBack = function () {

        window.location.href = "Index";

    }


</script>