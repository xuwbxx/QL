
@{
    ViewBag.Title = "工作任务";
    Layout = "~/Views/Shared/MobileLayout.cshtml";
}

<input type="hidden" id="hid_PostToken" value="@ViewData["PostToken"].ToString()" />
<input type="hidden" id="hid_ProjectID" value="@ViewData["ProjectID"].ToString()" />

<header>
    <div class="left_logo"><img src="~/Content/Mobile/img/logo.png"></div>@ViewData["ProjectName"].ToString()
    <span class="icon_user">@ViewData["UserName"].ToString()</span>
</header>
<div class="height88"></div>
<div class="enter_gzlb"><button type="button" class="btn btn-primary" onclick="OpenProject();">项目</button></div>

<div class="gzrw_search_box clearfix gzrw_search_box_fixed">

    <select class="selectpicker search_select" id="query_select_FlowStatus">
        <option value="100" selected>所有</option>
        <option value="0">审批中</option>
        <option value="1">退回</option>
        <option value="2">完成</option>
        <option value="3">作废</option>
    </select>

    <input type="text" class="form-control pull-left" placeholder="请输入任务名称" style="width: 65%;" id="query_txtTaskName">
    <button class="btn btn-primary" onclick="DoQuery();"><i class="fa fa-search"></i></button>
</div>

<div class="height150"></div>

