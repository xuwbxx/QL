<script>
    $(document).ready(function () {

        ParamInit();
        Query();
    })

    var Param = {};
    var ParamInit = function () {
        Param.FlowStatus = $('#query_select_FlowStatus').val();
        Param.TaskName = $("#query_txtTaskName").val();

        Param.ProjectID = $("#hid_ProjectID").val();

    }

    var OpenProject = function () {

        window.location.href = "/Mobile/Project/Index";

    }

    var Query = function () {

        //OpenMaskLayout();
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('TaskListQuery', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        var TaskListHtml = '';

                        $(data.Data).each(function (index, dom) {

                            var StatusCss = '';
                            if (dom.FlowStatus == 0) {
                                StatusCss = 'rwlb_zt_spz';
                            }
                            else if (dom.FlowStatus == 1)
                            {
                                StatusCss = 'rwlb_zt_th';
                            }
                            else if (dom.FlowStatus == 2) {
                                StatusCss = 'rwlb_zt_jhz';
                            }
                            else if (dom.FlowStatus == 3) {
                                StatusCss = 'rwlb_zt_zf';
                            }

                            TaskListHtml += '<li class="rwlb_box"><div class="rwlb_xmtitle" >' + dom.TaskCode + '</div><div class="rwlb_xmnumber" onclick=OpenTask(' + dom.ID + ',' + dom.SoftwareID + ')>任务名称：' + dom.TaskName + '</div><div class="rwlb_xmnumber">任务软件：<span>' + dom.SoftwareName + '</span></div><div class="rwlb_zt"><span class="' + StatusCss + '">' + dom.FlowStatusName + '</span></div></li>';

                        })
                        $('#html_TaskList').html(TaskListHtml);
                    }

                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                //Pagination();
            });

    }

    var DoQuery = function () {

        Param.TaskName = $("#query_txtTaskName").val();
        Param.FlowStatus = $('#query_select_FlowStatus').val();
        Query();
    }

    var OpenTask = function (TaskID, SoftwareID) {

        if (TaskID == '' || SoftwareID == '' || TaskID == 0 || SoftwareID == 0)
            return;

        if (SoftwareID == 2) {
            //插拔桩
            window.location.href = 'CBZTask?TaskID=' + TaskID;
        }
        else if (SoftwareID == 3)
        {
            window.location.href = 'KZYTask?TaskID=' + TaskID;
        }

    }



</script>