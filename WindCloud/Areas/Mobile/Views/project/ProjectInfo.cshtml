<script>
    $(document).ready(function () {

        Query();

    })

    var Param = {};
    var ParamInit = function () {

    }

    var Query = function () {

        //OpenMaskLayout();
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        Param.ProjectID = $('#hid_ProjectID').val();
        $.post('ProjectInfoQuery', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        $('#div_ProjectName').html(data.Data.ProjectName);
                        $('#div_ProjectCode').html(data.Data.ProjectCode);

                        var ProjectAreaHtml = '';
                        var PositionCount = 1;
                        $(data.Data.ProjectPosition).each(function (index, dom) {

                            ProjectAreaHtml += '<tr><td>' + PositionCount + '</td ><td>' + dom.Lon + '</td><td>' + dom.Lat + '</td></tr>';
                            PositionCount++;
                        })
                        $('#html_ProjectAreaList').html(ProjectAreaHtml);

                        var ProjectFanHtml = '';
                        $(data.Data.ProjectFan).each(function (index, dom) {

                            ProjectFanHtml += '<tr><td>' + dom.FanName + '</td ><td>' + dom.Lon + '</td><td>' + dom.Lat + '</td></tr>';
                        })
                        $('#html_FanAreaList').html(ProjectFanHtml);

                        $('#div_Company').html(data.Data.ProjectInfo.Company);
                        $('#span_ProjectStatus').html(data.Data.ProjectInfo.ProjectStatus);
                        //$('#div_WaterDepth').html(data.Data.ProjectInfo.WaterDepth);
                        $('#div_WaterDepthMin').html(data.Data.ProjectInfo.WaterDepthMin);
                        $('#div_WaterDepthMax').html(data.Data.ProjectInfo.WaterDepthMax);

                        var ProjectFileHtml = '';
                        $(data.Data.ProjectFile).each(function (index, dom) {

                            ProjectFileHtml += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a class="btn btn-primary" download="' + dom.FileName + '" href="' + dom.FilePath + '">下载</a></td></tr>';

                        })
                        $('#html_ProjectFile').html(ProjectFileHtml);

                        var dkyszlFileHtml = '';
                        $(data.Data.File_dkyszl).each(function (index, dom) {

                            dkyszlFileHtml += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a class="btn btn-primary" download="' + dom.FileName + '" href="' + dom.FilePath + '">下载</a></td></tr>';

                        })
                        $('#html_dkyszlFile').html(dkyszlFileHtml);

                        var dksjbFileHtml = '';
                        $(data.Data.File_dksjb).each(function (index, dom) {

                            dksjbFileHtml += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a class="btn btn-primary" download="' + dom.FileName + '" href="' + dom.FilePath + '">下载</a></td></tr>';

                        })
                        $('#html_dksjbFile').html(dksjbFileHtml);

                        $('#div_ProjectManager').html(data.Data.ProjectManager.UserName + '(' + data.Data.ProjectManager.UserDepart + ')');

                        var ProjectRoleHtml = '';
                        $(data.Data.ProjectGroupUser).each(function (index, dom) {

                            ProjectRoleHtml += '<div class="col-md-12 col-xs-12 col-sm-12 mt015">' + dom.UserName + '(' + dom.UserDepart + ')</div>';

                        })
                        $('#div_ProjectRoles').html(ProjectRoleHtml);


                        $('#div_ProjectLimitTime').html(data.Data.ProjectStartTime + ' 至 ' + data.Data.ProjectEndTime);

                    }

                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                //Pagination();
            });

    }

    var DoBack = function () {

        window.location.href = "Index";

    }

</script>