<script>

    $(document).ready(function () {
        //SoftwareZJCZHelper.Init();
        //SoftwareZJCZHelper.LoadZJCZShip();
    })

    var SoftwareZJCZHelper = {
        Init: function () {
            //SoftwareZJCZHelper.ForecastTimeInit();
        },
        ForecastTimeInit: function () {
            $('#popup_ForecastStartTime_ZJCZ').val(formatDateTimeByDay(new Date()));
            $('#popup_ForecastEndTime_ZJCZ').val(formatDateTimeByDay(new Date(new Date().setDate(new Date().getDate() + 90))));
        },
        OpenPopup: function () {

            var ChooseProjectID = $('#hid_ProjectID').val();
            if (ChooseProjectID == null || ChooseProjectID == '' || ChooseProjectID == 0) {
                ModalPopup('error', '必须先选择所关联的风场');
                return;
            }
            SoftwareZJCZHelper.PopupOpenedHandleType = 'new';
            SoftwareZJCZHelper.OpenTaskPopup('new', ChooseProjectID);

            Param.SoftwareID = 6;
            //下一节点人员
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('NextNodeQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            $('#popup_spanNextNodeName_ZJCZ').html(data.Data.NodeName);

                            if (data.Data.NodeUsers.length > 0) {

                                $('#popup_txtNodeUserName_ZJCZ').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_ZJCZ').attr('disabled', true);
                                $('#popup_divClearNodeName_ZJCZ').hide();

                                var NodeUserHtml = '';
                                $(data.Data.NodeUsers).each(function (index, dom) {

                                    NodeUserHtml += dom.ManageName + '(' + dom.ManageDepart + ');'

                                });
                                $('#popup_txtNodeUserName_ZJCZ').val(NodeUserHtml);

                            }
                            else {
                                $('#popup_txtNodeUserName_ZJCZ').attr('disabled', false);
                                $('#popup_btnFindNodeUserName_ZJCZ').attr('disabled', false);
                                $('#popup_divClearNodeName_ZJCZ').show();
                            }

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });



        },

        OpenTaskPopup: function (type, FlowStatus) {
            $('#popup_divSubmit_ZJCZ').show();
            if (type == 'new') {
                //清空弹窗
                SoftwareZJCZHelper.ClearTaskPopup();
                //设置可写
                SoftwareZJCZHelper.SetTaskPopupWrite();

                //报告文件
                $('#popup_divFileReport_ZJCZ').hide();
                /*上一节点审批意见*/
                $('#popup_divLastContent_ZJCZ').hide();
                //审批意见
                $('#popup_divContent_ZJCZ').hide();
                //下一节点
                $('#popup_divNextNode_ZJCZ').show();

                //提交按钮
                $('#popup_btnSubmit_ZJCZ').show().html('申请').attr('data-type', 1);
                $('#popup_btnBack_ZJCZ').hide();
                $('#popup_btnCancel_ZJCZ').hide();

                SoftwareZJCZHelper.PopupOpenedTaskID = parseInt(Math.random() * 10000000);

            }
            else if (type == 'view') {
                //清空弹窗
                SoftwareZJCZHelper.ClearTaskPopup();
                //设置可写
                SoftwareZJCZHelper.SetTaskPopupRead();

                //文件报告（需要另外判断）
                $('#popup_divFileReport_ZJCZ').show();

                /*上一节点审批意见*/
                $('#popup_divLastContent_ZJCZ').show();
                //审批意见
                $('#popup_divContent_ZJCZ').hide();
                //下一节点
                $('#popup_divNextNode_ZJCZ').hide();

                //提交按钮
                $('#popup_btnSubmit_ZJCZ').hide();
                $('#popup_btnBack_ZJCZ').hide();
                $('#popup_btnCancel_ZJCZ').hide();

                //作废的流程
                if (FlowStatus == 3) {
                    $('#popup_divSubmit_ZJCZ').hide();
                }

            }
            else if (type == 'approval') {
                //清空弹窗
                SoftwareZJCZHelper.ClearTaskPopup();
                //设置只读
                SoftwareZJCZHelper.SetTaskPopupRead();

                //成果报告（需要另外判断）
                $('#popup_divFileReport_ZJCZ').show();
                $('#popup_uploadFileReport_ZJCZ').attr('disabled', false);
                $('#popup_btn_uploadFileReport_ZJCZ').attr('disabled', false);

                /*上一节点审批意见*/
                $('#popup_divLastContent_ZJCZ').show();
                //审批意见
                $('#popup_divContent_ZJCZ').show();
                $('#popup_txtContent_ZJCZ').attr('disabled', false);
                //下一节点
                $('#popup_divNextNode_ZJCZ').show();
                $('#popup_txtNodeUserName_ZJCZ').attr('disabled', false);
                $('#popup_btnFindNodeUserName_ZJCZ').attr('disabled', false);
                $('#popup_divClearNodeName_ZJCZ').show();

                $('#popup_btnBack_ZJCZ').show();
                $('#popup_btnSubmit_ZJCZ').show().html('审批通过').attr('data-type', 2);
                $('#popup_btnCancel_ZJCZ').show();

            }
            else if (type == 'renew') {
                //清空弹窗
                SoftwareZJCZHelper.ClearTaskPopup();
                //设置可写
                SoftwareZJCZHelper.SetTaskPopupWrite();

                //成果报告（需要另外判断）
                $('#popup_divFileReport_ZJCZ').hide();

                /*上一节点审批意见*/
                $('#popup_divLastContent_ZJCZ').show();
                $('#popup_txtLastContent_ZJCZ').attr('disabled', true);
                //审批意见
                $('#popup_divContent_ZJCZ').show();
                $('#popup_txtContent_ZJCZ').attr('disabled', false);
                
                //下一节点
                $('#popup_divNextNode_ZJCZ').show();

                $('#popup_btnBack_ZJCZ').hide();
                $('#popup_btnSubmit_ZJCZ').show().html('重新提交').attr('data-type', 2);
                $('#popup_btnCancel_ZJCZ').show();

            }

            $('#Tk_software_06').modal('show');

            //SoftwareZJCZHelper.LoadDKFile(type);

            SoftwareZJCZHelper.LoadDKFile(type);

            //SoftwareZJCZHelper.LoadDKData(ProjectID);

            SoftwareZJCZHelper.LoadProjectPosition();

        },

        SetTaskPopupWrite: function () {

            //任务名
            //$('#popup_txtTaskName_ZJCZ').attr('disabled', false);
            //项目介绍
            $('#popup_txtProjectIntroduce_ZJCZ').attr('disabled', false);
            //项目位置
            $('#popup_txtProjectPosition_ZJCZ').attr('disabled', false);
            $('#popup_fileProjectPosition_ZJCZ').attr('disabled', false);
            $('#popup_btn_uploadProjectPosition_ZJCZ').attr('disabled', false);
            
            //桩帽替打
            $('#popup_txtPileReplace_ZJCZ').attr('disabled', false);
            //锤型号
            $('#popup_btnAddHammerModel_ZJCZ').attr('disabled', false);
            //桩配置
            $('#popup_filePileSource_ZJCZ').attr('disabled', false);
            $('#popup_btn_uploadPileSource_ZJCZ').attr('disabled', false);
            $('#popup_filePileData_ZJCZ').attr('disabled', false);
            $('#popup_btn_uploadPileData_ZJCZ').attr('disabled', false);
            //地勘数据
            $('#popup_file_DKYSZL_ZJCZ').attr('disabled', false);
            $('#popup_btn_upload_DKYSZL_ZJCZ').attr('disabled', false);
            $('#popup_file_DKSJB_ZJCZ').attr('disabled', false);
            $('#popup_btn_upload_DKSJB_ZJCZ').attr('disabled', false);
            //文件报告
            $('#popup_uploadFileReport_ZJCZ').attr('disabled', false);
            $('#popup_btn_uploadFileReport_ZJCZ').attr('disabled', false);
            //意见
            $('#popup_txtLastContent_ZJCZ').attr('disabled', false);
            $('#popup_txtContent_ZJCZ').attr('disabled', false);
            //节点
            $('#popup_btnFindNodeUserName_ZJCZ').attr('disabled', false);
            $('#popup_txtNodeUserName_ZJCZ').attr('disabled', false);
            $('#popup_divClearNodeName_ZJCZ').show();
        },

        SetTaskPopupRead: function () {

            //任务名
            //$('#popup_txtTaskName_ZJCZ').attr('disabled', true);
            //项目介绍
            $('#popup_txtProjectIntroduce_ZJCZ').attr('disabled', true);
            //项目位置
            $('#popup_txtProjectPosition_ZJCZ').attr('disabled', true);
            $('#popup_fileProjectPosition_ZJCZ').attr('disabled', true);
            $('#popup_btn_uploadProjectPosition_ZJCZ').attr('disabled', true);
            //桩帽替打
            $('#popup_txtPileReplace_ZJCZ').attr('disabled', true);
            //锤型号
            $('#popup_btnAddHammerModel_ZJCZ').attr('disabled', true);
            //桩配置
            $('#popup_filePileSource_ZJCZ').attr('disabled', true);
            $('#popup_btn_uploadPileSource_ZJCZ').attr('disabled', true);
            $('#popup_filePileData_ZJCZ').attr('disabled', true);
            $('#popup_btn_uploadPileData_ZJCZ').attr('disabled', true);
