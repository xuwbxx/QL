        AddTaskSubmit: function (dom) {

            var type = $(dom).attr('data-type');
            if (type == null || type == '')
                return;

            var InfoText = '';
            if (type == 0) {
                InfoText = '是否要流程退回？流程将退回至上一节点人员';
            }
            else if (type == 1) {

                var TaskName = SoftwareZJCZHelper.CreateTaskName();
                if (TaskName == '') {
                    return;
                }
                $('#popup_txtTaskName_ZJCZ').val(TaskName);
                InfoText = TaskName + '</br>是否要保存任务？';
            }
            else if (type == 2) {

                if (SoftwareZJCZHelper.PopupIsBackFlow == true) {
                    var TaskName = SoftwareZJCZHelper.CreateTaskName();
                    if (TaskName == '') {
                        return;
                    }
                    $('#popup_txtTaskName_ZJCZ').val(TaskName);
                    InfoText = TaskName + '</br>是否要保存任务？';
                }
                else {
                    InfoText = '是否要审批通过？';
                }
            }
            else if (type == 3) {
                InfoText = '是否要作废流程？';
            }

            ModalPopup('information', InfoText);

            $("#ModalSubmit").unbind('click').bind('click', function () {
                SoftwareZJCZHelper.DoTaskSubmit(type);
            });

        },

        DoTaskSubmit: function (type) {

            if (type == 1) {
                SoftwareZJCZHelper.DoTaskAdd();
            }
            else if (type == 0 || type == 2) {
                SoftwareZJCZHelper.DoTaskApproval(type);
            }
            else if (type == 3) {
                SoftwareZJCZHelper.DoTaskCancel();
            }
        },

        CreateTaskName: function () {

            var TaskName = '';

            //$('#popup_htmlHammerModel_ZJCZ li input').each(function (index, dom) {

            //    var HammerName = $(dom).val().trim();
            //    if (HammerName == '')
            //    {
            //        ModalClose('information');
            //        ModalPopup('error', '锤型号 不能为空');
            //        return '';
            //    }
            //})

            var HammerCount = $('#popup_htmlHammerModel_ZJCZ li input').length;
            if (HammerCount == 0) {
                ModalClose('information');
                ModalPopup('error', '没有输入 锤型号');
                return '';
            }
            else
            {
                if (HammerCount == 1) {
                    TaskName = '(' + $('#popup_htmlHammerModel_ZJCZ li input').first().val().trim() + ')桩基沉桩可打性分析';
                }
                else
                {
                    TaskName = '(' + $('#popup_htmlHammerModel_ZJCZ li input').first().val().trim() + ')等' + HammerCount + '个锤型号的桩基沉桩可打性分析';
                }
            }


            TaskName += '(' + GetFullDateTimeString(new Date()) + ')';

            return TaskName;

        },

        DoTaskAdd: function () {

            var ProjectID = $('#hid_ProjectID').val();
            if (ProjectID == null || ProjectID == '' || ProjectID == 0) {
                ModalClose('information');
                ModalPopup('error', '软件申请页面需要选择关联风电项目');
                return;
            }

            var SubmitFormData = new FormData();
            SubmitFormData.append("ProjectID", ProjectID);
            SubmitFormData.append("TaskID", SoftwareZJCZHelper.PopupOpenedTaskID);
            SubmitFormData.append("SoftwareID", 6);

            SubmitFormData.append("TaskName", $('#popup_txtTaskName_ZJCZ').val());
            SubmitFormData.append("ZJCZProjectIntroduce", $('#popup_txtProjectIntroduce_ZJCZ').val());
            SubmitFormData.append("ZJCZProjectPosition", $('#popup_txtProjectPosition_ZJCZ').val());
            SubmitFormData.append("PileReplace", $('#popup_txtPileReplace_ZJCZ').val());

            //桩锤号
            var HammerNames = '';
            var HammerErrorText = '';
            $('#popup_htmlHammerModel_ZJCZ li input').each(function (index, dom) {
                var HammerName = $(dom).val().trim();
                if (HammerName == '')
                {
                    HammerErrorText = '锤型号 内容不能为空';
                    return false;
                }
                HammerNames += HammerName + ','
            })
            if (HammerErrorText != '')
            {
                ModalClose('information');
                ModalPopup('error', '锤型号 内容不能为空');
                return;
            }
            HammerNames = HammerNames.substring(0, HammerNames.length - 1);
            SubmitFormData.append("HammerModel", HammerNames);

            //节点人员
            SubmitFormData.append("TaskNodeName", SoftwareZJCZHelper.ChoosedTaskNodeUser.Name);
            SubmitFormData.append("TaskNodeUserCode", SoftwareZJCZHelper.ChoosedTaskNodeUser.UserCode);
            SubmitFormData.append("TaskNodeDepart", SoftwareZJCZHelper.ChoosedTaskNodeUser.Depart);
            SubmitFormData.append("TaskNodePhone", SoftwareZJCZHelper.ChoosedTaskNodeUser.Phone);
            SubmitFormData.append("TaskNodeJobName", SoftwareZJCZHelper.ChoosedTaskNodeUser.JobName);

            $('#ModalSubmit').attr('disabled', true);
            OpenMaskPopUp();

            $.ajax({
                url: 'TaskSubmit_ZJCZ',
                dataType: 'json',
                type: 'POST',
                async: false,
                data: SubmitFormData,
                processData: false, // 使数据不做处理
                contentType: false, // 不要设置Content-Type请求头
                success: function (data) {

                    if (data) {
                        if (data.Success) {
                            ModalPopup('success', '保存成功');
                            $('#Tk_software_06').modal('hide');
                            $('#tk_WorkTasks').modal('hide');

                            Param.ProjectID = $('#hid_ProjectID').val();
                            DoQuery();


                        }
                        else {

                            ModalPopup('error', data.Message);
                        }

                    }

                },
                error: function (response) {
                    console.log(response);
                },
                complete: function (data) {
                    $('#ModalSubmit').attr('disabled', false);
                    CloseMaskPopUp();
                    ModalClose('information');
                }
            });

        },

        DoTaskApproval: function (type) {

            if (SoftwareZJCZHelper.PopupOpenedTaskID == 0) {
                ModalClose('information');
                ModalPopup('error', '数据出错，重新打开弹窗。');
                return;
            }

            var SubmitFormData = new FormData();

            SubmitFormData.append("ApprovalType", type);
            SubmitFormData.append("IsBackFlow", SoftwareZJCZHelper.PopupIsBackFlow);
            SubmitFormData.append("NodeID", SoftwareZJCZHelper.ChoosedTaskNodeUser.NextNodeID);
            SubmitFormData.append("TaskID", SoftwareZJCZHelper.PopupOpenedTaskID);
            SubmitFormData.append("TaskComment", $('#popup_txtContent_ZJCZ').val());
            if (SoftwareZJCZHelper.ChoosedTaskNodeUser.NextNodeID == 0) {
                //流程结束

            }
            else {
                //正常审批
                SubmitFormData.append("TaskNodeName", SoftwareZJCZHelper.ChoosedTaskNodeUser.Name);
                SubmitFormData.append("TaskNodeUserCode", SoftwareZJCZHelper.ChoosedTaskNodeUser.UserCode);
