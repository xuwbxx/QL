        DoTaskAdd: function () {

            if (SoftwareZJHelper.ChoosedDeliverUser == null || SoftwareZJHelper.ChoosedDeliverUser.UserCode == null || SoftwareZJHelper.ChoosedDeliverUser.UserCode == '') {
                ModalClose('information');
                ModalPopup('error', '需要选择报告接收人');
                return;
            }

            var ProjectID = $('#popup_software_ProjectChoose').val();
            if (ProjectID == null || ProjectID == '' || ProjectID == 0) {
                ModalClose('information');
                ModalPopup('error', '软件申请页面需要选择关联风电项目');
                return;
            }

            var SubmitFormData = new FormData();
            SubmitFormData.append("ProjectID", ProjectID);
            SubmitFormData.append("SoftwareID", 6);//桩基软件ID=6
            SubmitFormData.append("TaskName", $('#popup_txtTaskName_ZJ').val());
            SubmitFormData.append("TaskDeliverName", SoftwareZJHelper.ChoosedDeliverUser.Name);
            SubmitFormData.append("TaskDeliverUserCode", SoftwareZJHelper.ChoosedDeliverUser.UserCode);
            SubmitFormData.append("TaskDeliverDepart", SoftwareZJHelper.ChoosedDeliverUser.Depart);
            SubmitFormData.append("TaskDeliverPhone", SoftwareZJHelper.ChoosedDeliverUser.Phone);
            SubmitFormData.append("TaskDeliverJobName", SoftwareZJHelper.ChoosedDeliverUser.JobName);
            SubmitFormData.append("TaskDeliverTime", $('#popup_TaskDeliverTime_ZJ').val());

            //gcxmjbzl
            //jkwdkzl
            //jkwdksjb
            //qyzbzl
            //sggy
            //zyhj
            //ljxmsgzl
            //sjsgqk
            
            var FileCount_gcxmjbzl = $('#popup_htmlTaskFile_gcxmjbzl_ZJ tr').length;
            if (FileCount_gcxmjbzl > 0) {
                SubmitFormData.append("TaskFileCount_gcxmjbzl", FileCount_gcxmjbzl);
                var Files = $('#popup_uploadTaskFile_gcxmjbzl_ZJ')[0].files;
                var Count = 1;
