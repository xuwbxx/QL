                    var FileName = $(dom).find('td').first().html();
                    if (FileName != null && FileName != '') {

                        $(Files).each(function (index2, dom2) {

                            if (dom2.name == FileName) {
                                SubmitFormData.append("TaskFile_gcxmjbzl" + Count, dom2);
                                Count++;
                                return false;
                            }
                        });
