            else if (type == 1) {
                InfoText = '是否要保存任务？';
            }
            else if (type == 2) {
                InfoText = '是否要审批通过？';
            }

            ModalPopup('information', InfoText);

            $("#ModalSubmit").unbind('click').bind('click', function () {
                SoftwareZJHelper.DoTaskSubmit(type);
            });

        },

