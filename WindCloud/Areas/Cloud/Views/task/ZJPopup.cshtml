<script>
    $(document).ready(function () {
        SoftwareZJHelper.Init();
    })

    var SoftwareZJHelper = {

        Init: function () {
            SoftwareZJHelper.DeliverTimeInit();
        },
        DeliverTimeInit: function () {
            $('#popup_TaskDeliverTime_ZJ').val(formatDateTimeByDay(new Date(new Date().setMonth(new Date().getMonth() + 1))));
        },
        OpenPopup: function () {

            var ChooseProjectID = $('#popup_software_ProjectChoose').val();
            if (ChooseProjectID == null || ChooseProjectID == '' || ChooseProjectID == 0) {
                ModalPopup('error', '必须先选择所关联的风场');
                return;
            }

            SoftwareZJHelper.OpenTaskPopup('new');

        },
        OpenTaskPopup: function (type) {
            if (type == 'new') {
                //清空弹窗
                SoftwareZJHelper.ClearTaskPopup();
                //设置可写
                SoftwareZJHelper.SetTaskPopupWrite();

                //报告文件
                $('#popup_divReport_ZJ').hide();
                //上一节点审批意见
                $('#popup_divLastContent_ZJ').hide();
                //审批意见
                $('#popup_divContent_ZJ').hide();
                //下一节点
                $('#popup_divNextNode_ZJ').hide();

                $('#popup_btnBack_ZJ').hide();
                $('#popup_btnSubmit_ZJ').show().html('申请').attr('data-type', 1);

            }
            else if (type == 'view') {
                //清空弹窗
                SoftwareZJHelper.ClearTaskPopup();
                //设置可写
                SoftwareZJHelper.SetTaskPopupRead();


                //成果报告（需要另外判断）
                $('#popup_divReport_ZJ').show();

                //上节点审批意见
                $('#popup_divLastContent_ZJ').show();
                //审批意见
                $('#popup_divContent_ZJ').hide();
                //下节点信息
                $('#popup_divNextNode_ZJ').hide();

                //申请按钮
                $('#popup_btnSubmit_ZJ').hide();
                $('#popup_btnBack_ZJ').hide();

            }
            else if (type == 'approval') {
                //清空弹窗
                SoftwareZJHelper.ClearTaskPopup();
                //设置只读
                SoftwareZJHelper.SetTaskPopupRead();

                //成果报告（需要另外判断）
                $('#popup_divReport_ZJ').show();
                //上节点审批意见
                $('#popup_divLastContent_ZJ').show();
                //审批意见
                $('#popup_divContent_ZJ').show();
                $('#popup_txtContent_ZJ').attr('disabled', false);
                //下节点信息
                $('#popup_divNextNode_ZJ').show();
                $('#popup_txtNodeUserName_ZJ').attr('disabled', false);
                $('#popup_btnFindNodeUserName_ZJ').attr('disabled', false);
                $('#popup_divClearNodeName_ZJ').show();

                $('#popup_btnBack_ZJ').show();
                $('#popup_btnSubmit_ZJ').show().html('审批通过').attr('data-type', 2);



            }
            else if (type == 'renew') {
                //清空弹窗
                SoftwareZJHelper.ClearTaskPopup();
                //设置可写
                SoftwareZJHelper.SetTaskPopupWrite();

                //成果报告（需要另外判断）
                $('#popup_divReport_ZJ').show();

                //上节点审批意见
                $('#popup_divLastContent_ZJ').show();
                $('#popup_txtLastContent_ZJ').attr('disabled', true);
                //审批意见
                $('#popup_divContent_ZJ').show();
                $('#popup_txtContent_ZJ').attr('disabled', false);
                //下节点信息
                $('#popup_divNextNode_ZJ').hide();

                $('#popup_btnBack_ZJ').hide();
                $('#popup_btnSubmit_ZJ').show().html('重新提交').attr('data-type', 2);
            }

            $('#Tk_software_06').modal('show');

            $('#popup_htmlTaskFile_gcxmjbzl_ZJ').attr('data-tag', 0);
            $('#popup_htmlTaskFile_jkwdkzl_ZJ').attr('data-tag', 0);
            $('#popup_htmlTaskFile_jkwdksjb_ZJ').attr('data-tag', 0);
            $('#popup_htmlTaskFile_qyzbzl_ZJ').attr('data-tag', 0);
            $('#popup_htmlTaskFile_sggy_ZJ').attr('data-tag', 0);
            $('#popup_htmlTaskFile_zyhj_ZJ').attr('data-tag', 0);
            $('#popup_htmlTaskFile_ljxmsgzl_ZJ').attr('data-tag', 0);
            $('#popup_htmlTaskFile_sjsgqk_ZJ').attr('data-tag', 0);

            $('#popup_htmlReportFile_ZJ').attr('data-tag', 0);
        },
        ClearTaskPopup: function () {

            $('#popup_txtTaskName_ZJ').val('');

            $('#popup_uploadTaskFile_gcxmjbzl_ZJ').val('');
            $('#popup_uploadTaskFile_jkwdkzl_ZJ').val('');
            $('#popup_uploadTaskFile_jkwdksjb_ZJ').val('');
            $('#popup_uploadTaskFile_qyzbzl_ZJ').val('');
            $('#popup_uploadTaskFile_sggy_ZJ').val('');
            $('#popup_uploadTaskFile_zyhj_ZJ').val('');
            $('#popup_uploadTaskFile_ljxmsgzl_ZJ').val('');
            $('#popup_uploadTaskFile_sjsgqk_ZJ').val('');

            $('#popup_htmlTaskFile_gcxmjbzl_ZJ').html('');
            $('#popup_htmlTaskFile_jkwdkzl_ZJ').html('');
            $('#popup_htmlTaskFile_jkwdksjb_ZJ').html('');
            $('#popup_htmlTaskFile_qyzbzl_ZJ').html('');
            $('#popup_htmlTaskFile_sggy_ZJ').html('');
            $('#popup_htmlTaskFile_zyhj_ZJ').html('');
            $('#popup_htmlTaskFile_ljxmsgzl_ZJ').html('');
            $('#popup_htmlTaskFile_sjsgqk_ZJ').html('');

            $('#popup_uploadReportFile_ZJ').val('');
            $('#popup_htmlReportFile_ZJ').html('');

            $('#popup_txtDeliverUserName_ZJ').val('');
            $('#popup_TaskDeliverTime_ZJ').val('');

            $('#popup_txtLastContent_ZJ').val('');
            $('#popup_txtContent_ZJ').val('');
            $('#popup_txtNodeUserName_ZJ').val('');

            SoftwareZJHelper.DeliverTimeInit();
        },
        SetTaskPopupWrite: function () {

            $('#popup_txtTaskName_ZJ').attr('disabled', false);

            $('#popup_uploadTaskFile_gcxmjbzl_ZJ').attr('disabled', false);
            $('#popup_uploadTaskFile_jkwdkzl_ZJ').attr('disabled', false);
            $('#popup_uploadTaskFile_jkwdksjb_ZJ').attr('disabled', false);
            $('#popup_uploadTaskFile_qyzbzl_ZJ').attr('disabled', false);
            $('#popup_uploadTaskFile_sggy_ZJ').attr('disabled', false);
            $('#popup_uploadTaskFile_zyhj_ZJ').attr('disabled', false);
            $('#popup_uploadTaskFile_ljxmsgzl_ZJ').attr('disabled', false);
            $('#popup_uploadTaskFile_sjsgqk_ZJ').attr('disabled', false);

