<script>

    $(document).ready(function () {
        SoftwareListBind();
    });

    var SoftwareListBind = function () {

        var ProjectID = $('#hid_ProjectID').val();
        if (ProjectID != 0) {
            //$('#popup_software_ProjectChoose option[value=' + ProjectID + ']').prop('selected', true);
            PopupChooseProject(ProjectID);
        }



    }

    var AddTaskPopup = function () {

        $('#tk_WorkTasks').modal('show');

    }

    var PopupSoftwareInit = function (SoftwareID) {

        $('#Popup_btn_Software' + SoftwareID).removeClass('active');
        $('#Popup_btn_Software' + SoftwareID).attr('disabled', true);
        $('#Popup_btn_Software' + SoftwareID).html('申请使用');

        $('#Popup_LimitTime' + SoftwareID).html('');

    }

    var PopupChooseProject = function (ProjectID) {

        Param.ProjectID = ProjectID;
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('ChooseProject', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {



                        var WebGISModel = data.Data[0];
                        var cbzModel = data.Data[1];
                        var kzyModel = data.Data[2];
                        var mnazModel = data.Data[3];
                        var zjModel = data.Data[4];

                        //1.WebGIS
                        PopupSoftwareInit('01');
