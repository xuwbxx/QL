
@{
    ViewBag.Title = "工作任务";
    Layout = "~/Views/Shared/ManageLayout.cshtml";
}

<input type="hidden" id="hid_OpenType" value="@ViewData["OpenType"].ToString()" />
<input type="hidden" id="hid_TaskID" value="@ViewData["TaskID"].ToString()" />
<input type="hidden" id="hid_SoftwareID" value="@ViewData["SoftwareID"].ToString()" />

<input type="hidden" id="hid_ProjectID" value="@ViewData["ProjectID"].ToString()" />
<input type="hidden" id="hid_PostToken" value="@ViewData["PostToken"].ToString()" />



<div class="content clearfix">

    <div class="col-md-12">
        <div class="box_mode">

            <div class="title text-center">
                <div class="pull-left absolute_position"><button class="btn btn-primary mr03 btn-yfprw" onclick="OpenProject();"><i class="icon iconfont mr03">&#xe646;</i>项目列表</button></div>
                <span class="xmlb_tit" style="color: #81b71d;">@ViewData["ProjectName"].ToString()</span>
            </div>
            <div class="clearfix box_table_top">
                <div class="search_box pull-left">
                    <select id="query_selectFlowStatus" class="form-control">
                        <option value="100">请选择任务状态</option>
                        <option value="0">审批中</option>
                        <option value="1">退回</option>
                        <option value="2">完成</option>
                        <option value="3">作废</option>
                    </select>
                    <select id="query_selectSoftware" class="form-control">
                        <option value="0">请选择软件名</option>
                        @{
                            var SoftwareList = ViewData["Softwares"] as List<DataFactory.KingBase.CloudWind.Manage_Software>;
                            foreach (var item in SoftwareList)
                            {
                                <option value="@item.ID">@item.SoftwareName</option>
                            }
                        }
                    </select>
                    <input type="text" class="form-control" placeholder="请输入任务名称" id="query_txtTaskName">
                    <input type="text" class="form-control" placeholder="请输入项目名称" id="query_txtProjectName">
                    <button class="btn btn-primary search_btn" onclick="DoQuery();"><i class="fa fa-search"></i></button>
                </div>
                <div class="btn_box pull-right">
                    <a class="dg_webgis hide" id="Task_OpenWebGIS" onclick="OpenWebGIS();"><i class="icon iconfont">&#xe9ee;</i></a>
                    <button class="btn btn-warning border-radius8 hide" id="btn_AddTask" onclick="AddTaskPopup();"><i class="icon iconfont">&#xe728;</i>新增任务</button>
                </div>
            </div>


            <table class="table table_project table_project02">
                <thead>
                    <tr>
                        <th width="7%">任务号</th>
                        <th width="25%">任务名</th>
                        <th width="18%">项目</th>
                        <th width="5%">发起人</th>
                        <th width="20%">当前节点</th>
                        <th width="10%">申请时间</th>
                        <th width="8%">状态</th>
                        <th width="7%">操作</th>
                    </tr>
                </thead>
