<script>
    $(document).ready(function () {
        ParamInit();

        DoQuery();

        OpenPopup();

    })

    var Param = {};
    var ParamInit = function () {
        Param.PageIndex = 1;
        Param.PageSize = 100;
        Param.TotalPage = 0;
        Param.TotalCount = 0;

        Param.ProjectID = $('#hid_ProjectID').val();

        Param.FlowStatus = 100;
        Param.SoftwareID = $('#query_selectSoftware').val();
        Param.TaskName = $("#query_txtTaskName").val();
        //Param.Name = $('#popup_txtUserName').val();
        Param.ProjectName = $("#query_txtProjectName").val();

        if ($('#hid_ProjectID').val() != 0) {
            $('#Task_OpenWebGIS').removeClass('hide');
            $('#btn_AddTask').removeClass('hide');
        }


    }

    var InitType = function () {

        var InitType = $('#hid_InitType').val();
        if (InitType != '') {
            if (InitType == 'KZY') {
                //Param.SoftwareID = 3;

                $('#query_selectSoftware').val(3);

                Param.TaskID = $('#hid_TaskID').val();
            }
        }

    }

    //查询
    var Query = function () {
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('TaskListQuery', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        var DataListHtml = '';
                        $(data.Data).each(function (index, dom) {

                            var TaskCodeClass = dom.IsFinished ? 'xm_zt_green' : 'xm_zt_orange';

                            var FlowStatusClass = 'zt_orange';
                            if (dom.FlowStatus == 1) {
                                FlowStatusClass = 'zt_red';
                            }
                            else if (dom.FlowStatus == 2) {
                                FlowStatusClass = 'zt_green';
                            }
                            else if (dom.FlowStatus == 3) {
                                FlowStatusClass = 'zt_grey';
                            }

                            if (dom.FlowHandle == 'view') {
                                FlowOperateContent = '查看';
                                FlowOperateClass = 'cz_blue';
                                FlowOperateType = 'view'
                            }
                            else if (dom.FlowHandle == 'approval') {
                                FlowOperateContent = '审批';
                                FlowOperateClass = 'cz_orange';
                                FlowOperateType = 'approval'
                            }
                            else if (dom.FlowHandle == 'renew') {
                                FlowOperateContent = '重填';
                                FlowOperateClass = 'cz_orange';
                                FlowOperateType = 'approval'
                            }

                            var FlowNodeHtml = '';
                            if (dom.IsFinished) {
                                FlowNodeHtml = '流程结束';
                            }
                            else {
                                FlowNodeHtml = dom.FlowNode + '：';
                                $(dom.NodeUser).each(function (index, dom) {
                                    FlowNodeHtml += '<a href="#" class="xm_zt_blue table_ryxx_box"><span>' + dom.NodeUserName + ';</span><div class="hover_ryxx"><ul><li><i class="icon iconfont">&#xe752;</i>部门：' + dom.NodeUserDepart + '</li><li><i class="icon iconfont">&#xe607;</i>手机号：' + dom.NodeUserPhone + '</li><li> <i class="icon iconfont">&#xe673;</i>职位：' + dom.NodeUserJobName + '</li></ul></div></a>';
                                });
                                //FlowNodeHtml = dom.FlowNode + '：<a href="#" class="xm_zt_blue table_ryxx_box"><span>' + dom.NodeUser.NodeUserName + '</span><div class="hover_ryxx"><ul><li><i class="icon iconfont">&#xe752;</i>部门：' + dom.NodeUser.NodeUserDepart + '</li><li><i class="icon iconfont">&#xe607;</i>手机号：' + dom.NodeUser.NodeUserPhone + '</li><li> <i class="icon iconfont">&#xe673;</i>职位：' + dom.NodeUser.NodeUserJobName + '</li></ul></div></a>';
                            }

                            var SoftUrlHtml = '';
                            if (dom.IsUseStatus) {
                                FlowOperateContent = '查看';
                                FlowOperateClass = 'cz_blue';
                                FlowOperateType = 'view'
                                //SoftUrlHtml = '<a href="' + dom.SoftUrl + '" target="_blank">' + dom.SoftwareName + '</a>';
                                SoftUrlHtml = dom.ApplyTime;
                            }
                            else {
                                SoftUrlHtml = dom.ApplyTime;
                            }

                            DataListHtml += '<tr><td class="' + TaskCodeClass + '" onclick="OpenTaskInfo(' + dom.ID + ',' + dom.SoftwareID + ');">' + dom.TaskCode + '</td><td title="' + dom.TaskName + '" onclick="OpenTaskInfo(' + dom.ID + ',' + dom.SoftwareID + ');">' + dom.TaskName + '</td><td><a href="#">' + dom.ProjectName + '(' + dom.ProjectCode + ')</a></td>'
                                + '<td class="relative_position"><a href = "#" class="xm_zt_blue table_ryxx_box" ><span>' + dom.Applyer.ApplyerName + '</span><div class="hover_ryxx"><ul><li><i class="icon iconfont">&#xe752;</i>部门：' + dom.Applyer.ApplyerDepart + '</li><li> <i class="icon iconfont">&#xe607;</i>手机号：' + dom.Applyer.ApplyerPhone + '</li><li> <i class="icon iconfont">&#xe673;</i>职位：' + dom.Applyer.ApplyerJobName + '</li></ul></div></a></td>'
                                + '<td>' + FlowNodeHtml + '</td>'
                                + '<td>' + SoftUrlHtml + '</td>'
                                + '<td><a class="' + FlowStatusClass + '" href="#" onclick="QueryFlowHistory(' + dom.ID + ');">' + dom.FlowStatusName + '</a></td>'
                                + '<td><a class="' + FlowOperateClass + '" href="#" onclick="OpenTaskInfo(' + dom.ID + ',' + dom.SoftwareID + ');">' + FlowOperateContent + '</a></td></tr>';
                        });

                        $('#html_DataList').html(DataListHtml);

                        //分页
                        Param.TotalPage = data.TotalPage;
                        Param.TotalCount = data.TotalCount;
                        Param.PageIndex = data.PageIndex;

                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                Pagination();
            });

    }

    var OpenTaskInfo = function (TaskID, SoftwareID) {

        if (SoftwareID == 2) {
            //插拔装软件
            SoftwareCBZHelper.OpenTaskInfo(TaskID);
        }
        if (SoftwareID == 3) {
            //可作业软件
            SoftwareKZYHelper.OpenTaskInfo(TaskID);
        }
        if (SoftwareID == 4) {
            //可作业软件
            SoftwareTHFXHelper.OpenTaskInfo(TaskID);
        }
        if (SoftwareID == 6) {
            //桩基
            SoftwareZJCZHelper.OpenTaskInfo(TaskID);
        }
        if (SoftwareID == 7) {
            //选船分析
            SoftwareXCFXHelper.OpenTaskInfo(TaskID);
        }
        if (SoftwareID == 8) {
            //气象收集
            SoftwareQXSJHelper.OpenTaskInfo(TaskID);
        }
    }

    var OpenWebGIS = function () {

        var ProjectID = $('#hid_ProjectID').val();

        if (ProjectID != null && ProjectID != '' && ProjectID != 0) {
            window.open('/Cloud/WebGIS/Index?ProjectID=' + ProjectID, '_blank');
        }



    }

    var DoQuery = function () {

        Param.SoftwareID = $('#query_selectSoftware').val();
        Param.TaskName = $("#query_txtTaskName").val();
        Param.ProjectName = $("#query_txtProjectName").val();
        Param.FlowStatus = $('#query_selectFlowStatus').val();

        Query();
        //GetTaskCount();
    }

    //分页
    var Pagination = function () {
        $("#Pagination").pagination({
            currentPage: Param.PageIndex,
            totalPage: Param.TotalPage,
            isShow: true,
            totalCount: Param.TotalCount,
            count: 7,
            homePageText: "首页",
            endPageText: "尾页",
            prevPageText: "上一页",
            nextPageText: "下一页",
            callback: function (current) {
                Param.PageIndex = current;
                Query();
            }
        });
    }


    var OpenTask = function () {

        //window.open('/Cloud/Task/Index', '_blank')
        window.location.href = '/Cloud/Task/Index';
    }


    var GetTaskCount = function () {
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('GetTaskCount', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {
                        $('#span_ApprovalCount').html(data.Data);
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                Pagination();
            });

    }


    var QueryFlowHistory = function (TaskID) {

        if (TaskID == null || TaskID == '' || TaskID == 0) {
            return;
        }

        Param.TaskID = TaskID;
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('QueryFlowHistory', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {

                        var TaskFlowHistoryHtml = '';
                        $(data.Data).each(function (index, dom) {

                            var FlowHtml = '';
                            if (dom.FlowType == 0) {
                                FlowHtml += '<div class="oneNode"><!--左侧小球--><div class="check"><img src="../../Content/Cloud/img/lc_faqi.png"></div>'
                                    + '<!--右侧内容--><div class="NodeDetail"><div class="NodeLinkName"><i class="fa fa-paper-plane-o"></i>' + dom.NodeName + '</div>'
                                    + '<!--上--><div class="NodeDetail-title"><!--内容--><div class="details"><h4>' + dom.Flow[0].NodeUserName + '(' + dom.Flow[0].NodeUserJobName + ')</h4><p title="' + dom.Flow[0].NodeUserDepart + '">' + dom.Flow[0].NodeUserDepart.substring(0, 15) + '</p></div></div>'
                                    + '<!--中--><div class="NodeDetail-content"><p title="' + dom.Flow[0].Comment + '">' + dom.Flow[0].Comment.substring(0, 20) + '</p></div><div class="NodeDetail-footer"><span>' + dom.FlowTime + '</span></div></div></div>';
                            }
                            else if (dom.FlowType == 2) {
                                FlowHtml += '<div class="oneNode"><!--左侧小球--><div class="check"><img src="../../Content/Cloud/img/lc_end.png"></div>'

                                    + '<!--右侧内容--><div class="NodeDetail clearfix"><div class="NodeLinkName"><i class="fa fa-paper-plane-o"></i>流程结束</div>';

                                //$(dom.Flow).each(function (index2, dom2) {
                                //    FlowHtml += '<div class="NodeDetail-title pull-left"><!--内容--><div class="details"><h4>' + dom2.NodeUserName + '（' + dom2.NodeUserJobName + '）</h4><p title="' + dom2.NodeUserDepart + '">' + dom2.NodeUserDepart.substring(0, 15) + '</p></div></div>';
                                //})
                                FlowHtml += '<div class="NodeDetail-footer"><span>' + dom.FlowTime ?? "" + '</span></div></div></div>';
                            }
                            else if (dom.FlowType == 1) {
                                var PicType = 'lc_daishenpi.png';
                                //正常流程
                                if (dom.FlowHandle == 0) {
                                    //待审批
                                    PicType = 'lc_daishenpi.png';
                                }
                                else if (dom.FlowHandle == 1) {
                                    //审批通过
                                    PicType = 'lc_sptg.png';
                                }
                                else if (dom.FlowHandle == 2) {
                                    //审批退回
                                    PicType = 'lc_tuihui.png';
                                }
                                else if (dom.FlowHandle == 3) {
                                    //审批删除
                                    PicType = 'lc_delete.png';
                                }

                                if (dom.ApprovalType == 1) {
                                    //单人审批
                                    FlowHtml += '<div class="oneNode"><!--左侧小球--><div class="check"><img src="../../Content/Cloud/img/' + PicType + '"></div>'
                                        + '<!--右侧内容--><div class="NodeDetail"><div class="NodeLinkName"><i class="fa fa-paper-plane-o"></i>' + dom.NodeName + '</div>'
                                        + '<!--上--><div class="NodeDetail-title"><!--内容--><div class="details"><h4>' + dom.Flow[0].NodeUserName + '(' + dom.Flow[0].NodeUserJobName + ')</h4><p title="' + dom.Flow[0].NodeUserDepart + '">' + dom.Flow[0].NodeUserDepart.substring(0, 15) + '</p></div></div>'
                                        + '<!--中--><div class="NodeDetail-content"><p title="' + dom.Flow[0].Comment + '">' + dom.Flow[0].Comment.substring(0, 20) + '</p></div><div class="NodeDetail-footer"><span>' + dom.Flow[0].FlowTime + '</span></div></div></div>';
                                }
                                else {
                                    //多人审批
                                    FlowHtml += '<div class="oneNode"><!--左侧小球--><div class="check"><img src="../../Content/Cloud/img/' + PicType + '"></div>'
                                        + '<!--右侧内容--><div class="flowChart_lb"><div class="NodeLinkName_lb"><i class="fa fa-paper-plane-o"></i>' + dom.NodeName + '</div><ul class="clearfix">'

                                    $(dom.Flow).each(function (index2, dom2) {

                                        var FlowHandleType = 'xm_zt_orange';
                                        if (dom2.FlowHandle == 1) {
                                            FlowHandleType = 'xm_zt_green';
                                        }
                                        else if (dom2.FlowHandle == 2) {
                                            FlowHandleType = 'xm_zt_red';
                                        }

                                        FlowHtml += '<li><div class="NodeDetail_lb"><!--上--><div class="NodeDetail-title"><!--内容--><div class="details"><h4>' + dom2.NodeUserName + '（' + dom2.NodeUserJobName + '）</h4><p title="' + dom2.NodeUserDepart + '">' + dom2.NodeUserDepart.substring(0, 15) + '</p></div></div>'
                                            + '<!--中--><div class="NodeDetail-content"><p title="' + dom2.Comment + '">' + dom2.Comment.substring(0, 20) + '</p></div><div class="NodeDetail-content"><p class="' + FlowHandleType + ' m0">' + dom2.FlowHandleName + '</p></div><div class="NodeDetail-footer_lb"><span>' + dom2.FlowTime + '</span></div></div></li>';

                                    })
                                    FlowHtml += '</ul></div></div>';
                                }

                            }

                            TaskFlowHistoryHtml += FlowHtml;

                        })

                        $('#html_TaskFlowHistory').html(TaskFlowHistoryHtml);
                        $('#tk_path').modal('show');
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                Pagination();
            });

    }

    //0: 审批中 1：退回  2：完成  3：删除
    var QueryTaskList = function (FlowStatus) {

        //$("#query_txtTaskName").val('');
        //$("#query_txtProjectName").val('');
        //$('#query_selectSoftware').val('');

        Param.SoftwareID = $('#query_selectSoftware').val();
        Param.TaskName = $("#query_txtTaskName").val();
        Param.ProjectName = $("#query_txtTaskName").val();

        Param.FlowStatus = FlowStatus;
        Query();
        //GetTaskCount();
    }


    var OpenPopup = function () {

        var TaskID = $('#hid_TaskID').val();
        var OpenType = $('#hid_OpenType').val();
        var SoftwareID = $('#hid_SoftwareID').val();
        if (TaskID == '' || TaskID == 0 || SoftwareID == '' || SoftwareID == 0 || OpenType == '')
            return;

        if (OpenType == 'ReportPopup') {

            OpenReportPopup(TaskID);

        }
        else if (OpenType == 'ApprovalPopup') {
            OpenTaskInfo(TaskID, SoftwareID);
        }

    }

    var OpenReportPopup = function (TaskID) {

        if (TaskID == null || TaskID == '' || TaskID == 0)
            return;

        Param.TaskID = TaskID;
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        Param.ReportSize = 100;
        $.post('GetTaskReport', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {

                        $('#tk_Report').modal('show');

                        $('#hid_TaskID').val(TaskID);

                        $('#popup_file_TaskName1').html(data.Data.TaskName1 ?? "");
                        $('#popup_file_TaskName2').html(data.Data.TaskName2 ?? "");
                        $('#popup_file_TaskCode').html(data.Data.TaskCode ?? "");
                        $('#popup_file_TaskTime').html(data.Data.TaskTime ?? "");

                        if (data.Data.TypeID == 3) {
                            $('#popup_btn_QueryAllReport').show();
                            $('#popup_file_div_Export').removeClass('cr_file_height50').removeClass('cr_file_height100').addClass('cr_file_height100');
                        }
                        else {
                            $('#popup_btn_QueryAllReport').hide();
                            $('#popup_file_div_Export').removeClass('cr_file_height50').removeClass('cr_file_height100').addClass('cr_file_height50');
                        }

                        var ExportFileHtml = '';
                        var FileCount = 1;
                        $(data.Data.ExportFiles).each(function (index, dom) {

                            ExportFileHtml += '<tr><td>' + FileCount + '</td><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a href="' + dom.FilePath + '" class="xm_zt_green" download="' + dom.FileName + '">下载</a></td></tr>';
                            FileCount++;
                        })

                        var ImportFileHtml = '';
                        FileCount = 1;
                        $(data.Data.ImportFiles).each(function (index, dom) {

                            ImportFileHtml += '<tr><td>' + FileCount + '</td><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a href="' + dom.FilePath + '" class="xm_zt_green" download="' + dom.FileName + '">下载</a></td></tr>';
                            FileCount++;
                        })

                        $('#popup_file_ExportList').html(ExportFileHtml);
                        $('#popup_file_ImportList').html(ImportFileHtml);
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                //Pagination();
            });

    }

    var QueryAllReport = function () {

        var TaskID = $('#hid_TaskID').val();

        if (TaskID == null || TaskID == '' || TaskID == 0)
            return;

        Param.TaskID = TaskID;
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
