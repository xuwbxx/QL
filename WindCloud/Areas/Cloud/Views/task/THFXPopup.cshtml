            SubmitFormData.append("TaskNodeName", SoftwareTHFXHelper.ChoosedTaskNodeUser.Name);
            SubmitFormData.append("TaskNodeUserCode", SoftwareTHFXHelper.ChoosedTaskNodeUser.UserCode);
            SubmitFormData.append("TaskNodeDepart", SoftwareTHFXHelper.ChoosedTaskNodeUser.Depart);
