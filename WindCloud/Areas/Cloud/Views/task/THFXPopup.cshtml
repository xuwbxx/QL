<script>

    $(document).ready(function () {
        SoftwareTHFXHelper.Init();
        SoftwareTHFXHelper.LoadPosition();
    })

    var SoftwareTHFXHelper = {
        Init: function () {
            
        },
        ForecastTimeInit: function () {
            $('#popup_ForecastStartTime_THFX').val(formatDateTimeByDay(new Date()));
            $('#popup_ForecastEndTime_THFX').val(formatDateTimeByDay(new Date(new Date().setDate(new Date().getDate() + 90))));
        },
        LoadPosition: function () {
            Param.ProjectID = $('#hid_ProjectID').val();
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('LoadTowingPosition', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var PositionHtml = '';
                            var count = 1;
                            $(data.Data).each(function (index, dom) {

                                PositionHtml += '<tr><td>' + count + '</td ><td>' + dom.Lon + '</td><td>' + dom.Lat + '</td></tr> ';
                                count++;
                            })
                            $('#popup_htmlPosition_THFX').html(PositionHtml);


                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        },
        OpenPopup: function () {

            var ChooseProjectID = $('#hid_ProjectID').val();
            if (ChooseProjectID == null || ChooseProjectID == '' || ChooseProjectID == 0) {
                ModalPopup('error', '必须先选择所关联的风场');
                return;
            }
            SoftwareTHFXHelper.PopupOpenedHandleType = 'new';
            SoftwareTHFXHelper.OpenTaskPopup('new', ChooseProjectID);

            Param.SoftwareID = 4;
            //下一节点人员
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('NextNodeQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            $('#popup_spanNextNodeName_THFX').html(data.Data.NodeName);

                            if (data.Data.NodeUsers.length > 0) {

                                $('#popup_txtNodeUserName_THFX').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_THFX').attr('disabled', true);
                                $('#popup_divClearNodeName_THFX').hide();

                                var NodeUserHtml = '';
                                $(data.Data.NodeUsers).each(function (index, dom) {

                                    NodeUserHtml += dom.ManageName + '(' + dom.ManageDepart + ');'

                                });
                                $('#popup_txtNodeUserName_THFX').val(NodeUserHtml);

                            }
                            else {
                                $('#popup_txtNodeUserName_THFX').attr('disabled', false);
                                $('#popup_btnFindNodeUserName_THFX').attr('disabled', false);
                                $('#popup_divClearNodeName_THFX').show();
                            }

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        },

        OpenTaskPopup: function (type, ProjectID, FlowStatus) {
            $('#popup_divSubmit_THFX').show();
            if (type == 'new') {
                //清空弹窗
                SoftwareTHFXHelper.ClearTaskPopup();
                //设置可写
                SoftwareTHFXHelper.SetTaskPopupWrite();



                /*上一节点审批意见*/
                $('#popup_divLastContent_THFX').hide();
                //审批意见
                $('#popup_divContent_THFX').hide();
                //下一节点
                $('#popup_divNextNode_THFX').show();

                //提交按钮
                $('#popup_btnSubmit_THFX').show().html('申请').attr('data-type', 1);
                $('#popup_btnBack_THFX').hide();
                $('#popup_btnCancel_THFX').hide();

                

            }
            else if (type == 'view') {
                //清空弹窗
                SoftwareTHFXHelper.ClearTaskPopup();
                //设置可写
                SoftwareTHFXHelper.SetTaskPopupRead();

                

                /*上一节点审批意见*/
                $('#popup_divLastContent_THFX').show();
                //审批意见
                $('#popup_divContent_THFX').hide();
                //下一节点
                $('#popup_divNextNode_THFX').hide();

                $('#popup_btnSubmit_THFX').hide();
                $('#popup_btnBack_THFX').hide();
                $('#popup_btnCancel_THFX').hide();

                //作废的流程
                if (FlowStatus == 3) {
                    $('#popup_divSubmit_THFX').hide();
                }

            }
            else if (type == 'approval') {
                //清空弹窗
                SoftwareTHFXHelper.ClearTaskPopup();
                //设置只读
                SoftwareTHFXHelper.SetTaskPopupRead();


                /*上一节点审批意见*/
                $('#popup_divLastContent_THFX').show();
                //审批意见
                $('#popup_divContent_THFX').show();
                //下一节点
                $('#popup_divNextNode_THFX').show();

                $('#popup_txtNodeUserName_THFX').attr('disabled', false);
                $('#popup_btnFindNodeUserName_THFX').attr('disabled', false);
                $('#popup_divClearNodeName_THFX').show();

                $('#popup_btnBack_THFX').show();
                $('#popup_btnSubmit_THFX').show().html('审批通过').attr('data-type', 2);
                $('#popup_btnCancel_THFX').show();

            }
            else if (type == 'renew') {
                //清空弹窗
                SoftwareTHFXHelper.ClearTaskPopup();
                //设置可写
                SoftwareTHFXHelper.SetTaskPopupWrite();


                /*上一节点审批意见*/
                $('#popup_divLastContent_THFX').show();
                //审批意见
                $('#popup_divContent_THFX').show();
                //下一节点
                $('#popup_divNextNode_THFX').show();

                $('#popup_btnBack_THFX').hide();
                $('#popup_btnSubmit_THFX').show().html('重新提交').attr('data-type', 2);
                $('#popup_btnCancel_THFX').show();

            }

            $('#Tk_software_04').modal('show');

            SoftwareTHFXHelper.LoadPlanRoute();
            SoftwareTHFXHelper.LoadTowingFile();
            
        },

        SetTaskPopupWrite: function () {

            //$('#popup_txtTaskName_THFX').attr('disabled', false);

            //$('#popup_txtBTW_THFX').attr('disabled', false);
            //$('#popup_txtTLPZ_THFX').attr('disabled', false);
            //$('#popup_txtCSXX_THFX').attr('disabled', false);

            $('#popup_btnPlanRouteUpload_THFX').attr('disabled', false);
            $('#popup_btnFileUpload_THFX').attr('disabled', false);
            $('#popup_txtTowingScheme_THFX').attr('disabled', false);



            $('#popup_txtNodeUserName_THFX').attr('disabled', false);
            $('#popup_btnFindNodeUserName_THFX').attr('disabled', false);
            $('#popup_divClearNodeName_THFX').show();

        },

        SetTaskPopupRead: function () {

            //$('#popup_txtTaskName_THFX').attr('disabled', true);

            //$('#popup_txtBTW_THFX').attr('disabled', true);
            //$('#popup_txtTLPZ_THFX').attr('disabled', true);
            //$('#popup_txtCSXX_THFX').attr('disabled', true);

            $('#popup_btnPlanRouteUpload_THFX').attr('disabled', true);
            $('#popup_btnFileUpload_THFX').attr('disabled', true);
            $('#popup_txtTowingScheme_THFX').attr('disabled', true);



            $('#popup_txtNodeUserName_THFX').attr('disabled', true);
            $('#popup_btnFindNodeUserName_THFX').attr('disabled', true);
            $('#popup_divClearNodeName_THFX').hide();

        },

        ClearTaskPopup: function () {

            $('#popup_txtTaskName_THFX').val('');

            //$('#popup_txtBTW_THFX').val('');
            //$('#popup_txtTLPZ_THFX').val('');
            //$('#popup_txtCSXX_THFX').val('');

            $('#popup_filePlanRouteUpload_THFX').val('');
            $('#popup_htmlPosition_THFX').html('');
            $('#popup_filePlanRouteUpload_THFX').val('');
            $('#popup_htmlTowingFile_THFX').html('');
            $('#popup_txtTowingScheme_THFX').val('');

            $('#popup_txtNodeUserName_THFX').val('');
            $('#popup_txtLastContent_THFX').val('');

            $('#popup_txtContent_THFX').val('');

        },

        ChoosedTaskNodeUser: { Name: '', UserCode: '', Depart: '', Phone: '', JobName: '', NextNodeID: '' },

        FindShjNodeUserByName: function () {

            Param.Name = $("#popup_txtNodeUserName_THFX").val();
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('FindShjUser', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var DataListHtml = '';
                            $(data.Data).each(function (index, dom) {

                                DataListHtml += '<li onclick="SoftwareTHFXHelper.ChooseNodeUser(this);" data-usercode="' + dom.empcode + '" data-name="' + dom.name + '" data-depart="' + dom.wholeDeptPath + '" data-phone="' + dom.phone + '" data-jobname="' + dom.jobname + '" ><h3>' + dom.name + '(' + dom.jobname + ')</h3><div>' + dom.wholeDeptPath + '</div></li >';

                            });
                            $('ul#popup_ulNodeUserList_THFX').html(DataListHtml);
                            $('ul#popup_ulNodeUserList_THFX').show();
                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        },

        ChooseNodeUser: function (dom) {

            //SoftwareTHFXHelper.ChoosedTaskNodeUser = {};

            if (dom == null)
                return;

            var Name = $(dom).attr('data-name');
            var UserCode = $(dom).attr('data-usercode');
            var Depart = $(dom).attr('data-depart');
            var Phone = $(dom).attr('data-phone');
            var JobName = $(dom).attr('data-jobname');

            SoftwareTHFXHelper.ChoosedTaskNodeUser.Name = Name;
            SoftwareTHFXHelper.ChoosedTaskNodeUser.UserCode = UserCode;
            SoftwareTHFXHelper.ChoosedTaskNodeUser.Depart = Depart;
            SoftwareTHFXHelper.ChoosedTaskNodeUser.Phone = Phone;
            SoftwareTHFXHelper.ChoosedTaskNodeUser.JobName = JobName;

            if (Name == '' || UserCode == '')
                return;

            $('#popup_txtNodeUserName_THFX').val(Name + '(' + Depart + ')');

            $('ul#popup_ulNodeUserList_THFX').hide();

        },

        PopupOpenedTaskID: 0,
        PopupIsBackFlow: false,
        PopupOpenedHandleType: 'new',
        OpenTaskInfo: function (TaskID) {

            Param.TaskID = TaskID;

            SoftwareTHFXHelper.PopupOpenedTaskID = 0;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('TaskQuery_THFX', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {
                            SoftwareTHFXHelper.PopupOpenedTaskID = TaskID;

                            var Task = data.Data;

                            //如果是已经结束的流程，直接打开文件获取弹窗
                            if (Task.FlowInfo.FlowStatus == 2) {

                                OpenReportPopup(TaskID);
                                return;
                            }

                            SoftwareTHFXHelper.OpenTaskPopup(Task.FlowInfo.FlowHandle, Task.ProjectID, Task.FlowInfo.FlowStatus);

                            SoftwareTHFXHelper.PopupOpenedHandleType = Task.FlowInfo.FlowHandle;

                            SoftwareTHFXHelper.PopupIsBackFlow = Task.FlowInfo.IsBackFlow;

                            //如果是最后的流程
                            SoftwareTHFXHelper.ChoosedTaskNodeUser.NextNodeID = Task.FlowInfo.NextNodeID;
                            if (Task.FlowInfo.NextNodeID == 0) {
                                $('#popup_txtNodeUserName_THFX').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_THFX').attr('disabled', true);
                                $('#popup_divClearNodeName_THFX').hide();
                            }

                            //下一节点如果有默认人物
                            if (Task.FlowInfo.NextNode != null && Task.FlowInfo.NextNode.length > 0) {

                                $('#popup_txtNodeUserName_THFX').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_THFX').attr('disabled', true);
                                $('#popup_divClearNodeName_THFX').hide();

                                var NodeUserHtml = '';
                                $(Task.FlowInfo.NextNode).each(function (index, dom) {

                                    NodeUserHtml += dom.UserName + '(' + dom.UserDepart + ');'

                                });
                                $('#popup_txtNodeUserName_THFX').val(NodeUserHtml);

                            }

                            //上一节点意见（可能多人）
                            var CommentHtml = '';
                            $(Task.FlowInfo.LastNode).each(function (index, dom) {
                                CommentHtml += dom.UserName + ':' + dom.Comment + ';\n'
                            });
                            $('#popup_txtLastContent_THFX').val(CommentHtml);
                            //下一节点
                            $('#popup_spanNextNodeName_THFX').html(Task.FlowInfo.NextNodeName);

                            //填充表单数据
                            $('#popup_txtTaskName_THFX').val(Task.TaskName);

                            $('#popup_txtTowingScheme_THFX').val(Task.TaskInfo_THFX.Scheme);

                            //$('#popup_txtBTW_THFX').val(Task.TaskInfo_THFX.Scheme);
                            //文件
                            //var fileHtml = '';
                            //var count = 1;
                            //$(Task.TaskInfo_THFX.Files).each(function (index, dom) {

                            //    fileHtml += '<tr><td>' + count + '</td><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a href="' + dom.FilePath + '">' + dom.FileName + '</a></td></tr>';
                            //    count++;
                            //})

                            //$('#popup_txtTLPZ_THFX').val(Task.TaskInfo_THFX.TLPZ);
                            //$('#popup_txtCSXX_THFX').val(Task.TaskInfo_THFX.CSXX);

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

