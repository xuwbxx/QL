        AddTaskSubmit: function (dom) {

            var type = $(dom).attr('data-type');
            if (type == null || type == '')
                return;

            var InfoText = '';
            if (type == 0) {
                InfoText = '是否要流程退回？流程将退回至上一节点人员';
            }
            else if (type == 1) {

                var TaskName = SoftwareTHFXHelper.CreateTaskName();
                if (TaskName == '') {
                    return;
                }
                $('#popup_txtTaskName_THFX').val(TaskName);
                InfoText = TaskName + '</br>是否要保存任务？';
            }
            else if (type == 2) {

                if (SoftwareTHFXHelper.PopupIsBackFlow == true) {
                    var TaskName = SoftwareTHFXHelper.CreateTaskName();
                    if (TaskName == '') {
                        return;
                    }
                    $('#popup_txtTaskName_THFX').val(TaskName);
                    InfoText = TaskName + '</br>是否要保存任务？';
                }
                else {
                    InfoText = '是否要审批通过？';
                }
            }
            else if (type == 3) {
                InfoText = '是否要作废流程？';
            }

            ModalPopup('information', InfoText);

            $("#ModalSubmit").unbind('click').bind('click', function () {
                SoftwareTHFXHelper.DoTaskSubmit(type);
            });

        },

        DoTaskSubmit: function (type) {

            if (type == 1) {
                SoftwareTHFXHelper.DoTaskAdd();
            }
            else if (type == 0 || type == 2) {
                SoftwareTHFXHelper.DoTaskApproval(type);
            }
            else if (type == 3) {
                SoftwareTHFXHelper.DoTaskCancel();
            }
        },

        CreateTaskName: function () {

            var TaskName = '拖航可行性分析与预报';

            TaskName += '(' + GetFullDateTimeString(new Date()) + ')';

            return TaskName;

        },

        DoTaskAdd: function () {

