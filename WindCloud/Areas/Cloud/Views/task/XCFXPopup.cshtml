        OpenCreateLibraryShip: function () {

            var IsDisplay = $('#popup_divLibraryShip_XCFX').css('display');
            if (IsDisplay == 'none') {
                $('#popup_divLibraryShip_XCFX').show();
            }
            else {
                $('#popup_divLibraryShip_XCFX').hide();
            }

        },


        CreateNewLibraryShip: function () {

            ModalPopup('information', '确认是否要新增船舶？');

            $("#ModalSubmit").unbind('click').bind('click', function () {
                SoftwareXCFXHelper.DoCreateNewLibraryShip();
            });

        },

        DoCreateNewLibraryShip: function () {

            var ShipName = $('#popup_LibraryShipName_XCFX').val();
            if (ShipName == '') {
                ModalPopup('error', '需要输入船名');
                return;
            }

            var formData = new FormData();
            var ShipFile = $('#popup_LibraryShipFile_XCFX')[0].files;
            if (ShipFile.length == 0) {
                ModalPopup('error', '没有任何船舶文件');
                return;
            }
            formData.append("ShipName", ShipName);
            formData.append("LibraryShipFile", ShipFile[0]);

            $.ajax({
                url: 'CreateLibraryKZYShip',
                dataType: 'json',
                type: 'POST',
                async: false,
                data: formData,
                processData: false, // 使数据不做处理
                contentType: false, // 不要设置Content-Type请求头
                success: function (data) {

                    if (data) {
                        if (data.Success) {

                            var ShipHtml = '';
                            $(data.Data).each(function (index, dom) {

                                ShipHtml += '<li><input type="checkbox" data-id="' + dom.ID + '" data-name="' + dom.ShipName + '"><a title="' + dom.ShipName + '" onclick="SoftwareXCFXHelper.OpenShip(' + dom.ID + ');">' + dom.ShipName.substring(0, 9) + '</a></li>';

                            })
                            $('#popup_ulShipList_XCFX').html(ShipHtml);

                            ModalPopup('success', '保存成功');

                        }
                        else {
                            ModalPopup('error', data.Message);
                        }

                    }

                },
                error: function (response) {
                    console.log(response);
                },
                complete: function (data) {
                    ModalClose('information');
                }
            });

        },

        UploadReportFile: function () {

            if (SoftwareXCFXHelper.PopupOpenedTaskID == 0)
                return;

            var UploadReports = $('#popup_uploadReport_XCFX')[0].files;
            if (UploadReports == null || UploadReports.length == 0)
                return;

            var formData = new FormData();
            formData.append("TaskID", SoftwareXCFXHelper.PopupOpenedTaskID);

            var FileCount = UploadReports.length;
            formData.append("TaskUploadReportCount", FileCount);
            var Count = 1;
            $(UploadReports).each(function (index, dom) {

                formData.append("TaskUploadReportFile" + Count, dom);

                Count++;
            });


            $.ajax({
                url: 'TaskXCFXReportUpload',
                dataType: 'json',
                type: 'POST',
                async: false,
                data: formData,
                processData: false, // 使数据不做处理
                contentType: false, // 不要设置Content-Type请求头
                success: function (data) {

                    if (data) {
                        if (data.Success) {

                            var CommentFileHtml = '';
                            $(data.Data).each(function (index, dom) {
                                CommentFileHtml += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a class="xm_zt_green" download="' + dom.FileName + '" href="' + dom.FilePath + '">下载</a> / <a class="xm_zt_red" onclick="SoftwareXCFXHelper.DeleteUploadFile(' + dom.ID + ')">删除</a></td></tr>';
                            });

                            $('#popup_htmlTaskReport_XCFX').html(CommentFileHtml);

                            ModalPopup('success', '上传成功');

                        }
                        else {
                            ModalPopup('error', data.Message);
                        }

                    }

                },
                error: function (response) {
                    console.log(response);
                },
                complete: function (data) {
                }
            });
        },

        DeleteUploadFile: function (FileID) {

            if (FileID == '' || FileID == 0) {
                return;
            }

            Param.ID = FileID;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            //下一节点人员
            $.post('DeleteXCFXFile', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            var CommentFileHtml = '';
                            $(data.Data).each(function (index, dom) {

                                CommentFileHtml += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a class="xm_zt_green" download="' + dom.FileName + '" href="' + dom.FilePath + '">下载</a> / <a class="xm_zt_red" onclick="SoftwareXCFXHelper.DeleteUploadFile(' + dom.ID + ')">删除</a></td></tr>';
                            });

                            $('#popup_htmlTaskReport_XCFX').html(CommentFileHtml);

                            ModalPopup('success', '删除成功');

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        },

    }


</script>