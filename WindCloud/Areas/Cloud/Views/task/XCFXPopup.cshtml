                            DoQuery();

                        }
                        else {

                            ModalPopup('error', data.Message);
                        }

                    }

                },
                error: function (response) {
                    console.log(response);
                },
                complete: function (data) {
                    ModalClose('information');
                }
            });

        },

        ShowPositionMap: function () {

            var Lon = $('#popup_Lon_XCFX').val();
            var Lat = $('#popup_Lat_XCFX').val();
            var ProjectID = $('#popup_btnShowPosition').attr('data-ProjectID');

            if (Lon == '' || Lat == '' || ProjectID == 0) {
                return;
            }

            var Url = '/Cloud/WebGIS/ShowPosition?ProjectID=' + ProjectID + '&TaskLon=' + Lon + '&TaskLat=' + Lat;

            window.open(Url, '_blank');

        },

        QueryFloatShip: function () {

            var ShipNameKeyWord = $('#popup_txtFloatShipName_XCFX').val();

            if (ShipNameKeyWord == '') {
                $('#popup_ulShipList_XCFX a').each(function (index, dom) {

                    $(dom).parent().show();

                })
            }
            else {
                $('#popup_ulShipList_XCFX a').each(function (index, dom) {

                    var ShipName = $(dom).html();

                    if (ShipName.indexOf(ShipNameKeyWord) == -1) {

                        $(dom).parent().hide();

                    }
                    else {
                        $(dom).parent().show();
                    }

                })
            }



        },

        OpenReport: function () {

            if (SoftwareXCFXHelper.PopupOpenedTaskID == 0) {
                return;
            }
            Param.TaskID = SoftwareXCFXHelper.PopupOpenedTaskID;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            //alert('123');
            $('#Tk_XCFXReport').modal('show');


            $.post('LoadTaskFile', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var FileHtml = '';
                            $(data.Data).each(function (index, dom) {

