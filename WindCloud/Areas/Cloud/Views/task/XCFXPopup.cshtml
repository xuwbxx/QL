            SubmitFormData.append("TaskName", $('#popup_txtTaskName_XCFX').val());
            //SubmitFormData.append("XCFXForecastStartTime", $('#popup_ForecastStartTime_XCFX').val());
            //SubmitFormData.append("XCFXForecastEndTime", $('#popup_ForecastEndTime_XCFX').val());
            //SubmitFormData.append("XCFXLat", $('#popup_txtLat_XCFX').val());
            //SubmitFormData.append("XCFXLon", $('#popup_txtLon_XCFX').val());
            //SubmitFormData.append("XCFXBalance", $('#popup_txtHZ_XCFX').val());
            //SubmitFormData.append("XCFXYFYNo", $('#popup_txtYFYTask_XCFX').val());

            //浮式船舶
            var ShipIDs = '';
            $('#popup_ulShipList_XCFX input:checkbox:checked').each(function (index, dom) {
                var ID = $(dom).attr('data-id');
                if (ID != 0) {
                    ShipIDs += ID + ',';
                }
            })
            SubmitFormData.append("ShipIDstring", ShipIDs.substring(0, ShipIDs.length - 1));
            SubmitFormData.append("XCFX_TaskDesc", $('#popup_txtTaskDesc_XCFX').val());

            if (SoftwareXCFXHelper.ChoosedTaskNodeUser.NextNodeID == 0) {

                //流程结束
                //SubmitFormData.append("XCFXLon", $('#popup_txtLon_XCFX').val());
                //SubmitFormData.append("XCFXLat", $('#popup_txtLat_XCFX').val());
                //SubmitFormData.append("XCFXWaterDepth", $('#popup_txtWaterDepth_XCFX').val());
                //SubmitFormData.append("XCFXStandard", $('#popup_txtStandard_XCFX').val());
            }

            $.ajax({
                url: 'TaskApprovalSubmit_XCFX',
                dataType: 'json',
                type: 'POST',
                async: false,
                data: SubmitFormData,
                processData: false, // 使数据不做处理
                contentType: false, // 不要设置Content-Type请求头
                success: function (data) {

                    if (data) {
                        if (data.Success) {
                            ModalPopup('success', '保存成功');
                            $('#Tk_software_07').modal('hide');

                            Param.ProjectID = $('#hid_ProjectID').val();
                            DoQuery();

                        }
                        else {

                            ModalPopup('error', data.Message);
                        }

                    }

                },
                error: function (response) {
                    console.log(response);
                },
                complete: function (data) {
                    ModalClose('information');
                }
            });

        },

        DoTaskCancel: function () {

            if (SoftwareXCFXHelper.PopupOpenedTaskID == 0) {
                ModalClose('information');
                ModalPopup('error', '数据出错，重新打开弹窗。');
                return;
            }

            var SubmitFormData = new FormData();
            SubmitFormData.append("TaskID", SoftwareXCFXHelper.PopupOpenedTaskID);

            $.ajax({
                url: 'TaskCancelSubmit_XCFX',
                dataType: 'json',
                type: 'POST',
                async: false,
                data: SubmitFormData,
                processData: false, // 使数据不做处理
                contentType: false, // 不要设置Content-Type请求头
                success: function (data) {

