<script>

    $(document).ready(function () {
        SoftwareXCFXHelper.Init();
        SoftwareXCFXHelper.LoadXCFXShip();
    })

    var SoftwareXCFXHelper = {
        Init: function () {

        },
        LoadXCFXShip: function () {

            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('LoadKZYShip', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var ShipHtml = '';
                            $(data.Data).each(function (index, dom) {

                                ShipHtml += '<li><input type="checkbox" data-id="' + dom.ID + '" data-name="' + dom.ShipName + '"><a onclick="SoftwareXCFXHelper.OpenShip(' + dom.ID + ');">' + dom.ShipName + '</a></li>';

                            })
                            $('#popup_ulShipList_XCFX').html(ShipHtml);


                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        },
        OpenPopup: function () {

            var ChooseProjectID = $('#hid_ProjectID').val();
            if (ChooseProjectID == null || ChooseProjectID == '' || ChooseProjectID == 0) {
                ModalPopup('error', '必须先选择所关联的风场');
                return;
            }
            SoftwareXCFXHelper.PopupOpenedHandleType = 'new';
            SoftwareXCFXHelper.OpenTaskPopup('new', ChooseProjectID);

            Param.SoftwareID = 7;
            //下一节点人员
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('NextNodeQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            $('#popup_spanNextNodeName_XCFX').html(data.Data.NodeName);

                            if (data.Data.NodeUsers.length > 0) {

                                $('#popup_txtNodeUserName_XCFX').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_XCFX').attr('disabled', true);
                                $('#popup_divClearNodeName_XCFX').hide();

                                var NodeUserHtml = '';
                                $(data.Data.NodeUsers).each(function (index, dom) {

                                    NodeUserHtml += dom.ManageName + '(' + dom.ManageDepart + ');'

                                });
                                $('#popup_txtNodeUserName_XCFX').val(NodeUserHtml);

                            }
                            else {
                                $('#popup_txtNodeUserName_XCFX').attr('disabled', false);
                                $('#popup_btnFindNodeUserName_XCFX').attr('disabled', false);
                                $('#popup_divClearNodeName_XCFX').show();
                            }

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        },

        OpenTaskPopup: function (type, ProjectID, FlowStatus) {
            $('#popup_divSubmit_XCFX').show();
            if (type == 'new') {
                //清空弹窗
                SoftwareXCFXHelper.ClearTaskPopup();
                //设置可写
                SoftwareXCFXHelper.SetTaskPopupWrite();

                //任务数据
                //选船报告
                $('#popup_divReport_XCFX').hide();

                /*上一节点审批意见*/
                $('#popup_divLastContent_XCFX').hide();
                //审批意见
                $('#popup_divContent_XCFX').hide();
                //下一节点
                $('#popup_divNextNode_XCFX').show();

                //提交按钮
                $('#popup_btnSubmit_XCFX').show().html('申请').attr('data-type', 1);
                $('#popup_btnBack_XCFX').hide();
                $('#popup_btnCancel_XCFX').hide();



            }
            else if (type == 'view') {
                //清空弹窗
                SoftwareXCFXHelper.ClearTaskPopup();
                //设置可写
                SoftwareXCFXHelper.SetTaskPopupRead();

                //任务数据
                //选船报告
                $('#popup_divReport_XCFX').show();

                /*上一节点审批意见*/
                $('#popup_divLastContent_XCFX').show();
                //审批意见
                $('#popup_divContent_XCFX').hide();
                //下一节点
                $('#popup_divNextNode_XCFX').hide();

                $('#popup_btnSubmit_XCFX').hide();
                $('#popup_btnBack_XCFX').hide();
                $('#popup_btnCancel_XCFX').hide();

                //作废的流程
                if (FlowStatus == 3) {
                    $('#popup_divSubmit_XCFX').hide();
                }

            }
            else if (type == 'approval') {
                //清空弹窗
                SoftwareXCFXHelper.ClearTaskPopup();
                //设置只读
                SoftwareXCFXHelper.SetTaskPopupRead();

                //任务数据
                //选船报告
                $('#popup_divReport_XCFX').show();
                $('#popup_uploadReport_XCFX').attr('disabled', false);
                $('#popup_btn_uploadReport_XCFX').attr('disabled', false);

                /*上一节点审批意见*/
                $('#popup_divLastContent_XCFX').show();
                //审批意见
                $('#popup_divContent_XCFX').show();
                //下一节点
                $('#popup_divNextNode_XCFX').show();

                $('#popup_txtNodeUserName_XCFX').attr('disabled', false);
                $('#popup_btnFindNodeUserName_XCFX').attr('disabled', false);
                $('#popup_divClearNodeName_XCFX').show();

                $('#popup_btnBack_XCFX').show();
                $('#popup_btnSubmit_XCFX').show().html('审批通过').attr('data-type', 2);
                $('#popup_btnCancel_XCFX').show();


            }
            else if (type == 'renew') {
                //清空弹窗
                SoftwareXCFXHelper.ClearTaskPopup();
                //设置可写
                SoftwareXCFXHelper.SetTaskPopupWrite();

                //任务数据
                //选船报告
                $('#popup_divReport_XCFX').hide();

                /*上一节点审批意见*/
                $('#popup_divLastContent_XCFX').show();
                //审批意见
                $('#popup_divContent_XCFX').show();
                //下一节点
                $('#popup_divNextNode_XCFX').show();

                $('#popup_btnBack_XCFX').hide();
                $('#popup_btnSubmit_XCFX').show().html('重新提交').attr('data-type', 2);
                $('#popup_btnCancel_XCFX').show();

            }

            $('#Tk_software_07').modal('show');

        },

        SetTaskPopupWrite: function () {

            //$('#popup_txtTaskName_XCFX').attr('disabled', false);

            $('#popup_btnOpenCreateLibraryShip_XCFX').attr('disabled', false);

            $('#popup_btn_uploadReport_XCFX').attr('disabled', false);

            $('#popup_ulShipList_XCFX input:checkbox').attr('disabled', false);
            $('#popup_htmlTaskReport_XCFX').attr('disabled', false);
            $('#popup_txtTaskDesc_XCFX').attr('disabled', false);

            $('#popup_txtNodeUserName_XCFX').attr('disabled', false);
            $('#popup_btnFindNodeUserName_XCFX').attr('disabled', false);
            $('#popup_divClearNodeName_XCFX').show();

        },

        SetTaskPopupRead: function () {

            //$('#popup_txtTaskName_XCFX').attr('disabled', true);

            $('#popup_btnOpenCreateLibraryShip_XCFX').attr('disabled', true);

            $('#popup_btn_uploadReport_XCFX').attr('disabled', true);

            $('#popup_ulShipList_XCFX input:checkbox').attr('disabled', true);
            $('#popup_htmlTaskReport_XCFX').attr('disabled', true);
            $('#popup_txtTaskDesc_XCFX').attr('disabled', true);

            $('#popup_txtNodeUserName_XCFX').attr('disabled', true);
            $('#popup_btnFindNodeUserName_XCFX').attr('disabled', true);
            $('#popup_divClearNodeName_XCFX').hide();

        },

        ClearTaskPopup: function () {

            $('#popup_txtTaskName_XCFX').val('');
            $('#popup_ulShipList_XCFX input:checkbox').prop('checked', false);
            $('#popup_htmlTaskReport_XCFX').html('');
            $('#popup_txtTaskDesc_XCFX').val('');


            $('#popup_txtNodeUserName_XCFX').val('');
            $('#popup_txtLastContent_XCFX').val('');
            $('#popup_txtContent_XCFX').val('');

        },

        ChoosedTaskNodeUser: { Name: '', UserCode: '', Depart: '', Phone: '', JobName: '', NextNodeID: '' },

        FindShjNodeUserByName: function () {

            Param.Name = $("#popup_txtNodeUserName_XCFX").val();
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('FindShjUser', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var DataListHtml = '';
                            $(data.Data).each(function (index, dom) {

                                DataListHtml += '<li onclick="SoftwareXCFXHelper.ChooseNodeUser(this);" data-usercode="' + dom.empcode + '" data-name="' + dom.name + '" data-depart="' + dom.wholeDeptPath + '" data-phone="' + dom.phone + '" data-jobname="' + dom.jobname + '" ><h3>' + dom.name + '(' + dom.jobname + ')</h3><div>' + dom.wholeDeptPath + '</div></li >';

                            });
                            $('ul#popup_ulNodeUserList_XCFX').html(DataListHtml);
                            $('ul#popup_ulNodeUserList_XCFX').show();
                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        },

        ChooseNodeUser: function (dom) {

            //SoftwareXCFXHelper.ChoosedTaskNodeUser = {};

            if (dom == null)
                return;

            var Name = $(dom).attr('data-name');
            var UserCode = $(dom).attr('data-usercode');
            var Depart = $(dom).attr('data-depart');
            var Phone = $(dom).attr('data-phone');
            var JobName = $(dom).attr('data-jobname');

            SoftwareXCFXHelper.ChoosedTaskNodeUser.Name = Name;
            SoftwareXCFXHelper.ChoosedTaskNodeUser.UserCode = UserCode;
            SoftwareXCFXHelper.ChoosedTaskNodeUser.Depart = Depart;
            SoftwareXCFXHelper.ChoosedTaskNodeUser.Phone = Phone;
            SoftwareXCFXHelper.ChoosedTaskNodeUser.JobName = JobName;

            if (Name == '' || UserCode == '')
                return;

            $('#popup_txtNodeUserName_XCFX').val(Name + '(' + Depart + ')');

            $('ul#popup_ulNodeUserList_XCFX').hide();

        },

        PopupOpenedTaskID: 0,
        PopupIsBackFlow: false,
        PopupOpenedHandleType: 'new',
        OpenTaskInfo: function (TaskID) {

            Param.TaskID = TaskID;

            SoftwareXCFXHelper.PopupOpenedTaskID = 0;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('TaskQuery_XCFX', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {
                            SoftwareXCFXHelper.PopupOpenedTaskID = TaskID;

                            var Task = data.Data;

                            //如果是已经结束的流程，直接打开文件获取弹窗
                            if (Task.FlowInfo.FlowStatus == 2) {

                                OpenReportPopup(TaskID);
                                return;
                            }

                            SoftwareXCFXHelper.OpenTaskPopup(Task.FlowInfo.FlowHandle, Task.ProjectID, Task.FlowInfo.FlowStatus);

                            SoftwareXCFXHelper.PopupOpenedHandleType = Task.FlowInfo.FlowHandle;

                            SoftwareXCFXHelper.PopupIsBackFlow = Task.FlowInfo.IsBackFlow;

                            if (Task.FlowInfo.DoEditConfirm == true) {

                            }

                            if (Task.FlowInfo.IsUsingFlowNode) {
                                $('#popup_divContent_XCFX').hide();
                                $('#popup_divNextNode_XCFX').hide();
                                $('#popup_btnSubmit_XCFX').hide();
                                $('#popup_btnBack_XCFX').hide();
                            }

                            //如果是最后的流程
                            SoftwareXCFXHelper.ChoosedTaskNodeUser.NextNodeID = Task.FlowInfo.NextNodeID;
                            if (Task.FlowInfo.NextNodeID == 0) {
                                $('#popup_txtNodeUserName_XCFX').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_XCFX').attr('disabled', true);
                                $('#popup_divClearNodeName_XCFX').hide();
                            }

                            //下一节点如果有默认人物
                            if (Task.FlowInfo.NextNode != null && Task.FlowInfo.NextNode.length > 0) {

                                $('#popup_txtNodeUserName_XCFX').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_XCFX').attr('disabled', true);
                                $('#popup_divClearNodeName_XCFX').hide();

                                var NodeUserHtml = '';
                                $(Task.FlowInfo.NextNode).each(function (index, dom) {

                                    NodeUserHtml += dom.UserName + '(' + dom.UserDepart + ');'

                                });
                                $('#popup_txtNodeUserName_XCFX').val(NodeUserHtml);

                            }

                            //上一节点意见（可能多人）
                            var CommentHtml = '';
                            $(Task.FlowInfo.LastNode).each(function (index, dom) {
                                CommentHtml += dom.UserName + ':' + dom.Comment + ';\n'
                            });
                            $('#popup_txtLastContent_XCFX').val(CommentHtml);
                            //下一节点
                            $('#popup_spanNextNodeName_XCFX').html(Task.FlowInfo.NextNodeName);



                            var ReportFileHtml = '';
                            $(Task.Report.ReportFile).each(function (index, dom) {
                                ReportFileHtml += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a class="xm_zt_green" download="' + dom.FileName + '" href="' + dom.FilePath + '">下载</a> / <a class="xm_zt_red" onclick="SoftwareXCFXHelper.DeleteUploadFile(' + dom.ID + ')">删除</a></td></tr>';
                            })
                            $('#popup_htmlTaskReport_XCFX').html(ReportFileHtml);


                            //填充表单数据
                            $('#popup_txtTaskName_XCFX').val(Task.TaskName);
                            $(Task.TaskInfo_XCFX.ShipIDs).each(function (index, dom) {
                                $('#popup_ulShipList_XCFX input[data-id="' + dom + '"]').prop('checked', true);
                            });

                            $('#popup_txtTaskDesc_XCFX').val(Task.TaskInfo_XCFX.TaskDesc);

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        },

        ClearShjNodeUserName: function () {
            SoftwareXCFXHelper.ChoosedTaskNodeUser = {};
            $('#popup_txtNodeUserName_XCFX').val('');
        },

        AddTaskSubmit: function (dom) {

            var type = $(dom).attr('data-type');
            if (type == null || type == '')
                return;

            var InfoText = '';
            if (type == 0) {
                InfoText = '是否要流程退回？流程将退回至上一节点人员';
            }
            else if (type == 1) {

                var TaskName = SoftwareXCFXHelper.CreateTaskName();
                if (TaskName == '') {
                    return;
                }
                $('#popup_txtTaskName_XCFX').val(TaskName);
                InfoText = TaskName + '</br>是否要保存任务？';
            }
            else if (type == 2) {

                if (SoftwareXCFXHelper.PopupIsBackFlow == true) {
                    var TaskName = SoftwareXCFXHelper.CreateTaskName();
                    if (TaskName == '') {
                        return;
                    }
                    $('#popup_txtTaskName_XCFX').val(TaskName);
                    InfoText = TaskName + '</br>是否要保存任务？';
                }
                else {
                    InfoText = '是否要审批通过？';
                }
            }
            else if (type == 3) {
                InfoText = '是否要作废流程？';
            }

            ModalPopup('information', InfoText);

            $("#ModalSubmit").unbind('click').bind('click', function () {
                SoftwareXCFXHelper.DoTaskSubmit(type);
            });

        },

        DoTaskSubmit: function (type) {

            if (type == 1) {
                SoftwareXCFXHelper.DoTaskAdd();
            }
            else if (type == 0 || type == 2) {
                SoftwareXCFXHelper.DoTaskApproval(type);
            }
            else if (type == 3) {
                SoftwareXCFXHelper.DoTaskCancel();
            }
        },

        CreateTaskName: function () {

            var TaskName = '';

            //平台船
            var ShipIDs = [];
            $('#popup_ulShipList_XCFX input:checkbox:checked').each(function (index, dom) {
                var ID = $(dom).attr('data-id');
                if (ID != 0) {
                    ShipIDs.push(ID);
                }
            })

            if (ShipIDs.length == 0) {
                ModalClose('information');
                ModalPopup('error', '没有选择任何平台船');
                return '';
            }



            //if (ShipIDs.length == 1) {

            //    TaskName += '(' + $('#popup_ulShipList_XCFX input:checkbox:checked').next().first().html() + ')起重船基础施工可作业性预报';
            //}
            //else {
            //    TaskName += '(' + $('#popup_ulShipList_XCFX input:checkbox:checked').next().first().html() + ')等' + ShipIDs.length + '条起重船基础施工可作业性预报';
            //}

            TaskName += '基于历史环境数据的选船分析(' + GetFullDateTimeString(new Date()) + ')';

            return TaskName;

        },

        DoTaskAdd: function () {

            var ProjectID = $('#hid_ProjectID').val();
            if (ProjectID == null || ProjectID == '' || ProjectID == 0) {
                ModalClose('information');
                ModalPopup('error', '软件申请页面需要选择关联风电项目');
                return;
            }

            var SubmitFormData = new FormData();
            SubmitFormData.append("ProjectID", ProjectID);
            SubmitFormData.append("TaskID", SoftwareXCFXHelper.PopupOpenedTaskID);
            SubmitFormData.append("SoftwareID", 7);

            //节点人员
            SubmitFormData.append("TaskNodeName", SoftwareXCFXHelper.ChoosedTaskNodeUser.Name);
            SubmitFormData.append("TaskNodeUserCode", SoftwareXCFXHelper.ChoosedTaskNodeUser.UserCode);
            SubmitFormData.append("TaskNodeDepart", SoftwareXCFXHelper.ChoosedTaskNodeUser.Depart);
            SubmitFormData.append("TaskNodePhone", SoftwareXCFXHelper.ChoosedTaskNodeUser.Phone);
            SubmitFormData.append("TaskNodeJobName", SoftwareXCFXHelper.ChoosedTaskNodeUser.JobName);

            //船舶
            var ShipIDs = '';
            $('#popup_ulShipList_XCFX input:checkbox:checked').each(function (index, dom) {
                var ID = $(dom).attr('data-id');
                if (ID != 0) {
                    ShipIDs += ID + ',';
                }
            })
            SubmitFormData.append("ShipIDstring", ShipIDs.substring(0, ShipIDs.length - 1));
            SubmitFormData.append("XCFX_TaskDesc", $('#popup_txtTaskDesc_XCFX').val());

            SubmitFormData.append("TaskName", $('#popup_txtTaskName_XCFX').val());

            $.ajax({
                url: 'TaskSubmit_XCFX',
                dataType: 'json',
                type: 'POST',
                async: false,
                data: SubmitFormData,
                processData: false, // 使数据不做处理
                contentType: false, // 不要设置Content-Type请求头
                success: function (data) {

                    if (data) {
                        if (data.Success) {
                            ModalPopup('success', '保存成功');
                            $('#Tk_software_07').modal('hide');
                            $('#tk_WorkTasks').modal('hide');

                            Param.ProjectID = $('#hid_ProjectID').val();
                            DoQuery();


                        }
                        else {

                            ModalPopup('error', data.Message);
                        }

                    }

                },
                error: function (response) {
                    console.log(response);
                },
                complete: function (data) {
                    ModalClose('information');
                }
            });

        },

        DoTaskApproval: function (type) {

            if (SoftwareXCFXHelper.PopupOpenedTaskID == 0) {
                ModalClose('information');
                ModalPopup('error', '数据出错，重新打开弹窗。');
                return;
            }

            var SubmitFormData = new FormData();

            SubmitFormData.append("ApprovalType", type);
            SubmitFormData.append("IsBackFlow", SoftwareXCFXHelper.PopupIsBackFlow);
            SubmitFormData.append("NodeID", SoftwareXCFXHelper.ChoosedTaskNodeUser.NextNodeID);
            SubmitFormData.append("TaskID", SoftwareXCFXHelper.PopupOpenedTaskID);
            SubmitFormData.append("TaskComment", $('#popup_txtContent_XCFX').val());


            //正常审批
            SubmitFormData.append("TaskNodeName", SoftwareXCFXHelper.ChoosedTaskNodeUser.Name);
            SubmitFormData.append("TaskNodeUserCode", SoftwareXCFXHelper.ChoosedTaskNodeUser.UserCode);
