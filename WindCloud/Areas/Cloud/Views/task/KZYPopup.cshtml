                                <div class="col-md-10 p0 xmjbxx_box">

                                    <div class="col-md-5">
                                        <span>亿方云TaskNo</span>
                                        <input type="text" class="form-control" placeholder="例如：TN10503" id="popup_txtYFYTask_KZY">
                                    </div>

                                    <div class="col-md-5">
                                        <span>衡准</span>
                                        <input type="number" class="form-control" placeholder="例如：0.3" id="popup_txtHZ_KZY">
                                    </div>

                                    <div class="col-md-5">
                                        <span>风场经度</span>
                                        <input type="number" class="form-control" placeholder="例如：122.053478" id="popup_txtLon_KZY">
                                    </div>

                                    <div class="col-md-5">
                                        <span>风场纬度</span>
                                        <input type="number" class="form-control" placeholder="例如：29.664924" id="popup_txtLat_KZY">
                                    </div>


                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-2 control-label">推送时间</label>
                            <div class="col-md-5">
                                <input placeholder="开始时间" class="laydate-icon timeUstyle stateUTime form-control" id="popup_ForecastStartTime_KZY" onclick="laydate({istime: true,format:'YYYY-MM-DD'})">

                            </div>
                            <div class="col-md-5">
                                <input placeholder="结束时间" class="laydate-icon timeUstyle stateUTime form-control" id="popup_ForecastEndTime_KZY" onclick="laydate({istime: true,format:'YYYY-MM-DD'})">

