        ShowPositionMap: function () {

            var Lon = $('#popup_Lon_KZY').val();
            var Lat = $('#popup_Lat_KZY').val();
            var ProjectID = $('#popup_btnShowPosition').attr('data-ProjectID');

            if (Lon == '' || Lat == '' || ProjectID == 0) {
                return;
            }

            var Url = '/Cloud/WebGIS/ShowPosition?ProjectID=' + ProjectID + '&TaskLon=' + Lon + '&TaskLat=' + Lat;

            window.open(Url, '_blank');

        },

        QueryFloatShip: function () {

            var ShipNameKeyWord = $('#popup_txtFloatShipName_KZY').val();

            if (ShipNameKeyWord == '') {
                $('#popup_ulFloatList_KZY a').each(function (index, dom) {

                    $(dom).parent().show();

                })
            }
            else {
                $('#popup_ulFloatList_KZY a').each(function (index, dom) {

                    var ShipName = $(dom).html();

                    if (ShipName.indexOf(ShipNameKeyWord) == -1) {

                        $(dom).parent().hide();

                    }
                    else {
                        $(dom).parent().show();
                    }

                })
            }



        },

        OpenReport: function () {

            if (SoftwareKZYHelper.PopupOpenedTaskID == 0)
            {
                return;
            }
            Param.TaskID = SoftwareKZYHelper.PopupOpenedTaskID;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            //alert('123');
            $('#Tk_KZYReport').modal('show');


            $.post('LoadTaskFile', Param)
                .success(function (data, statusText, jqXRH) {
