<script>

    $(document).ready(function () {
        SoftwareKZYHelper.Init();
        SoftwareKZYHelper.LoadKZYShip();
    })

    var SoftwareKZYHelper = {
        Init: function () {
            SoftwareKZYHelper.ForecastTimeInit();
        },
        ForecastTimeInit: function () {
            $('#popup_ForecastStartTime_KZY').val(formatDateTimeByDay(new Date()));
            $('#popup_ForecastEndTime_KZY').val(formatDateTimeByDay(new Date(new Date().setDate(new Date().getDate() + 90))));
        },
        LoadKZYShip: function () {

            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('LoadKZYShip', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {

                        if (data.Success) {

                            var ShipHtml = '';
                            $(data.Data).each(function (index, dom) {

                                ShipHtml += '<li><input type="checkbox" data-id="' + dom.ID + '" data-name="' + dom.ShipName + '"><a onclick="SoftwareKZYHelper.OpenShip(' + dom.ID + ');">' + dom.ShipName + '</a></li>';

                            })
                            $('#popup_ulFloatList_KZY').html(ShipHtml);


                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        },
        OpenPopup: function () {

            var ChooseProjectID = $('#hid_ProjectID').val();
            if (ChooseProjectID == null || ChooseProjectID == '' || ChooseProjectID == 0) {
                ModalPopup('error', '必须先选择所关联的风场');
                return;
            }
            SoftwareKZYHelper.PopupOpenedHandleType = 'new';
            SoftwareKZYHelper.OpenTaskPopup('new', ChooseProjectID);

            Param.SoftwareID = 3;
            //下一节点人员
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('NextNodeQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            $('#popup_spanNextNodeName_KZY').html(data.Data.NodeName);

                            if (data.Data.NodeUsers.length > 0) {

                                $('#popup_txtNodeUserName_KZY').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_KZY').attr('disabled', true);
                                $('#popup_divClearNodeName_KZY').hide();

                                var NodeUserHtml = '';
                                $(data.Data.NodeUsers).each(function (index, dom) {

                                    NodeUserHtml += dom.ManageName + '(' + dom.ManageDepart + ');'

                                });
                                $('#popup_txtNodeUserName_KZY').val(NodeUserHtml);

                            }
                            else {
                                $('#popup_txtNodeUserName_KZY').attr('disabled', false);
                                $('#popup_btnFindNodeUserName_KZY').attr('disabled', false);
                                $('#popup_divClearNodeName_KZY').show();
                            }

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        },

        OpenTaskPopup: function (type, ProjectID, FlowStatus) {
            $('#popup_divSubmit_KZY').show();
            if (type == 'new') {
                //清空弹窗
                SoftwareKZYHelper.ClearTaskPopup();
                //设置可写
                SoftwareKZYHelper.SetTaskPopupWrite();

                //技术中心区域
                $('#popup_divTechEdit_KZY').hide();
                //报告文件
                $('#popup_divReport_KZY').hide();
                /*上一节点审批意见*/
                $('#popup_divLastContent_KZY').hide();
                //审批意见
                $('#popup_divContent_KZY').hide();
                //下一节点
                $('#popup_divNextNode_KZY').show();

                //提交按钮
                $('#popup_btnSubmit_KZY').show().html('申请').attr('data-type', 1);
                $('#popup_btnBack_KZY').hide();
                $('#popup_btnCancel_KZY').hide();

                

            }
            else if (type == 'view') {
                //清空弹窗
                SoftwareKZYHelper.ClearTaskPopup();
                //设置可写
                SoftwareKZYHelper.SetTaskPopupRead();

                $('#popup_ulFloatList_KZY input:checkbox').attr('disabled', true);

                //技术中心区域
                $('#popup_divTechEdit_KZY').show();

                //成果报告（需要另外判断）
                $('#popup_divReport_KZY').show();

                /*上一节点审批意见*/
                $('#popup_divLastContent_KZY').show();
                //审批意见
                $('#popup_divContent_KZY').hide();
                //下一节点
                $('#popup_divNextNode_KZY').hide();

                $('#popup_btnSubmit_KZY').hide();
                $('#popup_btnBack_KZY').hide();
                $('#popup_btnCancel_KZY').hide();

                //作废的流程
                if (FlowStatus == 3) {
                    $('#popup_divSubmit_KZY').hide();
                }

            }
            else if (type == 'approval') {
                //清空弹窗
                SoftwareKZYHelper.ClearTaskPopup();
                //设置只读
                SoftwareKZYHelper.SetTaskPopupRead();



                //技术中心区域
                $('#popup_divTechEdit_KZY').show();
                $('#popup_txtYFYTask_KZY').attr('disabled', false);
                $('#popup_txtHZ_KZY').attr('disabled', false);
                $('#popup_txtLon_KZY').attr('disabled', false);
                $('#popup_txtLat_KZY').attr('disabled', false);

                $('#popup_ForecastStartTime_KZY').attr('disabled', false);
                $('#popup_ForecastEndTime_KZY').attr('disabled', false);

                //成果报告（需要另外判断）
                $('#popup_divReport_KZY').show();

                /*上一节点审批意见*/
                $('#popup_divLastContent_KZY').show();
                //审批意见
                $('#popup_divContent_KZY').show();
                //下一节点
                $('#popup_divNextNode_KZY').show();

                $('#popup_txtNodeUserName_KZY').attr('disabled', false);
                $('#popup_btnFindNodeUserName_KZY').attr('disabled', false);
                $('#popup_divClearNodeName_KZY').show();

                $('#popup_btnBack_KZY').show();
                $('#popup_btnSubmit_KZY').show().html('审批通过').attr('data-type', 2);
                $('#popup_btnCancel_KZY').show();

                //个性化要求
                //$('#popup_txtLon_KZY').attr('disabled', false);
                //$('#popup_txtLat_KZY').attr('disabled', false);
                //$('#popup_txtWaterDepth_KZY').attr('disabled', false);
                //$('#popup_txtStandard_KZY').attr('disabled', false);


            }
            else if (type == 'renew') {
                //清空弹窗
                SoftwareKZYHelper.ClearTaskPopup();
                //设置可写
                SoftwareKZYHelper.SetTaskPopupWrite();

                //技术中心区域

                $('#popup_divTechEdit_KZY').hide();

                //成果报告（需要另外判断）
                $('#popup_divReport_KZY').show();

                /*上一节点审批意见*/
                $('#popup_divLastContent_KZY').show();
                //审批意见
                $('#popup_divContent_KZY').show();
                //下一节点
                $('#popup_divNextNode_KZY').show();

                $('#popup_btnBack_KZY').hide();
                $('#popup_btnSubmit_KZY').show().html('重新提交').attr('data-type', 2);
                $('#popup_btnCancel_KZY').show();

            }

            $('#Tk_software_03').modal('show');
            
        },

        SetTaskPopupWrite: function () {

            //$('#popup_txtTaskName_KZY').attr('disabled', false);

            $('#popup_ulFloatList_KZY input:checkbox').attr('disabled', false);

            $('#popup_txtYFYTask_KZY').attr('disabled', false);
            $('#popup_txtHZ_KZY').attr('disabled', false);
            $('#popup_txtLon_KZY').attr('disabled', false);
            $('#popup_txtLat_KZY').attr('disabled', false);

            $('#popup_ForecastStartTime_KZY').attr('disabled', false);
            $('#popup_ForecastEndTime_KZY').attr('disabled', false);

            $('#popup_txtNodeUserName_KZY').attr('disabled', false);
            $('#popup_btnFindNodeUserName_KZY').attr('disabled', false);
            $('#popup_divClearNodeName_KZY').show();

        },

        SetTaskPopupRead: function () {

            //$('#popup_txtTaskName_KZY').attr('disabled', true);

            $('#popup_ulFloatList_KZY input:checkbox').attr('disabled', true);

            $('#popup_txtYFYTask_KZY').attr('disabled', true);
            $('#popup_txtHZ_KZY').attr('disabled', true);
            $('#popup_txtLon_KZY').attr('disabled', true);
            $('#popup_txtLat_KZY').attr('disabled', true);

            $('#popup_ForecastStartTime_KZY').attr('disabled', true);
            $('#popup_ForecastEndTime_KZY').attr('disabled', true);

            $('#popup_txtNodeUserName_KZY').attr('disabled', true);
            $('#popup_btnFindNodeUserName_KZY').attr('disabled', true);
            $('#popup_divClearNodeName_KZY').hide();

        },

        ClearTaskPopup: function () {

            $('#popup_txtTaskName_KZY').val('');

            $('#popup_ulFloatList_KZY input:checkbox').prop('checked', false);


            $('#popup_ForecastStartTime_KZY').val('');
            $('#popup_ForecastEndTime_KZY').val('');

            //$('#popup_txtLon_KZY').val('');
            //$('#popup_txtLat_KZY').val('');

            //$('#popup_txtWaterDepth_KZY').val('');
            //$('#popup_txtStandard_KZY').val('');

            $('#popup_htmlTaskReportFile_KZY').html('');

            $('#popup_txtNodeUserName_KZY').val('');

            $('#popup_txtLastContent_KZY').val('');
            //$('#popup_ulLastNodeCommentFile_KZY').html('');

            $('#popup_txtContent_KZY').val('');
            $('#popup_ulNodeCommentFile_KZY').html('');


            SoftwareKZYHelper.ForecastTimeInit();
        },

        ChoosedTaskNodeUser: { Name: '', UserCode: '', Depart: '', Phone: '', JobName: '', NextNodeID: '' },

        FindShjNodeUserByName: function () {

            Param.Name = $("#popup_txtNodeUserName_KZY").val();
