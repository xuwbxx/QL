        ChooseNodeUser: function (dom) {

            //SoftwareKZYHelper.ChoosedTaskNodeUser = {};

            if (dom == null)
                return;

            var Name = $(dom).attr('data-name');
            var UserCode = $(dom).attr('data-usercode');
            var Depart = $(dom).attr('data-depart');
            var Phone = $(dom).attr('data-phone');
            var JobName = $(dom).attr('data-jobname');

            SoftwareKZYHelper.ChoosedTaskNodeUser.Name = Name;
            SoftwareKZYHelper.ChoosedTaskNodeUser.UserCode = UserCode;
            SoftwareKZYHelper.ChoosedTaskNodeUser.Depart = Depart;
            SoftwareKZYHelper.ChoosedTaskNodeUser.Phone = Phone;
            SoftwareKZYHelper.ChoosedTaskNodeUser.JobName = JobName;

            if (Name == '' || UserCode == '')
                return;

            $('#popup_txtNodeUserName_KZY').val(Name + '(' + Depart + ')');

            $('ul#popup_ulNodeUserList_KZY').hide();

        },

        PopupOpenedTaskID: 0,
        PopupIsBackFlow: false,
        PopupOpenedHandleType: 'new',
        OpenTaskInfo: function (TaskID) {

            Param.TaskID = TaskID;

            SoftwareKZYHelper.PopupOpenedTaskID = 0;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('TaskQuery_KZY', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {
                            SoftwareKZYHelper.PopupOpenedTaskID = TaskID;

                            var Task = data.Data;

                            //如果是已经结束的流程，直接打开文件获取弹窗
                            if (Task.FlowInfo.FlowStatus == 2) {

                                OpenReportPopup(TaskID);
                                return;
                            }

                            SoftwareKZYHelper.OpenTaskPopup(Task.FlowInfo.FlowHandle, Task.ProjectID, Task.FlowInfo.FlowStatus);

                            SoftwareKZYHelper.PopupOpenedHandleType = Task.FlowInfo.FlowHandle;

                            SoftwareKZYHelper.PopupIsBackFlow = Task.FlowInfo.IsBackFlow;

                            //if (Task.FlowInfo.FlowHandle == 'renew' && Task.FlowInfo.NodeID == 9)
                            //{
                            //    $('#popup_divTechEdit_KZY').show();
                            //}


                            if (Task.FlowInfo.DoEditConfirm == true) {
                                
                            }

                            if (Task.FlowInfo.IsUsingFlowNode) {
                                $('#popup_divContent_KZY').hide();
                                $('#popup_divNextNode_KZY').hide();
                                $('#popup_btnSubmit_KZY').hide();
                                $('#popup_btnBack_KZY').hide();
                            }

                            //如果是最后的流程
                            SoftwareKZYHelper.ChoosedTaskNodeUser.NextNodeID = Task.FlowInfo.NextNodeID;
                            if (Task.FlowInfo.NextNodeID == 0) {
                                $('#popup_txtNodeUserName_KZY').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_KZY').attr('disabled', true);
                                $('#popup_divClearNodeName_KZY').hide();
                            }

                            //下一节点如果有默认人物
                            if (Task.FlowInfo.NextNode != null && Task.FlowInfo.NextNode.length > 0) {

                                $('#popup_txtNodeUserName_KZY').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_KZY').attr('disabled', true);
                                $('#popup_divClearNodeName_KZY').hide();

                                var NodeUserHtml = '';
                                $(Task.FlowInfo.NextNode).each(function (index, dom) {

                                    NodeUserHtml += dom.UserName + '(' + dom.UserDepart + ');'

                                });
                                $('#popup_txtNodeUserName_KZY').val(NodeUserHtml);

                            }

                            //上一节点意见（可能多人）
                            var CommentHtml = '';
                            $(Task.FlowInfo.LastNode).each(function (index, dom) {
                                CommentHtml += dom.UserName + ':' + dom.Comment + ';\n'
                            });
                            $('#popup_txtLastContent_KZY').val(CommentHtml);
                            //下一节点
                            $('#popup_spanNextNodeName_KZY').html(Task.FlowInfo.NextNodeName);

                            //填充表单数据
                            $('#popup_txtTaskName_KZY').val(Task.TaskName);
                            $(Task.TaskInfo_KZY.ShipIDs).each(function (index, dom) {
                                $('#popup_ulFloatList_KZY input[data-id="' + dom + '"]').prop('checked', true);
                            });

                            $('#popup_ForecastStartTime_KZY').val(Task.TaskInfo_KZY.ForecastStartTime);
                            $('#popup_ForecastEndTime_KZY').val(Task.TaskInfo_KZY.ForecastEndTime);
                            $('#popup_txtLon_KZY').val(Task.TaskInfo_KZY.Lon);
                            $('#popup_txtLat_KZY').val(Task.TaskInfo_KZY.Lat);
                            $('#popup_txtHZ_KZY').val(Task.TaskInfo_KZY.Balance);
                            $('#popup_txtYFYTask_KZY').val(Task.TaskInfo_KZY.YFYNo);

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        },

        ClearShjNodeUserName: function () {
            SoftwareKZYHelper.ChoosedTaskNodeUser = {};
            $('#popup_txtNodeUserName_KZY').val('');
        },

        UploadLastCommentFile: function () {

            if (SoftwareKZYHelper.PopupOpenedTaskID == 0)
                return;

            var CommentFiles = $('#popup_uploadCommentFile_KZY')[0].files;
            if (CommentFiles == null || CommentFiles.length == 0)
                return;

            var formData = new FormData();
            formData.append("TaskID", SoftwareKZYHelper.PopupOpenedTaskID);

            var FileCount = CommentFiles.length;
            formData.append("TaskCommentFileCount", FileCount);
            var Count = 1;
            $(CommentFiles).each(function (index, dom) {

                formData.append("TaskCommentFile" + Count, dom);

                Count++;
            });


            $.ajax({
                url: 'TaskCommentFileUpload',
                dataType: 'json',
                type: 'POST',
                async: false,
                data: formData,
                processData: false, // 使数据不做处理
                contentType: false, // 不要设置Content-Type请求头
                success: function (data) {

                    if (data) {
                        if (data.Success) {

                            var CommentFileHtml = '';
                            $(data.Data).each(function (index, dom) {

                                CommentFileHtml += '<li><a href="' + dom.FilePath + '">' + dom.FileName + '</a></li>';
                            });

                            $('#popup_ulNodeCommentFile_KZY').html(CommentFileHtml);

                            ModalPopup('success', '上传成功');

                        }
                        else {
                            ModalPopup('error', data.Message);
                        }

                    }

                },
                error: function (response) {
                    console.log(response);
                },
                complete: function (data) {
                }
            });

        },

        AddTaskSubmit: function (dom) {

            var type = $(dom).attr('data-type');
            if (type == null || type == '')
                return;

            var InfoText = '';
            if (type == 0) {
                InfoText = '是否要流程退回？流程将退回至上一节点人员';
            }
            else if (type == 1) {

                var TaskName = SoftwareKZYHelper.CreateTaskName();
                if (TaskName == '') {
                    return;
                }
                $('#popup_txtTaskName_KZY').val(TaskName);
                InfoText = TaskName + '</br>是否要保存任务？';
            }
            else if (type == 2) {

                if (SoftwareKZYHelper.PopupIsBackFlow == true) {
                    var TaskName = SoftwareKZYHelper.CreateTaskName();
                    if (TaskName == '') {
                        return;
                    }
                    $('#popup_txtTaskName_KZY').val(TaskName);
                    InfoText = TaskName + '</br>是否要保存任务？';
                }
                else {
                    InfoText = '是否要审批通过？';
                }
            }
            else if (type == 3) {
                InfoText = '是否要作废流程？';
            }

            ModalPopup('information', InfoText);

            $("#ModalSubmit").unbind('click').bind('click', function () {
                SoftwareKZYHelper.DoTaskSubmit(type);
            });

        },

        DoTaskSubmit: function (type) {

            if (type == 1) {
                SoftwareKZYHelper.DoTaskAdd();
            }
            else if (type == 0 || type == 2) {
                SoftwareKZYHelper.DoTaskApproval(type);
            }
            else if (type == 3) {
                SoftwareKZYHelper.DoTaskCancel();
            }
        },

        CreateTaskName: function () {

            var TaskName = '';

            //平台船
            var ShipIDs = [];
            $('#popup_ulFloatList_KZY input:checkbox:checked').each(function (index, dom) {
                var ID = $(dom).attr('data-id');
                if (ID != 0) {
                    ShipIDs.push(ID);
                }
            })

            if (ShipIDs.length == 0) {
                ModalClose('information');
                ModalPopup('error', '没有选择任何平台船');
                return '';
            }



            //if (ShipIDs.length == 1) {

            //    TaskName += '(' + $('#popup_ulFloatList_KZY input:checkbox:checked').next().first().html() + ')起重船基础施工可作业性预报';
            //}
            //else {
            //    TaskName += '(' + $('#popup_ulFloatList_KZY input:checkbox:checked').next().first().html() + ')等' + ShipIDs.length + '条起重船基础施工可作业性预报';
            //}

            TaskName += '起重船基础施工可作业性预报(' + GetFullDateTimeString(new Date()) + ')';

            return TaskName;

        },

        DoTaskAdd: function () {

            var ProjectID = $('#hid_ProjectID').val();
            if (ProjectID == null || ProjectID == '' || ProjectID == 0) {
                ModalClose('information');
                ModalPopup('error', '软件申请页面需要选择关联风电项目');
                return;
            }

            var SubmitFormData = new FormData();
            SubmitFormData.append("ProjectID", ProjectID);
            SubmitFormData.append("TaskID", SoftwareKZYHelper.PopupOpenedTaskID);
            SubmitFormData.append("SoftwareID", 3);

            //节点人员
            SubmitFormData.append("TaskNodeName", SoftwareKZYHelper.ChoosedTaskNodeUser.Name);
            SubmitFormData.append("TaskNodeUserCode", SoftwareKZYHelper.ChoosedTaskNodeUser.UserCode);
            SubmitFormData.append("TaskNodeDepart", SoftwareKZYHelper.ChoosedTaskNodeUser.Depart);
            SubmitFormData.append("TaskNodePhone", SoftwareKZYHelper.ChoosedTaskNodeUser.Phone);
            SubmitFormData.append("TaskNodeJobName", SoftwareKZYHelper.ChoosedTaskNodeUser.JobName);

            //浮式船舶
            var ShipIDs = '';
            $('#popup_ulFloatList_KZY input:checkbox:checked').each(function (index, dom) {
                var ID = $(dom).attr('data-id');
                if (ID != 0) {
                    ShipIDs += ID + ',';
                }
            })
            SubmitFormData.append("ShipIDstring", ShipIDs.substring(0, ShipIDs.length - 1));
            SubmitFormData.append("KZYForecastStartTime", $('#popup_ForecastStartTime_KZY').val());
            SubmitFormData.append("KZYForecastEndTime", $('#popup_ForecastEndTime_KZY').val());

            //SubmitFormData.append("KZYLon", $('#popup_txtLon_KZY').val());
            //SubmitFormData.append("KZYLat", $('#popup_txtLat_KZY').val());
            //SubmitFormData.append("KZYWaterDepth", $('#popup_txtWaterDepth_KZY').val());
            //SubmitFormData.append("KZYStandard", $('#popup_txtStandard_KZY').val());

            SubmitFormData.append("TaskName", $('#popup_txtTaskName_KZY').val());

            $.ajax({
                url: 'TaskSubmit_KZY',
                dataType: 'json',
                type: 'POST',
                async: false,
                data: SubmitFormData,
                processData: false, // 使数据不做处理
                contentType: false, // 不要设置Content-Type请求头
                success: function (data) {

                    if (data) {
                        if (data.Success) {
                            ModalPopup('success', '保存成功');
                            $('#Tk_software_03').modal('hide');
                            $('#tk_WorkTasks').modal('hide');

                            Param.ProjectID = $('#hid_ProjectID').val();
                            DoQuery();


                        }
                        else {

                            ModalPopup('error', data.Message);
                        }

                    }

                },
                error: function (response) {
                    console.log(response);
                },
                complete: function (data) {
                    ModalClose('information');
                }
            });

        },

        DoTaskApproval: function (type) {

            if (SoftwareKZYHelper.PopupOpenedTaskID == 0) {
                ModalClose('information');
                ModalPopup('error', '数据出错，重新打开弹窗。');
                return;
            }

            var SubmitFormData = new FormData();

            SubmitFormData.append("ApprovalType", type);
            SubmitFormData.append("IsBackFlow", SoftwareKZYHelper.PopupIsBackFlow);
            SubmitFormData.append("NodeID", SoftwareKZYHelper.ChoosedTaskNodeUser.NextNodeID);
            SubmitFormData.append("TaskID", SoftwareKZYHelper.PopupOpenedTaskID);
            SubmitFormData.append("TaskComment", $('#popup_txtContent_KZY').val());


            //正常审批
            SubmitFormData.append("TaskNodeName", SoftwareKZYHelper.ChoosedTaskNodeUser.Name);
            SubmitFormData.append("TaskNodeUserCode", SoftwareKZYHelper.ChoosedTaskNodeUser.UserCode);
            SubmitFormData.append("TaskNodeDepart", SoftwareKZYHelper.ChoosedTaskNodeUser.Depart);
