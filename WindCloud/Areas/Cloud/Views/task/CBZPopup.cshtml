        OpenTaskInfo: function (TaskID) {

            Param.TaskID = TaskID;

            SoftwareCBZHelper.PopupOpenedTaskID = 0;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            $.post('TaskQuery_CBZ', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            SoftwareCBZHelper.PopupOpenedTaskID = TaskID;

                            if (data.Data.FlowInfo.LastNode != null && data.Data.FlowInfo.LastNode.length > 0)
                            {
                                LastNode = data.Data.FlowInfo.LastNode.filter(a => a.FlowHandle != 0)[0];
                            }

                            

                            var Task = data.Data;

                            $('#hid_ProjectID').val(Task.ProjectID);

                            //如果是已经结束的流程，直接打开文件获取弹窗
                            if (Task.FlowInfo.FlowStatus == 2) {

                                OpenReportPopup(TaskID);
                                return;
                            }


                            SoftwareCBZHelper.OpenTaskPopup(Task.FlowInfo.FlowHandle, Task.ProjectID, Task.FlowInfo.FlowStatus);

                            SoftwareCBZHelper.PopupOpenedHandleType = Task.FlowInfo.FlowHandle;

                            SoftwareCBZHelper.PopupIsBackFlow = Task.FlowInfo.IsBackFlow;

                            if (Task.FlowInfo.DoEditConfirm == true) {
                                $('#popup_btnCreateDKFile_CBZ').attr('disabled', false);
                                $('#popup_btnQueryLibraryShip_CBZ').attr('disabled', false);
                                $('#popup_btnQueryLibraryShip').attr('disabled', false);
                                $('#popup_btnCreateNewLibraryShip').attr('disabled', false);
                                $('#popup_btnOpenCreateLibraryShip_CBZ').attr('disabled', false);
                                $('#popup_btnCreateShipFile_CBZ').attr('disabled', false);
                            }

                            if (Task.FlowInfo.IsUsingFlowNode) {
                                $('#popup_divContent_CBZ').hide();
                                $('#popup_divNextNode_CBZ').hide();
                                $('#popup_btnSubmit_CBZ').hide();
                                $('#popup_btnBack_CBZ').hide();
                                $('#popup_btnBackLast_CBZ').hide();
                            }

                            //如果是最后的流程
                            SoftwareCBZHelper.ChoosedTaskNodeUser.NextNodeID = Task.FlowInfo.NextNodeID;
                            if (Task.FlowInfo.NextNodeID == 0) {
                                $('#popup_txtNodeUserName_CBZ').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_CBZ').attr('disabled', true);
                                $('#popup_divClearNodeName_CBZ').hide();
                            }

                            //下一节点如果有默认人物
                            if (Task.FlowInfo.NextNode != null && Task.FlowInfo.NextNode.length > 0) {

                                $('#popup_txtNodeUserName_CBZ').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_CBZ').attr('disabled', true);
                                $('#popup_divClearNodeName_CBZ').hide();

                                var NodeUserHtml = '';
                                $(Task.FlowInfo.NextNode).each(function (index, dom) {

                                    NodeUserHtml += dom.UserName + '(' + dom.UserDepart + ');'

                                });
                                $('#popup_txtNodeUserName_CBZ').val(NodeUserHtml);

                            }



                            //填充数据
                            $('#popup_txtTaskName_CBZ').val(Task.TaskName);

                            //上一节点意见（可能多人）
                            var CommentHtml = '';
                            $(Task.FlowInfo.LastNode).each(function (index, dom) {
                                CommentHtml += dom.UserName + ':' + dom.Comment + ';\n'
                            });
                            $('#popup_txtLastContent_CBZ').val(CommentHtml);
                            //上一节点文件
