@*插拔桩弹窗*@
<script>

    $(document).ready(function () {
        SoftwareCBZHelper.Init();
    })

    var SoftwareCBZHelper = {
        Init: function () {
            SoftwareCBZHelper.DeliverTimeInit();
        },
        DeliverTimeInit: function () {
            //$('#popup_TaskDeliverTime_CBZ').val(formatDateTimeByDay(new Date(new Date().setMonth(new Date().getMonth() + 1))));
        },
        OpenPopup: function () {

            var ChooseProjectID = $('#hid_ProjectID').val();
            if (ChooseProjectID == null || ChooseProjectID == '' || ChooseProjectID == 0) {
                ModalPopup('error', '必须先选择所关联的风场');
                return;
            }
            SoftwareCBZHelper.PopupOpenedHandleType = 'new';
            SoftwareCBZHelper.OpenTaskPopup('new', ChooseProjectID);

            Param.SoftwareID = 2;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            //下一节点人员
            $.post('NextNodeQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            $('#popup_spanNextNodeName_CBZ').html(data.Data.NodeName);

                            if (data.Data.NodeUsers.length > 0) {

                                $('#popup_txtNodeUserName_CBZ').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_CBZ').attr('disabled', true);
                                $('#popup_divClearNodeName_CBZ').hide();

                                var NodeUserHtml = '';
                                $(data.Data.NodeUsers).each(function (index, dom) {

                                    NodeUserHtml += dom.ManageName + '(' + dom.ManageDepart + ');'

                                });
                                $('#popup_txtNodeUserName_CBZ').val(NodeUserHtml);

                            }
                            else
                            {
                                $('#popup_txtNodeUserName_CBZ').attr('disabled', false);
                                $('#popup_btnFindNodeUserName_CBZ').attr('disabled', false);
                                $('#popup_divClearNodeName_CBZ').show();
                            }

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

            
            

        },

        OpenTaskPopup: function (type, ProjectID, FlowStatus) {

            $('#popup_divSubmit_CBZ').show();
            if (type == 'new') {
                //清空弹窗
                SoftwareCBZHelper.ClearTaskPopup();
                //设置可写
                SoftwareCBZHelper.SetTaskPopupWrite();

                //地勘数据


                //报告文件
                $('#popup_divReport_CBZ').hide();
                $('#popup_divModifyReport_CBZ').hide();
                //上一节点审批意见
                $('#popup_divLastContent_CBZ').hide();
                //审批意见
                $('#popup_divContent_CBZ').hide();
                //下一节点
                $('#popup_divNextNode_CBZ').show();

                $('#popup_btnBack_CBZ').hide();
                $('#popup_btnSubmit_CBZ').show().html('申请').attr('data-type', 1);
                $('#popup_btnCancel_CBZ').hide();

                $('#popup_btnBackLast_CBZ').hide();

                SoftwareCBZHelper.PopupOpenedTaskID = parseInt(Math.random() * 10000000);

                
            }
            else if (type == 'view') {
                //清空弹窗
                SoftwareCBZHelper.ClearTaskPopup();
                //设置可写
                SoftwareCBZHelper.SetTaskPopupRead();


                //成果报告（需要另外判断）
                $('#popup_divReport_CBZ').show();
                $('#popup_divModifyReport_CBZ').show();
                //上节点审批意见
                $('#popup_divLastContent_CBZ').show();
                //审批意见
                $('#popup_divContent_CBZ').hide();
                //下节点信息
                $('#popup_divNextNode_CBZ').hide();

                //申请按钮
                $('#popup_btnSubmit_CBZ').hide();
                $('#popup_btnBack_CBZ').hide();
                $('#popup_btnCancel_CBZ').hide();

                $('#popup_btnBackLast_CBZ').hide();

                //作废的流程
                if (FlowStatus == 3)
                {
                    $('#popup_divSubmit_CBZ').hide();
