        },

        LoadDKFile: function (type) {

            var ProjectID = $('#hid_ProjectID').val();
            //if (ProjectID == null || ProjectID == '' || ProjectID == 0)
            //    return;

            Param.ProjectID = ProjectID;
            Param.TaskID = SoftwareCBZHelper.PopupOpenedTaskID;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            //下一节点人员
            $.post('LoadDKFile', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            var GeologyFile_dkyszl_Html = '';
                            $(data.Data.File_dkyszl).each(function (index, dom) {

                                if (type != 'view') {
                                    GeologyFile_dkyszl_Html += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a href="' + dom.FilePath + '" class="xm_zt_green" download="' + dom.FileName + '">下载</a> / <a href="#" class="xm_zt_red" data-ID="' + dom.ID + '" onclick="SoftwareCBZHelper.DeleteDKFile(this);">删除</a></td></tr>';
                                }
                                else
                                {
                                    GeologyFile_dkyszl_Html += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a href="' + dom.FilePath + '" class="xm_zt_green" download="' + dom.FileName + '">下载</a></td></tr>';
                                }
                                
                            })
                            $('#popup_htmlProjectFile_dkyszl').html(GeologyFile_dkyszl_Html);

                            var GeologyFile_dksjb_Html = '';
                            $(data.Data.File_dksjb).each(function (index, dom) {
                                GeologyFile_dksjb_Html += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a href="' + dom.FilePath + '" class="xm_zt_green" download="' + dom.FileName + '">下载</a></td></tr>';
                            })
                            $('#popup_htmlProjectFile_dksjb').html(GeologyFile_dksjb_Html);

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        },

        DeleteDKFile: function (dom) {

            var ID = $(dom).attr('data-ID');
            if (ID == null || ID == '' || ID == 0)
                return;

            Param.ID = ID;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            //下一节点人员
            $.post('DeleteDKFile', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            var GeologyFileHtml = '';
                            $(data.Data).each(function (index, dom) {
                                GeologyFileHtml += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a href="' + dom.FilePath + '" class="xm_zt_green" >下载</a> / <a href="#" class="xm_zt_red" data-ID="' + dom.ID + '" onclick="SoftwareCBZHelper.DeleteDKFile(this);">删除</a></td></tr>';
                            })
                            //$('#popup_htmlProjectFile_dkyszl').html(GeologyFile_dkyszl_Html);
                            $(dom).parent().parent().parent().html(GeologyFileHtml);
                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        }


    }


</script>