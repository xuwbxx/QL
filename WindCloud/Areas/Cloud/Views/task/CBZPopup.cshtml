        DoCreateNewLibraryShip: function () {

            var ShipName = $('#popup_LibraryShipName_CBZ').val();
            if (ShipName == '')
            {
                ModalPopup('error', '需要输入船名');
                return;
            }

            var formData = new FormData();
            var ShipFile = $('#popup_LibraryShipFile_CBZ')[0].files;
            if (ShipFile.length == 0)
            {
                ModalPopup('error', '没有任何船舶文件');
                return;
            }
            formData.append("ShipName", ShipName);
            formData.append("FlowHandle", SoftwareCBZHelper.PopupOpenedHandleType);
            formData.append("TaskID", SoftwareCBZHelper.PopupOpenedTaskID);
            formData.append("LibraryShipFile", ShipFile[0]);

            $.ajax({
                url: 'CreateLibraryShip',
                dataType: 'json',
                type: 'POST',
                async: false,
                data: formData,
                processData: false, // 使数据不做处理
                contentType: false, // 不要设置Content-Type请求头
                success: function (data) {

                    if (data) {
                        if (data.Success) {

                            var ShipHtml = '';
                            $(data.Data).each(function (index, dom) {

                                ShipHtml += '<li><input type="checkbox" data-id="' + dom.ID + '" data-name="' + dom.ShipName + '"><a title="' + dom.ShipName + '" onclick="SoftwareCBZHelper.OpenShip(' + dom.ID + ');">' + dom.ShipName.substring(0,9) + '</a></li>';

                            })
                            $('#popup_ulShipList_CBZ').html(ShipHtml);

                            ModalPopup('success', '保存成功');

                        }
                        else
                        {
                            ModalPopup('error', data.Message);
                        }

                    }

                },
                error: function (response) {
                    console.log(response);
                },
                complete: function (data) {
                    ModalClose('information');
                }
            });

        },

