        AddTaskSubmit: function (dom) {

            var type = $(dom).attr('data-type');
            if (type == null || type == '')
                return;

            var InfoText = '';
            if (type == 0) {
                InfoText = '是否要流程退回？流程将退回至发起人';
            }
            else if (type == 1) {

                var TaskName = SoftwareCBZHelper.CreateTaskName();
                if (TaskName == '') {
                    return;
                }
                $('#popup_txtTaskName_CBZ').val(TaskName);
                InfoText = TaskName + '</br>是否要保存任务？';
            }
            else if (type == 2) {

                if (SoftwareCBZHelper.PopupIsBackFlow == true) {
                    var TaskName = SoftwareCBZHelper.CreateTaskName();
                    if (TaskName == '') {
                        return;
                    }
                    $('#popup_txtTaskName_CBZ').val(TaskName);
                    InfoText = TaskName + '</br>是否要保存任务？';
                }
                else {
                    InfoText = '是否要审批通过？';
                }


            }
            else if (type == 3) {
                InfoText = '是否要作废流程？';
            }
            else if (type == 4)
            {
                var txt = "是否要流程退回上一节点？";
                if (LastNode != null)
                {
                    txt = '是否要流程退回上一节点(' + LastNode.UserName + ')';
                }

                InfoText = txt;
            }

            ModalPopup('information', InfoText);

            $("#ModalSubmit").unbind('click').bind('click', function () {
                SoftwareCBZHelper.DoTaskSubmit(type);
            });

        },

        DoTaskSubmit: function (type) {

            if (type == 1) {
                SoftwareCBZHelper.DoTaskAdd();
            }
            else if (type == 0 || type == 2) {
                SoftwareCBZHelper.DoTaskApproval(type);
            }
            else if (type == 3) {
                SoftwareCBZHelper.DoTaskCancel();
            }
            else if (type == 4)
            {
                SoftwareCBZHelper.DoTaskBack();
            }
        },

        CreateTaskName: function () {

            var TaskName = '';

            //地勘数据表
            var DKs = [];
            $('#popup_DKZL_CBZ input:checkbox:checked').each(function (index, dom) {
                var ID = $(dom).attr('data-id');
                if (ID != 0) {
                    DKs.push(ID);
                }
            })
            //平台船
            var ShipIDs = [];
            $('#popup_ulShipList_CBZ input:checkbox:checked').each(function (index, dom) {
                var ID = $(dom).attr('data-id');
                if (ID != 0) {
                    ShipIDs.push(ID);
                }
            })

            if (DKs.length == 0) {
                ModalClose('information');
                ModalPopup('error', '没有选择任何地勘数据');
                return '';
            }
            if (ShipIDs.length == 0) {
                ModalClose('information');
                ModalPopup('error', '没有选择任何平台船');
                return '';
            }

            if (ShipIDs.length == 1) {

                TaskName += '(' + $('#popup_ulShipList_CBZ input:checkbox:checked').first().attr('data-name') + ')自升式平台船';
            }
            else {
                TaskName += '(' + $('#popup_ulShipList_CBZ input:checkbox:checked').first().attr('data-name') + ')等' + ShipIDs.length + '条自升式平台船';
            }

            if (DKs.length == 1) {
                TaskName += '(' + $('#popup_DKZL_CBZ input:checkbox:checked[data-id!="0"]').first().attr('data-name') + ')机位插拔腿计算';
            }
            else {
                TaskName += '(' + $('#popup_DKZL_CBZ input:checkbox:checked[data-id!="0"]').first().attr('data-name') + ')等' + DKs.length + '个机位插拔腿计算';
            }
            TaskName += '(' + GetFullDateTimeString(new Date()) + ')';

            return TaskName;

        },

