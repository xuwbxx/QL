        GetShipPreloading: function () {

            //桩腿预压力
            var ZTYYLValue = $('#popup_Ship_ZTYYL').val();
            //桩腿、桩靴自重
            var ZTZXZZValue = $('#popup_Ship_ZTZXZZ').val();
            //桩靴体积
            var ZXTJValue = $('#popup_Ship_ZXTJ').val();
            //桩靴面积
            var ZXMJValue = $('#popup_Ship_ZXMJ').val()

            if (ZTYYLValue == '' || ZTZXZZValue == '' || ZXTJValue == '')
            {
                return;
            }
            //计算预压荷载（t）
            var JSYYHZValue = (Number(ZTYYLValue) + Number(ZTZXZZValue) - ZXTJValue * 1.025).toFixed(2);

            $('#popup_Ship_JSYYHZ').val(JSYYHZValue);

            //对地比压（kpa）
            var DDBYValue = (Number(JSYYHZValue) * 9.8 / Number(ZXMJValue)).toFixed(2);

            $('#popup_Ship_DDBY').val(DDBYValue);

        },

