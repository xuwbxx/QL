@*风机模拟安装*@
<div class="modal fade" id="Tk_software_04" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog" style="right: -24vw;width: 48vw;">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h4 class="modal-title">
                    交互式风机整体安装模拟软件
                </h4>
            </div>
            <div class="modal-body">

                <div class="sqzl_box">
                    <div class="form-horizontal form-horizontal_sqrjzl">

                        <div class="form-group">
                            <label class="col-md-2 control-label">任务名</label>
                            <div class="col-md-10">
                                <input type="text" class="form-control" placeholder="任务名自动生成" id="popup_txtTaskName_MNAZ" disabled>
                            </div>
                        </div>

                        <div class="form-group mod_touying">

                            <div class="cb_check_f clearfix mb1">
                                @*<h3 class="title_tx">-----------------&nbsp;项目部&nbsp;-----------------</h3>*@
                                <label class="col-md-2 control-label">船舶选择</label>
                                <div class="col-md-10 clearfix">
                                    <div class="cb_checkbox">
                                        <ul class="clearfix" id="popup_ulCraneList_MNAZ">
                                            <li><input type="checkbox" data-id="1"><a>秦航工2300</a></li>
                                            <li><input type="checkbox" data-id="2"><a>华西5000</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>


                        <div class="form-group" id="popup_divTechEdit_MNAZ">
                            <div class="cb_check_f clearfix mb1">
                                <h3 class="title_tx">-----------------&nbsp;技术中心&nbsp;-----------------</h3>
                                <label class="col-md-2 control-label">可作业预报信息</label>
                                <div class="col-md-10 p0 xmjbxx_box">

                                    <div class="col-md-5">
                                        <span>亿方云TaskNo</span>
                                        <input type="text" class="form-control" placeholder="例如：TN10503" id="popup_txtYFYTask_MNAZ">
                                    </div>

                                    <div class="col-md-5">
                                        <span>衡准</span>
                                        <input type="number" class="form-control" placeholder="例如：0.3" id="popup_txtHZ_MNAZ">
                                    </div>

                                    <div class="col-md-5">
                                        <span>风场经度</span>
                                        <input type="number" class="form-control" placeholder="例如：122.053478" id="popup_txtLon_MNAZ">
                                    </div>

                                    <div class="col-md-5">
                                        <span>风场纬度</span>
                                        <input type="number" class="form-control" placeholder="例如：29.664924" id="popup_txtLat_MNAZ">
                                    </div>


                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="col-md-2 control-label">推送时间</label>
                            <div class="col-md-5">
                                <input placeholder="开始时间" class="laydate-icon timeUstyle stateUTime form-control" id="popup_ForecastStartTime_MNAZ" onclick="laydate({istime: true,format:'YYYY-MM-DD'})">

                            </div>
                            <div class="col-md-5">
                                <input placeholder="结束时间" class="laydate-icon timeUstyle stateUTime form-control" id="popup_ForecastEndTime_MNAZ" onclick="laydate({istime: true,format:'YYYY-MM-DD'})">

                            </div>

                        </div>

                        <div class="form-group mod_touying clearfix" id="popup_divReport_MNAZ">
                            <label class="col-md-2 control-label">文件报告</label>
                            <div class="col-md-10">
                                <button class="btn btn-primary" onclick="SoftwareKZYHelper.OpenReport();">提取可作业预报文件</button>
                            </div>
                        </div>



                        <div class="form-group mod_touying" id="popup_divLastContent_MNAZ">

                            <label class="col-md-2 control-label">上一节点意见</label>
                            <div class="col-md-10">
                                <textarea class="form-control" id="popup_txtLastContent_MNAZ" disabled></textarea>
                            </div>
                        </div>

                        <div class="form-group mod_touying" id="popup_divContent_MNAZ">

                            <label class="col-md-2 control-label">审批意见</label>
                            <div class="col-md-10">
                                <textarea class="form-control" id="popup_txtContent_MNAZ"></textarea>
                            </div>

                        </div>

                        <div class="form-group mod_touying" id="popup_divNextNode_MNAZ">

                            <label class="col-md-2 control-label lcjd_next">流程下一节点</label>
                            <div class="col-md-4 pr0">
                                <div class="lcjd_next_sp"><i class="icon iconfont">&#xe63e;</i><span id="popup_spanNextNodeName_MNAZ">分子公司审批</span></div>
                                <div class="nice-select">
                                    <input id="popup_txtNodeUserName_MNAZ" type="text" class="form-control" placeholder="搜索" autocomplete="off" />
                                    <div class="search_div" onclick="SoftwareKZYHelper.ClearShjNodeUserName();" id="popup_divClearNodeName_MNAZ">
                                        <i class="fa fa-close"></i>
                                    </div>
                                    <ul id="popup_ulNodeUserList_MNAZ" style="display:none;">
                                    </ul>
                                </div>

                            </div>
                            <div class="col-md-1 text-center mt4">
                                <button class="btn btn-primary search_btn" style="width: 100%" id="popup_btnFindNodeUserName_MNAZ" onclick="SoftwareKZYHelper.FindShjNodeUserByName();">搜索</button>
                            </div>
                            <div class="col-md-5 zhuyi_zt mt4">
                                注意：请按照流程节点审批要求，指定下一节点审批人。如果节点审批人选错，整个流程将不能通过或者退回。
                            </div>

                        </div>


                    </div>
                </div>

                <div class="text-center sqzl_btn_box" id="popup_divSubmit_MNAZ">
                    <button class="btn btn-success" id="popup_btnSubmit_MNAZ" data-type="1" onclick="SoftwareKZYHelper.AddTaskSubmit(this);">申请</button>
                    <button class="btn btn-danger" id="popup_btnBack_MNAZ" data-type="0" onclick="SoftwareKZYHelper.AddTaskSubmit(this);">审批退回</button>
                    <button class="btn btn-warning" id="popup_btnCancel_MNAZ" data-type="3" onclick="SoftwareKZYHelper.AddTaskSubmit(this);">作废</button>
                </div>


            </div>

        </div>
    </div>
</div>

@*模拟安装*@
<script>
    $(document).ready(function () {
        SoftwareMNAZHelper.Init();
    })

    var SoftwareMNAZHelper = {

        Init: function () {
            SoftwareMNAZHelper.DeliverTimeInit();
        },
        DeliverTimeInit: function () {
            $('#popup_TaskDeliverTime_MNAZ').val(formatDateTimeByDay(new Date(new Date().setMonth(new Date().getMonth() + 1))));
        },
        OpenPopup: function () {

            var ChooseProjectID = $('#popup_software_ProjectChoose').val();
            if (ChooseProjectID == null || ChooseProjectID == '' || ChooseProjectID == 0) {
                ModalPopup('error', '必须先选择所关联的风场');
                return;
            }
            SoftwareMNAZHelper.PopupOpenedHandleType = 'new';
            SoftwareMNAZHelper.OpenTaskPopup('new', ChooseProjectID);

            Param.SoftwareID = 4;
            Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
            //下一节点人员
            $.post('NextNodeQuery', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {

                            $('#popup_spanNextNodeName_MNAZ').html(data.Data.NodeName);

                            if (data.Data.NodeUsers.length > 0) {

                                $('#popup_txtNodeUserName_MNAZ').attr('disabled', true);
                                $('#popup_btnFindNodeUserName_MNAZ').attr('disabled', true);
                                $('#popup_divClearNodeName_MNAZ').hide();

                                var NodeUserHtml = '';
                                $(data.Data.NodeUsers).each(function (index, dom) {

                                    NodeUserHtml += dom.ManageName + '(' + dom.ManageDepart + ');'

                                });
                                $('#popup_txtNodeUserName_MNAZ').val(NodeUserHtml);

                            }
                            else {
                                $('#popup_txtNodeUserName_MNAZ').attr('disabled', false);
                                $('#popup_btnFindNodeUserName_MNAZ').attr('disabled', false);
                                $('#popup_divClearNodeName_MNAZ').show();
                            }

                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {
                });

        },

        OpenTaskPopup: function (type, ProjectID, FlowStatus) {

            $('#popup_divSubmit_MNAZ').show();
            if (type == 'new') {
                //清空弹窗
                SoftwareMNAZHelper.ClearTaskPopup();
                //设置可写
                SoftwareMNAZHelper.SetTaskPopupWrite();

                //报告文件
                $('#popup_divReport_MNAZ').hide();
                //上一节点审批意见
                $('#popup_divLastContent_MNAZ').hide();
                //审批意见
                $('#popup_divContent_MNAZ').hide();
                //下一节点
                $('#popup_divNextNode_MNAZ').show();

                $('#popup_btnBack_MNAZ').hide();
                $('#popup_btnSubmit_MNAZ').show().html('申请').attr('data-type', 1);
                $('#popup_btnCancel_MNAZ').hide();

                SoftwareMNAZHelper.PopupOpenedTaskID = parseInt(Math.random() * 10000000);


            }
            else if (type == 'view') {
                //清空弹窗
                SoftwareMNAZHelper.ClearTaskPopup();
                //设置可写
                SoftwareMNAZHelper.SetTaskPopupRead();


                //成果报告（需要另外判断）
                $('#popup_divReport_MNAZ').show();
                //上节点审批意见
                $('#popup_divLastContent_MNAZ').show();
                //审批意见
                $('#popup_divContent_MNAZ').hide();
                //下节点信息
                $('#popup_divNextNode_MNAZ').hide();

                //申请按钮
                $('#popup_btnSubmit_MNAZ').hide();
                $('#popup_btnBack_MNAZ').hide();
                $('#popup_btnCancel_MNAZ').hide();

                //作废的流程
                if (FlowStatus == 3) {
                    $('#popup_divSubmit_MNAZ').hide();
                }

            }
            else if (type == 'approval') {
                //清空弹窗
                SoftwareMNAZHelper.ClearTaskPopup();
                //设置只读
                SoftwareMNAZHelper.SetTaskPopupRead();

                //成果报告（需要另外判断）
                $('#popup_divReport_MNAZ').show();

                //上节点审批意见
                $('#popup_divLastContent_MNAZ').show();
                //审批意见
                $('#popup_divContent_MNAZ').show();
                $('#popup_txtContent_MNAZ').attr('disabled', false);
                $('#popup_uploadCommentFile_MNAZ').attr('disabled', false);

                //下节点信息
                $('#popup_divNextNode_MNAZ').show();
                $('#popup_txtNodeUserName_MNAZ').attr('disabled', false);
                $('#popup_btnFindNodeUserName_MNAZ').attr('disabled', false);
                $('#popup_divClearNodeName_MNAZ').show();

                $('#popup_btnBack_MNAZ').show();
                $('#popup_btnSubmit_MNAZ').show().html('审批通过').attr('data-type', 2);
                $('#popup_btnCancel_MNAZ').show();


            }
            else if (type == 'renew') {
                //清空弹窗
                SoftwareMNAZHelper.ClearTaskPopup();
                //设置可写
                SoftwareMNAZHelper.SetTaskPopupWrite();

                //成果报告（需要另外判断）
                $('#popup_divReport_MNAZ').show();

                //上节点审批意见
                $('#popup_divLastContent_MNAZ').show();
                $('#popup_txtLastContent_MNAZ').attr('disabled', true);
                //审批意见
                $('#popup_divContent_MNAZ').show();
                $('#popup_txtContent_MNAZ').attr('disabled', false);
                //下节点信息
                $('#popup_divNextNode_MNAZ').show();

                $('#popup_btnBack_MNAZ').hide();
                $('#popup_btnSubmit_MNAZ').show().html('重新提交').attr('data-type', 2);
                $('#popup_btnCancel_MNAZ').show();
            }

            $('#Tk_software_04').modal('show');

            //$('#popup_htmlTaskFile_ptcyszl_MNAZ').attr('data-tag', 0);
            //$('#popup_htmlTaskFile_ptcsjb_MNAZ').attr('data-tag', 0);

            SoftwareMNAZHelper.LoadDKData(ProjectID, type);

            SoftwareMNAZHelper.LoadShip(type);
        },

        ClearTaskPopup: function () {

            $('#popup_txtTaskName_MNAZ').val('');

            $('#popup_htmlTaskReportFile_MNAZ').html('');

            //$('#popup_txtDeliverUserName_MNAZ').val('');
            $('#popup_TaskDeliverTime_MNAZ').val('');

            $('#popup_txtLastContent_MNAZ').val('');
            $('#popup_txtContent_MNAZ').val('');
            $('#popup_txtNodeUserName_MNAZ').val('');

            $('#popup_ulLastNodeCommentFile_MNAZ').html('');
            $('#popup_uploadCommentFile_MNAZ').val('');
            $('#popup_ulNodeCommentFile_MNAZ').html('');

            $('#popup_DKZL_MNAZ').html('');
            $('#popup_DKFile_MNAZ').html('').attr('href', '');
            $('#popup_DKFile_MNAZ').html('');
            $('#popup_DKFile_MNAZ_JSCS').html('');

            $('#popup_LibraryShipNameKeyWord_MNAZ').val('');
            $('#popup_ulShipList_MNAZ').html('');
            $('#popup_ShipFile_MNAZ').html('');

            SoftwareCBZHelper.DeliverTimeInit();
        },

        SetTaskPopupWrite: function () {

            

            $('#popup_txtContent_MNAZ').attr('disabled', false);

            $('#popup_txtNodeUserName_MNAZ').attr('disabled', false);
            $('#popup_btnFindNodeUserName_MNAZ').attr('disabled', false);
            $('#popup_divClearNodeName_MNAZ').show();


        },

        SetTaskPopupRead: function () {

            $('#popup_txtContent_MNAZ').attr('disabled', true);

            $('#popup_txtNodeUserName_MNAZ').attr('disabled', true);
            $('#popup_btnFindNodeUserName_MNAZ').attr('disabled', true);
            $('#popup_divClearNodeName_MNAZ').hide();


        },

    }

</script>
