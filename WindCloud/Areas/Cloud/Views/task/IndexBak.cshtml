@*列表事件*@
<script>
    $(document).ready(function () {
        ParamInit();

        DoQuery();
    })

    var Param = {};
    var ParamInit = function () {
        Param.PageIndex = 1;
        Param.PageSize = 10;
        Param.TotalPage = 0;
        Param.TotalCount = 0;

        Param.TaskName = $("#query_txtTaskName").val();
        //Param.Name = $('#popup_txtUserName').val();
    }

    //查询
    var Query = function () {

        $.post('TaskListQuery', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        var DataListHtml = '';
                        $(data.Data).each(function (index, dom) {

                            var TaskCodeClass = dom.IsFinished ? 'xm_zt_green' : 'xm_zt_orange';
                            var FlowStatusClass = 'zt_orange';
                            if (dom.FlowStatus == 1) {
                                FlowStatusClass = 'zt_red';
                            }
                            else if (dom.FlowStatus == 2) {
                                FlowStatusClass = 'zt_green';
                            }
                            else if (dom.FlowStatus == 3) {
                                FlowStatusClass = 'zt_grey';
                            }
                            var FlowOperateContent = dom.IsCurrentNodeUser ? '审批' : '查看';
                            var FlowOperateClass = dom.IsCurrentNodeUser ? 'cz_orange' : 'cz_blue';


                            var FlowOperateContent = '';
                            var FlowOperateClass = '';
                            var FlowOperateType = '';

                            if (dom.IsFinished) {
                                FlowOperateContent = '查看';
                                FlowOperateClass = 'cz_blue';
                                FlowOperateType = 'view'
                            }
                            else {
                                FlowOperateContent = dom.IsCurrentNodeUser ? '审批' : '查看';
                                FlowOperateClass = dom.IsCurrentNodeUser ? 'cz_orange' : 'cz_blue';
                                FlowOperateType = dom.IsCurrentNodeUser ? 'approval' : 'view';
                            }

                            var FlowNodeHtml = '';
                            if (dom.IsFinished) {
                                FlowNodeHtml = '流程结束';
                            }
                            else {
                                FlowNodeHtml = dom.FlowNode + '：<a href="#" class="xm_zt_blue table_ryxx_box"><span>' + dom.NodeUser.NodeUserName + '</span><div class="hover_ryxx"><ul><li><i class="icon iconfont">&#xe752;</i>部门：' + dom.NodeUser.NodeUserDepart + '</li><li><i class="icon iconfont">&#xe607;</i>手机号：' + dom.NodeUser.NodeUserPhone + '</li><li> <i class="icon iconfont">&#xe673;</i>职位：' + dom.NodeUser.NodeUserJobName + '</li></ul></div></a>';
                            }



                            DataListHtml += '<tr><td class="' + TaskCodeClass + '">' + dom.TaskCode + '</td><td>' + dom.TaskName + '</td><td><a href="#">' + dom.ProjectName + '(' + dom.ProjectCode + ')</a></td>'
                                + '<td class="relative_position"><a href = "#" class="xm_zt_blue table_ryxx_box" ><span>' + dom.Applyer.ApplyerName + '</span><div class="hover_ryxx"><ul><li><i class="icon iconfont">&#xe752;</i>部门：' + dom.Applyer.ApplyerDepart + '</li><li> <i class="icon iconfont">&#xe607;</i>手机号：' + dom.Applyer.ApplyerPhone + '</li><li> <i class="icon iconfont">&#xe673;</i>职位：' + dom.Applyer.ApplyerJobName + '</li></ul></div></a></td>'
                                + '<td>' + FlowNodeHtml + '</td>'
                                + '<td><a href="' + dom.SoftUrl + '" target="_blank">' + dom.SoftwareName + '</a></td>'
                                + '<td><a class="' + FlowStatusClass + '" href="#" onclick="QueryFlowHistory(' + dom.ID + ');">' + dom.FlowStatusName + '</a></td>'
                                + '<td><a class="' + FlowOperateClass + '" href="#" onclick="OpenTaskInfo(' + dom.ID + ',\'' + FlowOperateType + '\');">' + FlowOperateContent + '</a></td></tr>';
                        });

                        $('#html_DataList').html(DataListHtml);

                        //分页
                        Param.TotalPage = data.TotalPage;
                        Param.TotalCount = data.TotalCount;
                        Param.PageIndex = data.PageIndex;

                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                Pagination();
            });

    }

    var OpenWebGIS = function (ProjectID) {

        if (ProjectID == null || ProjectID == '' || ProjectID == 0) {
            return;
        }

        window.open('/Cloud/WebGIS/Index?ProjectID=' + ProjectID, '_blank')

    }

    var DoQuery = function () {

        Param.TaskName = $("#query_txtTaskName").val();
        Query();
        GetTaskCount();
    }

    //分页
    var Pagination = function () {
        $("#Pagination").pagination({
            currentPage: Param.PageIndex,
            totalPage: Param.TotalPage,
            isShow: true,
            totalCount: Param.TotalCount,
            count: 7,
            homePageText: "首页",
            endPageText: "尾页",
            prevPageText: "上一页",
            nextPageText: "下一页",
            callback: function (current) {
                Param.PageIndex = current;
                Query();
            }
        });
    }


    var OpenTask = function () {

        //window.open('/Cloud/Task/Index', '_blank')
        window.location.href = '/Cloud/Task/Index';
    }


    var GetTaskCount = function () {

        $.post('GetTaskCount', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {
                        $('#span_ApprovalCount').html(data.Data);
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                Pagination();
            });

    }


    var QueryFlowHistory = function (TaskID) {

        if (TaskID == null || TaskID == '' || TaskID == 0) {
            return;
        }

        Param.TaskID = TaskID;

        $.post('QueryFlowHistory', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {

                        var TaskFlowHistoryHtml = '';
                        $(data.Data).each(function (index, dom) {

                            var PicType = '';
                            if (dom.FlowType == 0) {
                                PicType = 'check-prime';
                            }
                            else if (dom.FlowType == 2) {
                                PicType = 'check-end';
                            }
                            else if (dom.FlowType == 1) {
                                //正常流程
                                if (dom.FlowHandle == 0) {
                                    //待审批
                                    PicType = 'check-daishenpi';
                                }
                                else if (dom.FlowHandle == 1) {
                                    //审批通过
                                    PicType = 'check-success';
                                }
                                else if (dom.FlowHandle == 2) {
                                    //审批退回
                                    PicType = 'check-danger';
                                }
                                else if (dom.FlowHandle == 3) {
                                    //审批删除
                                    PicType = 'check-delete';
                                }
                            }

                            TaskFlowHistoryHtml += '<div class="oneNode"><div class="check ' + PicType + '">' + dom.FlowHandleName + '</div>'
                                + '<div class="NodeDetail"><div class="NodeDetail-title"><div class="details"><h4>' + dom.NodeUserName + '（' + dom.NodeUserJobName + '）</h4><p>' + dom.NodeUserDepart + '</p></div></div>'
                                + '<div class="NodeDetail-content"><p>' + dom.NodeName + '</p><p>' + dom.Comment + '</p></div>'
                                + '<div class="NodeDetail-footer"><span>' + dom.FlowTime + '</span></div></div></div>';
                        })
                        $('#html_TaskFlowHistory').html(TaskFlowHistoryHtml);
                        $('#tk_path').modal('show');
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                Pagination();
            });

    }


</script>

@*软件选择脚本*@
<script>

    var AddTaskPopup = function () {

        $('#tk_WorkTasks').modal('show');

    }

    var PopupSoftwareInit = function (SoftwareID) {

        $('#Popup_btn_Software' + SoftwareID).removeClass('active');
        $('#Popup_btn_Software' + SoftwareID).attr('disabled', true);
        $('#Popup_btn_Software' + SoftwareID).html('申请使用');

        $('#Popup_LimitTime' + SoftwareID).html('');

    }

    var PopupChooseProject = function () {

        var ChooseProjectID = $('#popup_software_ProjectChoose').val();
        if (ChooseProjectID == null || ChooseProjectID == '' || ChooseProjectID == 0)
            return;

        Param.ProjectID = ChooseProjectID;

        $.post('ChooseProject', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        var WebGISModel = data.Data[0];
                        var cbzModel = data.Data[1];

                        //1.WebGIS
                        PopupSoftwareInit('01');
                        if (WebGISModel.IsUsed) {
                            $('#Popup_btn_Software01').addClass('active');
                            $('#Popup_btn_Software01').attr('disabled', true);
                            $('#Popup_btn_Software01').html('已申请');
                        }
                        else {
                            $('#Popup_btn_Software01').removeClass('active');
                            $('#Popup_btn_Software01').attr('disabled', false);
                            $('#Popup_btn_Software01').html('申请使用');
                        }
                        $('#Popup_LimitTime01').html(WebGISModel.TaskTimeString);

                        //2.插拔桩
                        PopupSoftwareInit('02');
                        if (WebGISModel.IsUsed) {
