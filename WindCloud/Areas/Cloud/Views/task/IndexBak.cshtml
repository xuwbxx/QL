                            TaskFileHtml += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileExtension + '</td><td>' + dom.FileLength + '</td><td><a href="#" class="xm_zt_red" onclick="DeleteTaskFile(this);">删除</a></td></tr>';
                            TaskFileCount++;
