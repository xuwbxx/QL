                            $('#popup_htmlTaskFile_dkyszl').html(TaskFileHtml);
                            $('#popup_htmlTaskFile_dkyszl').attr('data-tag', 1);
                        }
                        else if (FileType == 2) {
                            $('#popup_htmlTaskFile_dksjb').html(TaskFileHtml);
                            $('#popup_htmlTaskFile_dksjb').attr('data-tag', 1);
                        }
                        else if (FileType == 3) {
                            $('#popup_htmlTaskFile_ptcyszl').html(TaskFileHtml);
                            $('#popup_htmlTaskFile_ptcyszl').attr('data-tag', 1);
