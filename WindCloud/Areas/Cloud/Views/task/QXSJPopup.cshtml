                error: function (response) {
                    console.log(response);
                },
                complete: function (data) {
                    ModalClose('information');
                }
            });

        },

        ShowPointMap: function () {

            var Points = [];
            $('ul#popup_htmlQXSJPoint li').each(function (index, dom) {

                var Inputs = $(dom).find('div.nice-select input');

                var PointName = $(Inputs).eq(0).val();
                var PointLon = $(Inputs).eq(1).val();
