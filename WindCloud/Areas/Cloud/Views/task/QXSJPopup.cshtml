        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h4 class="modal-title">
                    经纬度预览
                </h4>
            </div>
            <div class="modal-body">

                <div class="sqzl_box" style="height:50vh; " id="PointMap">

                </div>
            </div>

        </div>
    </div>
