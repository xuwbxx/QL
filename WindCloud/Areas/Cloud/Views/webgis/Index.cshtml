    };


    function setActive(obj) {
        $(".btn_weather").each(function (obj, index) {
            if ($(this).attr("is_show") == "1") {
                $(this).addClass("active");
            } else {
                $(this).removeClass("active");
            }
        });
    }


    var IsCustomerActive = false;
    var WeatherPreviousDay = function () {
        ThisWeatherDate.setDate(ThisWeatherDate.getDate() - 1);

        $('div#div_WeatherDate').html(CanvasShipUtils.dataFormat(ThisWeatherDate, "yyyy-MM-dd"))

        $(".btn_weather").each(function (index, dom) {
            if ($(dom).attr("is_show") == "1") {
                IsCustomerActive = true;
                $(dom).click();
            }
        });
    }

    var WeatherNextDay = function () {
        ThisWeatherDate.setDate(ThisWeatherDate.getDate() + 1);

        $('div#div_WeatherDate').html(CanvasShipUtils.dataFormat(ThisWeatherDate, "yyyy-MM-dd"))

        $(".btn_weather").each(function (index, dom) {
