            //        //console.error(arguments);
            //    })
            //    .always(function (data) {
            //    });
        },
        //查看轨迹信息
        ShowShipTrack: function () {
            var ShipID = $('#hid_ShipID').val();
            if (ShipID == "" || ShipID == 0)
                return;
            var PickerStartTime = $('#ShipTrackStartTime').val();
            var PickerEndTime = $('#ShipTrackEndTime').val();

            if (PickerStartTime == '' || PickerEndTime == '')
                return;
            var Param = {};
            Param.ShipID = ShipID;
            Param.StartTime = (new Date(PickerStartTime)).getTime().toString().substring(0, 10);
            Param.EndTime = (new Date(PickerEndTime)).getTime().toString().substring(0, 10);

            $.post('GetShipTrack', Param)
                .success(function (data, statusText, jqXRH) {
                    if (data) {
                        if (data.Success) {
                            ShipHelper.DrawShipTrack(data.Data);
                        }
                    }
                })
                .fail(function (jqXHR, statusText, errorMessage) {
                    //console.error(arguments);
                })
                .always(function (data) {

                });
        },

        DrawShipTrack: function (data) {
            if (data == null || data.length == 0)
                return;
            var ShipID = $('#hid_ShipID').val();
            if (ShipID == "" || ShipID == 0)
                return;
            var tracks = [];
            $(data).each(function (index, dom) {
                var track = new Track();
                track.hdg = dom.Cog;
                track.utc = dom.Time;
                track.sog = dom.Speed;
                track.lng = dom.LonValue;
                track.lat = dom.LatValue
                tracks.push(track);
            })

            var TrackOptions = {
                lineColor: 'tomato',// 线，颜色
                lineWeight: 2, // 线，粗细
                dash: true, // 是否为虚线
                dashArray: [5, 5],// 虚线间隔
                circleOverColor: 'yellow',// 轨迹点,鼠标划过时颜色
                isDilute: true, // 是否抽稀模式显示
                startShow: true,// 是否显示“起点”图标，默认值：true
                endShow: true,// 是否显示“终点”图标，默认值：true
                directionShow: true,// 轨迹方向三角是否展示，默认值：false
                //lableFields: ["name", "mmsi", "sog", "cog", "utc", "kn", "md"],// lable显示的字段
            };

            // 添加并显示轨迹
            _map.trackService.addAndShow("truck_id_001", tracks, TrackOptions, { "mmsi": ShipID });

            //if (_map.getZoom() > 14) {
            //    _map.setZoom(14);
            //}
        },
        //取消轨迹
        ClearShipTrack: function () {
            _map.trackService.removeAll();
        },

    }

    var CloseShipList = function () {

        $('.cblb_tk').hide();

    }

    var CloseShipInfo = function () {

        $('.cbxq_tk').hide();
    }

    var DisplayShip = function () {

        var IsChecked = $('#cb_chuanbo').prop('checked');
        //alert(IsChecked);

        if (IsChecked) {
            MarkerHelper.showAllShips();
            $('.cblb_tk').show();
        }
        else {
            MarkerHelper.clearAllShips();
            $('.cblb_tk').hide();
        }

    }

    var DisplayWeather = function () {

        var IsChecked = $('#cb_weather').prop('checked');

        if (IsChecked) {
            $('.qt_qxxq').show();
        }
        else {
            $('.qt_qxxq').hide();
        }

    }

    var QueryShipKeyWord = function () {

        var ShipType = $('#popup_html_ShipType').val();
        var ShipKeyWord = $('#popup_txt_ShipName').val();

        $('#table_html_ShipList tr').each(function (index, dom) {
            $(dom).css('display', '');
        })

        if (ShipType != 0) {
            $('#table_html_ShipList tr').each(function (index, dom) {
                var ThisShipType = $(dom).find('td').eq(1).html();
                if (ThisShipType != ShipType) {
                    $(dom).css('display', 'none');
                }
            })
        }

        if (ShipKeyWord != '') {
            $('#table_html_ShipList tr').each(function (index, dom) {
                var ThisShipName = $(dom).find('td').eq(0).html();
                if (ThisShipName.indexOf(ShipKeyWord) == -1) {
                    $(dom).css('display', 'none');
                }
            })
        }

    }


    var QueryShipInfo = function (ShipID, IsFocused) {

        if (ShipID == null || ShipID == '' || ShipID == 0)
            return;

        $('div.map_popover_cb').css('display', 'none');
        $('.cbxq_tk').stop(true, true).fadeIn();
        ShipHelper.ShipTrackDateInit();

        var Param = {};
        Param.ShipID = ShipID;
        $.post('GetShip', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {
                        var Ship = data.Data;
                        if (Ship.Lon != null && Ship.Lat != null) {
                            MarkerHelper.showShip(Ship.ID);
                            if (IsFocused) {
                                MapHelper.mapZoomToPosition(9, Ship.Lat, Ship.Lon);
                            }

                            $("#Ship" + ShipID).stop(true, true).fadeIn();
                            $('#hid_ShipID').val(Ship.ID);

                            //填充数据
                            $('#ShipInfo_ShipName').html(Ship.ShipName);
                            $('#ShipInfo_ShipType').html(Ship.ShipTypeName);
                            $('#ShipInfo_Dest').html(Ship.Dest);
                            $('#ShipInfo_Status').html(Ship.StatusStr);
                            //$('#ShipInfo_Weight').html("-<span>吨</span>");
                            $('#ShipInfo_Length').html(Ship.Length + "<span>米</span>");
                            $('#ShipInfo_Width').html(Ship.Width + "<span>米</span>");
                            $('#ShipInfo_Draught').html(Ship.Draught + "<span>米</span>");
                            //$('#ShipInfo_LiftWeight').html(Ship.LiftWeight + "<span>吨</span>");
                            //$('#ShipInfo_LiftHeight').html(Ship.LiftHeight + "<span>米</span>");
                            //AIS
                            $('#span_MMSI').html(Ship.MMSI);
                            $('#span_CallSign').html(Ship.CallSign);
                            $('#span_IMO').html(Ship.IMO);
                            $('#span_Speed').html(Ship.Speed + '<i>节</i>');
                            $('#span_Lon').html(Ship.LonStr);
                            $('#span_Lat').html(Ship.LatStr);
                            $('#span_Dest').html(Ship.Dest);
                            $('#span_ArriveTime').html(Ship.YDSJ);
                            $('#span_NaviStat').html(Ship.Navistat);
                            $('#span_Degree').html(Ship.Heading + '<i>度</i>');
                            $('#span_Left').html(Ship.Left + '<i>米</i>');
                            $('#span_Trail').html(Ship.Trail + '<i>米</i>');
                            $('#span_ShipCode').html(Ship.ShipCode);
                            $('#span_UpdateTime').html(formatDateStamp(Ship.UpdateTime));
                            //联系方式
                            //$('#span_Captain').html(Ship.Captain);
                            //$('#span_CaptainPhone').html(Ship.CaptainPhone);
                            //$('#span_Name1').html(Ship.Name1);
                            //$('#span_Phone1').html(Ship.Phone1);
                            //$('#span_Name2').html(Ship.Name2);
                            //$('#span_Phone2').html(Ship.Phone2);
                        }

                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
            });

    }



</script>