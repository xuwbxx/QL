        {
            return imgSrc;
        }

        if (img == 'word') {
            imgSrc = '/Content/Cloud/img/icon_word.png';
        }
        else if (img == 'excel') {
            imgSrc = '/Content/Cloud/img/icon_excel.png';
        }
        else if (img == 'pdf') {
            imgSrc = '/Content/Cloud/img/icon_pdf.png';
        }
        else
        {
            imgSrc = '/Content/Cloud/img/icon_qtwd.png';
        }
        return imgSrc;

    }

