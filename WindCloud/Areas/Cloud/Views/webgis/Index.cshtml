
@{
    ViewBag.Title = "风电WebGIS";
    Layout = "~/Views/Shared/WebGISLayout.cshtml";
}

<script src="https://api.shipxy.com/h5/api/?v=3.0&k=@(ViewData["PXYKey"].ToString())"></script>
<script src="~/Content/leaflet/dist/leaflet-ant-path.js"></script>
<input type="hidden" id="PXYKey" value="@ViewData["PXYKey"].ToString()" />
<input type="hidden" id="hid_ProjectID" value="@ViewData["ProjectID"].ToString()" />
<input type="hidden" id="hid_ProjectLon" value="@ViewData["ProjectLon"].ToString()" />
<input type="hidden" id="hid_ProjectLat" value="@ViewData["ProjectLat"].ToString()" />

<style>
    .map {
        position: relative;
        width: 100vw;
        height: 100vh;
        margin: 0 auto;
        background-color: rgb(126, 206, 244);
        background-size: cover;
    }

    .mapmin {
        width: 100vw;
        height: 100vh;
    }

    .leaflet-top {
        top: 6vh;
    }


    .div_btn {
        position: absolute;
        /*top: 150px;*/
        left: 10px;
        z-index: 888;
        width: 32px;
        border: 1px solid #ccc;
        border-radius: 4px;
        bottom: 200px;
    }

    .btn_weather {
        width: 32px;
        height: 32px;
        line-height: 32px;
        text-decoration: none;
        cursor: pointer;
        text-align: center;
        border: 0;
        opacity: 1;
        cursor: pointer;
        background-color: #fff;
        border-bottom: 1px solid #ccc;
        background-repeat: no-repeat;
        background-position: center center;
        background-size: 90%;
        padding: 0;
        margin: 0;
    }

        .btn_weather:first-child {
            border-top-left-radius: 4px;
            border-top-right-radius: 4px;
        }

        .btn_weather:last-child {
            border-bottom-left-radius: 4px;
            border-bottom-right-radius: 4px;
            border-bottom: 0px solid #ccc;
        }

        .btn_weather:active, .btn_weather:focus, .btn_weather.active {
            background-color: #48505c;
        }

        .btn_weather:hover {
            background-color: #ff8573;
        }

        .btn_weather.qiwen {
            background-image: url(data:image/png;base64,);
        }

        .btn_weather.qiya {
            background-image: url(data:image/png;base64,);
        }

        .btn_weather.haifeng {
            background-image: url(data:image/png;base64,);
        }

        .btn_weather.fengchang {
            background-image: url(data:image/png;base64,);
        }

        .btn_weather.taifeng {
            background-image: url(data:image/png;base64,);
        }

        .btn_weather.hailang {
            background-image: url(data:image/png;base64,);
        }

        .btn_weather.jiangshui {
            background-image: url(data:image/png;base64,);
        }

        .btn_weather.chaoxi {
            background-image: url(data:image/png;base64,);
        }

        .btn_weather.yubao {
            background-image: url(data:image/png;base64,);
        }

    table tbody tr td:nth-child(1) {
        text-align: center;
    }


    .leaflet-labelfan {
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        pointer-events: none;
        white-space: nowrap;
    }

    .leaflet-labelship {
        background-color: aqua;
        /*background-clip: padding-box;*/
        color: yellow;
        /*-webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
        pointer-events: none;
        white-space: nowrap;*/
    }


    /*滚动条*/
    ::-webkit-scrollbar {
        width: 0.24vw !important;
        height: 10px;
        background: rgba(0,0,0,0.8);
    }

    ::-moz-scrollbar {
        width: 0.24vw;
        height: 10px;
        background: rgba(0,0,0,0.8);
    }

    ::-ms-scrollbar {
        width: 0.24vw;
        height: 10px;
        background: rgba(0,0,0,0.8);
    }

    ::-o-scrollbar {
        width: 0.24vw;
        height: 10px;
        background: rgba(0,0,0,0.8);
    }

    ::-webkit-scrollbar-thumb {
        background: #2c98ff;
    }

    ::-moz-scrollbar-thumb {
        background: #2c98ff;
    }

    ::-mswebkit-scrollbar-thumb {
        background: #2c98ff;
    }

    ::-o-scrollbar-thumb {
        background: #2c98ff;
    }

    div {
        scrollbar-arrow-color: #2c98ff; /**/ /*三角箭头的颜色*/
        scrollbar-face-color: #2c98ff; /**/ /*立体滚动条的颜色*/
        scrollbar-3dlight-color: #2c98ff; /**/ /*立体滚动条亮边的颜色*/
        scrollbar-highlight-color: rgba(255,255,255,1); /**/ /*滚动条空白部分的颜色*/
        scrollbar-shadow-color: #2c98ff; /**/ /*立体滚动条阴影的颜色*/
        scrollbar-darkshadow-color: #2c98ff; /**/ /*立体滚动条强阴影的颜色*/
        scrollbar-track-color: #4e657b; /**/ /*立体滚动条背景颜色*/
        scrollbar-base-color: #f8f8f8; /**/ /*滚动条的基本颜色*/
    }
</style>

<input type="hidden" id="hid_PostToken" value="@ViewData["PostToken"].ToString()" />

<!--背景 start-->
<div class="bim-content">
    <div class="map">
        <div id="map" class="mapmin ma-map">
            <div class="div_btn">
                <p id="btn_qiwen" class="btn_weather qiwen" title="气温" />

                <p id="btn_qiya" class="btn_weather qiya" title="气压" />

                <p id="btn_haifeng" class="btn_weather haifeng" title="海风" />

                <p id="btn_taifeng" class="btn_weather taifeng" title="台风" />

                <p id="btn_fengchang" class="btn_weather fengchang" title="风场" />

                <p id="btn_hailang" class="btn_weather hailang" title="海浪" />

                <p id="btn_chaoxi" class="btn_weather chaoxi" title="潮汐" />

                <p id="btn_haiquyubao" class="btn_weather yubao" title="预报" />
            </div>
        </div>
    </div>
</div>
<!--背景 end-->
<!--header start-->
<div class="box-header clearfix">
    <div class="title_l"><img src="~/Content/Cloud/img/logo.png">海上风电WebGIS平台</div>
    <div class="title_fc_name">@ViewData["ProjectName"].ToString()</div>
    <div class="fhsyy_box" onclick="DoProjectFanBack();">
        <img src="~/Content/Cloud/img/bg_icon_fhsyy.png">
