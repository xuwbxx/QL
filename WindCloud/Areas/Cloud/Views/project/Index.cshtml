<script>
    var OpenDKMatch = function () {

        $('#tk_DK_Match').modal('show');

        Param.ProjectID = PopupOpenedProjectID;
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('QueryDKData', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        var FanHtml = '';
                        $(data.Data.Fans).each(function (index, dom) {

                            FanHtml += '<li><span><input type="radio" name="fengji" data-id="' + dom.ID + '" onchange="ChooseFan(this);">' + dom.FanName + '</span><span>';

                            var FanDKHtml = '';
                            $(dom.DKs).each(function (index2, dom2) {

                                FanDKHtml += '<i data-id="' + dom2.ID + '" title="' + dom2.DKName + '">' + dom2.DKName + '</i>';

                            })
                            FanHtml += FanDKHtml;
                            FanHtml += '</span></li>';
                        })
                        $('#popup_htmlFanMatch').html(FanHtml);

                        var DKHtml = '';
                        $(data.Data.DKs).each(function (index, dom) {

                            var IsChecked = '';
                            if (dom.IsChecked)
                            {
                                IsChecked = 'checked disabled';
                            }
                            
                            DKHtml += '<li><input type="checkbox" data-name="' + dom.DKName + '" data-fanid="' + dom.FanID + '" data-id="' + dom.ID + '" ' + IsChecked + '>' + dom.DKName + '</li>';

                        })
                        $('#popup_htmlDKMatch').html(DKHtml);
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
            });

    }


    var FanDKMatch = function () {

        var FanDom = $('input[name="fengji"]:checked');
        if (FanDom == null)
            return;

        var FanID = $(FanDom).attr('data-id');

        $(FanDom).parent().next().html('');

        $('#popup_htmlDKMatch input:checkbox').each(function (index, dom) {

            if ($(dom).attr('disabled') != 'disabled')
            {
                $(dom).attr('data-fanid', 0);

                if ($(dom).prop('checked') == true)
                {
                    $(dom).attr('data-fanid', FanID);

                    $(FanDom).parent().next().append('<i data-id="' + $(dom).attr('data-id') + '" data-name="' + $(dom).attr('data-name') + '">' + $(dom).attr('data-name') + '</i>')

                }

            }

        })

    }


    var ChooseFan = function (dom) {

        var FanID = $(dom).attr('data-id');

        $('#popup_htmlDKMatch input:checkbox').each(function (index, dom) {

            //$(dom).parent().show();
            $(dom).prop('checked', false).attr('disabled', false);

            var ThisFanID = $(dom).attr('data-fanid');

            if (ThisFanID != 0)
            {
                if (ThisFanID == FanID) {
                    $(dom).prop('checked', true).attr('disabled', false);
                }
                else
                {
                    $(dom).prop('checked', true).attr('disabled', true);
                }
            }
        })

    }

    var SaveDKMatch = function () {

        Param.ProjectID = PopupOpenedProjectID;

        Param.Fans = [];

        $('#popup_htmlFanMatch input[name="fengji"]').each(function (index, dom) {

            var fan = {};
            fan.ID = $(dom).attr('data-id');
            fan.DKs = [];

            $(dom).parent().next().children('i').each(function (index2, dom2) {

                var dk = {};
                dk.ID = $(dom2).attr('data-id');
                fan.DKs.push(dk);
            })

            Param.Fans.push(fan);

        })
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('SaveDKMatch', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        ModalPopup('success', '保存成功');

                        $('#tk_DK_Match').modal('hide');
                        
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
            });

    }

    var OpenProjectInfoMore = function () {

        if ($('.xmjbxx_boxmore').css("display") == 'block') {
            $('.xmjbxx_boxmore').hide();
            $('.xmjbxx_boxmore_btn').css("background", "url('../../Content/Cloud/img/icon-fc-bottom.png') no-repeat center center");
        } else {
            $('.xmjbxx_boxmore').show();
            $('.xmjbxx_boxmore_btn').css("background", "url('../../Content/Cloud/img/icon-fc-top.png') no-repeat center center");
        }

    }

    var DeleteProjectFile = function (ID) {

        if (ID == null || ID == '' || ID == 0)
        {
            return;
        }

        Param.ID = ID;
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        //下一节点人员
        $.post('DeleteProjectFile', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {

                        var ProjectFileHtml = '';
                        $(data.Data).each(function (index, dom) {

                            ProjectFileHtml += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a href="' + dom.FilePath + '" download="' + dom.FileName + '" class="xm_zt_green" download="' + dom.FileName + '">下载</a> / <a class="xm_zt_red" onclick="DeleteProjectFile(' + dom.ID + ')">删除</a></td></tr>';  //<a href="#" class="xm_zt_red" onclick="DeleteProjectFile(this);">删除</a>
                        });
                        $('#popup_htmlProjectFile').html(ProjectFileHtml);

                        ModalPopup('success', '删除成功');

                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
            });

    }
    

</script>

