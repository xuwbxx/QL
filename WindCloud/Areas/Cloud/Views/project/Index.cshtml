@*列表事件*@
<script>
    $(document).ready(function () {
        ParamInit();

        Query();

        
    })

    var Param = {};
    var ParamInit = function () {
        Param.PageIndex = 1;
        Param.PageSize = 100;
        Param.TotalPage = 0;
        Param.TotalCount = 0;

        Param.ProjectName = $("#query_txtProjectName").val();
        Param.Name = $('#popup_txtUserName').val();

        Param.Order = "desc";
        Param.OrderName = "ApplyTime";

    }

    //查询
    var Query = function () {

        //OpenMaskLayout();
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('ProjectListQuery', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        var DataListHtml = '';
                        $(data.Data).each(function (index, dom) {

                            var ProjectCodeClass = dom.IsFinished ? 'xm_zt_blue' : 'xm_zt_orange';

                            //流程状态
                            var FlowStatusClass = 'zt_orange';
                            if (dom.FlowStatus == 1) {
                                FlowStatusClass = 'zt_red';
                            }
                            else if (dom.FlowStatus == 2) {
                                FlowStatusClass = 'zt_green';
                            }
                            else if (dom.FlowStatus == 3) {
                                FlowStatusClass = 'zt_grey';
                            }

                            //操作
                            if (dom.FlowHandle == 'view') {
                                FlowOperateContent = '查看';
                                FlowOperateClass = 'cz_blue';
                                FlowOperateType = 'view'
                            }
                            else if (dom.FlowHandle == 'approval') {
                                FlowOperateContent = '审批';
                                FlowOperateClass = 'cz_orange';
                                FlowOperateType = 'approval'
                            }
                            else if (dom.FlowHandle == 'renew') {
                                FlowOperateContent = '重填';
                                FlowOperateClass = 'cz_orange';
                                FlowOperateType = 'approval'
                            }

                            var FlowNodeHtml = '';
                            if (dom.IsFinished == true) {
                                FlowNodeHtml = '流程结束';
                            }
                            else {
                                FlowNodeHtml = dom.FlowNode + '：';
                                $(dom.NodeUser).each(function (index, dom) {
                                    FlowNodeHtml += '<a href="#" class="xm_zt_blue table_ryxx_box"><span>' + dom.NodeUserName + ';</span><div class="hover_ryxx"><ul><li><i class="icon iconfont">&#xe752;</i>部门：' + dom.NodeUserDepart + '</li><li><i class="icon iconfont">&#xe607;</i>手机号：' + dom.NodeUserPhone + '</li><li> <i class="icon iconfont">&#xe673;</i>职位：' + dom.NodeUserJobName + '</li></ul></div></a>';
                                });
                                //FlowNodeHtml = dom.FlowNode + '：<a href="#" class="xm_zt_blue table_ryxx_box"><span>' + dom.NodeUser.NodeUserName + '</span><div class="hover_ryxx"><ul><li><i class="icon iconfont">&#xe752;</i>部门：' + dom.NodeUser.NodeUserDepart + '</li><li><i class="icon iconfont">&#xe607;</i>手机号：' + dom.NodeUser.NodeUserPhone + '</li><li> <i class="icon iconfont">&#xe673;</i>职位：' + dom.NodeUser.NodeUserJobName + '</li></ul></div></a>';
                            }

                            var FlowRightEditHtml = '';
                            if (dom.DoRightEdit == true)
                            {
                                FlowRightEditHtml = '<a class="cz_orange" href="#" onclick="OpenProjectEdit(' + dom.ID + ');">资料修改</a>';
                            }
                            var FlowRightDeleteHtml = '';
                            if (dom.DoRightDelete == true) {
                                FlowRightDeleteHtml = '<a class="cz_red" href="#" onclick="DeleteProjectFlow(' + dom.ID + ',\'' + dom.ProjectName + '\');">删除</a>';
                            }

                            var WebGISHtml = '';
                            if (dom.IsWebGIS)
                            {
                                WebGISHtml = '<img src="/Content/Cloud/img/icon_webgis.png" class="img_webgis" onclick="OpenWebGIS(' + dom.ID + ');">';
                            }

                            DataListHtml += '<tr><td class="' + ProjectCodeClass + '"><a class="xm_zt_blue" href="/Cloud/Task/Index?ProjectID=' + dom.ID + '">' + dom.ProjectCode + '</a></td><td><a class="xm_zt_blue" href="/Cloud/Task/Index?ProjectID=' + dom.ID + '">' + dom.ProjectName + '</a></td><td class="xm_zt_green">' + dom.ProjectStatus + '</td>'
                                + '<td class=""><a href="#" class="xm_zt_blue table_ryxx_box"><span>' + dom.Director.DirectorName + '</span><div class="hover_ryxx"><ul><li><i class="icon iconfont">&#xe752;</i>部门：' + dom.Director.DirectorDepart + '</li><li><i class="icon iconfont">&#xe607;</i>手机号：' + dom.Director.DirectorPhone + '</li><li> <i class="icon iconfont">&#xe673;</i>职位：' + dom.Director.DirectorJobName + '</li></ul></div></a></td>'
                                + '<td class="">' + dom.Assister + '</td>'
                                + '<td>' + dom.ApplyTime + '</td><td>' + dom.ProjectStartTime + ' 至 ' + dom.ProjectEndTime + '</td>'
                                + '<td class="">' + FlowNodeHtml + '</td>'
                                + '<td><a class="' + FlowStatusClass + '" href="#" onclick="QueryFlowHistory(' + dom.ID + ');">' + dom.FlowStatusName + '</a></td>'
                                + '<td><a class="' + FlowOperateClass + '" href="#" onclick="OpenProjectInfo(' + dom.ID + ');">' + FlowOperateContent + '</a>' + FlowRightEditHtml + FlowRightDeleteHtml + WebGISHtml + '</td>'
                                + '</tr>';
                        });

                        $('#html_DataList').html(DataListHtml);

                        //分页
                        Param.TotalPage = data.TotalPage;
                        Param.TotalCount = data.TotalCount;
                        Param.PageIndex = data.PageIndex;

                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                Pagination();
            });

    }

    var OpenWebGIS = function (ProjectID) {

        if (ProjectID == null || ProjectID == '' || ProjectID == 0) {
            return;
        }

        window.open('/Cloud/WebGIS/Index?ProjectID=' + ProjectID, '_blank')

    }

    var DoQuery = function () {

        Param.ProjectName = $("#query_txtProjectName").val();
        Query();
    }

    var DoOrderQuery = function (dom, OrderName) {

        var Order = $(dom).attr('data-order');

        Param.Order = Order;
        Param.OrderName = OrderName;

        Query();

        if (Order == 'asc') {
            $(dom).attr('data-order', 'desc');
        }
        else
        {
            $(dom).attr('data-order', 'asc');
        }

    }

    //分页
    var Pagination = function () {
        $("#Pagination").pagination({
            currentPage: Param.PageIndex,
            totalPage: Param.TotalPage,
            isShow: true,
            totalCount: Param.TotalCount,
            count: 7,
            homePageText: "首页",
            endPageText: "尾页",
            prevPageText: "上一页",
            nextPageText: "下一页",
            callback: function (current) {
                Param.PageIndex = current;
                Query();
            }
        });
    }


    var OpenTask = function () {

        //window.open('/Cloud/Task/Index', '_blank')
        window.location.href = '/Cloud/Task/Index';
    }

    var PopupOpenedProjectID = 0;
    var PopupOpenedFlowHandle = 'view';
    var PopupIsBackFlow = false;
    var PopupIsCreateProjectCodeNode = false;
    var OpenProjectInfo = function (ProjectID) {

        Param.ProjectID = ProjectID;

        PopupOpenedProjectID = 0;
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('ProjectQuery', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {
                        PopupOpenedProjectID = ProjectID;

                        var Project = data.Data;

                        OpenProjectPopup(Project.FlowInfo.FlowHandle);
                        PopupIsBackFlow = Project.FlowInfo.IsBackFlow;

                        if (Project.FlowInfo.DoEditConfirm == true)
                        {
                            //此节点如果是可编辑状态
                            $('#popup_uploadProjectPosition').attr('disabled', false);
                            $('#popup_btnProjectPositionUpload').attr('disabled', false);
                            $('#popup_btnProjectPositionDownload').attr('disabled', false);
                            $('#popup_btnAddProjectPosition').attr('disabled', false);

                            $('#popup_uploadProjectFanPosition').attr('disabled', false);
                            $('#popup_btnProjectFanPositionUpload').attr('disabled', false);
                            /*$('#popup_btnAddFanPosition').attr('disabled', false);*/

                            $('#popup_uploadProjectFileInfo').attr('disabled', false);
                            $('#popup_btnUploadProjectFile').attr('disabled', false);

                            $('#popup_uploadProjectFile_dkyszl').attr('disabled', false);
                            $('#popup_btn_uploadProjectFile_dkyszl').attr('disabled', false);

                            $('#popup_uploadProjectFile_dksjb').attr('disabled', false);
                            $('#popup_btn_uploadProjectFile_dksjb').attr('disabled', false);

                            $('div#popup_divDKMatch').show();

                        }

                        //退回重新走流程
                        if (Project.FlowInfo.FlowHandle == 'renew') {
                            ChoosedProjectManager.Name = Project.ProjectManager.UserName;
                            ChoosedProjectManager.UserCode = Project.ProjectManager.UserCode;
                            ChoosedProjectManager.Depart = Project.ProjectManager.UserDepart;
                            ChoosedProjectManager.Phone = Project.ProjectManager.UserPhone;
                            ChoosedProjectManager.JobName = Project.ProjectManager.UserJobName;
                        }

                        //如果下一节点流程结束
                        ChoosedProjectNodeManager.NextNodeID = Project.FlowInfo.NextNodeID;
                        if (Project.FlowInfo.NextNodeID == 0) {
                            $('#popup_txtNodeUserName').attr('disabled', true);
                            $('#popup_btnFindNodeUserName').attr('disabled', true);
                            $('#popup_divClearNodeName').hide();

                        }

                        

                        //下一节点如果有默认人物,则不能让用户搜索人物
                        if (Project.FlowInfo.NextNode != null && Project.FlowInfo.NextNode.length > 0) {
                            $('#popup_txtNodeUserName').attr('disabled', true);
                            $('#popup_btnFindNodeUserName').attr('disabled', true);
                            $('#popup_divClearNodeName').hide();

                            var NodeUserHtml = '';
                            $(Project.FlowInfo.NextNode).each(function (index, dom) {

                                NodeUserHtml += dom.UserName + '(' + dom.UserDepart + ');'

                            });
                            $('#popup_txtNodeUserName').val(NodeUserHtml);
                        }

                        //填充数据
                        $('#popup_txtProjectName').val(Project.ProjectName);
                        $('#popup_txtProjectCode').val(Project.ProjectCode);
                        $('#popup_spanNextNodeName').html(Project.FlowInfo.NextNodeName);

                        
                        PopupIsCreateProjectCodeNode = Project.FlowInfo.IsCreateProjectCode;
                        if (PopupIsCreateProjectCodeNode) {
                            $('#popup_txtProjectCode').attr('disabled', false).val('');
                        }
                        else {
                            $('#popup_txtProjectCode').attr('disabled', true);
                        }

                        //项目负责人
                        $('#popup_txtUserName').val(Project.ProjectManager.UserName + '(' + Project.ProjectManager.UserDepart + ')');

                        var ProjectGroupUserHtml = '';
                        $(Project.ProjectGroupUser).each(function (index, dom) {

                            ProjectGroupUserHtml += '<li class="clearfix"><span><div class="nice-select"><input type="text" class="form-control" data-UserName="' + dom.UserName + '" data-UserCode="' + dom.UserCode + '" data-UserDepart="' + dom.UserDepart + '" data-UserPhone="' + dom.UserPhone + '" data-UserJobName="' + dom.UserJobName + '" value="' + dom.UserName + '(' + dom.UserDepart + ')"><div class="search_div" onclick="ClearProjectGroupUser(this);"><i class="fa fa-close"></i></div><ul></ul></div></span><span><button type="button" class="btn btn-primary" onclick="FindProjectGroupUser(this);">搜索</button><button type="button" class="btn btn-danger" onclick="DeleteProjectGroupUser(this);">删除</button></span></li>';

                        })
                        $('#popup_htmlProjectGroupUser').html(ProjectGroupUserHtml);
                        if (Project.FlowInfo.FlowHandle == 'renew') {
                            SetProjectGroupUserWrite();
                        }
                        else
                        {
                            SetProjectGroupUserRead();
                        }
                        
                        


                        $('#popup_ProjectDateStart').val(Project.ProjectStartTime);
                        $('#popup_ProjectDateEnd').val(Project.ProjectEndTime);

                        //上一节点意见（可能多人）
                        var CommentHtml = '';
                        $(Project.FlowInfo.LastNode).each(function (index, dom) {
                            CommentHtml += dom.UserName + ':' + dom.Comment + ';\n'
                        });
                        $('#popup_txtLastContent').val(CommentHtml);


                        //基本信息
                        var ProjectInfo = Project.ProjectInfo;
                        $('#popup_ProjectCompany').val(Project.CompanyID);
                        $('#popup_ProjectStatus').val(Project.Status);
                        $('#popup_ProjectWaterDepthMax').val(ProjectInfo.WaterDepthMax);
                        $('#popup_ProjectWaterDepthMin').val(ProjectInfo.WaterDepthMin);

                        //以下是文件资料
                        var ProjectPositionHtml = '';
                        $(Project.ProjectPosition).each(function (index, dom) {
                            ProjectPositionHtml += '<tr><td>' + (index + 1) + '</td><td><input type="text" disabled class="form-control" placeholder="注意格式：120.1794393" value="' + dom.Lon + '"></td><td><input type="text" disabled class="form-control" placeholder="注意格式：25.1794393" value="' + dom.Lat + '"></td><td></td></tr>';  //<a href="#" class="xm_zt_red" onclick="DeleteProjectPosition(this);">删除</a>
                        });
                        $('#popup_htmlProjectPosition').html(ProjectPositionHtml);

                        var FanPositionHtml = '';
                        $(Project.ProjectFan).each(function (index, dom) {
                            FanPositionHtml += '<tr><td><input type="text" disabled class="form-control" disabled placeholder="1#" value="' + dom.FanName + '"></td><td><input type="text" disabled class="form-control" placeholder="注意格式：120.1794393" value="' + dom.Lon + '"></td><td><input type="text" disabled class="form-control" placeholder="25.1794393" value="' + dom.Lat + '"></td><td></td></tr>';  //<a href="#" class="xm_zt_red" onclick="DeleteProjectPosition(this);">删除</a>
                        });
                        $('#popup_htmlProjectFanPosition').html(FanPositionHtml);

                        var ProjectFileHtml = '';
                        $(Project.ProjectFile).each(function (index, dom) {
                            if (Project.FlowInfo.FlowHandle == 'approval' || Project.FlowInfo.FlowHandle == 'renew') {
                                ProjectFileHtml += '<tr><td>' + dom.FileName + '</td><td>' + dom.FileTime + '</td><td><a href="' + dom.FilePath + '" class="xm_zt_green" download="' + dom.FileName + '">下载</a> / <a class="xm_zt_red" onclick="DeleteProjectFile(' + dom.ID + ')">删除</a></td></tr>';
                            }
                            else
