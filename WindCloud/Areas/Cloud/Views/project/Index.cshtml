    var DoProjectEditSubmit = function () {

        if (ChoosedProjectManager == null || ChoosedProjectManager.UserCode == null || ChoosedProjectManager.UserCode == '') {
            ModalClose('information');
            ModalPopup('error', '需要选择项目负责人');
            return;
        }

        var SubmitFormData = new FormData();
        SubmitFormData.append("ProjectID", PopupOpenedProjectID);
        SubmitFormData.append("ProjectName", $('#popup_txtProjectName').val());
        SubmitFormData.append("ProjectStartTime", $('#popup_ProjectDateStart').val());
        SubmitFormData.append("ProjectEndTime", $('#popup_ProjectDateEnd').val());

        SubmitFormData.append("ProjectManagerName", ChoosedProjectManager.Name);
        SubmitFormData.append("ProjectManagerUserCode", ChoosedProjectManager.UserCode);
        SubmitFormData.append("ProjectManagerDepart", ChoosedProjectManager.Depart);
        SubmitFormData.append("ProjectManagerPhone", ChoosedProjectManager.Phone);
        SubmitFormData.append("ProjectManagerJobName", ChoosedProjectManager.JobName);

        SubmitFormData.append("CompanyID", $('#popup_ProjectCompany').val());
        SubmitFormData.append("Status", $('#popup_ProjectStatus').val());
        SubmitFormData.append("WaterDepthMax", $('#popup_ProjectWaterDepthMax').val());
        SubmitFormData.append("WaterDepthMin", $('#popup_ProjectWaterDepthMin').val());

        var ProjectGroupUsers = [];
        $('#popup_htmlProjectGroupUser li.clearfix').each(function (index, dom) {

            if ($(UserDom).attr('data-UserCode') != '')
            {
                var User = {};
                var UserDom = $(dom).find('div.nice-select').children().first();
                User.UserName = $(UserDom).attr('data-UserName');
                User.UserCode = $(UserDom).attr('data-UserCode');
                User.UserDepartName = $(UserDom).attr('data-UserDepart');
                User.UserPhone = $(UserDom).attr('data-UserPhone');
                User.UserJobName = $(UserDom).attr('data-UserJobName');
                ProjectGroupUsers.push(User);
            }
        })

        SubmitFormData.append("ProjectGroupUsers", JSON.stringify(ProjectGroupUsers));

        $.ajax({
            url: 'ProjectEditSubmit',
            dataType: 'json',
            type: 'POST',
            async: false,
            data: SubmitFormData,
            processData: false, // 使数据不做处理
            contentType: false, // 不要设置Content-Type请求头
            success: function (data) {

                if (data) {
                    if (data.Success) {
                        ModalPopup('success', '保存成功');
                        $('#tk_Project').modal('hide');
                        DoQuery();
                    }
                    else {

                        ModalPopup('error', data.Message);
                    }

                }

            },
            error: function (response) {
                console.log(response);
            },
            complete: function (data) {
                ModalClose('information');
            }
        });
    }


    var AddProjectGroupUser = function () {

        var NewHtml = '<li class="clearfix"><span><div class="nice-select"><input type="text" class="form-control" data-UserName="" data-UserCode="" data-UserDepart="" data-UserPhone="" data-UserJobName="" value="" placeholder="姓名关键字搜索"><div class="search_div" onclick="ClearProjectGroupUser(this);"><i class="fa fa-close"></i></div><ul></ul></div></span><span>'
            + '<button type="button" class="btn btn-primary" onclick="FindProjectGroupUser(this);">搜索</button><button type="button" class="btn btn-danger" onclick="DeleteProjectGroupUser(this);">删除</button></span></li>';

        $('#popup_htmlProjectGroupUser').append(NewHtml);

    }

    var ClearProjectGroupUser = function (dom) {

        $(dom).prev('input').val('');

        $(dom).prev('input').attr('data-username', '');
        $(dom).prev('input').attr('data-usercode', '');
        $(dom).prev('input').attr('data-userdepart', '');
        $(dom).prev('input').attr('data-userphone', '');
        $(dom).prev('input').attr('data-userjobname', '');
    }

    var FindProjectGroupUser = function (dom) {

        var UserName = $(dom).parent().prev().children().last().children().first().val()
        if (UserName == null || UserName == '')
            return;

        var ShjUserDom = $(dom).parent().prev().children().children('ul');

        $(ShjUserDom).html('');

        Param.Name = UserName;
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('/Cloud/Base/FindShjUser', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {

                    if (data.Success) {

                        var ShjUsertml = '';
                        $(data.Data).each(function (index, dom) {

                            ShjUsertml += '<li onclick="ChooseProjectGroupUser(this);" data-usercode="' + dom.empcode + '" data-name="' + dom.name + '" data-depart="' + dom.wholeDeptPath + '" data-phone="' + dom.phone + '" data-jobname="' + dom.jobname + '" ><h3>' + dom.name + '(' + dom.jobname + ')</h3><div>' + dom.wholeDeptPath + '</div></li >';

                        });
                        $(ShjUserDom).show().html(ShjUsertml);

                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                //Pagination();
            });

    }

    var DeleteProjectGroupUser = function (dom) {

        $(dom).parent().parent().remove();

    }

    var ChooseProjectGroupUser = function (dom) {

        if (dom == null)
            return;

        var Name = $(dom).attr('data-name');
        var UserCode = $(dom).attr('data-usercode');
        var Depart = $(dom).attr('data-depart');
        var Phone = $(dom).attr('data-phone');
        var JobName = $(dom).attr('data-jobname');

        var UserDom = $(dom).parent().parent().children().first();

        $(UserDom).val(Name + '(' + Depart + ')');

        $(UserDom).attr('data-UserName', Name);
        $(UserDom).attr('data-UserCode', UserCode);
        $(UserDom).attr('data-UserDepart', Depart);
        $(UserDom).attr('data-UserPhone', Phone);
        $(UserDom).attr('data-UserJobName', JobName);

        $(dom).parent().hide();

    }

</script>

