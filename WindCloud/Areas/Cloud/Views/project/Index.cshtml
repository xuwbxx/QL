    //通过或者退回0和2
    var DoProjectApproval = function (type) {

        if (PopupOpenedProjectID == 0) {
            ModalClose('information');
            ModalPopup('error', '数据出错，重新打开弹窗。');
            return;
        }

        var SubmitFormData = new FormData();
        SubmitFormData.append("ApprovalType", type);
        SubmitFormData.append("NodeID", ChoosedProjectNodeManager.NextNodeID);
        SubmitFormData.append("ProjectID", PopupOpenedProjectID);
        SubmitFormData.append("ProjectComment", $('#popup_txtContent').val());
        if (ChoosedProjectNodeManager.NextNodeID == 0) {
            //流程结束

            if (type != 0)
            {
                //生成风电项目编号
                var ProjectCode = $('#popup_txtProjectCode').val();
                if (ProjectCode == '') {
                    ModalClose('information');
                    ProjectCode = ModalPopup('error', '必须输入风场项目编号');
                    return;
                }
                SubmitFormData.append("ProjectCode", $('#popup_txtProjectCode').val());
            }
            
        }
        else {
            //正常审批
            SubmitFormData.append("ProjectNodeName", ChoosedProjectNodeManager.Name);
            SubmitFormData.append("ProjectNodeUserCode", ChoosedProjectNodeManager.UserCode);
            SubmitFormData.append("ProjectNodeDepart", ChoosedProjectNodeManager.Depart);
            SubmitFormData.append("ProjectNodePhone", ChoosedProjectNodeManager.Phone);
            SubmitFormData.append("ProjectNodeJobName", ChoosedProjectNodeManager.JobName);

            //如果是退回重新审批的流程
            if (PopupIsBackFlow) {

                var ProjectName = $('#popup_txtProjectName').val();
                if (ProjectName == '') {
                    ModalClose('information');
                    ProjectCode = ModalPopup('error', '项目名称必须输入');
                    return;
                }

                SubmitFormData.append("ProjectName", $('#popup_txtProjectName').val());
                //SubmitFormData.append("ProjectCode", $('#popup_txtProjectCode').val());
                SubmitFormData.append("ProjectManagerName", ChoosedProjectManager.Name);
                SubmitFormData.append("ProjectManagerUserCode", ChoosedProjectManager.UserCode);
                SubmitFormData.append("ProjectManagerDepart", ChoosedProjectManager.Depart);
                SubmitFormData.append("ProjectManagerPhone", ChoosedProjectManager.Phone);
                SubmitFormData.append("ProjectManagerJobName", ChoosedProjectManager.JobName);

                //项目组成员
                var ProjectGroupUsers = [];
                $('#popup_htmlProjectGroupUser li.clearfix').each(function (index, dom) {

                    if ($(UserDom).attr('data-UserCode') != '') {
                        var User = {};
                        var UserDom = $(dom).find('div.nice-select').children().first();
                        User.UserName = $(UserDom).attr('data-UserName');
                        User.UserCode = $(UserDom).attr('data-UserCode');
                        User.UserDepartName = $(UserDom).attr('data-UserDepart');
                        User.UserPhone = $(UserDom).attr('data-UserPhone');
                        User.UserJobName = $(UserDom).attr('data-UserJobName');

                        ProjectGroupUsers.push(User);
                    }
                })
                SubmitFormData.append("ProjectGroupUsers", JSON.stringify(ProjectGroupUsers));

                SubmitFormData.append("ProjectStartTime", $('#popup_ProjectDateStart').val());
                SubmitFormData.append("ProjectEndTime", $('#popup_ProjectDateEnd').val());

                var CompanyID = $('#popup_ProjectCompany').val();
                var Status = $('#popup_ProjectStatus').val();
                var MaxWater = $('#popup_ProjectWaterDepthMax').val();
                var MinWater = $('#popup_ProjectWaterDepthMin').val();
                if (CompanyID == 0 || Status == 0 || MaxWater == '' || MinWater == '')
                {
                    ModalClose('information');
                    ProjectCode = ModalPopup('error', '必须输入风场项目基本信息');
                    return;
                }

                SubmitFormData.append("CompanyID", $('#popup_ProjectCompany').val());
                SubmitFormData.append("Status", $('#popup_ProjectStatus').val());
                SubmitFormData.append("WaterDepthMin", $('#popup_ProjectWaterDepthMin').val());
                SubmitFormData.append("WaterDepthMax", $('#popup_ProjectWaterDepthMax').val());



                var ProjectPosition = [];
                $('#popup_htmlProjectPosition tr').each(function (index, dom) {

                    var PPosition = {};
                    PPosition.Lon = $(dom).find('input').eq(0).val();
                    PPosition.Lat = $(dom).find('input').eq(1).val();
                    ProjectPosition.push(PPosition);
                });
                SubmitFormData.append("ProjectPositionString", JSON.stringify(ProjectPosition));

                var ProjectFanPosition = [];
                $('#popup_htmlProjectFanPosition tr').each(function (index, dom) {

                    var FPosition = {};
                    FPosition.FanName = $(dom).find('input').eq(0).val();
                    FPosition.Lon = $(dom).find('input').eq(1).val();
                    FPosition.Lat = $(dom).find('input').eq(2).val();
                    ProjectFanPosition.push(FPosition);
                });
                SubmitFormData.append("ProjectFanPositionString", JSON.stringify(ProjectFanPosition));


                var ProjectFile_tag = $('#popup_htmlProjectFile').attr('data-tag');
                SubmitFormData.append("ProjectFile_tag", ProjectFile_tag);
                if (ProjectFile_tag == '1') {
                    var FileCount = $('#popup_htmlProjectFile tr').length;
                    if (FileCount > 0) {
                        SubmitFormData.append("ProjectFileCount", FileCount);
                        var ProjectFiles = $('#popup_uploadProjectFileInfo')[0].files;
                        var Count = 1;
                        $('#popup_htmlProjectFile tr').each(function (index, dom) {

                            var FileName = $(dom).find('td').first().html();
                            if (FileName != null && FileName != '') {

                                $(ProjectFiles).each(function (index2, dom2) {

                                    if (dom2.name == FileName) {
                                        SubmitFormData.append("ProjectFile" + Count, dom2);
                                        Count++;
                                        return false;
                                    }

                                });

                            }
                        })

                    }
                }


                //1.地勘原始资料
