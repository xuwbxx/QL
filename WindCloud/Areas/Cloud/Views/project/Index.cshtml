
@{
    ViewBag.Title = "风电项目列表";
    Layout = "~/Views/Shared/ManageLayout.cshtml";
}

@{ 
    var Companys = ViewData["Companys"] as List<DataFactory.KingBase.CloudWind.Manage_Company>;
}
<input type="hidden" id="hid_CloudID" value="@ViewData["CloudID"].ToString()" />
<input type="hidden" id="hid_PostToken" value="@ViewData["PostToken"].ToString()" />

<div class="content">
    <div class="box_mode">

        <div class="title text-center">
            <div class="pull-left absolute_position">
                <button class="btn btn-primary btn-yfprw" onclick="OpenTask();"><i class="icon iconfont mr03">&#xe711;</i>已分配任务</button>
                
            </div>
            <span class="xmlb_tit" style="color: #bf1111;">风电项目列表</span>
            
        </div>
        <div class="clearfix box_table_top">
            <div class="search_box pull-left">
                <input type="text" class="form-control" placeholder="请输入项目名称" id="query_txtProjectName">
                <button class="btn btn-primary search_btn" onclick="DoQuery();"><i class="fa fa-search"></i></button>
                <span class="xm_zt_red" style="padding-left:3vw;">点击项目名称，进入软件使用界面。</span>
            </div>
            <div class="btn_box pull-right">
                <button class="btn btn-warning border-radius8" onclick="OpenProjectPopup('new');"><i class="icon iconfont">&#xe728;</i>创建项目</button>
            </div>
        </div>

        <table class="table table_project table_project02">
            <thead>
                <tr>
                    <th width="6%"><a class="xm_zt_blue" href="javascript:;" data-order="asc" onclick="DoOrderQuery(this, 'ProjectCode');">项目号</a></th>
                    <th width="16%">项目名</th>
                    <th width="4%">项目状态</th>
                    <th width="6%">项目经理</th>
                    <th width="8%">项目组成员</th>
                    <th width="10%"><a class="xm_zt_blue" href="javascript:;" data-order="asc" onclick="DoOrderQuery(this, 'ApplyTime');">申请时间</a></th>
                    <th width="12%">项目期限</th>
                    <th width="16%">当前节点</th>
                    <th width="6%">状态</th>
                    <th width="16%">操作</th>
                </tr>
            </thead>
            <tbody id="html_DataList">
            </tbody>
        </table>
        <ul class="pagination">
            <div id="Pagination"></div>
        </ul>
    </div>
</div>

<div class="zlk_box">
    <div><i class="icon iconfont">&#xe651;</i></div>
    <div>资料库</div>
</div>

