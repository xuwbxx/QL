<!--流程弹框-->
<div class="modal fade" id="tk_path" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true" data-backdrop="static">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">
                    &times;
                </button>
                <h4 class="modal-title">
                    流程图
                </h4>
            </div>
            <div class="modal-body clearfix">

                <!--流程 start-->
                <div class="flowChart">
                    <!--左侧轴-->
                    <div class="flowChart-left">
                        <!--虚线-->
                        <div class="dashed"></div>
                    </div>

                    <!--右侧内容-->
                    <div class="flowChart-right" id="html_ProjectFlowHistory">
                        <!--                                                节点1  -->

                        <div class="oneNode">
                            <!--左侧小球-->
                            <div class="check">
                                <img src="~/Content/Cloud/img/lc_faqi.png">
                            </div>

                            <!--右侧内容-->
                            <div class="NodeDetail">
                                <div class="NodeLinkName"><i class="fa fa-paper-plane-o"></i>员工入职发起申请</div>
                                <!--上-->
                                <div class="NodeDetail-title">
                                    <!--内容-->
                                    <div class="details">
                                        <h4>程伟（高级工程师）</h4>
                                        <p>三航局-技术中心-总部-BIM中心</p>
                                    </div>
                                </div>
                                <!--中-->
                                <div class="NodeDetail-content">
                                    <p>请领导查阅</p>
                                </div>

                                <div class="NodeDetail-footer">
                                    <span>2017-10-31 22:22:31</span>
                                </div>
                            </div>
                        </div>


                        <div class="oneNode">
                            <!--左侧小球-->
                            <div class="check check-prime">
                                发起
                            </div>

