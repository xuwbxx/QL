    var DoDeleteProjectFlow = function (ProjectID) {

        if (ProjectID == null || ProjectID == '' || ProjectID == 0)
            return;

        Param.ProjectID = ProjectID;
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('DeleteProjectFlow', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {

                        ModalPopup('success', '删除成功');
                        DoQuery();
                        
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
                ModalClose('information');
            });
    }



    var QueryFlowHistory = function (ProjectID) {

        if (ProjectID == null || ProjectID == '' || ProjectID == 0) {
            return;
        }

        Param.ProjectID = ProjectID;
        Param.PostToken = $('#hid_PostToken').val() + CreateTimeToken();
        $.post('QueryFlowHistory', Param)
            .success(function (data, statusText, jqXRH) {
                if (data) {
                    if (data.Success) {

                        var ProjectFlowHistoryHtml = '';
                        $(data.Data).each(function (index, dom) {

                            var FlowHtml = '';
                            if (dom.FlowType == 0) {
                                FlowHtml += '<div class="oneNode"><!--左侧小球--><div class="check"><img src="../../Content/Cloud/img/lc_faqi.png"></div>'
                                    + '<!--右侧内容--><div class="NodeDetail"><div class="NodeLinkName"><i class="fa fa-paper-plane-o"></i>' + dom.NodeName + '</div>'
                                    + '<!--上--><div class="NodeDetail-title"><!--内容--><div class="details"><h4>' + dom.Flow[0].NodeUserName + '(' + dom.Flow[0].NodeUserJobName + ')</h4><p title="' + dom.Flow[0].NodeUserDepart + '">' + dom.Flow[0].NodeUserDepart.substring(0, 15) + '</p></div></div>'
                                    + '<!--中--><div class="NodeDetail-content"><p title="' + dom.Flow[0].Comment + '">' + dom.Flow[0].Comment.substring(0, 20) + '</p></div><div class="NodeDetail-footer"><span>' + dom.FlowTime + '</span></div></div></div>';
                            }
                            else if (dom.FlowType == 2) {
                                FlowHtml += '<div class="oneNode"><!--左侧小球--><div class="check"><img src="../../Content/Cloud/img/lc_end.png"></div>'

                                    + '<!--右侧内容--><div class="NodeDetail clearfix"><div class="NodeLinkName"><i class="fa fa-paper-plane-o"></i>抄送</div>';

                                $(dom.Flow).each(function (index2, dom2) {
                                    FlowHtml += '<div class="NodeDetail-title pull-left"><!--内容--><div class="details"><h4>' + dom2.NodeUserName + '（' + dom2.NodeUserJobName + '）</h4><p title="' + dom2.NodeUserDepart + '">' + dom2.NodeUserDepart.substring(0, 15) + '</p></div></div>';
                                })
                                FlowHtml += '<div class="NodeDetail-footer"><span>' + dom.FlowTime ?? "" + '</span></div></div></div>';
                            }
                            else if (dom.FlowType == 1) {
                                var PicType = 'lc_daishenpi.png';
                                //正常流程
                                if (dom.FlowHandle == 0) {
                                    //待审批
                                    PicType = 'lc_daishenpi.png';
                                }
                                else if (dom.FlowHandle == 1) {
                                    //审批通过
                                    PicType = 'lc_sptg.png';
                                }
                                else if (dom.FlowHandle == 2) {
                                    //审批退回
                                    PicType = 'lc_tuihui.png';
                                }
                                else if (dom.FlowHandle == 3) {
                                    //审批删除
                                    PicType = 'lc_delete.png';
                                }

                                if (dom.ApprovalType == 1) {
                                    //单人审批
                                    FlowHtml += '<div class="oneNode"><!--左侧小球--><div class="check"><img src="../../Content/Cloud/img/' + PicType + '"></div>'
                                        + '<!--右侧内容--><div class="NodeDetail"><div class="NodeLinkName"><i class="fa fa-paper-plane-o"></i>' + dom.NodeName + '</div>'
                                        + '<!--上--><div class="NodeDetail-title"><!--内容--><div class="details"><h4>' + dom.Flow[0].NodeUserName + '(' + dom.Flow[0].NodeUserJobName + ')</h4><p title="' + dom.Flow[0].NodeUserDepart + '">' + dom.Flow[0].NodeUserDepart.substring(0, 15) + '</p></div></div>'
                                        + '<!--中--><div class="NodeDetail-content"><p title="' + dom.Flow[0].Comment + '">' + dom.Flow[0].Comment.substring(0, 20) + '</p></div><div class="NodeDetail-footer"><span>' + dom.Flow[0].FlowTime + '</span></div></div></div>';
                                }
                                else {
                                    //多人审批
                                    FlowHtml += '<div class="oneNode"><!--左侧小球--><div class="check"><img src="../../Content/Cloud/img/' + PicType + '"></div>'
                                        + '<!--右侧内容--><div class="flowChart_lb"><div class="NodeLinkName_lb"><i class="fa fa-paper-plane-o"></i>' + dom.NodeName + '</div><ul class="clearfix">'

                                    $(dom.Flow).each(function (index2, dom2) {

                                        var FlowHandleType = 'xm_zt_orange';
                                        if (dom2.FlowHandle == 1) {
                                            FlowHandleType = 'xm_zt_green';
                                        }
                                        else if (dom2.FlowHandle == 2) {
                                            FlowHandleType = 'xm_zt_red';
                                        }

                                        FlowHtml += '<li><div class="NodeDetail_lb"><!--上--><div class="NodeDetail-title"><!--内容--><div class="details"><h4>' + dom2.NodeUserName + '（' + dom2.NodeUserJobName + '）</h4><p title="' + dom2.NodeUserDepart + '">' + dom2.NodeUserDepart.substring(0, 15) + '</p></div></div>'
                                            + '<!--中--><div class="NodeDetail-content"><p title="' + dom2.Comment + '">' + dom2.Comment.substring(0, 20) + '</p></div><div class="NodeDetail-content"><p class="' + FlowHandleType + ' m0">' + dom2.FlowHandleName + '</p></div><div class="NodeDetail-footer_lb"><span>' + dom2.FlowTime + '</span></div></div></li>';

                                    })
                                    FlowHtml += '</ul></div></div>';
                                }

                            }

                            ProjectFlowHistoryHtml += FlowHtml;

                        })

                        $('#html_ProjectFlowHistory').html(ProjectFlowHistoryHtml);
                        $('#tk_path').modal('show');
                    }
                }
            })
            .fail(function (jqXHR, statusText, errorMessage) {
                //console.error(arguments);
            })
            .always(function (data) {
            });

    }


</script>

