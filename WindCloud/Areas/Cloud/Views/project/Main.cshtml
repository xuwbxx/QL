    function detectDevice() {

        const userAgent = navigator.userAgent.toLowerCase();
        const screenWidth = window.innerWidth;//944
        const screenHeight = window.innerHeight;//573
        //pad 582 648
        //交建通 944 573
        alert(screenWidth + ',' + screenHeight);

        const isTouchDevice = 'ontouchstart' in window || navigator.maxTouchPoints > 0;

        var s1 = 'ontouchstart' in window;
        var s2 = navigator.maxTouchPoints > 0;

        alert(s1);
        alert(s2);

        // 1. 明确的移动设备检测
        const isMobile = /mobile|android|iphone|ipod/i.test(userAgent);
        //pad 582 648
        //交建通 944 573
        // 2. 平板特征检测（结合触控和尺寸）
        const isTablet =
            (/tablet|ipad/i.test(userAgent) ||
                (isTouchDevice && screenWidth > 767)) &&
            !isMobile; // 排除明确的移动设备

        // 3. 使用媒体查询检测桌面设备
        const isDesktop = window.matchMedia('(min-width: 1025px) and (hover: hover)').matches;

        // 最终判断逻辑
        if (isTablet) {
            return 'tablet';
        } else if (isMobile || (!isDesktop && screenWidth <= 1024)) {
            return 'mobile';
        } else {
            return 'desktop';
        }

    }


