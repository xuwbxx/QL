        var WorkAreaAdd = function(){
            // 修复：新增时不仅清空表单，还要显示弹窗
            $('#hid_ID').val(0);
            $('#areaCode, #workColumn, #workRow, #startX, #startY, #endX, #endY, #topBiaoGao, #bottomBiaoGao, #soilGuanRuLiang, #soilUseTotal, #soilBiaoGao').val('');
            $('#workColumn, #workRow, #startX, #startY, #endX, #endY').prop('disabled', false);
            $('#dataModal').css('display', 'flex'); // 新增这行，打开弹窗
