        var WorkAreaSave = function(){

            // 1. 获取并验证表单数据
                const formData = {
                    ID: $('#hid_ID').val(),
                    areaNo: $('#areaCode').val().trim(),
                    workColumn: formatValue($('#workColumn').val().trim()),
                    workRow: formatValue($('#workRow').val().trim()),
                    startX: formatValue($('#startX').val().trim()),
                    startY: formatValue($('#startY').val().trim()),
                    endX: formatValue($('#endX').val().trim()),
                    endY: formatValue($('#endY').val().trim()),
                    topBiaoGao: formatValue($('#topBiaoGao').val().trim()),
                    bottomBiaoGao: formatValue($('#bottomBiaoGao').val().trim()),
                    soilGuanRuLiang: formatValue($('#soilGuanRuLiang').val().trim()),
                    soilUseTotal: formatValue($('#soilUseTotal').val().trim()),
                    soilBiaoGao: formatValue($('#soilBiaoGao').val().trim())
                };

                // 基础验证：区域编号不能为空
                if (!formData.areaNo) {
                    alert('请输入区域编号！');
                    return;
                }

                // 2. 弹出确认提示框
                const isConfirm = confirm(`确认要保存区域编号【${formData.areaNo}】的施工数据吗？`);
                if (!isConfirm) {
                    // 用户取消保存
                    return;
                }

                // 3. 发送POST请求到后端（JSON格式）
                $.ajax({
                    url: '/Work/Improve/WorkAreaSave', // 替换为你的实际后端接口地址
                    type: 'POST',
                    contentType: 'application/json; charset=utf-8', // 指定JSON格式
                    dataType: 'json',
                    data: JSON.stringify(formData), // 转换为JSON字符串
                    success: function(response) {

                        if(response.success)
                        {
                            alert('保存成功！区域编号： ' + formData.areaNo + ',' + response.message);
                            // 关闭弹窗
                            $('#dataModal').css('display', 'none');
                            // 可选：清空表单数据
                            $('#areaCode, #workColumn, #workRow, #startX, #startY, #endX, #endY, #topBiaoGao, #bottomBiaoGao, #soilGuanRuLiang, #soilUseTotal, #soilBiaoGao').val('');

                            DataListQuery();

                        }
                        else
                        {
                            alert('保存失败！' + response.message);
                        }

                    },
                    error: function(xhr, status, error) {
                        // 请求失败处理
                        console.error('保存失败：', error);
                        alert(`保存失败！\n错误状态：${status}\n错误信息：${xhr.responseText || '网络异常，请重试'}`);
                    },
                    complete: function() {
                        // 无论成功失败都执行的逻辑（可选）
                        // 例如：隐藏加载中状态
                    }
                });

        }

        var WorkAreaOpen = function(ID){

            //alert(ID);

            window.open('Work2?areaID=' + ID, '_blank');

        }


        var formatValue = function(value){

            // 空字符串/空值 → null
            if (value === '' || value === undefined || value === null) {
                return null;
            }
            // 尝试转换为数字（针对数值型字段）
            const num = Number(value);
            // 转换成功则返回数字，否则返回原始值（如字符串类型的areaNo）
            return isNaN(num) ? value : num;

        }

