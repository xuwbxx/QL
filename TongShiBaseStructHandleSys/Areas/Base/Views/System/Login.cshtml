
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>登录页</title>

    <script type="text/javascript" src="~/lib/jquery/dist/jquery.min.js"></script>

    <style>
        /* 全局样式重置 */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Microsoft Yahei", Arial, sans-serif;
        }

        /* 页面背景 */
        body {
            background-color: #f0f2f5;
            background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-9-21c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM60 91c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM35 41c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2zM12 60c1.105 0 2-.895 2-2s-.895-2-2-2-2 .895-2 2 .895 2 2 2z' fill='%23165DFF' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
        }

        /* 登录卡片容器 */
        .login-container {
            width: 100%;
            max-width: 420px;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
            padding: 40px 30px;
            position: relative;
            overflow: hidden;
        }

            /* 顶部装饰条 */
            .login-container::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 4px;
                background: linear-gradient(90deg, #165DFF, #0F3B88);
            }

        /* 标题区域 */
        .login-header {
            text-align: center;
            margin-bottom: 30px;
        }

            .login-header h1 {
                font-size: 20px;
                color: #1D2129;
                margin-bottom: 8px;
                font-weight: 600;
            }

            .login-header p {
                font-size: 14px;
                color: #86909C;
            }

        /* 表单样式 */
        .login-form .form-item {
            margin-bottom: 20px;
            position: relative;
        }

        .login-form label {
            display: block;
            font-size: 14px;
            color: #4E5969;
            margin-bottom: 6px;
        }

        .login-form input {
            width: 100%;
            height: 44px;
            padding: 0 15px;
            border: 1px solid #DCDFE6;
            border-radius: 4px;
            font-size: 14px;
            color: #1D2129;
            transition: border-color 0.3s;
        }

            .login-form input:focus {
                outline: none;
                border-color: #165DFF;
                box-shadow: 0 0 0 2px rgba(22, 93, 255, 0.1);
            }

        /* 按钮样式 */
        .login-btn {
            width: 100%;
            height: 44px;
            background-color: #165DFF;
            color: #ffffff;
            border: none;
            border-radius: 4px;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.3s;
            margin-top: 10px;
        }

            .login-btn:hover {
                background-color: #0F52D9;
            }

            .login-btn:active {
                background-color: #0A49C6;
            }

        /* 底部信息 */
        .login-footer {
            text-align: center;
            margin-top: 20px;
            font-size: 12px;
            color: #86909C;
        }

    </style>

</head>
<body>

    <div class="login-container">
        <div class="login-header">
            <h1 style="font-size:2.8vh;">桶式基础结构地基改良处理系统</h1>
            <p>洋山深水港区小洋山作业区地基处理工程</p>
        </div>
        <form class="login-form">
            <div class="form-item">
                <label for="username">用户名</label>
                <input type="text" id="username" placeholder="请输入登录账号" required>
            </div>
            <div class="form-item">
                <label for="password">密码</label>
                <input type="password" id="password" placeholder="请输入登录密码" required>
            </div>
            <button type="submit" class="login-btn">登录系统</button>
        </form>
        <div class="login-footer">
            <p>© 2026 三航局技术中心 版权所有</p>
        </div>
    </div>

</body>

</html>

<script type="text/javascript">
        // 确保页面加载完成后执行
    $(document).ready(function() {
        // 监听登录表单提交事件（兼容点击按钮和回车提交）
        $('.login-form').on('submit', function(e) {
            // 阻止表单默认跳转行为
            e.preventDefault();

            // 1. 获取并校验输入值
            var username = $('#username').val().trim();
            var password = $('#password').val().trim();

            // 用户名校验
            if (username === '') {
                alert('请输入用户名！');
                $('#username').focus();
                return;
            }
            // 密码校验
            if (password === '') {
                alert('请输入密码！');
                $('#password').focus();
                return;
            }

            // var PostData = {};
            // PostData.UserName = username;
            // PostData.Password = password;

            // 2. 设置按钮加载状态，防止重复提交
            var $loginBtn = $('.login-btn');
            $loginBtn.prop('disabled', true).text('登录中...');

            // 3. 发送 POST 请求到后端控制器
            $.ajax({
                url: '/Base/System/DoLogin',  // 后端控制器接口地址
                type: 'POST',        // 请求方式
                contentType: 'application/json; charset=utf-8', // 请求参数格式
                dataType: 'json',    // 预期后端返回的数据格式
                // 要发送给后端的参数
                data: JSON.stringify({
                    UserName: username,  // 字段名要和后端模型的属性名完全一致（大小写敏感）
                    Password: password
                }),
                // 请求成功的回调
                success: function(res) {
                    // 根据后端返回的状态判断登录结果
                    if (res.success) {
                        // 登录成功：跳转到系统首页（示例路径）
                        //alert('登录成功！正在进入系统...');
                        window.location.href = '/Work/Improve/Index2'; // 替换为你的首页路径
                    } else {
                        // 登录失败：提示错误信息
                        alert('登录失败：' + (res.message || '用户名或密码错误'));
                    }
                },
                // 请求失败的回调（网络错误、接口不存在等）
                error: function(xhr, status, error) {
                    alert('登录请求失败：' + error || '服务器连接异常，请稍后重试');
                    console.error('请求错误：', xhr, status, error); // 控制台打印详情，方便调试
                },
                // 无论成功/失败，最终执行的回调（恢复按钮状态）
                complete: function() {
                    $loginBtn.prop('disabled', false).text('登录系统');
                }
            });
        });
    });
</script>
